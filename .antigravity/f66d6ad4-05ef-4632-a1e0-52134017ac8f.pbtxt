      target_content: "      {/* Categorized Checklist Grid */}\n      <div className=\"grid grid-cols-1 md:grid-cols-3 gap-5\">\n        {categories.map((category) => {\n          const items = checklist.filter((i) => i.category === category);\n\n          return (\n            <div\n              key={category}\n              className=\"p-5 rounded-2xl bg-[#293735] border border-[#3B4B47] shadow-lg flex flex-col justify-between\"\n            >\n              <div>\n                <div className=\"flex items-center justify-between pb-3 border-b border-[#3B4B47]\">\n                  <h3 className=\"text-xs font-mono font-bold text-[#F0F4EE] uppercase tracking-wider\">\n                    {category}\n                  </h3>\n                  <span className=\"text-[10px] font-mono text-[#71817B]\">\n                    {items.filter((i) => i.status === \'COMPLETE\').length} / {items.length}\n                  </span>\n                </div>\n\n                <div className=\"space-y-3 mt-3\">\n                  {items.map((item) => {\n                    const isDone = item.status === \'COMPLETE\';\n                    const isAttn = item.status === \'NEEDS_ATTENTION\';\n\n                    return (\n                      <div\n                        key={item.id}\n                        onClick={() => onToggleStatus(item.id)}\n                        className={`p-3.5 rounded-xl border transition-all cursor-pointer select-none space-y-2 ${\n                          isDone\n                            ? \'bg-[#202B2A] border-[#B7E4C7]/30\'\n                            : isAttn\n                            ? \'bg-[#31413F] border-[#FFE0A3]/30\'\n                            : \'bg-[#202B2A] border-[#3B4B47] opacity-60\'\n                        }`}\n                      >\n                        <div className=\"flex items-start justify-between gap-2\">\n                          <span className=\"text-xs font-bold text-[#F0F4EE] leading-tight\">\n                            {item.label}\n                          </span>\n                          <span className={`px-1.5 py-0.5 rounded text-[9px] font-mono font-bold shrink-0 ${\n                            isDone\n                              ? \'bg-[#B7E4C7]/20 text-[#B7E4C7]\'\n                              : isAttn\n                              ? \'bg-[#FFE0A3]/20 text-[#FFE0A3]\'\n                              : \'bg-[#202B2A] text-[#71817B]\'\n                          }`}>\n                            {item.status.replace(\'_\', \' \')}\n                          </span>\n                        </div>\n\n                        <p className=\"text-[11px] text-[#AAB8B2] leading-snug\">\n                          {item.detail}\n                        </p>\n\n                        <div className=\"pt-1.5 border-t border-[#3B4B47]/50 flex items-center justify-between text-[10px] font-mono text-[#71817B]\">\n                          <span>Time: {item.timeToFinish}</span>\n                          <span className=\"text-[#A8E6CF] hover:underline\">\n                            {isDone ? \'\342\234\223 Verified\' : \'Mark Complete\'}\n                          </span>\n                        </div>\n                      </div>\n                    );\n                  })}\n                </div>\n              </div>\n            </div>\n          );\n        })}\n      </div>\n    </div>\n  );\n};"
      replacement_content: "      {/* Categorized Checklist Grid */}\n      <div className=\"grid grid-cols-1 md:grid-cols-3 gap-5\">\n        {categories.map((category) => {\n          const items = checklist.filter((i) => i.category === category);\n\n          return (\n            <div\n              key={category}\n              className=\"p-5 rounded-2xl bg-[#293735] border border-[#3B4B47] shadow-lg flex flex-col justify-between\"\n            >\n              <div>\n                <div className=\"flex items-center justify-between pb-3 border-b border-[#3B4B47]\">\n                  <h3 className=\"text-xs font-mono font-bold text-[#F0F4EE] uppercase tracking-wider\">\n                    {category}\n                  </h3>\n                  <span className=\"text-[10px] font-mono text-[#71817B]\">\n                    {items.filter((i) => i.status === \'COMPLETE\').length} / {items.length}\n                  </span>\n                </div>\n\n                <div className=\"space-y-3 mt-3\">\n                  {items.map((item) => {\n                    const isDone = item.status === \'COMPLETE\';\n                    const isAttn = item.status === \'NEEDS_ATTENTION\';\n\n                    return (\n                      <div\n                        key={item.id}\n                        onClick={() => onToggleStatus(item.id)}\n                        className={`p-3.5 rounded-xl border transition-all cursor-pointer select-none space-y-2 ${\n                          isDone\n                            ? \'bg-[#202B2A] border-[#B7E4C7]/30\'\n                            : isAttn\n                            ? \'bg-[#31413F] border-[#FFE0A3]/30\'\n                            : \'bg-[#202B2A] border-[#3B4B47] opacity-60\'\n                        }`}\n                      >\n                        <div className=\"flex items-start justify-between gap-2\">\n                          <span className=\"text-xs font-bold text-[#F0F4EE] leading-tight\">\n                            {item.label}\n                          </span>\n                          <span className={`px-1.5 py-0.5 rounded text-[9px] font-mono font-bold shrink-0 ${\n                            isDone\n                              ? \'bg-[#B7E4C7]/20 text-[#B7E4C7]\'\n                              : isAttn\n                              ? \'bg-[#FFE0A3]/20 text-[#FFE0A3]\'\n                              : \'bg-[#202B2A] text-[#71817B]\'\n                          }`}>\n                            {item.status.replace(\'_\', \' \')}\n                          </span>\n                        </div>\n\n                        <p className=\"text-[11px] text-[#AAB8B2] leading-snug\">\n                          {item.detail}\n                        </p>\n\n                        <div className=\"pt-1.5 border-t border-[#3B4B47]/50 flex items-center justify-between text-[10px] font-mono text-[#71817B]\">\n                          <span>Time: {item.timeToFinish}</span>\n                          <span className=\"text-[#A8E6CF] hover:underline\">\n                            {isDone ? \'\342\234\223 Verified\' : \'Mark Complete\'}\n                          </span>\n                        </div>\n                      </div>\n                    );\n                  })}\n                </div>\n              </div>\n            </div>\n          );\n        })}\n      </div>\n\n      {/* AI PITCH COACH & 75-SECOND DEMO SCRIPT */}\n      <div className=\"p-6 rounded-2xl bg-[#293735] border border-[#3B4B47] shadow-xl space-y-5\">\n        <div className=\"flex flex-col sm:flex-row sm:items-center justify-between pb-3 border-b border-[#3B4B47] gap-3\">\n          <div className=\"flex items-center gap-2\">\n            <Mic className=\"w-4 h-4 text-[#A8E6CF]\" />\n            <h2 className=\"text-sm font-bold font-mono text-[#F0F4EE] uppercase\">\n              AI PITCH COACH &amp; 60\342\200\22390s DEMO SCRIPT\n            </h2>\n          </div>\n\n          <button\n            onClick={handleGeneratePitch}\n            disabled={isGeneratingPitch}\n            className=\"flex items-center gap-2 px-3.5 py-1.5 rounded-xl bg-[#31413F] hover:bg-[#3B4B47] border border-[#3B4B47] hover:border-[#A8E6CF]/40 text-xs font-mono text-[#F0F4EE] transition-all disabled:opacity-50 self-start sm:self-auto\"\n          >\n            <RefreshCw className={`w-3.5 h-3.5 text-[#A8E6CF] ${isGeneratingPitch ? \'animate-spin\' : \'\'}`} />\n            <span>{isGeneratingPitch ? \'HALFTIME IS THINKING...\' : \'RE-GENERATE PITCH WITH GEMINI\'}</span>\n          </button>\n        </div>\n\n        {isGeneratingPitch && (\n          <div className=\"p-4 rounded-xl bg-[#202B2A] border border-[#A8E6CF]/40 space-y-2 animate-in fade-in\">\n            <div className=\"flex items-center justify-between text-xs font-mono\">\n              <span className=\"font-bold text-[#A8E6CF] flex items-center gap-2\">\n                <Sparkles className=\"w-3.5 h-3.5 animate-spin\" />\n                HALFTIME IS THINKING...\n              </span>\n              <span className=\"text-[#71817B]\">Step {pitchStep + 1} of 4</span>\n            </div>\n            <p className=\"text-xs text-[#F0F4EE] font-mono\">\n              {pitchSteps[pitchStep]}\n            </p>\n            <div className=\"h-1.5 w-full bg-[#3B4B47] rounded-full overflow-hidden\">\n              <div\n                className=\"h-full bg-gradient-to-r from-[#A8E6CF] to-[#A8DADC] transition-all duration-500\"\n                style={{ width: `${((pitchStep + 1) / pitchSteps.length) * 100}%` }}\n              />\n            </div>\n          </div>\n        )}\n\n        {pitchData && (\n          <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-5\">\n            {/* Structured Pitch Pillars */}\n            <div className=\"lg:col-span-6 space-y-3\">\n              <span className=\"text-[11px] font-mono font-bold text-[#71817B] uppercase block\">\n                7-POINT JUDGE CONVERSION MATRIX\n              </span>\n\n              <div className=\"space-y-2 text-xs\">\n                <div className=\"p-3 rounded-xl bg-[#202B2A] border border-[#3B4B47]\">\n                  <span className=\"font-mono text-[#FFB7B2] font-semibold text-[10px] block\">1. VISCERAL PROBLEM</span>\n                  <p className=\"text-[#AAB8B2] mt-0.5\">{pitchData.problem}</p>\n                </div>\n\n                <div className=\"p-3 rounded-xl bg-[#202B2A] border border-[#3B4B47]\">\n                  <span className=\"font-mono text-[#FFE0A3] font-semibold text-[10px] block\">2. WHY IT MATTERS</span>\n                  <p className=\"text-[#AAB8B2] mt-0.5\">{pitchData.whyItMatters}</p>\n                </div>\n\n                <div className=\"p-3 rounded-xl bg-[#202B2A] border border-[#3B4B47]\">\n                  <span className=\"font-mono text-[#A8E6CF] font-semibold text-[10px] block\">3. SOLUTION &amp; HOW IT WORKS</span>\n                  <p className=\"text-[#F0F4EE] font-medium mt-0.5\">{pitchData.solution}</p>\n                  <p className=\"text-[#AAB8B2] mt-1 text-[11px]\">{pitchData.howItWorks}</p>\n                </div>\n\n                <div className=\"p-3 rounded-xl bg-[#202B2A] border border-[#3B4B47]\">\n                  <span className=\"font-mono text-[#C7F9A6] font-semibold text-[10px] block\">4. 30s LIVE DEMO MOMENT</span>\n                  <p className=\"text-[#C7F9A6] mt-0.5 font-medium\">{pitchData.demoMoment}</p>\n                </div>\n\n                <div className=\"grid grid-cols-2 gap-2\">\n                  <div className=\"p-2.5 rounded-xl bg-[#202B2A] border border-[#3B4B47]\">\n                    <span className=\"font-mono text-[#A8DADC] font-semibold text-[10px] block\">5. IMPACT</span>\n                    <p className=\"text-[#AAB8B2] mt-0.5 text-[11px]\">{pitchData.impact}</p>\n                  </div>\n                  <div className=\"p-2.5 rounded-xl bg-[#202B2A] border border-[#3B4B47]\">\n                    <span className=\"font-mono text-[#B8DDF0] font-semibold text-[10px] block\">6. WHY NOW</span>\n                    <p className=\"text-[#AAB8B2] mt-0.5 text-[11px]\">{pitchData.whyNow}</p>\n                  </div>\n                </div>\n              </div>\n            </div>\n\n            {/* Word-for-Word Spoken Teleprompter */}\n            <div className=\"lg:col-span-6 flex flex-col justify-between p-5 rounded-xl bg-[#202B2A] border border-[#C7F9A6]/30 shadow-inner\">\n              <div className=\"space-y-3\">\n                <div className=\"flex items-center justify-between pb-2 border-b border-[#3B4B47]\">\n                  <div className=\"flex items-center gap-2\">\n                    <span className=\"px-2 py-0.5 rounded bg-[#C7F9A6]/20 text-[#C7F9A6] text-[10px] font-mono font-bold\">\n                      {pitchData.durationSeconds || 75}s VERBAL RUNTIME\n                    </span>\n                    <span className=\"text-[10px] font-mono text-[#71817B]\">SPOKEN TELEPROMPTER</span>\n                  </div>\n\n                  <button\n                    onClick={handleCopyScript}\n                    className=\"flex items-center gap-1 text-[11px] font-mono text-[#A8E6CF] hover:underline\"\n                  >\n                    {copiedScript ? <Check className=\"w-3 h-3 text-[#C7F9A6]\" /> : <Copy className=\"w-3 h-3\" />}\n                    <span>{copiedScript ? \'Copied!\' : \'Copy Script\'}</span>\n                  </button>\n                </div>\n\n                <div className=\"p-4 rounded-xl bg-[#293735]/80 border border-[#3B4B47] text-xs sm:text-sm text-[#F0F4EE] leading-relaxed whitespace-pre-line font-sans select-text\">\n                  {pitchData.script}\n                </div>\n              </div>\n\n              <div className=\"pt-3 mt-3 border-t border-[#3B4B47] flex items-center justify-between text-[11px] font-mono\">\n                <span className=\"text-[#71817B]\">KEY 