    file_change_type: FILE_CHANGE_TYPE_EDIT
    replacement_chunks {
      target_content: "import React, { useEffect, useState } from \'react\';\nimport { Terminal } from \'lucide-react\';\nimport { HealthStatus } from \'../types\';\n\ninterface TopBarProps {\n  healthStatus: HealthStatus;\n  onOpenCommandPalette: () => void;\n  onOpenShipMode: () => void;\n  shipModeReady: boolean;\n}\n\nexport const TopBar: React.FC<TopBarProps> = ({\n  healthStatus,\n  onOpenCommandPalette,\n  onOpenShipMode,\n  shipModeReady,\n}) => {\n  // Live countdown (simulating 11:42:17 ticking)\n  const [secondsLeft, setSecondsLeft] = useState(11 * 3600 + 42 * 60 + 17);\n\n  useEffect(() => {\n    const timer = setInterval(() => {\n      setSecondsLeft((prev) => (prev > 0 ? prev - 1 : 0));\n    }, 1000);\n    return () => clearInterval(timer);\n  }, []);\n\n  const hours = Math.floor(secondsLeft / 3600);\n  const minutes = Math.floor((secondsLeft % 3600) / 60);\n  const seconds = secondsLeft % 60;\n\n  const pad = (n: number) => n.toString().padStart(2, \'0\');\n  const isCritical = healthStatus === \'critical\' || healthStatus === \'at-risk\';\n\n  return (\n    <header \n      id=\"halftime-topbar\"\n      className=\"h-20 border-b border-[#3B4B47] flex items-center justify-between px-6 sm:px-10 relative z-10 bg-[#202B2A]/90 backdrop-blur-md\"\n    >\n      {/* Left hackathon event indicator */}\n      <div className=\"flex items-center space-x-4\">\n        <span className=\"text-[11px] font-mono text-[#71817B] uppercase tracking-widest\">\n          Event\n        </span>\n        <span className=\"text-xs font-bold bg-[#293735] px-3 py-1.5 rounded-full border border-[#3B4B47] text-[#F0F4EE]\">\n          DORAHACKS 2.0\n        </span>\n      </div>\n\n      {/* Right controls: Quick command trigger and artistic countdown capsule */}\n      <div className=\"flex items-center space-x-4\">\n        <button\n          id=\"btn-topbar-command-palette\"\n          onClick={onOpenCommandPalette}\n          className=\"hidden md:flex items-center space-x-2 px-3 py-1.5 rounded-xl bg-[#293735] hover:bg-[#31413F] border border-[#3B4B47] text-xs text-[#AAB8B2] hover:text-[#F0F4EE] transition-all group\"\n          title=\"Quick actions and navigation (\342\214\230K)\"\n        >\n          <Terminal className=\"w-3.5 h-3.5 text-[#71817B] group-hover:text-[#A8E6CF] transition-colors\" />\n          <span>Search</span>\n          <kbd className=\"px-1.5 py-0.5 rounded bg-[#202B2A] border border-[#3B4B47] text-[10px] text-[#71817B] font-mono\">\342\214\230K</kbd>\n        </button>\n\n        {/* Artistic time & ship mode capsule */}\n        <div \n          id=\"halftime-countdown-capsule\"\n          className=\"flex items-center bg-[#293735] border border-[#3B4B47] rounded-2xl px-5 sm:px-6 py-2 shadow-2xl\"\n        >\n          <div className=\"flex flex-col items-center mr-4 sm:mr-6\">\n            <span className=\"text-[9px] text-[#71817B] uppercase tracking-tighter mb-0.5 font-mono\">\n              Time Left\n            </span>\n            <span \n              className={`text-lg sm:text-xl font-mono font-bold tracking-tight ${\n                isCritical ? \'text-[#FFB7B2]\' : \'text-[#C7F9A6]\'\n              }`}\n            >\n              {pad(hours)}:{pad(minutes)}:{pad(seconds)}\n            </span>\n          </div>\n\n          <div className=\"w-px h-8 bg-[#3B4B47] mx-1 sm:mx-2\" />\n\n          <button \n            id=\"btn-topbar-ship-mode\"\n            onClick={onOpenShipMode}\n            className=\"flex flex-col items-start ml-3 sm:ml-4 text-left group cursor-pointer\"\n          >\n            <span className=\"text-[10px] font-bold text-[#C7F9A6] group-hover:brightness-125 transition-all tracking-wide\">\n              SHIP MODE\n            </span>\n            <div className=\"flex space-x-1 mt-1\">\n              <div className=\"w-1 h-1 bg-[#C7F9A6] rounded-full\" />\n              <div className=\"w-1 h-1 bg-[#C7F9A6] rounded-full opacity-40\" />\n              <div className=\"w-1 h-1 bg-[#C7F9A6] rounded-full opacity-20\" />\n            </div>\n          </button>\n        </div>\n      </div>\n    </header>\n  );\n};"
      replacement_content: "import React from \'react\';\nimport { Terminal } from \'lucide-react\';\nimport { HealthStatus } from \'../types\';\n\ninterface TopBarProps {\n  healthStatus: HealthStatus;\n  onOpenCommandPalette: () => void;\n  onOpenShipMode: () => void;\n  shipModeReady: boolean;\n  countdownDisplay: string;\n  countdownStatus: \'NORMAL\' | \'AT RISK\' | \'CRITICAL\';\n}\n\nexport const TopBar: React.FC<TopBarProps> = ({\n  healthStatus,\n  onOpenCommandPalette,\n  onOpenShipMode,\n  shipModeReady,\n  countdownDisplay,\n  countdownStatus,\n}) => {\n  const getStatusColor = () => {\n    if (countdownStatus === \'CRITICAL\' || healthStatus === \'critical\') {\n      return \'text-[#FFB7B2]\';\n    }\n    if (countdownStatus === \'AT RISK\' || healthStatus === \'at-risk\') {\n      return \'text-[#FFE0A3]\';\n    }\n    return \'text-[#C7F9A6]\';\n  };\n\n  const getStatusBadge = () => {\n    if (countdownStatus === \'CRITICAL\') {\n      return \'bg-[#FFB7B2]/20 text-[#FFB7B2] border-[#FFB7B2]/40\';\n    }\n    if (countdownStatus === \'AT RISK\') {\n      return \'bg-[#FFE0A3]/20 text-[#FFE0A3] border-[#FFE0A3]/40\';\n    }\n    return \'bg-[#C7F9A6]/20 text-[#C7F9A6] border-[#C7F9A6]/40\';\n  };\n\n  return (\n    <header \n      id=\"halftime-topbar\"\n      className=\"h-20 border-b border-[#3B4B47] flex items-center justify-between px-4 sm:px-8 lg:px-10 relative z-10 bg-[#202B2A]/90 backdrop-blur-md\"\n    >\n      {/* Left hackathon event indicator */}\n      <div className=\"flex items-center space-x-3 sm:space-x-4\">\n        <span className=\"text-[11px] font-mono text-[#71817B] uppercase tracking-widest hidden sm:inline\">\n          Event\n        </span>\n        <span className=\"text-xs font-bold bg-[#293735] px-3 py-1.5 rounded-full border border-[#3B4B47] text-[#F0F4EE] flex items-center gap-2\">\n          <span className=\"w-1.5 h-1.5 rounded-full bg-[#A8E6CF] animate-pulse\" />\n          <span>DORAHACKS 2.0</span>\n        </span>\n        <span className={`text-[10px] font-mono px-2 py-0.5 rounded border ${getStatusBadge()} hidden md:inline-block`}>\n          {countdownStatus}\n        </span>\n      </div>\n\n      {/* Right controls: Quick command trigger and artistic countdown capsule */}\n      <div className=\"flex items-center space-x-3 sm:space-x-4\">\n        <button\n          id=\"btn-topbar-command-palette\"\n          onClick={onOpenCommandPalette}\n          className=\"hidden md:flex items-center space-x-2 px-3 py-1.5 rounded-xl bg-[#293735] hover:bg-[#31413F] border border-[#3B4B47] text-xs text-[#AAB8B2] hover:text-[#F0F4EE] transition-all group\"\n          title=\"Quick actions and navigation (\342\214\230K)\"\n        >\n          <Terminal className=\"w-3.5 h-3.5 text-[#71817B] group-hover:text-[#A8E6CF] transition-colors\" />\n          <span>Search</span>\n          <kbd className=\"px-1.5 py-0.5 rounded bg-[#202B2A] border border-[#3B4B47] text-[10px] text-[#71817B] font-mono\">\342\214\230K</kbd>\n        </button>\n\n        {/* Artistic time & ship mode capsule */}\n        <div \n          id=\"halftime-countdown-capsule\"\n          className=\"flex items-center bg-[#293735] border border-[#3B4B47] rounded-2xl px-4 sm:px-6 py-2 shadow-2xl\"\n        >\n          <div className=\"flex flex-col items-center mr-3 sm:mr-6\">\n            <span className=\"text-[9px] text-[#71817B] uppercase tracking-wider mb-0.5 font-mono\">\n              TIME LEFT\n            </span>\n            <span \n              className={`text-base sm:text-xl font-mono font-bold tracking-tight ${getStatusColor()}`}\n            >\n              {countdownDisplay}\n            </span>\n          </div>\n\n          <div className=\"w-px h-8 bg-[#3B4B47] mx-1 sm:mx-2\" />\n\n          <button \n            id=\"btn-topbar-ship-mode\"\n            onClick={onOpenShipMode}\n            className=\"flex flex-col items-start ml-2 sm:ml-4 text-left group cursor-pointer\"\n          >\n            <span className=\"text-[10px] font-bold text-[#C7F9A6] group-hover:brightness-125 transition-all tracking-wide\">\n              SHIP MODE\n            </span>\n            <div className=\"flex space-x-1 mt-1\">\n              <div className=\"w-1 h-1 bg-[#C7F9A6] rounded-full\" />\n              <div className=\"w-1 h-1 bg-[#C7F9A6] rounded-full opacity-40\" />\n              <div className=\"w-1 h-1 bg-[#C7F9A6] rounded-full opacity-20\" />\n            </div>\n          </button>\n        </div>\n      </div>\n    </header>\n  );\n};\n"
    }
