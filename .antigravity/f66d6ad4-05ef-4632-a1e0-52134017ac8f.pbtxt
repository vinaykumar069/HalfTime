  file_change {
    absolute_path_uri: "file:///src/components/ideas/IdeaLab.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { \n  Lightbulb, \n  Sparkles, \n  Layers, \n  TrendingUp, \n  CheckCircle, \n  AlertOctagon, \n  XCircle, \n  ArrowRight,\n  Filter,\n  Plus,\n  RefreshCw,\n  Trash2,\n  FileText,\n  AlertTriangle,\n  Check,\n  X\n} from \'lucide-react\';\nimport { IdeaItem } from \'../../types\';\nimport { generateIdeas, evaluateIdea, defineProblem, ProblemDefinitionResult } from \'../../services/aiService\';\n\ninterface IdeaLabProps {\n  ideas: IdeaItem[];\n  onSelectActiveIdea: (idea: IdeaItem) => void;\n  onAddGeneratedIdeas: (newIdeas: IdeaItem[]) => void;\n  onDeleteIdea?: (ideaId: string) => void;\n  currentProjectName?: string;\n}\n\nexport const IdeaLab: React.FC<IdeaLabProps> = ({\n  ideas,\n  onSelectActiveIdea,\n  onAddGeneratedIdeas,\n  onDeleteIdea,\n  currentProjectName = \'Hackathon Project\',\n}) => {\n  const [teamSkills, setTeamSkills] = useState(\'Frontend development, AI, UI/UX\');\n  const [frustrations, setFrustrations] = useState(\'Teams waste too much time deciding what to build and building scope traps.\');\n  const [interests, setInterests] = useState(\'AI Developer Tools & Hackathon Copilots\');\n  const [targetUsers, setTargetUsers] = useState(\'Hackathon teams & builders\');\n  const [availableTime, setAvailableTime] = useState(\'12\');\n  const [criteria, setCriteria] = useState(\'Innovation 25%, Problem Fit 20%, Usability 20%, Execution 15%\');\n  const [isGenerating, setIsGenerating] = useState(false);\n  const [loadingStep, setLoadingStep] = useState(0);\n  const [filterVerdict, setFilterVerdict] = useState<string>(\'ALL\');\n  const [evaluatingIdeaId, setEvaluatingIdeaId] = useState<string | null>(null);\n  const [errorMessage, setErrorMessage] = useState<string | null>(null);\n\n  // Manual Add Modal / State\n  const [isManualAddOpen, setIsManualAddOpen] = useState(false);\n  const [manualTitle, setManualTitle] = useState(\'\');\n  const [manualProblem, setManualProblem] = useState(\'\');\n  const [manualTargetUser, setManualTargetUser] = useState(\'\');\n  const [manualSolution, setManualSolution] = useState(\'\');\n\n  // Define Problem Tool State\n  const [isProblemModalOpen, setIsProblemModalOpen] = useState(false);\n  const [problemDesc, setProblemDesc] = useState(\'\');\n  const [isDefiningProblem, setIsDefiningProblem] = useState(false);\n  const [problemResult, setProblemResult] = useState<ProblemDefinitionResult | null>(null);\n\n  const steps = [\n    \'Analyzing team strengths & tech stack...\',\n    \'Mining visceral problem spaces...\',\n    \'Validating 24h feasibility & runway...\',\n    \'Simulating 3-minute hackathon judge demo...\',\n  ];\n\n  const handleGenerate = async () => {\n    setErrorMessage(null);\n    setIsGenerating(true);\n    setLoadingStep(0);\n\n    const interval = setInterval(() => {\n      setLoadingStep((prev) => (prev < steps.length - 1 ? prev + 1 : prev));\n    }, 600);\n\n    try {\n      const generated = await generateIdeas({\n        teamSkills,\n        frustrations,\n        interests,\n        targetUsers,\n        availableTimeHours: parseInt(availableTime, 10) || 24,\n        hackathonCriteria: criteria,\n      });\n      onAddGeneratedIdeas(generated);\n    } catch (err: any) {\n      setErrorMessage(err?.message || \'HALFTIME AI is temporarily unavailable. Please try again.\');\n    } finally {\n      clearInterval(interval);\n      setIsGenerating(false);\n    }\n  };\n\n  const handleSingleEvaluate = async (idea: IdeaItem) => {\n    setErrorMessage(null);\n    setEvaluatingIdeaId(idea.id);\n    try {\n      const updated = await evaluateIdea(idea, {\n        availableTime: parseInt(availableTime, 10) || 24,\n        teamSkills,\n        hackathonCriteria: criteria,\n      });\n      const newIdeas = ideas.map((i) => (i.id === idea.id ? { ...i, ...updated } : i));\n      onAddGeneratedIdeas(newIdeas);\n    } catch (err: any) {\n      setErrorMessage(err?.message || \'HALFTIME AI is temporarily unavailable. Please try again.\');\n    } finally {\n      setEvaluatingIdeaId(null);\n    }\n  };\n\n  const handleDefineProblem = async () => {\n    setErrorMessage(null);\n    setIsDefiningProblem(true);\n    try {\n      const res = await defineProblem({\n        projectTitle: currentProjectName,\n        description: problemDesc || frustrations,\n        targetUser: targetUsers,\n      });\n      setProblemResult(res);\n    } catch (err: any) {\n      setErrorMessage(err?.message || \'Failed to define problem statement with Gemini.\');\n    } finally {\n      setIsDefiningProblem(false);\n    }\n  };\n\n  const handleAddManualIdea = (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!manualTitle.trim()) return;\n\n    const newIdea: IdeaItem = {\n      id: `custom-idea-${Date.now()}`,\n      title: manualTitle.trim(),\n      problem: manualProblem.trim() || \'User defined problem statement.\',\n      targetUser: manualTargetUser.trim() || targetUsers,\n      solution: manualSolution.trim() || \'Custom MVP solution.\',\n      innovationScore: 8.0,\n      problemFitScore: 8.0,\n      feasibilityScore: 8.0,\n      demoPotentialScore: 8.0,\n      verdict: \'BUILD\',\n      verdictReason: \'User created concept. Run Gemini critique for deep judge evaluation.\',\n      tags: [\'Custom\', \'User Added\'],\n    };\n\n    onAddGeneratedIdeas([newIdea, ...ideas]);\n    setManualTitle(\'\');\n    setManualProblem(\'\');\n    setManualTargetUser(\'\');\n    setManualSolution(\'\');\n    setIsManualAddOpen(false);\n  };\n\n  const filteredIdeas = ideas.filter(idea => {\n    if (filterVerdict === \'ALL\') return true;\n    return idea.verdict === filterVerdict;\n  });\n\n  return (\n    <div className=\"space-y-8 animate-in fade-in duration-300 pb-12\">\n      {/* Header */}\n      <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-4\">\n        <div>\n          <div className=\"inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#31413F] border border-[#3B4B47] text-xs font-mono text-[#A8DADC] mb-2\">\n            <Lightbulb className=\"w-3.5 h-3.5\" />\n            <span>IDEA VALIDATOR &amp; MATRIX</span>\n          </div>\n          <h1 className=\"text-2xl sm:text-4xl font-extrabold text-[#F0F4EE] tracking-tight font-display\">\n            FIND SOMETHING WORTH BUILDING.\n          </h1>\n          <p className=\"text-sm sm:text-base text-[#AAB8B2] mt-1 font-medium\">\n            Filter through hackathon noise. Score ideas by feasibility and 3-minute demo potential before writing a single line of code.\n          </p>\n        </div>\n\n        <div className=\"flex items-center gap-2 self-start sm:self-auto\">\n          <button\n            onClick={() => setIsProblemModalOpen(true)}\n            className=\"flex items-center gap-1.5 px-3.5 py-2 rounded-xl bg-[#293735] hover:bg-[#31413F] border border-[#3B4B47] text-xs font-mono text-[#A8E6CF] transition-all cursor-pointer\"\n          >\n            <FileText className=\"w-3.5 h-3.5\" />\n            <span>DEFINE THE PROBLEM</span>\n          </button>\n          <button\n            onClick={() => setIsManualAddOpen(!isManualAddOpen)}\n            className=\"flex items-center gap-1.5 px-3.5 py-2 rounded-xl bg-[#31413F] hover:bg-[#3B4B47] border border-[#3B4B47] text-xs font-mono text-[#F0F4EE] transition-all cursor-pointer\"\n          >\n            <Plus className=\"w-3.5 h-3.5 text-[#C7F9A6]\" />\n            <span>ADD CUSTOM IDEA</span>\n          </button>\n        </div>\n      </div>\n\n      {errorMessage && (\n        <div className=\"p-4 rounded-xl bg-[#FFB7B2]/10 border border-[#FFB7B2]/30 flex items-center justify-between gap-3 text-xs text-[#FFB7B2] animate-in fade-in\">\n          <div className=\"flex items-center gap-2.5\">\n            <AlertTriangle className=\"w-4 h-4 shrink-0\" />\n            <span>{errorMessage}</span>\n          </div>\n          <button\n            onClick={handleGenerate}\n            className=\"px-3 py-1 rounded-lg bg-[#FFB7B2]/20 hover:bg-[#FFB7B2]/30 font-mono text-[11px] font-bold text-[#FFB7B2] transition-colors\"\n          >\n            TRY AGAIN\n          </button>\n        </div>\n      )}\n\n      {/* Manual Add Form */}\n      {isManualAddOpen && (\n        <form onSubmit={handleAddManualIdea} className=\"p-6 rounded-2xl bg-[#293735] border border-[#C7F9A6]/40 shadow-xl space-y-4 animate-in fade-in\">\n          <div className=\"flex items-center justify-between pb-2 border-b border-[#3B4B47]\">\n            <span className=\"text-xs font-mono font-bold text-[#C7F9A6] flex items-center gap-2\">\n              <Plus className=\"w-4 h-4\" />\n              CREATE CUSTOM IDEA\n            </span>\n            <button\n              type=\"button\"\n              onClick={() => setIsManualAddOpen(false)}\n              className=\"text-[#71817B] hover:text-[#F0F4EE]\"\n            >\n              <X className=\"w-4 h-4\" />\n            </button>\n          </div>\n\n          <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-4\">\n            <div>\n              <label className=\"block text-[11px] font-mono text-[#AAB8B2] uppercase mb-1\">Concept Title *</label>\n              <input\n                type=\"text\"\n                required\n                value={manualTitle}\n                onChange={e => setManualTitle(e.target.value)}\n                placeholder=\"e.g. Agentic Code Auditor\"\n                className=\"w-full px-3 py-2 rounded-xl bg-[#202B2A] border border-[#3B4B47] text-xs text-[#F0F4EE] focus:outline-none focus:border-[#C7F9A6]\"\n              />\n            </div>\n            <div>\n              <label className=\"block text-[11px] font-mono text-[#AAB8B2] uppercase mb-1\">Target User</label>\n              <input\n                type=\"text\"\n                value={manualTargetUser}\n                onChange={e => setManualTargetUser(e.target.value)}\n                placeholder=\"e.g. Solo Hackathon Engineers\"\n                className=\"w-full px-3 py-2 rounded-xl bg-[#202B2A] border border-[#3B4B47] text-xs text-[#F0F4EE] focus:outline-none focus:border-[#C7F9A6]\"\n              />\n            </div>\n            <div className=\"sm:col-span-2\">\n              <label className=\"block text-[11px] font-mono text-[#AAB8B2] uppercase mb-1\">Problem Being Solved</label>\n              <input\n                type=\"text\"\n                value={manualProblem}\n                onChange={e => setManualProblem(e.target.value)}\n                placeholder=\"Describe the painful friction point...\"\n                className=\"w-full px-3 py-2 rounded-xl bg-[#202B2A] border border-[#3B4B47] text-xs text-[#F0F4EE] focus:outline-none focus:border-[#C7F9A6]\"\n              />\n            </div>\n            <div className=\"sm:col-span-2\">\n              <label className=\"block text-[11px] font-mono text-[#AAB8B2] uppercase mb-1\">Solution / Core Demo Hook</label>\n              <input\n                type=\"text\"\n                value={manualSolution}\n                onChange={e => setManualSolution(e.target.value)}\n                placeholder=\"What happens in the 3-minute live judge demo?\"\n                className=\"w-full px-3 py-2 rounded-xl bg-[#202B2A] border border-[#3B4B47] text-xs text-[#F0F4EE] focus:outline-none focus:border-[#C7F9A6]\"\n              />\n            </div>\n          </div>\n\n          <div className=\"flex justify-end gap-2 pt-2\">\n            <button\n              type=\"button\"\n              onClick={() => setIsManualAddOpen(false)}\n              className=\"px-3.5 py-1.5 rounded-xl bg-[#202B2A] text-xs font-mono text-[#71817B] hover:text-[#F0F4EE]\"\n            >\n              Cancel\n            </button>\n            <button\n              type=\"submit\"\n              className=\"px-4 py-1.5 rounded-xl bg-[#C7F9A6] text-[#202B2A] text-xs font-bold font-mono hover:brightness-110 shadow-sm\"\n            >\n              Save Concept\n            </button>\n          </div>\n        </form>\n      )}\n\n      {/* Idea Generation Form Card */}\n      <div \n        id=\"idea-generation-form\"\n        className=\"p-6 rounded-2xl bg-[#293735] border border-[#3B4B47] shadow-xl space-y-4\"\n      >\n        <div className=\"flex items-center justify-between pb-3 border-b border-[#3B4B47]\">\n          <span className=\"text-xs font-mono font-bold text-[#F0F4EE] flex items-center gap-2\">\n            <Sparkles className=\"w-4 h-4 text-[#A8E6CF]\" />\n            AI IDEA SYNTHESIZER\n          </span>\n          <span className=\"text-[10px] font-mono text-[#71817B]\">POWERED BY GEMINI 2.5 FLASH</span>\n        </div>\n\n        <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 text-xs\">\n          {/* Team skills */}\n          <div className=\"space-y-1.5\">\n            <label className=\"text-[11px] font-mono text-[#AAB8B2] font-semibold\">\n              Team Skills &amp; Stack\n            </label>\n            <input\n              type=\"text\"\n              value={teamSkills}\n              onChange={(e) => setTeamSkills(e.target.value)}\n              className=\"w-full px-3 py-2 rounded-xl bg-[#202B2A] border border-[#3B4B47] text-[#F0F4EE] focus:outline-none focus:border-[#A8E6CF]\"\n            />\n          </div>\n\n          {/* Personal frustrations */}\n          <div className=\"space-y-1.5\">\n            <label className=\"text-[11px] font-mono text-[#AAB8B2] font-semibold\">\n              Personal Frustrations / Problem Space\n            </label>\n            <input\n              type=\"text\"\n              value={frustrations}\n              onChange={(e) => setFrustrations(e.target.value)}\n              className=\"w-full px-3 py-2 rounded-xl bg-[#202B2A] border border-[#3B4B47] text-[#F0F4EE] focus:outline-none focus:border-[#A8E6CF]\"\n            />\n          </div>\n\n          {/* Interests */}\n          <div className=\"space-y-1.5\">\n            <label className=\"text-[11px] font-mono text-[#AAB8B2] font-semibold\">\n              Technology Interests\n            </label>\n            <input\n              type=\"text\"\n              value={interests}\n              onChange={(e) => setInterests(e.target.value)}\n              className=\"w-full px-3 py-2 rounded-xl bg-[#202B2A] border border-[#3B4B47] text-[#F0F4EE] focus:outline-none focus:border-[#A8E6CF]\"\n            />\n          </div>\n\n          {/* Target users */}\n          <div className=\"space-y-1.5\">\n            <label className=\"text-[11px] font-mono text-[#AAB8B2] font-semibold\">\n              Target Users\n            </label>\n            <input\n              type=\"text\"\n              value={targetUsers}\n              onChange={(e) => setTargetUsers(e.target.value)}\n              className=\"w-full px-3 py-2 rounded-xl bg-[#202B2A] border border-[#3B4B47] text-[#F0F4EE] focus:outline-none focus:border-[#A8E6CF]\"\n            />\n          </div>\n\n          {/* Available time */}\n          <div className=\"space-y-1.5\">\n            <label className=\"text-[11px] font-mono text-[#AAB8B2] font-semibold\">\n              Available Runway (Hours)\n            </label>\n            <input\n              type=\"number\"\n              value={availableTime}\n              onChange={(e) => setAvailableTime(e.target.value)}\n              className=\"w-full px-3 py-2 rounded-xl bg-[#202B2A] border border-[#3B4B47] text-[#F0F4EE] focus:outline-none focus:border-[#A8E6CF]\"\n            />\n          </div>\n\n          {/* Judging criteria */}\n          <div className=\"space-y-1.5\">\n            <label className=\"text-[11px] font-mono text-[#AAB8B2] font-semibold\">\n              Judging Criteria / Rubric\n            </label>\n            <input\n              type=\"text\"\n              value={criteria}\n              onChange={(e) => setCriteria(e.target.value)}\n              className=\"w-full px-3 py-2 rounded-xl bg-[#202B2A] border border-[#3B4B47] text-[#F0F4EE] focus:outline-none focus:border-[#A8E6CF]\"\n            />\n          </div>\n        </div>\n\n        {/* Generate Button */}\n        <div className=\"pt-2 flex justify-end\">\n          <button\n            id=\"btn-synthesize-ideas\"\n            onClick={handleGenerate}\n            disabled={isGenerating}\n            className=\"flex items-center gap-2 px-5 py-2.5 rounded-xl bg-gradient-to-r from-[#A8E6CF] to-[#A8DADC] text-[#202B2A] font-mono text-xs font-bold hover:brightness-110 shadow-md active:scale-95 disabled:opacity-50 transition-all cursor-pointer\"\n          >\n            <Sparkles className={`w-3.5 h-3.5 ${isGenerating ? \'animate-spin\' : \'\'}`} />\n            <span>{isGenerating ? \'HALFTIME IS THINKING...\' : \'GENERATE & VALIDATE IDEAS\'}</span>\n          </button>\n        </div>\n      </div>\n\n      {/* Loading Steps Animation */}\n      {isGenerating && (\n        <div className=\"p-4 rounded-xl bg-[#293735] border border-[#A8E6CF]/40 space-y-2 animate-in fade-in\">\n          <div className=\"flex items-center justify-between text-xs font-mono\">\n            <span className=\"font-bold text-[#A8E6CF] flex items-center gap-2\">\n              <Sparkles className=\"w-3.5 h-3.5 animate-spin\" />\n              HALFTIME IS THINKING...\n            </span>\n            <span className=\"text-[#71817B]\">Step {loadingStep + 1} of 4</span>\n          </div>\n          <p className=\"text-xs text-[#F0F4EE] font-mono\">{steps[loadingStep]}</p>\n          <div className=\"h-1.5 w-full bg-[#3B4B47] rounded-full overflow-hidden\">\n            <div\n              className=\"h-full bg-gradient-to-r from-[#A8E6CF] to-[#C7F9A6] transition-all duration-500\"\n              style={{ width: `${((loadingStep + 1) / steps.length) * 100}%` }}\n            />\n          </div>\n        </div>\n      )}\n\n      {/* Filter and Matrix Controls */}\n      <div className=\"flex flex-wrap items-center justify-between gap-3 p-4 rounded-xl bg-[#293735] border border-[#3B4B47]\">\n        <div className=\"flex items-center gap-2 text-xs font-mono\">\n          <Filter className=\"w-3.5 h-3.5 text-[#71817B]\" />\n          <span className=\"text-[#71817B]\">Filter Verdict:</span>\n          {[\'ALL\', \'BUILD\', \'MODIFY\', \'KILL\'].map((v) => (\n            <button\n              key={v}\n              onClick={() => setFilterVerdict(v)}\n              className={`px-2.5 py-1 rounded-lg text-xs font-mono transition-all ${\n                filterVerdict === v\n                  ? \'bg-[#31413F] text-[#F0F4EE] border border-[#A8E6CF]/30\'\n                  : \'text-[#71817B] hover:text-[#F0F4EE]\'\n              }`}\n            >\n              {v}\n            </button>\n          ))}\n        </div>\n\n        <div className=\"text-xs font-mono text-[#71817B]\">\n          Showing {filteredIdeas.length} of {ideas.length} concepts\n        </div>\n      </div>\n\n      {/* Idea Cards Grid */}\n      <div className=\"grid grid-cols-1 lg:grid-cols-2 gap-5 sm:gap-6\">\n        {filteredIdeas.map((idea) => {\n          const isBuild = idea.verdict === \'BUILD\';\n          const isModify = idea.verdict === \'MODIFY\';\n          const isKill = idea.verdict === \'KILL\';\n\n          return (\n            <div\n              key={idea.id}\n              className={`p-6 rounded-2xl bg-[#293735] border transition-all duration-200 shadow-xl flex flex-col justify-between ${\n                isBuild\n                  ? \'border-[#C7F9A6]/40 hover:border-[#C7F9A6]\'\n                  : isModify\n                  ? \'border-[#FFE0A3]/40 hover:border-[#FFE0A3]\'\n                  : \'border-[#FFB7B2]/30 hover:border-[#FFB7B2]/60 opacity-80\'\n              }`}\n            >\n              <div className=\"space-y-4\">\n                {/* Card Header & Verdict Pill */}\n                <div className=\"flex items-start justify-between gap-3\">\n                  <div className=\"flex-1 min-w-0\">\n                    <div className=\"flex flex-wrap gap-1.5 mb-2\">\n                      {idea.tags.map((tag) => (\n                        <span\n                          key={tag}\n                          className=\"px-2 py-0.5 rounded-full text-[10px] font-mono bg-[#202B2A] text-[#AAB8B2] border border-[#3B4B47]\"\n                        >\n                          {tag}\n                        </span>\n                      ))}\n                    </div>\n                    <h3 className=\"text-lg font-bold text-[#F0F4EE] tracking-tight\">\n                      {idea.title}\n                    </h3>\n                  </div>\n\n                  <div className=\"flex items-center gap-2\">\n                    <span\n                      className={`px-3 py-1 rounded-full text-xs font-mono font-bold flex items-center gap-1.5 border ${\n                        isBuild\n                          ? \'bg-[#C7F9A6]/20 text-[#C7F9A6] border-[#C7F9A6]/40\'\n                          : isModify\n                          ? \'bg-[#FFE0A3]/20 text-[#FFE0A3] border-[#FFE0A3]/40\'\n                          : \'bg-[#FFB7B2]/20 text-[#FFB7B2] border-[#FFB7B2]/40\'\n                      }`}\n                    >\n                      {isBuild && <CheckCircle className=\"w-3.5 h-3.5\" />}\n                      {isModify && <AlertOctagon className=\"w-3.5 h-3.5\" />}\n                      {isKill && <XCircle className=\"w-3.5 h-3.5\" />}\n                      <span>{idea.verdict}</span>\n                    </span>\n\n                    {onDeleteIdea && (\n                      <button\n                        onClick={() => onDeleteIdea(idea.id)}\n                        className=\"p-1 rounded-lg text-[#71817B] hover:text-[#FFB7B2] hover:bg-[#202B2A] transition-colors\"\n                        title=\"Delete concept\"\n                      >\n                        <Trash2 className=\"w-3.5 h-3.5\" />\n                      </button>\n                    )}\n                  </div>\n                </div>\n\n                {/* Problem & Solution */}\n                <div className=\"space-y-2 text-xs\">\n                  <div>\n                    <span className=\"font-mono text-[#71817B] font-semibold\">PROBLEM: </span>\n                    <span className=\"text-[#F0F4EE]\">{idea.problem}</span>\n                  </div>\n                  <div>\n                    <span className=\"font-mono text-[#71817B] font-semibold\">SOLUTION: </span>\n                    <span className=\"text-[#AAB8B2]\">{idea.solution}</span>\n                  </div>\n                  <div>\n                    <span className=\"font-mono text-[#71817B] font-semibold\">TARGET USER: </span>\n                    <span>{idea.targetUser}</span>\n                  </div>\n                </div>\n\n                {/* Score Meters */}\n                <div className=\"grid grid-cols-2 sm:grid-cols-4 gap-2 pt-2 border-t border-[#3B4B47]\">\n                  <div className=\"p-2 rounded-lg bg-[#202B2A] border border-[#3B4B47] text-center\">\n                    <div className=\"text-[10px] font-mono text-[#71817B]\">INNOVATION (25%)</div>\n                    <div className=\"text-xs font-mono font-bold text-[#C7F9A6] mt-0.5\">{idea.innovationScore}</div>\n                  </div>\n                  <div className=\"p-2 rounded-lg bg-[#202B2A] border border-[#3B4B47] text-center\">\n                    <div className=\"text-[10px] font-mono text-[#71817B]\">PROBLEM FIT (20%)</div>\n                    <div className=\"text-xs font-mono font-bold text-[#A8E6CF] mt-0.5\">{idea.problemFitScore}</div>\n                  </div>\n                  <div className=\"p-2 rounded-lg bg-[#202B2A] border border-[#3B4B47] text-center\">\n                    <div className=\"text-[10px] font-mono text-[#71817B]\">FEASIBILITY (10%)</div>\n                    <div className=\"text-xs font-mono font-bold text-[#A8DADC] mt-0.5\">{idea.feasibilityScore}</div>\n                  </div>\n                  <div className=\"p-2 rounded-lg bg-[#202B2A] border border-[#3B4B47] text-center\">\n                    <div className=\"text-[10px] font-mono text-[#71817B]\">IMPACT/DEMO (15%)</div>\n                    <div className=\"text-xs font-mono font-bold text-[#FFE0A3] mt-0.5\">{idea.demoPotentialScore}</div>\n                  </div>\n                </div>\n\n                {/* Extended Rubric if evaluated */}\n                {idea.overallScore && (\n                  <div className=\"grid grid-cols-3 gap-2\">\n                    <div className=\"p-1.5 rounded-lg bg-[#202B2A] border border-[#3B4B47] text-center\">\n                      <div className=\"text-[9px] font-mono text-[#71817B]\">USABILITY</div>\n                      <div className=\"text-[11px] font-mono font-bold text-[#F0F4EE]\">{idea.usabilityScore || 8.0}</div>\n                    </div>\n                    <div className=\"p-1.5 rounded-lg bg-[#202B2A] border border-[#3B4B47] text-center\">\n                      <div className=\"text-[9px] font-mono text-[#71817B]\">EXECUTION</div>\n                      <div className=\"text-[11px] font-mono font-bold text-[#F0F4EE]\">{idea.executionScore || 8.0}</div>\n                    </div>\n                    <div className=\"p-1.5 rounded-lg bg-[#202B2A] border border-[#C7F9A6]/30 text-center\">\n                      <div className=\"text-[9px] font-mono text-[#C7F9A6]\">OVERALL SCORE</div>\n                      <div className=\"text-[11px] font-mono font-bold text-[#C7F9A6]\">{idea.overallScore}/10</div>\n                    </div>\n                  </div>\n                )}\n\n                {/* Reason & Deep Judge Insights */}\n                <div className=\"space-y-2\">\n                  <div className=\"p-3 rounded-xl bg-[#202B2A]/70 border border-[#3B4B47]/60 text-[11px] text-[#AAB8B2] italic\">\n                    &ldquo;{idea.verdictReason}&rdquo;\n                  </div>\n\n                  {(idea.whyThisCouldWin || idea.whyThisCouldFail || idea.whatToChange) && (\n                    <div className=\"p-3 rounded-xl bg-[#202B2A] border border-[#3B4B47] space-y-1.5 text-[11px]\">\n                      {idea.whyThisCouldWin && (\n                        <div>\n                          <span className=\"font-mono text-[#C7F9A6] font-bold text-[10px] block\">WHY THIS COULD WIN:</span>\n                          <p className=\"text-[#F0F4EE]\">{idea.whyThisCouldWin}</p>\n                        </div>\n                      )}\n                      {idea.whyThisCouldFail && (\n                        <div>\n                          <span className=\"font-mono text-[#FFB7B2] font-bold text-[10px] block\">WHY THIS COULD FAIL:</span>\n                          <p className=\"text-[#AAB8B2]\">{idea.whyThisCouldFail}</p>\n                        </div>\n                      )}\n                      {idea.whatToChange && (\n                        <div>\n                          <span className=\"font-mono text-[#FFE0A3] font-bold text-[10px] block\">WHAT TO CHANGE:</span>\n                          <p className=\"text-[#AAB8B2]\">{idea.whatToChange}</p>\n                        </div>\n                      )}\n                    </div>\n                  )}\n                </div>\n              </div>\n\n              {/* Actions */}\n              <div className=\"pt-4 mt-3 border-t border-[#3B4B47] flex items-center justify-between gap-2\">\n                <button\n                  onClick={() => handleSingleEvaluate(idea)}\n                  disabled={evaluatingIdeaId === idea.id}\n                  className=\"flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-[#202B2A] hover:bg-[#31413F] border border-[#3B4B47] text-[11px] font-mono text-[#AAB8B2] hover:text-[#A8E6CF] transition-all disabled:opacity-50 cursor-pointer\"\n                >\n                  <RefreshCw className={`w-3 h-3 ${evaluatingIdeaId === idea.id ? \'animate-spin\' : \'\'}`} />\n                  <span>{evaluatingIdeaId === idea.id ? \'Critiquing...\' : \'Critique with Gemini\'}</span>\n                </button>\n\n                <button\n                  onClick={() => onSelectActiveIdea(idea)}\n                  className=\"flex items-center gap-1.5 px-3.5 py-1.5 rounded-lg bg-[#31413F] hover:bg-[#3B4B47] border border-[#3B4B47] hover:border-[#C7F9A6]/40 text-xs font-mono text-[#F0F4EE] hover:text-[#C7F9A6] transition-all cursor-pointer\"\n                >\n                  <span>Select for MVP Plan</span>\n                  <ArrowRight className=\"w-3.5 h-3.5\" />\n                </button>\n              </div>\n            </div>\n          );\n        })}\n      </div>\n\n      {/* Define Problem Modal */}\n      {isProblemModalOpen && (\n        <div className=\"fixed inset-0 bg-black/75 z-50 flex items-center justify-center p-4 backdrop-blur-sm animate-in fade-in\">\n          <div className=\"w-full max-w-2xl bg-[#293735] border border-[#3B4B47] rounded-3xl p-6 sm:p-8 shadow-2xl relative max-h-[90vh] overflow-y-auto\">\n            <button\n              onClick={() => setIsProblemModalOpen(false)}\n              className=\"absolute top-5 right-5 p-1.5 rounded-lg text-[#71817B] hover:text-[#F0F4EE] hover:bg-[#202B2A]\"\n            >\n              <X className=\"w-4 h-4\" />\n            </button>\n\n            <div className=\"flex items-center gap-3 mb-6\">\n              <div className=\"p-3 rounded-2xl bg-[#202B2A] border border-[#3B4B47] text-[#A8E6CF]\">\n                <FileText className=\"w-5 h-5\" />\n              </div>\n              <div>\n                <h2 className=\"text-lg font-bold text-[#F0F4EE]\">DEFINE THE PROBLEM</h2>\n                <p className=\"text-xs text-[#71817B]\">Generate a structured, judge-calibrated problem statement</p>\n              </div>\n            </div>\n\n            <div className=\"space-y-4 mb-6\">\n              <div>\n                <label className=\"block text-xs font-mono text-[#AAB8B2] uppercase mb-1.5\">\n                  Project Description or Pain Point\n                </label>\n                <textarea\n                  rows={3}\n                  value={problemDesc}\n                  onChange={e => setProblemDesc(e.target.value)}\n                  placeholder=\"Explain the visceral friction or reason this project exists...\"\n                  className=\"w-full px-3.5 py-2.5 rounded-xl bg-[#202B2A] border border-[#3B4B47] text-xs text-[#F0F4EE] placeholder-[#71817B] focus:outline-none focus:border-[#A8E6CF]\"\n                />\n              </div>\n\n              <button\n                onClick={handleDefineProblem}\n                disabled={isDefiningProblem}\n                className=\"w-full py-2.5 px-4 rounded-xl bg-[#A8E6CF] hover:bg-[#97d3bc] text-[#202B2A] font-bold font-mono text-xs flex items-center justify-center gap-2 transition-all cursor-pointer disabled:opacity-50\"\n              >\n                <Sparkles className={`w-3.5 h-3.5 ${isDefiningProblem ? \'animate-spin\' : \'\'}`} />\n                <span>{isDefiningProblem ? \'SYNTHESIZING PROBLEM ARCHITECTURE...\' : \'GENERATE PROBLEM STATEMENT\'}</span>\n              </button>\n            </div>\n\n            {problemResult && (\n              <div className=\"p-5 rounded-2xl bg-[#202B2A] border border-[#A8E6CF]/30 space-y-3.5 text-xs animate-in fade-in\">\n                <div>\n                  <span className=\"text-[10px] font-mono text-[#A8E6CF] font-bold block mb-1\">CORE PROBLEM STATEMENT:</span>\n                  <p className=\"text-[#F0F4EE] font-semibold text-sm leading-relaxed\">{problemResult.problemStatement}</p>\n                </div>\n                <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-3 pt-2 border-t border-[#3B4B47]\">\n                  <div>\n                    <span className=\"text-[10px] font-mono text-[#71817B] font-bold block\">TARGET USER:</span>\n                    <p className=\"text-[#AAB8B2] mt-0.5\">{problemResult.targetUser}</p>\n                  </div>\n                  <div>\n                    <span className=\"text-[10px] font-mono text-[#71817B] font-bold block\">PAIN POINT:</span>\n                    <p className=\"text-[#AAB8B2] mt-0.5\">{problemResult.painPoint}</p>\n                  </div>\n                  <div>\n                    <span className=\"text-[10px] font-mono text-[#71817B] font-bold block\">CURRENT ALTERNATIVE:</span>\n                    <p className=\"text-[#AAB8B2] mt-0.5\">{problemResult.currentAlternative}</p>\n                  </div>\n                  <div>\n                    <span className=\"text-[10px] font-mono text-[#FFB7B2] font-bold block\">WHY EXISTING SOLUTIONS FAIL:</span>\n                    <p className=\"text-[#AAB8B2] mt-0.5\">{problemResult.whyExistingSolutionsFail}</p>\n                  </div>\n                </div>\n                <div className=\"pt-2 border-t border-[#3B4B47]\">\n                  <span className=\"text-[10px] font-mono text-[#FFE0A3] font-bold block mb-1\">JUDGE SUCCESS CRITERIA:</span>\n                  <ul className=\"list-disc list-inside space-y-1 text-[#AAB8B2]\">\n                    {problemResult.successCriteria.map((c, i) => (\n                      <li key={i}>{c}</li>\n                    ))}\n                  </ul>\n                </div>\n              </div>\n            )}\n          </div>\n        </div>\n      )}\n    </div>\n  );\n};\n"
    }
