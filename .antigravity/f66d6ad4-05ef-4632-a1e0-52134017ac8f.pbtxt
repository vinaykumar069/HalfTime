  file_change {
    absolute_path_uri: "file:///src/components/launch/LaunchView.tsx"
    file_change_type: FILE_CHANGE_TYPE_EDIT
    replacement_chunks {
      target_content: "import React from \'react\';\nimport { \n  Rocket, \n  Sparkles, \n  CheckCircle2, \n  AlertCircle, \n  Clock, \n  ArrowRight,\n  ExternalLink,\n  ShieldCheck\n} from \'lucide-react\';\nimport { LaunchChecklistItem, LaunchStatus } from \'../../types\';\n\ninterface LaunchViewProps {\n  checklist: LaunchChecklistItem[];\n  onToggleStatus: (id: string) => void;\n  onOpenShipMode: () => void;\n  scopeCutApplied: boolean;\n}\n\nexport const LaunchView: React.FC<LaunchViewProps> = ({\n  checklist,\n  onToggleStatus,\n  onOpenShipMode,\n  scopeCutApplied,\n}) => {\n  const completedCount = checklist.filter((item) => item.status === \'COMPLETE\').length;\n  const readinessPercent = Math.round((completedCount / checklist.length) * 100);\n\n  const categories: Array<\'Product\' | \'Pitch & Demo\' | \'Distribution\'> = [\n    \'Product\',\n    \'Pitch & Demo\',\n    \'Distribution\',\n  ];"
      replacement_content: "import React, { useState } from \'react\';\nimport { \n  Rocket, \n  Sparkles, \n  CheckCircle2, \n  AlertCircle, \n  Clock, \n  ArrowRight,\n  ExternalLink,\n  ShieldCheck,\n  Mic,\n  Copy,\n  Check,\n  RefreshCw,\n  Play\n} from \'lucide-react\';\nimport { LaunchChecklistItem, LaunchStatus } from \'../../types\';\nimport { improvePitch, PitchCoachResult } from \'../../services/aiService\';\n\ninterface LaunchViewProps {\n  checklist: LaunchChecklistItem[];\n  onToggleStatus: (id: string) => void;\n  onOpenShipMode: () => void;\n  scopeCutApplied: boolean;\n}\n\nexport const LaunchView: React.FC<LaunchViewProps> = ({\n  checklist,\n  onToggleStatus,\n  onOpenShipMode,\n  scopeCutApplied,\n}) => {\n  const [pitchData, setPitchData] = useState<PitchCoachResult | null>({\n    problem: \'Hackathon teams waste 60% of their build time on features judges never click, leading to rushed, broken demos.\',\n    whyItMatters: \'Every weekend, thousands of talented engineers burn out and fail to submit their prototypes.\',\n    solution: \'HALFTIME is the real-time mission control copilot that constantly recalculates runway and ruthlessly cuts scope.\',\n    howItWorks: \'1. Connects to project backlog. 2. Tracks real-time velocity against DoraHacks deadline. 3. Recommends 1-click feature cuts with 0 demo sacrifice.\',\n    demoMoment: \'In one click, HALFTIME cuts 3 hours of bloat and moves the project from AT RISK to ON TRACK.\',\n    impact: \'Helps 100,000+ hackathon builders globally ship working MVPs on time.\',\n    whyNow: \'LLM reasoning makes instant scope triage possible at zero cognitive overhead.\',\n    script: `Judges, 60% of hackathon teams fail before the finish line. Not because they can\'t code, but because they build the wrong things.\n\nMeet HALFTIME: the AI mission control for hackathon teams.\n\nHALFTIME monitors our build time against the deadline in real time. 20 minutes ago, we were 3 hours over capacity. In one click, HALFTIME executed a surgical scope cut\342\200\224saving 3 hours and 45 minutes of bloat without sacrificing a single judging point.\n\nInstead of an unfinished monolith, we shipped a rock-solid, production-ready product. Stop. Recalculate. Ship.`,\n    durationSeconds: 75,\n    keyTakeaway: \'Don\342\200\231t build more. Ship what matters.\',\n  });\n\n  const [isGeneratingPitch, setIsGeneratingPitch] = useState(false);\n  const [copiedScript, setCopiedScript] = useState(false);\n  const [pitchStep, setPitchStep] = useState(0);\n\n  const pitchSteps = [\n    \'Synthesizing judge attention hook & problem statement...\',\n    \'Structuring 3-step mechanics & live demo moment...\',\n    \'Refining 60-90s spoken cadence and timing cues...\',\n    \'Generating final presentation script...\',\n  ];\n\n  const handleGeneratePitch = async () => {\n    setIsGeneratingPitch(true);\n    setPitchStep(0);\n\n    const timer = setInterval(() => {\n      setPitchStep((prev) => (prev < pitchSteps.length - 1 ? prev + 1 : prev));\n    }, 600);\n\n    try {\n      const res = await improvePitch({\n        problem: \'Hackathon scope bloat causing teams to miss submission deadlines\',\n        solution: \'HALFTIME: AI Hackathon Mission Control & Scope Cutter\',\n        demoMoment: \'1-click scope cut recovering 3h 45m with 0 demo sacrifice\',\n        impact: \'Transforming how 100k+ builders ship on time\',\n      });\n      if (res) {\n        setPitchData(res);\n      }\n    } catch (e) {\n      // Handled\n    } finally {\n      clearInterval(timer);\n      setIsGeneratingPitch(false);\n    }\n  };\n\n  const handleCopyScript = () => {\n    if (!pitchData?.script) return;\n    navigator.clipboard.writeText(pitchData.script);\n    setCopiedScript(true);\n    setTimeout(() => setCopiedScript(false), 2000);\n  };\n\n  const completedCount = checklist.filter((item) => item.status === \'COMPLETE\').length;\n  const readinessPercent = Math.round((completedCount / checklist.length) * 100);\n\n  const categories: Array<\'Product\' | \'Pitch & Demo\' | \'Distribution\'> = [\n    \'Product\',\n    \'Pitch & Demo\',\n    \'Distribution\',\n  ];"
    }
