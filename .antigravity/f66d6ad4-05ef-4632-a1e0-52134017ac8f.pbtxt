      replacement_content: "import { \n  ProjectHealth, \n  ScopeCutItem, \n  IdeaItem, \n  MVPFeature, \n  TaskItem, \n  TeamMember, \n  AIResourceItem, \n  JudgeEvaluation, \n  LaunchChecklistItem, \n  ActivityTimelineItem \n} from \'../types\';\n\nexport const initialProjectHealth: ProjectHealth = {\n  score: 72,\n  status: \'at-risk\',\n  timeAvailableHours: 11,\n  workRequiredHours: 14,\n  capacityGapHours: 3,\n  mvpPercent: 82,\n  mvpStatus: \'ON TRACK\',\n  scopePercent: 64,\n  scopeStatus: \'TOO LARGE\',\n  teamPercent: 91,\n  teamStatus: \'ON TRACK\',\n  resourcesPercent: 48,\n  resourcesStatus: \'LIMITED\',\n  testingPercent: 31,\n  testingStatus: \'NEEDS ATTENTION\',\n};\n\nexport const initialScopeCutItems: ScopeCutItem[] = [\n  {\n    id: \'cut-1\',\n    name: \'Analytics dashboard\',\n    category: \'Reporting & Charts\',\n    timeMinutes: 120,\n    timeFormatted: \'\342\210\2222h\',\n    reason: \'Judges will not click into secondary analytics during a 3-minute pitch. Zero demo impact.\',\n    selectedForCut: true,\n    isCut: false,\n    impactScore: \'0% demo impact\',\n  },\n  {\n    id: \'cut-2\',\n    name: \'Team profiles & bios\',\n    category: \'User Experience\',\n    timeMinutes: 60,\n    timeFormatted: \'\342\210\2221h\',\n    reason: \'Static team badges can be verbally introduced in 10 seconds. Save UI build time.\',\n    selectedForCut: true,\n    isCut: false,\n    impactScore: \'0% demo impact\',\n  },\n  {\n    id: \'cut-3\',\n    name: \'Dark mode customization\',\n    category: \'Styling & Themes\',\n    timeMinutes: 45,\n    timeFormatted: \'\342\210\22245m\',\n    reason: \'Dark theme is already default and polished. Custom theme switchers waste precious testing hours.\',\n    selectedForCut: true,\n    isCut: false,\n    impactScore: \'0% demo impact\',\n  },\n  {\n    id: \'cut-4\',\n    name: \'Multi-language localization\',\n    category: \'Internationalization\',\n    timeMinutes: 90,\n    timeFormatted: \'\342\210\2221h 30m\',\n    reason: \'DoraHacks judging is in English. Localization can be listed as a roadmap bullet.\',\n    selectedForCut: false,\n    isCut: false,\n    impactScore: \'0% demo impact\',\n  },\n];\n\nexport const initialIdeas: IdeaItem[] = [\n  {\n    id: \'idea-1\',\n    title: \'HALFTIME (Hackathon Copilot)\',\n    problem: \'Hackathon teams waste 60% of their limited 36-48 hours building the wrong features, running out of time before shipping a working demo.\',\n    targetUser: \'Hackathon builders, solo developers, collegiate teams, and demo-day finalists.\',\n    solution: \'An AI mission control that continuously recalculates work vs. remaining time, flags judge risks, and executes ruthless scope cuts.\',\n    innovationScore: 8.7,\n    problemFitScore: 9.2,\n    feasibilityScore: 9.1,\n    demoPotentialScore: 9.4,\n    verdict: \'BUILD\',\n    verdictReason: \'Massive emotional resonance with judges. High feasibility in a hackathon timeframe with instant visual payoff.\',\n    tags: [\'AI Agent\', \'Productivity\', \'High Impact\'],\n  },\n  {\n    id: \'idea-2\',\n    title: \'Autonomous Smart Contract Gas Optimizer\',\n    problem: \'DeFi users and bots lose millions during network congestion due to inefficient batch execution and MEV extraction.\',\n    targetUser: \'Web3 developers and high-frequency liquidity providers.\',\n    solution: \'AI-driven mempool routing engine with predictive gas bidding simulation.\',\n    innovationScore: 8.9,\n    problemFitScore: 7.4,\n    feasibilityScore: 5.6,\n    demoPotentialScore: 6.2,\n    verdict: \'MODIFY\',\n    verdictReason: \'Very complex backend requirement. High risk of non-functioning live demo unless mocked heavily.\',\n    tags: [\'Web3\', \'Infrastructure\', \'Complex\'],\n  },\n  {\n    id: \'idea-3\',\n    title: \'Multiplayer Collaborative Code Whiteboard\',\n    problem: \'Remote engineering interview candidates struggle to draw clean architecture diagrams while coding simultaneously.\',\n    targetUser: \'Hiring managers, interviewers, and candidate engineers.\',\n    solution: \'Infinite canvas with real-time audio chat and Monaco code execution sandbox.\',\n    innovationScore: 6.2,\n    problemFitScore: 6.8,\n    feasibilityScore: 7.1,\n    demoPotentialScore: 5.8,\n    verdict: \'KILL\',\n    verdictReason: \'Market is saturated (Miro, Excalidraw, HackerRank). Difficult to showcase novel AI innovation in 3 minutes.\',\n    tags: [\'Collab\', \'Red Ocean\', \'Low Moat\'],\n  },\n  {\n    id: \'idea-4\',\n    title: \'BioPrompt: AI Lab Notebook for Researchers\',\n    problem: \'Biotech researchers spend hours parsing unstructured assay logs into reproducible protocol steps.\',\n    targetUser: \'Wet-lab scientists, academic researchers, biotech startups.\',\n    solution: \'Voice-to-protocol parser with automated reagent stoichiometry calculations.\',\n    innovationScore: 8.8,\n    problemFitScore: 8.9,\n    feasibilityScore: 8.3,\n    demoPotentialScore: 8.9,\n    verdict: \'BUILD\',\n    verdictReason: \'Strong domain specificity. Clear before/after story for judges with demonstrable voice workflow.\',\n    tags: [\'Biotech\', \'Specialized AI\', \'High Value\'],\n  },\n];\n\nexport const initialMVPFeatures: MVPFeature[] = [\n  {\n    id: \'feat-1\',\n    name: \'Core AI Evaluation Flow\',\n    description: \'Instant reasoning engine calculating time vs. capacity and generating actionable interventions.\',\n    estimatedHours: 2.5,\n    priority: \'MUST_BUILD\',\n    demoCritical: true,\n    category: \'Core AI\',\n  },\n  {\n    id: \'feat-2\',\n    name: \'Interactive Scope Cutter\',\n    description: \'One-click feature trimming that mathematically adjusts project capacity and timeline.\',\n    estimatedHours: 1.5,\n    priority: \'MUST_BUILD\',\n    demoCritical: true,\n    category: \'Core AI\',\n  },\n  {\n    id: \'feat-3\',\n    name: \'Live Countdown & Health Dial\',\n    description: \'Mission control telemetry bar with visual color changes during time pressure.\',\n    estimatedHours: 1.0,\n    priority: \'MUST_BUILD\',\n    demoCritical: true,\n    category: \'UI / Polish\',\n  },\n  {\n    id: \'feat-4\',\n    name: \'Brutal AI Judge Simulator\',\n    description: \'Weighted rubric breakdown showing \"Why you might lose\" and exact point-scoring fixes.\',\n    estimatedHours: 2.0,\n    priority: \'SHOULD_BUILD\',\n    demoCritical: true,\n    category: \'Core AI\',\n  },\n  {\n    id: \'feat-5\',\n    name: \'AI Resource Pressure Gauge\',\n    description: \'Manual and simulated credit consumption monitoring for Gemini, Base44, Claude.\',\n    estimatedHours: 1.0,\n    priority: \'SHOULD_BUILD\',\n    demoCritical: false,\n    category: \'Infrastructure\',\n  },\n  {\n    id: \'feat-6\',\n    name: \'Command Palette (\342\214\230K)\',\n    description: \'Rapid keyboard shortcuts for judges and power users during the presentation.\',\n    estimatedHours: 0.75,\n    priority: \'NICE_TO_HAVE\',\n    demoCritical: false,\n    category: \'UI / Polish\',\n  },\n  {\n    id: \'feat-7\',\n    name: \'Secondary Analytics & Heatmaps\',\n    description: \'Longitudinal user retention graphs and exportable CSV reports.\',\n    estimatedHours: 2.0,\n    priority: \'CUT\',\n    demoCritical: false,\n    category: \'Add-on\',\n  },\n  {\n    id: \'feat-8\',\n    name: \'Custom Team Bio Profiles\',\n    description: \'Editable profile picture avatars, social links, and bio markdown editor.\',\n    estimatedHours: 1.0,\n    priority: \'CUT\',\n    demoCritical: false,\n    category: \'Add-on\',\n  },\n];\n\nexport const initialTasks: TaskItem[] = [\n  {\n    id: \'task-1\',\n    title: \'Finish the core AI evaluation flow\',\n    owner: \'Alex (Builder)\',\n    role: \'Builder\',\n    priority: \'CRITICAL\',\n    status: \'IN_PROGRESS\',\n    estimatedTime: \'1h 20m\',\n    estimatedMinutes: 80,\n    reason: \'Everything else depends on this workflow.\',\n    activeSince: Date.now() - 15 * 60 * 1000,\n  },\n  {\n    id: \'task-2\',\n    title: \'Polish Scope Cutter interactive animation\',\n    owner: \'Elena (Designer)\',\n    role: \'Designer\',\n    priority: \'HIGH\',\n    status: \'TODO\',\n    estimatedTime: \'45m\',\n    estimatedMinutes: 45,\n    reason: \'Hero moment during the 3-minute live judge demo.\',\n  },\n  {\n    id: \'task-3\',\n    title: \'Write 3-minute pitch hook & live demo script\',\n    owner: \'Marcus (Product)\',\n    role: \'Product\',\n    priority: \'HIGH\',\n    status: \'TODO\',\n    estimatedTime: \'1h\',\n    estimatedMinutes: 60,\n    reason: \'Addresses the \"Demo takes too long to reach value\" judge risk.\',\n  },\n  {\n    id: \'task-4\',\n    title: \'Record backup 60s demo video screencast\',\n    owner: \'Sam (Growth)\',\n    role: \'Growth\',\n    priority: \'MEDIUM\',\n    status: \'TODO\',\n    estimatedTime: \'50m\',\n    estimatedMinutes: 50,\n    reason: \'Insurance against conference Wi-Fi crashes.\',\n  },\n  {\n    id: \'task-5\',\n    title: \'Connect AI Judge scoring rubric matrix\',\n    owner: \'Alex (Builder)\',\n    role: \'Builder\',\n    priority: \'HIGH\',\n    status: \'DONE\',\n    estimatedTime: \'1h 30m\',\n    estimatedMinutes: 90,\n  },\n  {\n    id: \'task-6\',\n    title: \'Implement Ship Mode launch checklist\',\n    owner: \'Elena (Designer)\',\n    role: \'Designer\',\n    priority: \'MEDIUM\',\n    status: \'DONE\',\n    estimatedTime: \'1h 10m\',\n    estimatedMinutes: 70,\n  },\n  {\n    id: \'task-7\',\n    title: \'Setup GitHub README & submission tags\',\n    owner: \'Sam (Growth)\',\n    role: \'Growth\',\n    priority: \'LOW\',\n    status: \'BACKLOG\',\n    estimatedTime: \'30m\',\n    estimatedMinutes: 30,\n  },\n  {\n    id: \'task-8\',\n    title: \'Benchmark latency on Gemini 2.5 Flash calls\',\n    owner: \'Alex (Builder)\',\n    role: \'Builder\',\n    priority: \'MEDIUM\',\n    status: \'BACKLOG\',\n    estimatedTime: \'40m\',\n    estimatedMinutes: 40,\n  },\n];\n\nexport const teamMembers: