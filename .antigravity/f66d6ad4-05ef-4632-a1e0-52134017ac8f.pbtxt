  file_change {
    absolute_path_uri: "file:///src/components/onboarding/OnboardingScreen.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { \n  Sparkles, \n  Clock, \n  Layers, \n  Users, \n  ArrowRight, \n  Play, \n  CheckCircle2, \n  AlertTriangle \n} from \'lucide-react\';\nimport { BrandLogo } from \'../BrandLogo\';\n\ninterface OnboardingScreenProps {\n  onCreateProject: (data: {\n    name: string;\n    hackathonName: string;\n    deadline: string;\n    description: string;\n    teamName?: string;\n    teamMembers?: string[];\n    teamSkills?: string[];\n  }) => Promise<void>;\n  onSelectDemo: () => void;\n  isLoading?: boolean;\n}\n\nexport const OnboardingScreen: React.FC<OnboardingScreenProps> = ({\n  onCreateProject,\n  onSelectDemo,\n  isLoading = false,\n}) => {\n  // Form State\n  const [projectName, setProjectName] = useState(\'\');\n  const [hackathonName, setHackathonName] = useState(\'\');\n  const [description, setDescription] = useState(\'\');\n  const [hoursRemaining, setHoursRemaining] = useState<number>(12);\n  const [customDeadline, setCustomDeadline] = useState<string>(\'\');\n  const [useCustomDate, setUseCustomDate] = useState(false);\n\n  // Optional fields\n  const [teamName, setTeamName] = useState(\'\');\n  const [teamMembersInput, setTeamMembersInput] = useState(\'\');\n  const [teamSkillsInput, setTeamSkillsInput] = useState(\'Frontend, AI, UI/UX\');\n  const [showOptional, setShowOptional] = useState(false);\n\n  const [formError, setFormError] = useState<string | null>(null);\n\n  const handleSubmit = async (e: React.FormEvent) => {\n    e.preventDefault();\n    setFormError(null);\n\n    if (!projectName.trim()) {\n      setFormError(\'Project name is required.\');\n      return;\n    }\n    if (!hackathonName.trim()) {\n      setFormError(\'Hackathon name is required.\');\n      return;\n    }\n    if (!description.trim()) {\n      setFormError(\'Project description is required to generate AI insights.\');\n      return;\n    }\n\n    let finalDeadlineIso: string;\n    if (useCustomDate && customDeadline) {\n      finalDeadlineIso = new Date(customDeadline).toISOString();\n    } else {\n      finalDeadlineIso = new Date(Date.now() + hoursRemaining * 3600 * 1000).toISOString();\n    }\n\n    const parsedMembers = teamMembersInput\n      .split(\',\')\n      .map(s => s.trim())\n      .filter(Boolean);\n\n    const parsedSkills = teamSkillsInput\n      .split(\',\')\n      .map(s => s.trim())\n      .filter(Boolean);\n\n    await onCreateProject({\n      name: projectName,\n      hackathonName,\n      description,\n      deadline: finalDeadlineIso,\n      teamName: teamName || \'My Team\',\n      teamMembers: parsedMembers,\n      teamSkills: parsedSkills,\n    });\n  };\n\n  return (\n    <div className=\"min-h-screen bg-[#202B2A] text-[#F0F4EE] flex flex-col items-center justify-center p-4 sm:p-6 lg:p-8 relative selection:bg-[#C7F9A6] selection:text-[#202B2A]\">\n      {/* Ambient glowing atmosphere */}\n      <div className=\"fixed top-[-150px] right-[-150px] w-[600px] h-[600px] bg-[#A8E6CF] opacity-[0.04] blur-[150px] rounded-full pointer-events-none\" />\n      <div className=\"fixed bottom-[-150px] left-[-150px] w-[500px] h-[500px] bg-[#B8DDF0] opacity-[0.03] blur-[140px] rounded-full pointer-events-none\" />\n\n      <div className=\"w-full max-w-2xl bg-[#293735]/90 border border-[#3B4B47] rounded-3xl p-6 sm:p-10 shadow-2xl backdrop-blur-xl relative z-10\">\n        {/* Header Branding */}\n        <div className=\"flex flex-col items-center text-center mb-8\">\n          <div className=\"mb-4\">\n            <BrandLogo size=\"lg\" showLabel={false} animated={true} />\n          </div>\n          <span className=\"text-[11px] font-mono font-bold tracking-widest text-[#A8E6CF] uppercase mb-1\">\n            HACKATHON COPILOT\n          </span>\n          <h1 className=\"text-2xl sm:text-4xl font-bold tracking-tight text-[#F0F4EE]\">\n            WELCOME TO HALFTIME\n          </h1>\n          <p className=\"text-sm sm:text-base text-[#AAB8B2] mt-2 max-w-md\">\n            Turn your remaining hackathon time into a shipping plan.\n          </p>\n        </div>\n\n        {formError && (\n          <div className=\"mb-6 p-3.5 rounded-xl bg-[#FFB7B2]/10 border border-[#FFB7B2]/30 flex items-center gap-3 text-xs text-[#FFB7B2]\">\n            <AlertTriangle className=\"w-4 h-4 shrink-0\" />\n            <span>{formError}</span>\n          </div>\n        )}\n\n        <form onSubmit={handleSubmit} className=\"space-y-5\">\n          {/* Project & Hackathon Names */}\n          <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-4\">\n            <div>\n              <label className=\"block text-xs font-mono text-[#AAB8B2] uppercase mb-1.5\">\n                Project Name <span className=\"text-[#C7F9A6]\">*</span>\n              </label>\n              <input\n                id=\"input-project-name\"\n                type=\"text\"\n                required\n                value={projectName}\n                onChange={e => setProjectName(e.target.value)}\n                placeholder=\"e.g. CampusShield, EcoTrack\"\n                className=\"w-full px-3.5 py-2.5 rounded-xl bg-[#202B2A] border border-[#3B4B47] text-sm text-[#F0F4EE] placeholder-[#71817B] focus:outline-none focus:border-[#C7F9A6] transition-colors\"\n              />\n            </div>\n\n            <div>\n              <label className=\"block text-xs font-mono text-[#AAB8B2] uppercase mb-1.5\">\n                Hackathon Name <span className=\"text-[#C7F9A6]\">*</span>\n              </label>\n              <input\n                id=\"input-hackathon-name\"\n                type=\"text\"\n                required\n                value={hackathonName}\n                onChange={e => setHackathonName(e.target.value)}\n                placeholder=\"e.g. DoraHacks, ETHGlobal, TreeHacks\"\n                className=\"w-full px-3.5 py-2.5 rounded-xl bg-[#202B2A] border border-[#3B4B47] text-sm text-[#F0F4EE] placeholder-[#71817B] focus:outline-none focus:border-[#C7F9A6] transition-colors\"\n              />\n            </div>\n          </div>\n\n          {/* Project Description */}\n          <div>\n            <label className=\"block text-xs font-mono text-[#AAB8B2] uppercase mb-1.5\">\n              Project Description <span className=\"text-[#C7F9A6]\">*</span>\n            </label>\n            <textarea\n              id=\"input-project-desc\"\n              required\n              rows={3}\n              value={description}\n              onChange={e => setDescription(e.target.value)}\n              placeholder=\"What core problem are you solving? What is the main differentiator?\"\n              className=\"w-full px-3.5 py-2.5 rounded-xl bg-[#202B2A] border border-[#3B4B47] text-sm text-[#F0F4EE] placeholder-[#71817B] focus:outline-none focus:border-[#C7F9A6] transition-colors resize-none\"\n            />\n          </div>\n\n          {/* Hackathon Deadline / Time Left */}\n          <div>\n            <div className=\"flex items-center justify-between mb-2\">\n              <label className=\"text-xs font-mono text-[#AAB8B2] uppercase flex items-center gap-1.5\">\n                <Clock className=\"w-3.5 h-3.5 text-[#C7F9A6]\" />\n                <span>Remaining Runway <span className=\"text-[#C7F9A6]\">*</span></span>\n              </label>\n              <button\n                type=\"button\"\n                onClick={() => setUseCustomDate(!useCustomDate)}\n                className=\"text-[11px] text-[#A8E6CF] hover:underline\"\n              >\n                {useCustomDate ? \'Use quick hours\' : \'Set exact date/time\'}\n              </button>\n            </div>\n\n            {!useCustomDate ? (\n              <div className=\"grid grid-cols-4 gap-2\">\n                {[6, 12, 24, 36].map(hours => (\n                  <button\n                    type=\"button\"\n                    key={hours}\n                    onClick={() => setHoursRemaining(hours)}\n                    className={`py-2 px-3 rounded-xl border text-xs font-mono font-bold transition-all ${\n                      hoursRemaining === hours\n                        ? \'bg-[#C7F9A6] text-[#202B2A] border-[#C7F9A6] shadow-[0_0_15px_rgba(199,249,166,0.3)]\'\n                        : \'bg-[#202B2A] text-[#AAB8B2] border-[#3B4B47] hover:border-[#71817B]\'\n                    }`}\n                  >\n                    {hours}h left\n                  </button>\n                ))}\n              </div>\n            ) : (\n              <input\n                id=\"input-custom-deadline\"\n                type=\"datetime-local\"\n                required\n                value={customDeadline}\n                onChange={e => setCustomDeadline(e.target.value)}\n                className=\"w-full px-3.5 py-2.5 rounded-xl bg-[#202B2A] border border-[#3B4B47] text-sm text-[#F0F4EE] focus:outline-none focus:border-[#C7F9A6]\"\n              />\n            )}\n          </div>\n\n          {/* Optional Team Details Accordion */}\n          <div className=\"border-t border-[#3B4B47] pt-3\">\n            <button\n              type=\"button\"\n              onClick={() => setShowOptional(!showOptional)}\n              className=\"text-xs font-mono text-[#71817B] hover:text-[#A8E6CF] flex items-center gap-1.5 transition-colors\"\n            >\n              <Users className=\"w-3.5 h-3.5\" />\n              <span>{showOptional ? \'Hide optional team fields\' : \'+ Add optional team details & skills\'}</span>\n            </button>\n\n            {showOptional && (\n              <div className=\"mt-3 space-y-3 p-3.5 rounded-2xl bg-[#202B2A]/60 border border-[#3B4B47]\">\n                <div>\n                  <label className=\"block text-[11px] font-mono text-[#71817B] uppercase mb-1\">\n                    Team Name\n                  </label>\n                  <input\n                    type=\"text\"\n                    value={teamName}\n                    onChange={e => setTeamName(e.target.value)}\n                    placeholder=\"e.g. Binary Beasts, ZeroToOne\"\n                    className=\"w-full px-3 py-2 rounded-lg bg-[#202B2A] border border-[#3B4B47] text-xs text-[#F0F4EE] placeholder-[#71817B] focus:outline-none focus:border-[#C7F9A6]\"\n                  />\n                </div>\n                <div>\n                  <label className=\"block text-[11px] font-mono text-[#71817B] uppercase mb-1\">\n                    Team Skills (comma-separated)\n                  </label>\n                  <input\n                    type=\"text\"\n                    value={teamSkillsInput}\n                    onChange={e => setTeamSkillsInput(e.target.value)}\n                    placeholder=\"e.g. React, Python, Solidity, UX\"\n                    className=\"w-full px-3 py-2 rounded-lg bg-[#202B2A] border border-[#3B4B47] text-xs text-[#F0F4EE] placeholder-[#71817B] focus:outline-none focus:border-[#C7F9A6]\"\n                  />\n                </div>\n              </div>\n            )}\n          </div>\n\n          {/* Action Buttons */}\n          <div className=\"pt-3 flex flex-col sm:flex-row gap-3\">\n            <button\n              id=\"btn-create-my-hackathon\"\n              type=\"submit\"\n              disabled={isLoading}\n              className=\"flex-1 py-3.5 px-6 rounded-2xl bg-[#C7F9A6] hover:bg-[#b5f58c] text-[#202B2A] font-bold text-sm flex items-center justify-center gap-2 shadow-[0_0_25px_rgba(199,249,166,0.3)] transition-all cursor-pointer disabled:opacity-50\"\n            >\n              {isLoading ? (\n                <div className=\"w-4 h-4 border-2 border-[#202B2A] border-t-transparent rounded-full animate-spin\" />\n              ) : (\n                <>\n                  <span>CREATE MY HACKATHON</span>\n                  <ArrowRight className=\"w-4 h-4\" />\n                </>\n              )}\n            </button>\n\n            <button\n              id=\"btn-try-demo\"\n              type=\"button\"\n              onClick={onSelectDemo}\n              className=\"py-3.5 px-6 rounded-2xl bg-[#202B2A] hover:bg-[#31413F] text-[#A8E6CF] border border-[#3B4B47] font-bold text-sm flex items-center justify-center gap-2 transition-colors cursor-pointer\"\n            >\n              <Play className=\"w-4 h-4 fill-[#A8E6CF]\" />\n              <span>TRY DEMO</span>\n            </button>\n          </div>\n        </form>\n\n        {/* Demo Indicator Note */}\n        <div className=\"mt-6 pt-6 border-t border-[#3B4B47] flex items-center justify-between text-[11px] text-[#71817B]\">\n          <span className=\"flex items-center gap-1.5\">\n            <CheckCircle2 className=\"w-3.5 h-3.5 text-[#A8E6CF]\" />\n            <span>Multi-project isolation enabled</span>\n          </span>\n          <button\n            type=\"button\"\n            onClick={onSelectDemo}\n            className=\"text-[#A8E6CF] hover:underline\"\n          >\n            Load Team DOOM (DoraHacks 2.0)\n          </button>\n        </div>\n      </div>\n    </div>\n  );\n};\n"
    }
