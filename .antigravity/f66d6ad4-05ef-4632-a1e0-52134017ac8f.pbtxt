    replacement_infos {
      original_chunk {
        target_content: "import React, { useState, useEffect, useMemo } from \'react\';\nimport { \n  NavigationTab, \n  ProjectHealth, \n  ScopeCutItem, \n  IdeaItem, \n  MVPFeature, \n  TaskItem, \n  AIResourceItem, \n  JudgeEvaluation, \n  LaunchChecklistItem, \n  ActivityTimelineItem,\n  FeaturePriority,\n  TaskStatus,\n  Project\n} from \'./types\';\nimport { \n  teamMembers as defaultTeamMembers, \n  aiResources \n} from \'./data/mockData\';\nimport { \n  formatCountdown, \n  calculateProjectMetrics,\n  formatMinutes\n} from \'./services/projectEngine\';\nimport { \n  fetchUserProjects, \n  createNewProject, \n  loadProjectFullData, \n  saveProjectFullData, \n  getActiveProjectId, \n  setActiveProjectId, \n  DEMO_PROJECT,\n  ProjectFullData\n} from \'./services/projectStorage\';\nimport { Sidebar } from \'./components/Sidebar\';\nimport { TopBar } from \'./components/TopBar\';\nimport { CommandPalette } from \'./components/CommandPalette\';\nimport { ToastContainer, ToastMessage } from \'./components/Toast\';\nimport { ReasoningModal } from \'./components/modals/ReasoningModal\';\nimport { ShipModeModal } from \'./components/ShipModeModal\';\nimport { ProjectSwitcherModal } from \'./components/modals/ProjectSwitcherModal\';\nimport { OnboardingScreen } from \'./components/onboarding/OnboardingScreen\';\nimport { OverviewDashboard } from \'./components/overview/OverviewDashboard\';\nimport { IdeaLab } from \'./components/ideas/IdeaLab\';\nimport { MVPPlanner } from \'./components/mvp/MVPPlanner\';\nimport { TaskBoard } from \'./components/tasks/TaskBoard\';\nimport { ResourcesView } from \'./components/resources/ResourcesView\';\nimport { JudgeMode } from \'./components/judge/JudgeMode\';\nimport { LaunchView } from \'./components/launch/LaunchView\';\nimport confetti from \'canvas-confetti\';\nimport { Menu } from \'lucide-react\';\n\nexport default function App() {\n  // Projects & Multi-User State\n  const [projectsList, setProjectsList] = useState<Project[]>([]);\n  const [activeProject, setActiveProject] = useState<Project | null>(null);\n  const [isOnboarding, setIsOnboarding] = useState<boolean>(false);\n  const [isProjectSwitcherOpen, setIsProjectSwitcherOpen] = useState<boolean>(false);\n  const [isInitializing, setIsInitializing] = useState<boolean>(true);\n\n  // Navigation\n  const [activeTab, setActiveTab] = useState<NavigationTab>(\'overview\');\n  const [isMobileMenuOpen, setIsMobileMenuOpen] = useState(false);\n\n  // Active Project Scoped State\n  const [scopeItems, setScopeItems] = useState<ScopeCutItem[]>([]);\n  const [ideas, setIdeas] = useState<IdeaItem[]>([]);\n  const [mvpFeatures, setMvpFeatures] = useState<MVPFeature[]>([]);\n  const [tasks, setTasks] = useState<TaskItem[]>([]);\n  const [resources, setResources] = useState<AIResourceItem[]>(aiResources);\n  const [judgeEval, setJudgeEval] = useState<JudgeEvaluation>(DEMO_PROJECT as any);\n  const [launchChecklist, setLaunchChecklist] = useState<LaunchChecklistItem[]>([]);\n  const [activityLogs, setActivityLogs] = useState<ActivityTimelineItem[]>([]);\n  const [scopeCutApplied, setScopeCutApplied] = useState(false);\n\n  // Modals & UI States\n  const [isCommandPaletteOpen, setIsCommandPaletteOpen] = useState(false);\n  const [isReasoningOpen, setIsReasoningOpen] = useState(false);\n  const [isShipModeOpen, setIsShipModeOpen] = useState(false);\n\n  // Active Task Timer\n  const [isTaskActive, setIsTaskActive] = useState(true);\n  const [activeTaskSeconds, setActiveTaskSeconds] = useState(15 * 60 + 23);\n  const [activeTaskId, setActiveTaskId] = useState<string>(\'task-1\');\n\n  // Toasts\n  const [toasts, setToasts] = useState<ToastMessage[]>([]);\n\n  const addToast = (type: \'success\' | \'warning\' | \'info\' | \'ai\', title: string, message: string) => {\n    const id = `toast-${Date.now()}`;\n    setToasts(prev => [...prev, { id, type, title, message }]);\n    setTimeout(() => {\n      setToasts(prev => prev.filter(t => t.id !== id));\n    }, 4500);\n  };\n\n  const dismissToast = (id: string) => {\n    setToasts(prev => prev.filter(t => t.id !== id));\n  };\n\n  // 1. INITIAL PROJECT BOOTSTRAP\n  useEffect(() => {\n    async function initProjects() {\n      try {\n        const projects = await fetchUserProjects();\n        setProjectsList(projects);\n\n        const savedActiveId = getActiveProjectId();\n        const hasVisited = localStorage.getItem(\'halftime_visited\');\n\n        if (!hasVisited || (!savedActiveId && projects.length === 0)) {\n          // First time user: Show onboarding screen\n          setIsOnboarding(true);\n        } else {\n          // Returning user or active session\n          const targetId = savedActiveId || (projects.length > 0 ? projects[0].id : DEMO_PROJECT.id);\n          switchProject(targetId, projects);\n        }\n      } catch (err) {\n        console.error(\'Failed to initialize projects:\', err);\n        switchProject(DEMO_PROJECT.id, [DEMO_PROJECT]);\n      } finally {\n        setIsInitializing(false);\n      }\n    }\n\n    initProjects();\n  }, []);\n\n  // Switch Active Project\n  const switchProject = (projectId: string, currentList: Project[] = projectsList) => {\n    const targetProject = currentList.find(p => p.id === projectId) || \n      (projectId === DEMO_PROJECT.id ? DEMO_PROJECT : currentList[0] || DEMO_PROJECT);\n\n    setActiveProject(targetProject);\n    setActiveProjectId(targetProject.id);\n    setIsOnboarding(false);\n\n    // Load full isolated data for this project\n    const pData = loadProjectFullData(targetProject.id);\n    setScopeItems(pData.scopeItems || []);\n    setIdeas(pData.ideas || []);\n    setMvpFeatures(pData.features || []);\n    setTasks(pData.tasks || []);\n    setJudgeEval(pData.judgeEval);\n    setLaunchChecklist(pData.launchChecklist || []);\n    setActivityLogs(pData.activities || []);\n    setScopeCutApplied(Boolean(pData.scopeCutApplied));\n\n    if (targetProject.isDemo) {\n      addToast(\'ai\', \'DEMO MODE ACTIVE\', \'Viewing sample Team DOOM sprint on DoraHacks 2.0.\');\n    } else {\n      addToast(\'success\', \'PROJECT LOADED\', `Active workspace: ${targetProject.name}`);\n    }\n  };\n\n  // Sync state changes back to storage\n  useEffect(() => {\n    if (!activeProject || isInitializing) return;\n\n    const fullData: ProjectFullData = {\n      project: activeProject,\n      tasks,\n      features: mvpFeatures,\n      scopeItems,\n      ideas,\n      activities: activityLogs,\n      judgeEval,\n      launchChecklist,\n      scopeCutApplied,\n    };\n\n    saveProjectFullData(activeProject.id, fullData);\n  }, [\n    activeProject,\n    tasks,\n    mvpFeatures,\n    scopeItems,\n    ideas,\n    activityLogs,\n    judgeEval,\n    launchChecklist,\n    scopeCutApplied,\n    isInitializing\n  ]);\n\n  // Derived Project Engine Metrics\n  const projectMetrics = useMemo(() => {\n    return calculateProjectMetrics(scopeItems, activeProject || undefined, tasks, mvpFeatures);\n  }, [scopeItems, activeProject, tasks, mvpFeatures]);\n\n  const health = projectMetrics.health;\n\n  // Real-time Countdown calculation (based on active project\'s deadline)\n  const [secondsRemaining, setSecondsRemaining] = useState<number>(() => {\n    if (!activeProject) return 11 * 3600;\n    const msLeft = new Date(activeProject.deadline).getTime() - Date.now();\n    return Math.max(0, Math.floor(msLeft / 1000));\n  });\n\n  useEffect(() => {\n    if (!activeProject) return;\n\n    const computeSeconds = () => {\n      const msLeft = new Date(activeProject.deadline).getTime() - Date.now();\n      return Math.max(0, Math.floor(msLeft / 1000));\n    };\n\n    setSecondsRemaining(computeSeconds());\n\n    const timer = setInterval(() => {\n      setSecondsRemaining(computeSeconds());\n    }, 1000);\n\n    return () => clearInterval(timer);\n  }, [activeProject?.deadline, activeProject?.id]);\n\n  const countdownInfo = formatCountdown(secondsRemaining);\n\n  // Live timer for active task\n  useEffect(() => {\n    let interval: any = null;\n    if (isTaskActive) {\n      interval = setInterval(() => {\n        setActiveTaskSeconds(prev => prev + 1);\n      }, 1000);\n    }\n    return () => clearInterval(interval);\n  }, [isTaskActive]);\n\n  // Handle Creating New Project from Onboarding or Project Switcher\n  const handleCreateProject = async (data: {\n    name: string;\n    hackathonName: string;\n    deadline: string;\n    description: string;\n    teamName?: string;\n    teamMembers?: string[];\n    teamSkills?: string[];\n  }) => {\n    try {\n      const created = await createNewProject(data);\n      const updatedList = [created, ...projectsList.filter(p => p.id !== created.id)];\n      setProjectsList(updatedList);\n      localStorage.setItem(\'halftime_visited\', \'true\');\n      switchProject(created.id, updatedList);\n      addToast(\'success\', \'HACKATHON CREATED\', `\"${created.name}\" configured. Ready to build!`);\n    } catch (err) {\n      console.error(\'Project creation failed:\', err);\n      addToast(\'warning\', \'CREATE FAILED\', \'Could not create project. Please try again.\');\n    }\n  };\n\n  // Handle Selecting Demo Mode\n  const handleSelectDemo = () => {\n    localStorage.setItem(\'halftime_visited\', \'true\');\n    if (!projectsList.some(p => p.id === DEMO_PROJECT.id)) {\n      setProjectsList(prev => [DEMO_PROJECT, ...prev]);\n    }\n    switchProject(DEMO_PROJECT.id, [DEMO_PROJECT, ...projectsList]);\n  };\n\n  // 1. HERO SCOPE CUT ACTION\n  const handleExecuteScopeCut = () => {\n    const selectedItems = scopeItems.filter(item => item.selectedForCut && !item.isCut);\n    const recoveredMins = selectedItems.reduce((acc, curr) => acc + curr.timeMinutes, 0);\n    const recoveredFormatted = formatMinutes(recoveredMins);\n\n    setScopeCutApplied(true);\n\n    // Update Scope Items\n    setScopeItems(prev => prev.map(item => item.selectedForCut ? { ...item, isCut: true } : item));\n\n    // Update MVP Features\n    setMvpFeatures(prev => prev.map(feat => {\n      if (\n        feat.name.toLowerCase().includes(\'analytics\') || \n        feat.name.toLowerCase().includes(\'profile\') || \n        feat.name.toLowerCase().includes(\'dark mode\')\n      ) {\n        return { ...feat, priority: \'CUT\' };\n      }\n      return feat;\n    }));\n\n    // Update Judge Evaluation\n    setJudgeEval(prev => ({\n      ...prev,\n      overallScore: Math.min(10, Number((prev.overallScore + 0.65).toFixed(2))),\n      statusLabel: \'STRONG CONTENDER\',\n      summaryFeedback: \'Feature bloat pruned. Clear demo narrative preserved with ample testing runway.\',\n      whyYouMightLose: \'Maintain flawless execution on the primary user path.\',\n    }));\n\n    // Add activity log\n    setActivityLogs(prev => [\n      {\n        id: `act-${Date.now()}`,\n        title: `Scope Cut Executed: Pruned ${selectedItems.length} features, recovered ${recoveredFormatted}`,\n        timestamp: \'just now\',\n        type: \'scope\',\n        badgeColor: \'#B7E4C7\',\n      },\n      ...prev,\n    ]);\n\n    // Trigger celebratory confetti\n    confetti({\n      particleCount: 75,\n      spread: 60,\n      origin: { y: 0.75 },\n      colors: [\'#C7F9A6\', \'#A8E6CF\', \'#B8DDF0\'],\n    });\n\n    addToast(\n      \'success\',\n      \'SCOPE CUT EXECUTED\',\n      `Saved ${recoveredFormatted}. Hackathon sprint capacity restored to ON TRACK.`\n    );\n  };\n\n  // 2. RESET SCOPE CUT\n  const handleResetScopeCut = () => {\n    setScopeCutApplied(false);\n    setScopeItems(prev => prev.map(item => ({ ...item, isCut: false })));\n    setMvpFeatures(prev => prev.map(feat => {\n      if (feat.priority === \'CUT\') {\n        return { ...feat, priority: \'NICE_TO_HAVE\' };\n      }\n      return feat;\n    }));\n\n    setJudgeEval(prev => ({\n      ...prev,\n      overallScore: Math.max(7.0, Number((prev.overallScore - 0.65).toFixed(2))),\n      statusLabel: \'AT RISK (TIME CRUNCH)\',\n    }));\n\n    addToast(\'info\', \'SCOPE CUT RESET\', \'Previous backlog restored. Back in 3h capacity deficit.\');\n  };\n\n  // 3. TOGGLE SCOPE CHECKBOX\n  const handleToggleScopeSelect = (id: string) => {\n    setScopeItems(prev => prev.map(item => \n      item.id === id ? { ...item, selectedForCut: !item.selectedForCut } : item\n    ));\n  };\n\n  // 4. RECALCULATE PLAN VIA GEMINI\n  const handleRecalculatePlan = async () => {\n    addToast(\'ai\', \'RECALCULATING PLAN\', \'Gemini evaluating sprint capacity and backlog velocity...\');\n    \n    // Simulate smart recalculation / fetch\n    setTimeout(() => {\n      setActivityLogs(prev => [\n        {\n          id: `act-${Date.now()}`,\n          title: \'Plan recalculated: Backlog prioritized around high-rubric core loop\',\n          timestamp: \'just now\',\n          type: \'ai\',\n          badgeColor: \'#C7F9A6\',\n        },\n        ...prev,\n      ]);\n      addToast(\'success\', \'SPRINT PLAN UPDATED\', \'Sprint synchronized with remaining runway.\');\n    }, 1000);\n  };\n\n  // 5. START NEXT TASK\n  const handleStartNextTask = () => {\n    setIsTaskActive(true);\n    setActiveTaskSeconds(0);\n    setActiveTab(\'tasks\');\n    addToast(\'info\', \'SPRINT TIMER STARTED\', \'Tracking active build sprint for primary milestone.\');\n  };\n\n  // 6. IDEA LAB ACTIONS\n  const handleSelectActiveIdea = (idea: IdeaItem) => {\n    addToast(\'ai\', \'ACTIVE IDEA SELECTED\', `Switched primary project context to \"${idea.title}\".`);\n  };\n\n  const handleAddGeneratedIdeas = (newIdeas: IdeaItem[]) => {\n    setIdeas(prev => [...newIdeas, ...prev]);\n    addToast(\'success\', \'IDEAS GENERATED\', `${newIdeas.length} new hackathon concepts synthesized.`);\n  };\n\n  // 7. MVP PLANNER ACTIONS\n  const handleChangeFeaturePriority = (id: string, newPriority: FeaturePriority) => {\n    setMvpFeatures(prev => prev.map(f => f.id === id ? { ...f, priority: newPriority } : f));\n    addToast(\'info\', \'MVP MATRIX UPDATED\', `Feature moved to ${newPriority.replace(\'_\', \' \')}.`);\n  };\n\n  const handleAddFeature = (feat: MVPFeature) => {\n    setMvpFeatures(prev => [...prev, feat]);\n    addToast(\'success\', \'FEATURE ADDED\', `\"${feat.name}\" added to MVP Plan.`);\n  };\n\n  // 8. TASK BOARD ACTIONS\n  const handleUpdateTaskStatus = (taskId: string, newStatus: TaskStatus) => {\n    setTasks(prev => prev.map(t => t.id === taskId ? { ...t, status: newStatus } : t));\n    if (newStatus === \'DONE\') {\n      addToast(\'success\', \'TASK COMPLETED\', \'Sprint velocity updated.\');\n    }\n  };\n\n  const handleAddTask = (task: TaskItem) => {\n    setTasks(prev => [task, ...prev]);\n    addToast(\'info\', \'TASK CREATED\', `\"${task.title}\" added to backlog.`);\n  };\n\n  // 9. JUDGE FIX TOGGLE\n  const handleToggleJudgeFix = (fixId: number) => {\n    setJudgeEval(prev => {\n      const updatedFixes = prev.fixes.map(f => f.id === fixId ? { ...f, applied: !f.applied } : f);\n      return {\n        ...prev,\n        fixes: updatedFixes,\n      };\n    });\n    addToast(\'ai\', \'JUDGE RUBRIC UPDATED\', \'Fix status recalculated in live audit score.\');\n  };\n\n  const handleRerunJudge = () => {\n    addToast(\'ai\', \'JUDGE AUDIT RE-EVALUATED\', \'Rubric synchronized with evaluation criteria.\');\n  };\n\n  // 10. LAUNCH CHECKLIST TOGGLE\n  const handleToggleLaunchStatus = (id: string) => {\n    setLaunchChecklist(prev => prev.map(item => {\n      if (item.id === id) {\n        const nextStatus = item.status === \'COMPLETE\' ? \'NEEDS_ATTENTION\' : \'COMPLETE\';\n        return { ...item, status: nextStatus };\n      }\n      return item;\n    }));\n  };\n\n  // If first-time user / onboarding mode:\n  if (isOnboarding && !activeProject) {\n    return (\n      <>\n        <OnboardingScreen\n          onCreateProject={handleCreateProject}\n          onSelectDemo={handleSelectDemo}\n        />\n        <ToastContainer toasts={toasts} onDismiss={dismissToast} />\n      </>\n    );\n  }\n\n  const currentProjectName = activeProject?.name || \'Hackathon Copilot\';\n  const currentHackathonName = activeProject?.hackathonName || \'DoraHacks 2.0\';\n  const currentTeamName = activeProject?.teamName || \'Team DOOM\';\n  const isDemo = Boolean(activeProject?.isDemo);\n\n  return (\n    <div className=\"min-h-screen bg-[#202B2A] text-[#F0F4EE] flex flex-col selection:bg-[#C7F9A6] selection:text-[#202B2A] relative overflow-x-hidden\">\n      {/* Ambient background blur aura */}\n      <div className=\"fixed top-[-100px] right-[-100px] w-[500px] h-[500px] bg-[#A8E6CF] opacity-[0.03] blur-[120px] rounded-full pointer-events-none z-0\" />\n\n      {/* Sidebar Navigation */}\n      <Sidebar\n        activeTab={activeTab}\n        onSelectTab={setActiveTab}\n        scopeCutApplied={scopeCutApplied}\n        isOpenMobile={isMobileMenuOpen}\n        onCloseMobile={() => setIsMobileMenuOpen(false)}\n        projectName={currentProjectName}\n        teamName={currentTeamName}\n        isDemo={isDemo}\n        onOpenProjectSwitcher={() => setIsProjectSwitcherOpen(true)}\n      />\n\n      {/* Main Content Layout with Left Offset for Desktop Sidebar */}\n      <div className=\"lg:pl-64 flex flex-col flex-1 min-w-0 relative z-10\">\n        {/* Mobile Top Header Toggle Bar */}\n        <div className=\"lg:hidden h-14 bg-[#202B2A] border-b border-[#3B4B47] px-4 flex items-center justify-between sticky top-0 z-40\">\n          <button\n            onClick={() => setIsMobileMenuOpen(true)}\n            className=\"p-2 rounded-lg bg-[#293735] text-[#F0F4EE] border border-[#3B4B47] active:scale-95 cursor-pointer\"\n            aria-label=\"Open navigation menu\"\n          >\n            <Menu className=\"w-5 h-5\" />\n          </button>\n          <button \n            onClick={() => setIsProjectSwitcherOpen(true)}\n            className=\"font-mono font-bold text-xs tracking-wider text-[#F0F4EE] flex items-center gap-1.5\"\n          >\n            <span>{currentProjectName}</span>\n            {isDemo && (\n              <span className=\"text-[9px] px-1.5 py-0.2 rounded bg-[#FFE0A3]/20 text-[#FFE0A3]\">\n                DEMO\n              </span>\n            )}\n          </button>\n          <span className=\"text-[10px] font-mono px-2 py-0.5 rounded bg-[#31413F] text-[#A8E6CF]\">\n            {countdownInfo.display}\n          </span>\n        </div>\n\n        {/* Global Top Bar with Functional Real-Time Countdown & Project Switcher */}\n        <TopBar\n          healthStatus={health.status}\n          onOpenCommandPalette={() => setIsCommandPaletteOpen(true)}\n          onOpenShipMode={() => setIsShipModeOpen(true)}\n          onOpenProjectSwitcher={() => setIsProjectSwitcherOpen(true)}\n          shipModeReady={launchChecklist.filter(i => i.status === \'COMPLETE\').length >= 6}\n          countdownDisplay={countdownInfo.display}\n          countdownStatus={countdownInfo.status}\n          projectName={currentProjectName}\n          hackathonName={currentHackathonName}\n          isDemo={isDemo}\n        />\n\n        {/* Dynamic Main View Container */}\n        <main className=\"flex-1 px-4 sm:px-8 py-6 sm:py-8 max-w-7xl w-full mx-auto\">\n          {activeTab === \'overview\' && (\n            <OverviewDashboard\n              health={health}\n              scopeItems={scopeItems}\n              activityLogs={activityLogs}\n              scopeCutApplied={scopeCutApplied}\n              onExecuteScopeCut={handleExecuteScopeCut}\n              onResetScopeCut={handleResetScopeCut}\n              onToggleScopeSelect={handleToggleScopeSelect}\n              onRecalculatePlan={handleRecalculatePlan}\n              onOpenReasoning={() => setIsReasoningOpen(true)}\n              onStartNextTask={handleStartNextTask}\n              isTaskActive={isTaskActive}\n              taskActiveSeconds={activeTaskSeconds}\n            />\n          )}\n\n          {activeTab === \'idea-lab\' && (\n            <IdeaLab\n              ideas={ideas}\n              onSelectActiveIdea={handleSelectActiveIdea}\n              onAddGeneratedIdeas={handleAddGeneratedIdeas}\n            />\n          )}\n\n          {activeTab === \'mvp-planner\' && (\n            <MVPPlanner\n              features={mvpFeatures}\n              onChangeFeaturePriority={handleChangeFeaturePriority}\n              onAddFeature={handleAddFeature}\n              onSetAllFeatures={(newFeats) => setMvpFeatures(newFeats)}\n              activeIdeaTitle={currentProjectName}\n            />\n          )}\n\n          {activeTab === \'tasks\' && (\n            <TaskBoard\n              tasks={tasks}\n              teamMembers={defaultTeamMembers}\n              onUpdateTaskStatus={handleUpdateTaskStatus}\n              onAddTask={handleAddTask}\n              activeTaskId={activeTaskId}\n              onSetActiveTask={setActiveTaskId}\n            />\n          )}\n\n          {activeTab === \'resources\' && (\n            <ResourcesView\n              resources={resources}\n              onOptimizeCredits={() => {\n                addToast(\'ai\', \'CREDIT OPTIMIZATION ACTIVE\', \'Prompt tokens pruned; Base44 calls throttled for demo.\');\n              }}\n            />\n          )}\n\n          {activeTab === \'judge-mode\' && (\n            <JudgeMode\n              evaluation={judgeEval}\n              onToggleFix={handleToggleJudgeFix}\n              onRerunJudge={handleRerunJudge}\n              onUpdateEvaluation={(newEval) => setJudgeEval(newEval)}\n              scopeCutApplied={scopeCutApplied}\n            />\n          )}\n\n          {activeTab === \'launch\' && (\n            <LaunchView\n              checklist={launchChecklist}\n              onToggleStatus={handleToggleLaunchStatus}\n              onOpenShipMode={() => setIsShipModeOpen(true)}\n              scopeCutApplied={scopeCutApplied}\n            />\n          )}\n        </main>\n      </div>\n\n      {/* Floating Bottom-Right Corner Widget */}\n      <div className=\"fixed bottom-6 right-6 sm:bottom-8 sm:right-8 z-40 flex items-center space-x-3 pointer-events-auto\">\n        <div className=\"bg-[#293735]/85 backdrop-blur-md px-4 py-2 rounded-full border border-white/5 flex items-center space-x-2.5 shadow-2xl\">\n          <span className=\"w-2 h-2 rounded-full bg-[#A8E6CF] animate-pulse\" />\n          <span className=\"text-[10px] font-bold tracking-tight text-[#F0F4EE]\">\n            {isDemo ? \'DEMO MODE\' : \'AI ONLINE\'}\n          </span>\n        </div>\n        <button\n          onClick={() => setIsCommandPaletteOpen(true)}\n          className=\"bg-[#C7F9A6] text-[#202B2A] w-11 h-11 sm:w-12 sm:h-12 rounded-full flex items-center justify-center shadow-[0_0_30px_rgba(199,249,166,0.4)] cursor-pointer hover:scale-105 active:scale-95 transition-transform\"\n          title=\"Open Quick Command Palette (\342\214\230K)\"\n        >\n          <span className=\"text-xs font-black\">\342\214\230K</span>\n        </button>\n      </div>\n\n      {/* Command Palette (\342\214\230K) */}\n      <CommandPalette\n        isOpen={isCommandPaletteOpen}\n        onClose={() => setIsCommandPaletteOpen(false)}\n        onSelectTab={setActiveTab}\n        onTriggerScopeCut={handleExecuteScopeCut}\n        onTriggerShipMode={() => setIsShipModeOpen(true)}\n        onStartNextTask={handleStartNextTask}\n      />\n\n      {/* AI Reasoning Deep Dive Modal */}\n      <ReasoningModal\n        isOpen={isReasoningOpen}\n        onClose={() => setIsReasoningOpen(false)}\n        health={health}\n        scopeCutApplied={scopeCutApplied}\n      />\n\n      {/* Hero Ship Mode Modal */}\n      <ShipModeModal\n        isOpen={isShipModeOpen}\n        onClose={() => setIsShipModeOpen(false)}\n        scopeCutApplied={scopeCutApplied}\n        score={judgeEval?.overallScore || 8.8}\n      />\n\n      {/* Project Switcher Modal */}\n      <ProjectSwitcherModal\n        isOpen={isProjectSwitcherOpen}\n        onClose={() => setIsProjectSwitcherOpen(false)}\n        projects={projectsList}\n        activeProjectId={activeProject?.id || \'\'}\n        onSelectProject={(id) => switchProject(id)}\n        onOpenCreateNew={() => {\n          setIsOnboarding(true);\n          setActiveProject(null);\n        }}\n      />\n\n      {/* Global Toast Container */}\n      <ToastContainer toasts={toasts} onDismiss={dismissToast} />\n    </div>\n  );\n}"
        replacement_content: "import React, { useState, useEffect, useMemo } from \'react\';\nimport { \n  NavigationTab, \n  ProjectHealth, \n  ScopeCutItem, \n  IdeaItem, \n  MVPFeature, \n  TaskItem, \n  AIResourceItem, \n  JudgeEvaluation, \n  LaunchChecklistItem, \n  ActivityTimelineItem,\n  FeaturePriority,\n  TaskStatus,\n  Project\n} from \'./types\';\nimport { \n  teamMembers as defaultTeamMembers, \n  aiResources \n} from \'./data/mockData\';\nimport { \n  formatCountdown, \n  calculateProjectMetrics,\n  formatMinutes\n} from \'./services/projectEngine\';\nimport { \n  fetchUserProjects, \n  createNewProject, \n  loadProjectFullData, \n  saveProjectFullData, \n  getActiveProjectId, \n  setActiveProjectId, \n  DEMO_PROJECT,\n  ProjectFullData\n} from \'./services/projectStorage\';\nimport { recommendNextAction } from \'./services/aiService\';\nimport { Sidebar } from \'./components/Sidebar\';\nimport { TopBar } from \'./components/TopBar\';\nimport { CommandPalette } from \'./components/CommandPalette\';\nimport { ToastContainer, ToastMessage } from \'./components/Toast\';\nimport { ReasoningModal } from \'./components/modals/ReasoningModal\';\nimport { ShipModeModal } from \'./components/ShipModeModal\';\nimport { ProjectSwitcherModal } from \'./components/modals/ProjectSwitcherModal\';\nimport { AuthModal } from \'./components/modals/AuthModal\';\nimport { OnboardingScreen } from \'./components/onboarding/OnboardingScreen\';\nimport { OverviewDashboard } from \'./components/overview/OverviewDashboard\';\nimport { IdeaLab } from \'./components/ideas/IdeaLab\';\nimport { MVPPlanner } from \'./components/mvp/MVPPlanner\';\nimport { TaskBoard } from \'./components/tasks/TaskBoard\';\nimport { ResourcesView } from \'./components/resources/ResourcesView\';\nimport { JudgeMode } from \'./components/judge/JudgeMode\';\nimport { LaunchView } from \'./components/launch/LaunchView\';\nimport confetti from \'canvas-confetti\';\nimport { Menu } from \'lucide-react\';\n\nexport default function App() {\n  // Projects & Multi-User State\n  const [projectsList, setProjectsList] = useState<Project[]>([]);\n  const [activeProject, setActiveProject] = useState<Project | null>(null);\n  const [isOnboarding, setIsOnboarding] = useState<boolean>(false);\n  const [isProjectSwitcherOpen, setIsProjectSwitcherOpen] = useState<boolean>(false);\n  const [isAuthModalOpen, setIsAuthModalOpen] = useState<boolean>(false);\n  const [isInitializing, setIsInitializing] = useState<boolean>(true);\n\n  // Navigation\n  const [activeTab, setActiveTab] = useState<NavigationTab>(\'overview\');\n  const [isMobileMenuOpen, setIsMobileMenuOpen] = useState(false);\n\n  // Active Project Scoped State\n  const [scopeItems, setScopeItems] = useState<ScopeCutItem[]>([]);\n  const [ideas, setIdeas] = useState<IdeaItem[]>([]);\n  const [mvpFeatures, setMvpFeatures] = useState<MVPFeature[]>([]);\n  const [tasks, setTasks] = useState<TaskItem[]>([]);\n  const [dynamicTeamMembers, setDynamicTeamMembers] = useState<string[]>([\'Builder (Fullstack)\', \'Designer (UI/UX)\', \'Product (Pitch)\', \'AI Eng (Gemini)\']);\n  const [resources, setResources] = useState<AIResourceItem[]>(aiResources);\n  const [judgeEval, setJudgeEval] = useState<JudgeEvaluation>(DEMO_PROJECT as any);\n  const [launchChecklist, setLaunchChecklist] = useState<LaunchChecklistItem[]>([]);\n  const [activityLogs, setActivityLogs] = useState<ActivityTimelineItem[]>([]);\n  const [scopeCutApplied, setScopeCutApplied] = useState(false);\n\n  // Modals & UI States\n  const [isCommandPaletteOpen, setIsCommandPaletteOpen] = useState(false);\n  const [isReasoningOpen, setIsReasoningOpen] = useState(false);\n  const [isShipModeOpen, setIsShipModeOpen] = useState(false);\n\n  // Active Task Timer\n  const [isTaskActive, setIsTaskActive] = useState(true);\n  const [activeTaskSeconds, setActiveTaskSeconds] = useState(15 * 60 + 23);\n  const [activeTaskId, setActiveTaskId] = useState<string>(\'task-1\');\n\n  // Toasts\n  const [toasts, setToasts] = useState<ToastMessage[]>([]);\n\n  const addToast = (type: \'success\' | \'warning\' | \'info\' | \'ai\', title: string, message: string) => {\n    const id = `toast-${Date.now()}`;\n    setToasts(prev => [...prev, { id, type, title, message }]);\n    setTimeout(() => {\n      setToasts(prev => prev.filter(t => t.id !== id));\n    }, 4500);\n  };\n\n  const dismissToast = (id: string) => {\n    setToasts(prev => prev.filter(t => t.id !== id));\n  };\n\n  // 1. INITIAL PROJECT BOOTSTRAP\n  useEffect(() => {\n    async function initProjects() {\n      try {\n        const projects = await fetchUserProjects();\n        setProjectsList(projects);\n\n        const savedActiveId = getActiveProjectId();\n        const hasVisited = localStorage.getItem(\'halftime_visited\');\n\n        if (!hasVisited || (!savedActiveId && projects.length === 0)) {\n          // First time user: Show onboarding screen\n          setIsOnboarding(true);\n        } else {\n          // Returning user or active session\n          const targetId = savedActiveId || (projects.length > 0 ? projects[0].id : DEMO_PROJECT.id);\n          switchProject(targetId, projects);\n        }\n      } catch (err) {\n        console.error(\'Failed to initialize projects:\', err);\n        switchProject(DEMO_PROJECT.id, [DEMO_PROJECT]);\n      } finally {\n        setIsInitializing(false);\n      }\n    }\n\n    initProjects();\n  }, []);\n\n  // Switch Active Project\n  const switchProject = (projectId: string, currentList: Project[] = projectsList) => {\n    const targetProject = currentList.find(p => p.id === projectId) || \n      (projectId === DEMO_PROJECT.id ? DEMO_PROJECT : currentList[0] || DEMO_PROJECT);\n\n    setActiveProject(targetProject);\n    setActiveProjectId(targetProject.id);\n    setIsOnboarding(false);\n\n    // Load full isolated data for this project\n    const pData = loadProjectFullData(targetProject.id);\n    setScopeItems(pData.scopeItems || []);\n    setIdeas(pData.ideas || []);\n    setMvpFeatures(pData.features || []);\n    setTasks(pData.tasks || []);\n    if (targetProject.teamMembers && targetProject.teamMembers.length > 0) {\n      setDynamicTeamMembers(targetProject.teamMembers);\n    }\n    setJudgeEval(pData.judgeEval);\n    setLaunchChecklist(pData.launchChecklist || []);\n    setActivityLogs(pData.activities || []);\n    setScopeCutApplied(Boolean(pData.scopeCutApplied));\n\n    if (targetProject.isDemo) {\n      addToast(\'ai\', \'DEMO MODE ACTIVE\', \'Viewing sample Team DOOM sprint on DoraHacks 2.0.\');\n    } else {\n      addToast(\'success\', \'PROJECT LOADED\', `Active workspace: ${targetProject.name}`);\n    }\n  };\n\n  // Sync state changes back to storage\n  useEffect(() => {\n    if (!activeProject || isInitializing) return;\n\n    const fullData: ProjectFullData = {\n      project: activeProject,\n      tasks,\n      features: mvpFeatures,\n      scopeItems,\n      ideas,\n      activities: activityLogs,\n      judgeEval,\n      launchChecklist,\n      scopeCutApplied,\n    };\n\n    saveProjectFullData(activeProject.id, fullData);\n  }, [\n    activeProject,\n    tasks,\n    mvpFeatures,\n    scopeItems,\n    ideas,\n    activityLogs,\n    judgeEval,\n    launchChecklist,\n    scopeCutApplied,\n    isInitializing\n  ]);\n\n  // Derived Project Engine Metrics\n  const projectMetrics = useMemo(() => {\n    return calculateProjectMetrics(scopeItems, activeProject || undefined, tasks, mvpFeatures);\n  }, [scopeItems, activeProject, tasks, mvpFeatures]);\n\n  const health = projectMetrics.health;\n\n  // Real-time Countdown calculation (based on active project\'s deadline)\n  const [secondsRemaining, setSecondsRemaining] = useState<number>(() => {\n    if (!activeProject) return 11 * 3600;\n    const msLeft = new Date(activeProject.deadline).getTime() - Date.now();\n    return Math.max(0, Math.floor(msLeft / 1000));\n  });\n\n  useEffect(() => {\n    if (!activeProject) return;\n\n    const computeSeconds = () => {\n      const msLeft = new Date(activeProject.deadline).getTime() - Date.now();\n      return Math.max(0, Math.floor(msLeft / 1000));\n    };\n\n    setSecondsRemaining(computeSeconds());\n\n    const timer = setInterval(() => {\n      setSecondsRemaining(computeSeconds());\n    }, 1000);\n\n    return () => clearInterval(timer);\n  }, [activeProject?.deadline, activeProject?.id]);\n\n  const countdownInfo = formatCountdown(secondsRemaining);\n\n  // Live timer for active task\n  useEffect(() => {\n    let interval: any = null;\n    if (isTaskActive) {\n      interval = setInterval(() => {\n        setActiveTaskSeconds(prev => prev + 1);\n      }, 1000);\n    }\n    return () => clearInterval(interval);\n  }, [isTaskActive]);\n\n  // Handle Creating New Project from Onboarding or Project Switcher\n  const handleCreateProject = async (data: {\n    name: string;\n    hackathonName: string;\n    deadline: string;\n    description: string;\n    teamName?: string;\n    teamMembers?: string[];\n    teamSkills?: string[];\n  }) => {\n    try {\n      const created = await createNewProject(data);\n      const updatedList = [created, ...projectsList.filter(p => p.id !== created.id)];\n      setProjectsList(updatedList);\n      localStorage.setItem(\'halftime_visited\', \'true\');\n      switchProject(created.id, updatedList);\n      addToast(\'success\', \'HACKATHON CREATED\', `\"${created.name}\" configured. Ready to build!`);\n    } catch (err) {\n      console.error(\'Project creation failed:\', err);\n      addToast(\'warning\', \'CREATE FAILED\', \'Could not create project. Please try again.\');\n    }\n  };\n\n  // Handle Selecting Demo Mode\n  const handleSelectDemo = () => {\n    localStorage.setItem(\'halftime_visited\', \'true\');\n    if (!projectsList.some(p => p.id === DEMO_PROJECT.id)) {\n      setProjectsList(prev => [DEMO_PROJECT, ...prev]);\n    }\n    switchProject(DEMO_PROJECT.id, [DEMO_PROJECT, ...projectsList]);\n  };\n\n  // 1. HERO SCOPE CUT ACTION\n  const handleExecuteScopeCut = () => {\n    const selectedItems = scopeItems.filter(item => item.selectedForCut && !item.isCut);\n    const recoveredMins = selectedItems.reduce((acc, curr) => acc + curr.timeMinutes, 0);\n    const recoveredFormatted = formatMinutes(recoveredMins);\n\n    setScopeCutApplied(true);\n\n    // Update Scope Items\n    setScopeItems(prev => prev.map(item => item.selectedForCut ? { ...item, isCut: true } : item));\n\n    // Update MVP Features\n    setMvpFeatures(prev => prev.map(feat => {\n      if (\n        feat.name.toLowerCase().includes(\'analytics\') || \n        feat.name.toLowerCase().includes(\'profile\') || \n        feat.name.toLowerCase().includes(\'dark mode\')\n      ) {\n        return { ...feat, priority: \'CUT\' };\n      }\n      return feat;\n    }));\n\n    // Update Judge Evaluation\n    setJudgeEval(prev => ({\n      ...prev,\n      overallScore: Math.min(10, Number((prev.overallScore + 0.65).toFixed(2))),\n      statusLabel: \'STRONG CONTENDER\',\n      summaryFeedback: \'Feature bloat pruned. Clear demo narrative preserved with ample testing runway.\',\n      whyYouMightLose: \'Maintain flawless execution on the primary user path.\',\n    }));\n\n    // Add activity log\n    setActivityLogs(prev => [\n      {\n        id: `act-${Date.now()}`,\n        title: `Scope Cut Executed: Pruned ${selectedItems.length} features, recovered ${recoveredFormatted}`,\n        timestamp: \'just now\',\n        type: \'scope\',\n        badgeColor: \'#B7E4C7\',\n      },\n      ...prev,\n    ]);\n\n    // Trigger celebratory confetti\n    confetti({\n      particleCount: 75,\n      spread: 60,\n      origin: { y: 0.75 },\n      colors: [\'#C7F9A6\', \'#A8E6CF\', \'#B8DDF0\'],\n    });\n\n    addToast(\n      \'success\',\n      \'SCOPE CUT EXECUTED\',\n      `Saved ${recoveredFormatted}. Hackathon sprint capacity restored to ON TRACK.`\n    );\n  };\n\n  // 2. RESET SCOPE CUT\n  const handleResetScopeCut = () => {\n    setScopeCutApplied(false);\n    setScopeItems(prev => prev.map(item => ({ ...item, isCut: false })));\n    setMvpFeatures(prev => prev.map(feat => {\n      if (feat.priority === \'CUT\') {\n        return { ...feat, priority: \'NICE_TO_HAVE\' };\n      }\n      return feat;\n    }));\n\n    setJudgeEval(prev => ({\n      ...prev,\n      overallScore: Math.max(7.0, Number((prev.overallScore - 0.65).toFixed(2))),\n      statusLabel: \'AT RISK (TIME CRUNCH)\',\n    }));\n\n    addToast(\'info\', \'SCOPE CUT RESET\', \'Previous backlog restored. Back in 3h capacity deficit.\');\n  };\n\n  // 3. TOGGLE SCOPE CHECKBOX\n  const handleToggleScopeSelect = (id: string) => {\n    setScopeItems(prev => prev.map(item => \n      item.id === id ? { ...item, selectedForCut: !item.selectedForCut } : item\n    ));\n  };\n\n  // 4. RECALCULATE PLAN VIA REAL GEMINI\n  const handleRecalculatePlan = async () => {\n    addToast(\'ai\', \'RECALCULATING PLAN\', \'Gemini evaluating sprint capacity and backlog velocity...\');\n    try {\n      const rec = await recommendNextAction({\n        timeRemaining: countdownInfo.display,\n        workRemaining: `${health.workRemainingHours}h`,\n        tasks,\n        teamMembers: dynamicTeamMembers,\n        currentProject: activeProject?.name,\n        projectHealth: health,\n        riskStatus: health.status,\n        scopeCutApplied,\n      });\n\n      setActivityLogs(prev => [\n        {\n          id: `act-${Date.now()}`,\n          title: `AI Triage: ${rec?.actionTitle || \'Focus on core demo\'} - ${rec?.reason || \'Optimizes judge demo score.\'}`,\n          timestamp: \'just now\',\n          type: \'ai\',\n          badgeColor: \'#C7F9A6\',\n        },\n        ...prev,\n      ]);\n      addToast(\'success\', \'SPRINT PLAN UPDATED\', rec?.actionTitle ? `Focus: ${rec.actionTitle}` : \'Sprint synchronized with Gemini.\');\n    } catch (err: any) {\n      addToast(\'warning\', \'AI TRIAGE NOTICE\', err?.message || \'HALFTIME AI is temporarily unavailable. Please try again.\');\n    }\n  };\n\n  // 5. START NEXT TASK\n  const handleStartNextTask = () => {\n    setIsTaskActive(true);\n    setActiveTaskSeconds(0);\n    setActiveTab(\'tasks\');\n    addToast(\'info\', \'SPRINT TIMER STARTED\', \'Tracking active build sprint for primary milestone.\');\n  };\n\n  // 6. IDEA LAB ACTIONS\n  const handleSelectActiveIdea = (idea: IdeaItem) => {\n    addToast(\'ai\', \'ACTIVE IDEA SELECTED\', `Switched primary project context to \"${idea.title}\".`);\n  };\n\n  const handleAddGeneratedIdeas = (newIdeas: IdeaItem[]) => {\n    setIdeas(prev => [...newIdeas, ...prev]);\n    addToast(\'success\', \'IDEAS GENERATED\', `${newIdeas.length} new hackathon concepts synthesized.`);\n  };\n\n  const handleDeleteIdea = (ideaId: string) => {\n    setIdeas(prev => prev.filter(i => i.id !== ideaId));\n    addToast(\'info\', \'IDEA REMOVED\', \'Concept removed from matrix.\');\n  };\n\n  // 7. MVP PLANNER ACTIONS\n  const handleChangeFeaturePriority = (id: string, newPriority: FeaturePriority) => {\n    setMvpFeatures(prev => prev.map(f => f.id === id ? { ...f, priority: newPriority } : f));\n    addToast(\'info\', \'MVP MATRIX UPDATED\', `Feature moved to ${newPriority.replace(\'_\', \' \')}.`);\n  };\n\n  const handleAddFeature = (feat: MVPFeature) => {\n    setMvpFeatures(prev => [...prev, feat]);\n    addToast(\'success\', \'FEATURE ADDED\', `\"${feat.name}\" added to MVP Plan.`);\n  };\n\n  const handleDeleteFeature = (featId: string) => {\n    setMvpFeatures(prev => prev.filter(f => f.id !== featId));\n    addToast(\'info\', \'FEATURE REMOVED\', \'Feature pruned from MVP architecture.\');\n  };\n\n  const handleAddTasksFromRoadmap = (newTasks: TaskItem[]) => {\n    setTasks(prev => [...newTasks, ...prev]);\n    addToast(\'success\', \'ROADMAP IMPORTED\', `Added ${newTasks.length} sprint tickets to Task Board.`);\n  };\n\n  // 8. TASK BOARD ACTIONS\n  const handleUpdateTaskStatus = (taskId: string, newStatus: TaskStatus) => {\n    setTasks(prev => prev.map(t => t.id === taskId ? { ...t, status: newStatus } : t));\n    if (newStatus === \'DONE\') {\n      addToast(\'success\', \'TASK COMPLETED\', \'Sprint velocity updated.\');\n    }\n  };\n\n  const handleAddTask = (task: TaskItem) => {\n    setTasks(prev => [task, ...prev]);\n    addToast(\'info\', \'TASK CREATED\', `\"${task.title}\" added to backlog.`);\n  };\n\n  const handleDeleteTask = (taskId: string) => {\n    setTasks(prev => prev.filter(t => t.id !== taskId));\n    addToast(\'info\', \'TASK REMOVED\', \'Ticket removed from board.\');\n  };\n\n  const handleAddTeamMember = (memberName: string) => {\n    setDynamicTeamMembers(prev => [...prev, memberName]);\n    addToast(\'success\', \'TEAM UPDATED\', `${memberName} added to active hacker roster.`);\n  };\n\n  // 9. RESOURCES ACTIONS\n  const handleAddResource = (resItem: AIResourceItem) => {\n    setResources(prev => [resItem, ...prev]);\n    addToast(\'success\', \'RESOURCE TRACKED\', `${resItem.tool} quota added.`);\n  };\n\n  const handleUpdateResourceUsage = (id: string, newUsage: number) => {\n    setResources(prev => prev.map(r => {\n      if (r.id === id && r.budgetLimit) {\n        const remaining = Math.max(0, r.budgetLimit - newUsage);\n        const percent = Math.min(100, Math.max(0, Math.round((remaining / r.budgetLimit) * 100)));\n        return {\n          ...r,\n          currentUsage: newUsage,\n          remainingPercent: percent,\n          creditsLabel: `${(r.budgetLimit - newUsage).toFixed(0)} / ${r.budgetLimit} ${r.unit || \'units\'} remaining`,\n        };\n      }\n      return r;\n    }));\n  };\n\n  const handleDeleteResource = (id: string) => {\n    setResources(prev => prev.filter(r => r.id !== id));\n    addToast(\'info\', \'RESOURCE REMOVED\', \'Resource telemetry unlinked.\');\n  };\n\n  // 10. JUDGE FIX TOGGLE\n  const handleToggleJudgeFix = (fixId: number) => {\n    setJudgeEval(prev => {\n      const updatedFixes = prev.fixes.map(f => f.id === fixId ? { ...f, applied: !f.applied } : f);\n      return {\n        ...prev,\n        fixes: updatedFixes,\n      };\n    });\n    addToast(\'ai\', \'JUDGE RUBRIC UPDATED\', \'Fix status recalculated in live audit score.\');\n  };\n\n  const handleRerunJudge = () => {\n    addToast(\'ai\', \'JUDGE AUDIT RE-EVALUATED\', \'Rubric synchronized with evaluation criteria.\');\n  };\n\n  // 11. LAUNCH CHECKLIST TOGGLE\n  const handleToggleLaunchStatus = (id: string) => {\n    setLaunchChecklist(prev => prev.map(item => {\n      if (item.id === id) {\n        const nextStatus = item.status === \'COMPLETE\' ? \'NEEDS_ATTENTION\' : \'COMPLETE\';\n        return { ...item, status: nextStatus };\n      }\n      return item;\n    }));\n  };\n\n  const handleAddChecklistItem = (item: LaunchChecklistItem) => {\n    setLaunchChecklist(prev => [...prev, item]);\n    addToast(\'success\', \'CHECKLIST ITEM ADDED\', `\"${item.label}\" added.`);\n  };\n\n  const handleDeleteChecklistItem = (id: string) => {\n    setLaunchChecklist(prev => prev.filter(i => i.id !== id));\n    addToast(\'info\', \'ITEM REMOVED\', \'Checklist gate removed.\');\n  };\n\n  // If first-time user / onboarding mode:\n  if (isOnboarding && !activeProject) {\n    return (\n      <>\n        <OnboardingScreen\n          onCreateProject={handleCreateProject}\n          onSelectDemo={handleSelectDemo}\n        />\n        <ToastContainer toasts={toasts} onDismiss={dismissToast} />\n      </>\n    );\n  }\n\n  const currentProjectName = activeProject?.name || \'Hackathon Copilot\';\n  const currentHackathonName = activeProject?.hackathonName || \'DoraHacks 2.0\';\n  const currentTeamName = activeProject?.teamName || \'Team DOOM\';\n  const isDemo = Boolean(activeProject?.isDemo);\n\n  return (\n    <div className=\"min-h-screen bg-[#202B2A] text-[#F0F4EE] flex flex-col selection:bg-[#C7F9A6] selection:text-[#202B2A] relative overflow-x-hidden\">\n      {/* Ambient background blur aura */}\n      <div className=\"fixed top-[-100px] right-[-100px] w-[500px] h-[500px] bg-[#A8E6CF] opacity-[0.03] blur-[120px] rounded-full pointer-events-none z-0\" />\n\n      {/* Sidebar Navigation */}\n      <Sidebar\n        activeTab={activeTab}\n        onSelectTab={setActiveTab}\n        scopeCutApplied={scopeCutApplied}\n        isOpenMobile={isMobileMenuOpen}\n        onCloseMobile={() => setIsMobileMenuOpen(false)}\n        projectName={currentProjectName}\n        teamName={currentTeamName}\n        isDemo={isDemo}\n        onOpenProjectSwitcher={() => setIsProjectSwitcherOpen(true)}\n      />\n\n      {/* Main Content Layout with Left Offset for Desktop Sidebar */}\n      <div className=\"lg:pl-64 flex flex-col flex-1 min-w-0 relative z-10\">\n        {/* Mobile Top Header Toggle Bar */}\n        <div className=\"lg:hidden h-14 bg-[#202B2A] border-b border-[#3B4B47] px-4 flex items-center justify-between sticky top-0 z-40\">\n          <button\n            onClick={() => setIsMobileMenuOpen(true)}\n            className=\"p-2 rounded-lg bg-[#293735] text-[#F0F4EE] border border-[#3B4B47] active:scale-95 cursor-pointer\"\n            aria-label=\"Open navigation menu\"\n          >\n            <Menu className=\"w-5 h-5\" />\n          </button>\n          <button \n            onClick={() => setIsProjectSwitcherOpen(true)}\n            className=\"font-mono font-bold text-xs tracking-wider text-[#F0F4EE] flex items-center gap-1.5\"\n          >\n            <span>{currentProjectName}</span>\n            {isDemo && (\n              <span className=\"text-[9px] px-1.5 py-0.2 rounded bg-[#FFE0A3]/20 text-[#FFE0A3]\">\n                DEMO\n              </span>\n            )}\n          </button>\n          <span className=\"text-[10px] font-mono px-2 py-0.5 rounded bg-[#31413F] text-[#A8E6CF]\">\n            {countdownInfo.display}\n          </span>\n        </div>\n\n        {/* Global Top Bar with Functional Real-Time Countdown, Auth & Project Switcher */}\n        <TopBar\n          healthStatus={health.status}\n          onOpenCommandPalette={() => setIsCommandPaletteOpen(true)}\n          onOpenShipMode={() => setIsShipModeOpen(true)}\n          onOpenProjectSwitcher={() => setIsProjectSwitcherOpen(true)}\n          onOpenAuth={() => setIsAuthModalOpen(true)}\n          shipModeReady={launchChecklist.filter(i => i.status === \'COMPLETE\').length >= 6}\n          countdownDisplay={countdownInfo.display}\n          countdownStatus={countdownInfo.status}\n          projectName={currentProjectName}\n          hackathonName={currentHackathonName}\n          isDemo={isDemo}\n        />\n\n        {/* Dynamic Main View Container */}\n        <main className=\"flex-1 px-4 sm:px-8 py-6 sm:py-8 max-w-7xl w-full mx-auto\">\n          {activeTab === \'overview\' && (\n            <OverviewDashboard\n              health={health}\n              scopeItems={scopeItems}\n              activityLogs={activityLogs}\n              scopeCutApplied={scopeCutApplied}\n              onExecuteScopeCut={handleExecuteScopeCut}\n              onResetScopeCut={handleResetScopeCut}\n              onToggleScopeSelect={handleToggleScopeSelect}\n              onRecalculatePlan={handleRecalculatePlan}\n              onOpenReasoning={() => setIsReasoningOpen(true)}\n              onStartNextTask={handleStartNextTask}\n              isTaskActive={isTaskActive}\n              taskActiveSeconds={activeTaskSeconds}\n            />\n          )}\n\n          {activeTab === \'idea-lab\' && (\n            <IdeaLab\n              ideas={ideas}\n              onSelectActiveIdea={handleSelectActiveIdea}\n              onAddGeneratedIdeas={handleAddGeneratedIdeas}\n              onDeleteIdea={handleDeleteIdea}\n              currentProjectName={currentProjectName}\n            />\n          )}\n\n          {activeTab === \'mvp-planner\' && (\n            <MVPPlanner\n              features={mvpFeatures}\n              onChangeFeaturePriority={handleChangeFeaturePriority}\n              onAddFeature={handleAddFeature}\n              onDeleteFeature={handleDeleteFeature}\n              onSetAllFeatures={(newFeats) => setMvpFeatures(newFeats)}\n              onAddTasksFromRoadmap={handleAddTasksFromRoadmap}\n              activeIdeaTitle={currentProjectName}\n              availableHours={Math.max(2, Math.round(secondsRemaining / 3600))}\n              teamSkills={activeProject?.teamSkills || []}\n              teamMembers={dynamicTeamMembers}\n            />\n          )}\n\n          {activeTab === \'tasks\' && (\n            <TaskBoard\n              tasks={tasks}\n              teamMembers={dynamicTeamMembers}\n              onUpdateTaskStatus={handleUpdateTaskStatus}\n              onAddTask={handleAddTask}\n              onDeleteTask={handleDeleteTask}\n              onAddTeamMember={handleAddTeamMember}\n              activeTaskId={activeTaskId}\n              onSetActiveTask={setActiveTaskId}\n            />\n          )}\n\n          {activeTab === \'resources\' && (\n            <ResourcesView\n              resources={resources}\n              onAddResource={handleAddResource}\n              onUpdateResourceUsage={handleUpdateResourceUsage}\n              onDeleteResource={handleDeleteResource}\n              teamSkills={activeProject?.teamSkills || [\'React\', \'TypeScript\', \'Node.js\', \'Tailwind\']}\n              availableHours={Math.max(2, Math.round(secondsRemaining / 3600))}\n            />\n          )}\n\n          {activeTab === \'judge-mode\' && (\n            <JudgeMode\n              evaluation={judgeEval}\n              onToggleFix={handleToggleJudgeFix}\n              onRerunJudge={handleRerunJudge}\n              onUpdateEvaluation={(newEval) => setJudgeEval(newEval)}\n              scopeCutApplied={scopeCutApplied}\n              projectName={currentProjectName}\n              problem={activeProject?.description}\n              solution={currentProjectName}\n              features={mvpFeatures}\n            />\n          )}\n\n          {activeTab === \'launch\' && (\n            <LaunchView\n              checklist={launchChecklist}\n              onToggleStatus={handleToggleLaunchStatus}\n              onAddChecklistItem={handleAddChecklistItem}\n              onDeleteChecklistItem={handleDeleteChecklistItem}\n              onOpenShipMode={() => setIsShipModeOpen(true)}\n              scopeCutApplied={scopeCutApplied}\n              projectName={currentProjectName}\n              problem={activeProject?.description}\n              solution={currentProjectName}\n              features={mvpFeatures}\n            />\n          )}\n        </main>\n      </div>\n\n      {/* Floating Bottom-Right Corner Widget */}\n      <div className=\"fixed bottom-6 right-6 sm:bottom-8 sm:right-8 z-40 flex items-center space-x-3 pointer-events-auto\">\n        <div className=\"bg-[#293735]/85 backdrop-blur-md px-4 py-2 rounded-full border border-white/5 flex items-center space-x-2.5 shadow-2xl\">\n          <span className=\"w-2 h-2 rounded-full bg-[#A8E6CF] animate-pulse\" />\n          <span className=\"text-[10px] font-bold tracking-tight text-[#F0F4EE]\">\n            {isDemo ? \'DEMO MODE\' : \'AI ONLINE\'}\n          </span>\n        </div>\n        <button\n          onClick={() => setIsCommandPaletteOpen(true)}\n          className=\"bg-[#C7F9A6] text-[#202B2A] w-11 h-11 sm:w-12 sm:h-12 rounded-full flex items-center justify-center shadow-[0_0_30px_rgba(199,249,166,0.4)] cursor-pointer hover:scale-105 active:scale-95 transition-transform\"\n          title=\"Open Quick Command Palette (\342\214\230K)\"\n        >\n          <span className=\"text-xs font-black\">\342\214\230K</span>\n        </button>\n      </div>\n\n      {/* Command Palette (\342\214\230K) */}\n      <CommandPalette\n        isOpen={isCommandPaletteOpen}\n        onClose={() => setIsCommandPaletteOpen(false)}\n        onSelectTab={setActiveTab}\n        onTriggerScopeCut={handleExecuteScopeCut}\n        onTriggerShipMode={() => setIsShipModeOpen(true)}\n        onStartNextTask={handleStartNextTask}\n      />\n\n      {/* AI Reasoning Deep Dive Modal */}\n      <ReasoningModal\n        isOpen={isReasoningOpen}\n        onClose={() => setIsReasoningOpen(false)}\n        health={health}\n        scopeCutApplied={scopeCutApplied}\n      />\n\n      {/* Hero Ship Mode Modal */}\n      <ShipModeModal\n        isOpen={isShipModeOpen}\n        onClose={() => setIsShipModeOpen(false)}\n        scopeCutApplied={scopeCutApplied}\n        score={judgeEval?.overallScore || 8.8}\n      />\n\n      {/* Project Switcher Modal */}\n      <ProjectSwitcherModal\n        isOpen={isProjectSwitcherOpen}\n        onClose={() => setIsProjectSwitcherOpen(false)}\n        projects={projectsList}\n        activeProjectId={activeProject?.id || \'\'}\n        onSelectProject={(id) => switchProject(id)}\n        onOpenCreateNew={() => {\n          setIsOnboarding(true);\n          setActiveProject(null);\n        }}\n      />\n\n      {/* Supabase Authentication Modal */}\n      <AuthModal\n        isOpen={isAuthModalOpen}\n        onClose={() => setIsAuthModalOpen(false)}\n        onAuthChange={() => {\n          fetchUserProjects().then(p => {\n            setProjectsList(p);\n            if (p.length > 0) switchProject(p[0].id, p);\n          });\n        }}\n      />\n\n      {/* Global Toast Container */}\n      <ToastContainer toasts={toasts} onDismiss={dismissToast} />\n    </div>\n  );\n}\n"
      }
      num_matches: 1
    }
  }
}
