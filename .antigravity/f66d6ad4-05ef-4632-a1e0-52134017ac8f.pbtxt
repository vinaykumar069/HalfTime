  file_change {
    absolute_path_uri: "file:///src/components/launch/LaunchView.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { \n  Rocket, \n  Sparkles, \n  CheckCircle2, \n  AlertCircle, \n  Clock, \n  ArrowRight,\n  ExternalLink,\n  ShieldCheck,\n  Mic,\n  Copy,\n  Check,\n  RefreshCw,\n  Play,\n  Plus,\n  Trash2,\n  ListOrdered,\n  AlertTriangle,\n  X\n} from \'lucide-react\';\nimport { LaunchChecklistItem, LaunchStatus, MVPFeature } from \'../../types\';\nimport { improvePitch, generateDemoFlow, PitchCoachResult, DemoFlowResult } from \'../../services/aiService\';\n\ninterface LaunchViewProps {\n  checklist: LaunchChecklistItem[];\n  onToggleStatus: (id: string) => void;\n  onAddChecklistItem?: (item: LaunchChecklistItem) => void;\n  onDeleteChecklistItem?: (id: string) => void;\n  onOpenShipMode: () => void;\n  scopeCutApplied: boolean;\n  projectName?: string;\n  problem?: string;\n  solution?: string;\n  features?: MVPFeature[];\n}\n\nexport const LaunchView: React.FC<LaunchViewProps> = ({\n  checklist,\n  onToggleStatus,\n  onAddChecklistItem,\n  onDeleteChecklistItem,\n  onOpenShipMode,\n  scopeCutApplied,\n  projectName = \'Hackathon Project\',\n  problem = \'Hackathon teams waste time on non-demo features.\',\n  solution = \'HALFTIME: AI mission control for hackathons.\',\n  features = [],\n}) => {\n  const [pitchData, setPitchData] = useState<PitchCoachResult | null>({\n    problem: problem || \'Hackathon teams waste 60% of their build time on features judges never click, leading to rushed, broken demos.\',\n    whyItMatters: \'Every weekend, thousands of talented engineers burn out and fail to submit their prototypes.\',\n    solution: solution || \'HALFTIME is the real-time mission control copilot that constantly recalculates runway and ruthlessly cuts scope.\',\n    howItWorks: \'1. Connects to project backlog. 2. Tracks real-time velocity against hackathon deadline. 3. Recommends 1-click feature cuts with 0 demo sacrifice.\',\n    demoMoment: \'In one click, HALFTIME cuts 3 hours of bloat and moves the project from AT RISK to ON TRACK.\',\n    impact: \'Helps 100,000+ hackathon builders globally ship working MVPs on time.\',\n    whyNow: \'LLM reasoning makes instant scope triage possible at zero cognitive overhead.\',\n    script: `Judges, 60% of hackathon teams fail before the finish line. Not because they can\'t code, but because they build the wrong things.\n\nMeet ${projectName}: the AI mission control for hackathon teams.\n\n${projectName} monitors build velocity against the deadline in real time. In one click, we executed a surgical scope cut\342\200\224saving hours of bloat without sacrificing a single judging point.\n\nInstead of an unfinished monolith, we shipped a rock-solid, production-ready product. Stop. Recalculate. Ship.`,\n    durationSeconds: 75,\n    keyTakeaway: \'Don\342\200\231t build more. Ship what matters.\',\n  });\n\n  const [isGeneratingPitch, setIsGeneratingPitch] = useState(false);\n  const [copiedScript, setCopiedScript] = useState(false);\n  const [pitchStep, setPitchStep] = useState(0);\n  const [errorMessage, setErrorMessage] = useState<string | null>(null);\n\n  // Demo Flow State\n  const [isDemoFlowOpen, setIsDemoFlowOpen] = useState(false);\n  const [isGeneratingDemoFlow, setIsGeneratingDemoFlow] = useState(false);\n  const [demoFlowResult, setDemoFlowResult] = useState<DemoFlowResult | null>(null);\n\n  // Custom Checklist Item State\n  const [isAddingItem, setIsAddingItem] = useState(false);\n  const [newLabel, setNewLabel] = useState(\'\');\n  const [newCategory, setNewCategory] = useState<\'Product\' | \'Pitch & Demo\' | \'Distribution\'>(\'Product\');\n  const [newDetail, setNewDetail] = useState(\'\');\n  const [newTime, setNewTime] = useState(\'10m\');\n\n  const pitchSteps = [\n    `Synthesizing judge hook for ${projectName}...`,\n    \'Structuring 3-step mechanics & live demo moment...\',\n    \'Refining 60-90s spoken cadence and timing cues...\',\n    \'Generating final presentation script...\',\n  ];\n\n  const handleGeneratePitch = async () => {\n    setErrorMessage(null);\n    setIsGeneratingPitch(true);\n    setPitchStep(0);\n\n    const timer = setInterval(() => {\n      setPitchStep((prev) => (prev < pitchSteps.length - 1 ? prev + 1 : prev));\n    }, 600);\n\n    try {\n      const res = await improvePitch({\n        projectName,\n        problem,\n        solution,\n        demoMoment: \'Live interactive demo workflow with Gemini 2.5 Flash\',\n        impact: \'Maximized judge demo score and zero submission panic\',\n      });\n      if (res) {\n        setPitchData(res);\n      }\n    } catch (e: any) {\n      setErrorMessage(e?.message || \'HALFTIME AI is temporarily unavailable. Please try again.\');\n    } finally {\n      clearInterval(timer);\n      setIsGeneratingPitch(false);\n    }\n  };\n\n  const handleGenerateDemoFlow = async () => {\n    setErrorMessage(null);\n    setIsGeneratingDemoFlow(true);\n\n    try {\n      const res = await generateDemoFlow({\n        projectName,\n        solution,\n        features,\n      });\n      setDemoFlowResult(res);\n      setIsDemoFlowOpen(true);\n    } catch (e: any) {\n      setErrorMessage(e?.message || \'Failed to generate demo flow with Gemini.\');\n    } finally {\n      setIsGeneratingDemoFlow(false);\n    }\n  };\n\n  const handleCreateChecklistItem = (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!newLabel.trim() || !onAddChecklistItem) return;\n\n    const newItem: LaunchChecklistItem = {\n      id: `check-${Date.now()}`,\n      label: newLabel.trim(),\n      category: newCategory,\n      status: \'NOT_STARTED\',\n      detail: newDetail.trim() || \'User defined launch gate requirement.\',\n      timeToFinish: newTime.trim() || \'10m\',\n    };\n\n    onAddChecklistItem(newItem);\n    setNewLabel(\'\');\n    setNewDetail(\'\');\n    setIsAddingItem(false);\n  };\n\n  const handleCopyScript = () => {\n    if (!pitchData?.script) return;\n    navigator.clipboard.writeText(pitchData.script);\n    setCopiedScript(true);\n    setTimeout(() => setCopiedScript(false), 2000);\n  };\n\n  const completedCount = checklist.filter((item) => item.status === \'COMPLETE\').length;\n  const readinessPercent = checklist.length > 0 ? Math.round((completedCount / checklist.length) * 100) : 0;\n\n  const categories: Array<\'Product\' | \'Pitch & Demo\' | \'Distribution\'> = [\n    \'Product\',\n    \'Pitch & Demo\',\n    \'Distribution\',\n  ];\n\n  return (\n    <div className=\"space-y-8 animate-in fade-in duration-300 pb-12\">\n      {/* Header */}\n      <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-4\">\n        <div>\n          <div className=\"inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#31413F] border border-[#3B4B47] text-xs font-mono text-[#A8DADC] mb-2\">\n            <Rocket className=\"w-3.5 h-3.5\" />\n            <span>SUBMISSION &amp; DEMO DAY GATE</span>\n          </div>\n          <h1 className=\"text-2xl sm:text-4xl font-extrabold text-[#F0F4EE] tracking-tight font-display\">\n            LAUNCH READINESS\n          </h1>\n          <p className=\"text-sm sm:text-base text-[#AAB8B2] mt-1 font-medium\">\n            Lock in all pitch assets, smoke tests, and repository links before the submission clock expires.\n          </p>\n        </div>\n\n        <div className=\"flex flex-wrap items-center gap-2 self-start sm:self-auto\">\n          <button\n            onClick={handleGenerateDemoFlow}\n            disabled={isGeneratingDemoFlow}\n            className=\"flex items-center gap-2 px-4 py-2.5 rounded-xl bg-[#293735] hover:bg-[#31413F] border border-[#3B4B47] text-xs font-mono text-[#F0F4EE] hover:text-[#A8E6CF] transition-all cursor-pointer disabled:opacity-50\"\n          >\n            <ListOrdered className=\"w-3.5 h-3.5 text-[#A8E6CF]\" />\n            <span>{isGeneratingDemoFlow ? \'GENERATING FLOW...\' : \'GENERATE 3-MIN DEMO FLOW\'}</span>\n          </button>\n\n          <button\n            id=\"btn-enter-ship-mode\"\n            onClick={onOpenShipMode}\n            className=\"flex items-center gap-2 px-5 py-2.5 rounded-xl bg-gradient-to-r from-[#C7F9A6] to-[#A8E6CF] text-[#202B2A] font-mono text-xs font-extrabold hover:brightness-110 shadow-md active:scale-95 transition-all cursor-pointer\"\n          >\n            <Sparkles className=\"w-4 h-4 fill-[#202B2A]\" />\n            <span>ENTER SHIP MODE \342\206\222</span>\n          </button>\n        </div>\n      </div>\n\n      {errorMessage && (\n        <div className=\"p-4 rounded-xl bg-[#FFB7B2]/10 border border-[#FFB7B2]/30 flex items-center justify-between gap-3 text-xs text-[#FFB7B2] animate-in fade-in\">\n          <div className=\"flex items-center gap-2.5\">\n            <AlertTriangle className=\"w-4 h-4 shrink-0\" />\n            <span>{errorMessage}</span>\n          </div>\n          <button\n            onClick={handleGeneratePitch}\n            className=\"px-3 py-1 rounded-lg bg-[#FFB7B2]/20 hover:bg-[#FFB7B2]/30 font-mono text-[11px] font-bold text-[#FFB7B2] transition-colors\"\n          >\n            TRY AGAIN\n          </button>\n        </div>\n      )}\n\n      {/* Hero Readiness Dial Card */}\n      <div className=\"p-6 rounded-2xl bg-[#293735] border border-[#3B4B47] shadow-xl flex flex-col md:flex-row md:items-center justify-between gap-6\">\n        <div className=\"flex items-center gap-5\">\n          {/* Radial meter */}\n          <div className=\"relative w-20 h-20 flex items-center justify-center shrink-0\">\n            <svg className=\"w-full h-full -rotate-90\" viewBox=\"0 0 80 80\">\n              <circle cx=\"40\" cy=\"40\" r=\"34\" stroke=\"#202B2A\" strokeWidth=\"7\" fill=\"none\" />\n              <circle\n                cx=\"40\"\n                cy=\"40\"\n                r=\"34\"\n                stroke=\"#C7F9A6\"\n                strokeWidth=\"7\"\n                fill=\"none\"\n                strokeDasharray={2 * Math.PI * 34}\n                strokeDashoffset={2 * Math.PI * 34 * (1 - readinessPercent / 100)}\n                strokeLinecap=\"round\"\n                className=\"transition-all duration-700 ease-out\"\n              />\n            </svg>\n            <span className=\"absolute text-base font-mono font-bold text-[#F0F4EE]\">\n              {readinessPercent}%\n            </span>\n          </div>\n\n          <div>\n            <div className=\"flex items-center gap-2\">\n              <h3 className=\"text-lg font-bold text-[#F0F4EE]\">\n                {readinessPercent === 100\n                  ? \'Ready to Submit\'\n                  : readinessPercent > 60\n                  ? \'Approaching Submission Gate\'\n                  : \'Action Items Pending\'}\n              </h3>\n              <span className=\"text-xs font-mono text-[#71817B]\">\n                ({completedCount}/{checklist.length} Completed)\n              </span>\n            </div>\n            <p className=\"text-xs text-[#AAB8B2] mt-1 max-w-xl\">\n              Complete the critical pre-flight smoke tests, lock repository links, and finalize pitch script before judging begins.\n            </p>\n          </div>\n        </div>\n\n        {scopeCutApplied && (\n          <div className=\"px-4 py-2 rounded-xl bg-[#C7F9A6]/10 border border-[#C7F9A6]/30 text-xs font-mono text-[#C7F9A6] flex items-center gap-2 shrink-0\">\n            <CheckCircle2 className=\"w-4 h-4\" />\n            <span>Scope Cut Verified &amp; Applied</span>\n          </div>\n        )}\n      </div>\n\n      {/* AI Pitch Coach Generator */}\n      <div className=\"p-6 sm:p-8 rounded-3xl bg-[#293735] border border-[#3B4B47] shadow-xl space-y-6\">\n        <div className=\"flex flex-col sm:flex-row sm:items-center justify-between pb-4 border-b border-[#3B4B47] gap-3\">\n          <div className=\"flex items-center gap-2.5\">\n            <div className=\"p-2 rounded-xl bg-[#202B2A] border border-[#3B4B47] text-[#A8E6CF]\">\n              <Mic className=\"w-4 h-4\" />\n            </div>\n            <div>\n              <h2 className=\"text-base font-bold text-[#F0F4EE]\">\n                AI PITCH COACH &amp; SCRIPT\n              </h2>\n              <p className=\"text-xs text-[#71817B]\">\n                High-impact 60-90s narrative crafted for judge retention\n              </p>\n            </div>\n          </div>\n\n          <div className=\"flex items-center gap-2\">\n            <button\n              onClick={handleGeneratePitch}\n              disabled={isGeneratingPitch}\n              className=\"flex items-center gap-2 px-3.5 py-2 rounded-xl bg-[#202B2A] hover:bg-[#31413F] border border-[#3B4B47] text-xs font-mono text-[#A8E6CF] transition-all disabled:opacity-50 cursor-pointer\"\n            >\n              <RefreshCw className={`w-3.5 h-3.5 ${isGeneratingPitch ? \'animate-spin\' : \'\'}`} />\n              <span>{isGeneratingPitch ? \'GENERATING...\' : \'REGENERATE WITH GEMINI\'}</span>\n            </button>\n\n            <button\n              onClick={handleCopyScript}\n              className=\"flex items-center gap-2 px-3.5 py-2 rounded-xl bg-[#C7F9A6] text-[#202B2A] font-mono text-xs font-bold hover:brightness-110 transition-all cursor-pointer\"\n            >\n              {copiedScript ? <Check className=\"w-3.5 h-3.5\" /> : <Copy className=\"w-3.5 h-3.5\" />}\n              <span>{copiedScript ? \'COPIED SCRIPT\' : \'COPY SCRIPT\'}</span>\n            </button>\n          </div>\n        </div>\n\n        {isGeneratingPitch && (\n          <div className=\"p-4 rounded-xl bg-[#202B2A] border border-[#A8E6CF]/40 space-y-2 animate-in fade-in\">\n            <div className=\"flex items-center justify-between text-xs font-mono\">\n              <span className=\"font-bold text-[#A8E6CF] flex items-center gap-2\">\n                <Sparkles className=\"w-3.5 h-3.5 animate-spin\" />\n                HALFTIME IS THINKING...\n              </span>\n              <span className=\"text-[#71817B]\">Step {pitchStep + 1} of 4</span>\n            </div>\n            <p className=\"text-xs text-[#F0F4EE] font-mono\">{pitchSteps[pitchStep]}</p>\n            <div className=\"h-1.5 w-full bg-[#3B4B47] rounded-full overflow-hidden\">\n              <div\n                className=\"h-full bg-gradient-to-r from-[#A8E6CF] to-[#C7F9A6] transition-all duration-500\"\n                style={{ width: `${((pitchStep + 1) / pitchSteps.length) * 100}%` }}\n              />\n            </div>\n          </div>\n        )}\n\n        {pitchData && (\n          <div className=\"space-y-4\">\n            {/* Script Box */}\n            <div className=\"p-5 rounded-2xl bg-[#202B2A] border border-[#3B4B47] space-y-3\">\n              <div className=\"flex items-center justify-between\">\n                <span className=\"text-xs font-mono font-bold text-[#A8E6CF] uppercase\">\n                  VERBATIM SPOKEN SCRIPT\n                </span>\n                <span className=\"text-xs font-mono text-[#71817B]\">\n                  ~{pitchData.durationSeconds}s Spoken Pace ({pitchData.script.split(\' \').length} words)\n                </span>\n              </div>\n              <p className=\"text-xs sm:text-sm text-[#F0F4EE] leading-relaxed whitespace-pre-line font-medium\">\n                {pitchData.script}\n              </p>\n            </div>\n\n            {/* Structured Pitch Matrix */}\n            <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3 text-xs\">\n              <div className=\"p-3 rounded-xl bg-[#202B2A] border border-[#3B4B47] space-y-1\">\n                <span className=\"font-mono text-[10px] text-[#71817B] font-bold block\">1. PROBLEM STATEMENT</span>\n                <p className=\"text-[#AAB8B2]\">{pitchData.problem}</p>\n              </div>\n              <div className=\"p-3 rounded-xl bg-[#202B2A] border border-[#3B4B47] space-y-1\">\n                <span className=\"font-mono text-[10px] text-[#71817B] font-bold block\">2. CORE SOLUTION</span>\n                <p className=\"text-[#AAB8B2]\">{pitchData.solution}</p>\n              </div>\n              <div className=\"p-3 rounded-xl bg-[#202B2A] border border-[#3B4B47] space-y-1\">\n                <span className=\"font-mono text-[10px] text-[#C7F9A6] font-bold block\">3. LIVE DEMO WOW MOMENT</span>\n                <p className=\"text-[#F0F4EE] font-medium\">{pitchData.demoMoment}</p>\n              </div>\n              <div className=\"p-3 rounded-xl bg-[#202B2A] border border-[#3B4B47] space-y-1\">\n                <span className=\"font-mono text-[10px] text-[#71817B] font-bold block\">4. HOW IT WORKS</span>\n                <p className=\"text-[#AAB8B2]\">{pitchData.howItWorks}</p>\n              </div>\n              <div className=\"p-3 rounded-xl bg-[#202B2A] border border-[#3B4B47] space-y-1\">\n                <span className=\"font-mono text-[10px] text-[#71817B] font-bold block\">5. PROJECT IMPACT</span>\n                <p className=\"text-[#AAB8B2]\">{pitchData.impact}</p>\n              </div>\n              <div className=\"p-3 rounded-xl bg-[#202B2A] border border-[#3B4B47] space-y-1\">\n                <span className=\"font-mono text-[10px] text-[#A8DADC] font-bold block\">6. KEY TAKEAWAY</span>\n                <p className=\"text-[#F0F4EE] font-bold\">{pitchData.keyTakeaway}</p>\n              </div>\n            </div>\n          </div>\n        )}\n      </div>\n\n      {/* Interactive Launch Checklist Section */}\n      <div className=\"space-y-6\">\n        <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-4\">\n          <div>\n            <h2 className=\"text-xl font-bold text-[#F0F4EE]\">\n              LAUNCH CHECKLIST\n            </h2>\n            <p className=\"text-xs text-[#71817B]\">\n              Every item is interactive. Check items off or add custom pre-submission gates.\n            </p>\n          </div>\n\n          {onAddChecklistItem && (\n            <button\n              onClick={() => setIsAddingItem(!isAddingItem)}\n              className=\"flex items-center gap-2 px-4 py-2 rounded-xl bg-[#202B2A] hover:bg-[#31413F] border border-[#3B4B47] text-xs font-mono text-[#F0F4EE] hover:text-[#C7F9A6] transition-all cursor-pointer self-start sm:self-auto\"\n            >\n              <Plus className=\"w-3.5 h-3.5 text-[#C7F9A6]\" />\n              <span>ADD CHECKLIST ITEM</span>\n            </button>\n          )}\n        </div>\n\n        {/* Add Item Form */}\n        {isAddingItem && (\n          <form onSubmit={handleCreateChecklistItem} className=\"p-4 rounded-xl bg-[#293735] border border-[#C7F9A6]/40 flex flex-wrap items-center gap-3 animate-in fade-in\">\n            <input\n              type=\"text\"\n              required\n              placeholder=\"Requirement name (e.g. Test video link in incognito mode)...\"\n              value={newLabel}\n              onChange={e => setNewLabel(e.target.value)}\n              className=\"flex-1 min-w-[240px] px-3 py-2 rounded-lg bg-[#202B2A] border border-[#3B4B47] text-xs text-[#F0F4EE] focus:outline-none focus:border-[#C7F9A6]\"\n            />\n            <select\n              value={newCategory}\n              onChange={e => setNewCategory(e.target.value as any)}\n              className=\"px-3 py-2 rounded-lg bg-[#202B2A] border border-[#3B4B47] text-xs text-[#F0F4EE] focus:outline-none\"\n            >\n              <option value=\"Product\">Product</option>\n              <option value=\"Pitch & Demo\">Pitch & Demo</option>\n              <option value=\"Distribution\">Distribution</option>\n            </select>\n            <input\n              type=\"text\"\n              placeholder=\"Est. time (e.g. 5m)\"\n              value={newTime}\n              onChange={e => setNewTime(e.target.value)}\n              className=\"w-24 px-3 py-2 rounded-lg bg-[#202B2A] border border-[#3B4B47] text-xs text-[#F0F4EE] focus:outline-none\"\n            />\n            <button\n              type=\"submit\"\n              className=\"px-4 py-2 rounded-lg bg-[#C7F9A6] text-[#202B2A] text-xs font-mono font-bold hover:brightness-110\"\n            >\n              Add Item\n            </button>\n            <button\n              type=\"button\"\n              onClick={() => setIsAddingItem(false)}\n              className=\"px-3 py-2 rounded-lg text-xs font-mono text-[#71817B] hover:text-[#F0F4EE]\"\n            >\n              Cancel\n            </button>\n          </form>\n        )}\n\n        {/* Categorized Checklist Cards */}\n        <div className=\"grid grid-cols-1 lg:grid-cols-3 gap-6\">\n          {categories.map((cat) => {\n            const catItems = checklist.filter((item) => item.category === cat);\n\n            return (\n              <div\n                key={cat}\n                className=\"p-5 rounded-2xl bg-[#293735] border border-[#3B4B47] flex flex-col justify-between shadow-lg\"\n              >\n                <div>\n                  <div className=\"flex items-center justify-between pb-3 border-b border-[#3B4B47]\">\n                    <span className=\"text-xs font-mono font-bold text-[#F0F4EE] uppercase tracking-wider\">\n                      {cat}\n                    </span>\n                    <span className=\"text-xs font-mono text-[#71817B]\">\n                      {catItems.filter((i) => i.status === \'COMPLETE\').length}/{catItems.length}\n                    </span>\n                  </div>\n\n                  <div className=\"py-3 space-y-2.5\">\n                    {catItems.map((item) => {\n                      const isDone = item.status === \'COMPLETE\';\n\n                      return (\n                        <div\n                          key={item.id}\n                          className={`p-3 rounded-xl border transition-all flex items-start justify-between gap-3 group ${\n                            isDone\n                              ? \'bg-[#202B2A] border-[#C7F9A6]/40\'\n                              : \'bg-[#202B2A]/50 border-[#3B4B47] hover:border-[#71817B]\'\n                          }`}\n                        >\n                          <div \n                            onClick={() => onToggleStatus(item.id)}\n                            className=\"flex items-start gap-2.5 flex-1 cursor-pointer\"\n                          >\n                            <div\n                              className={`w-4 h-4 rounded mt-0.5 flex items-center justify-center border transition-colors shrink-0 ${\n                                isDone\n                                  ? \'bg-[#C7F9A6] border-[#C7F9A6] text-[#202B2A]\'\n                                  : \'border-[#3B4B47]\'\n                              }`}\n                            >\n                              {isDone && <Check className=\"w-3 h-3 stroke-[3]\" />}\n                            </div>\n\n                            <div>\n                              <span\n                                className={`text-xs font-bold block ${\n                                  isDone ? \'line-through text-[#71817B]\' : \'text-[#F0F4EE]\'\n                                }`}\n                              >\n                                {item.label}\n                              </span>\n                              <p className=\"text-[11px] text-[#AAB8B2] mt-0.5 leading-snug\">\n                                {item.detail}\n                              </p>\n                            </div>\n                          </div>\n\n                          <div className=\"flex items-center gap-1.5 shrink-0\">\n                            <span className=\"text-[10px] font-mono text-[#71817B]\">\n                              {item.timeToFinish}\n                            </span>\n                            {onDeleteChecklistItem && (\n                              <button\n                                onClick={() => onDeleteChecklistItem(item.id)}\n                                className=\"text-[#71817B] hover:text-[#FFB7B2] opacity-0 group-hover:opacity-100 transition-opacity p-0.5\"\n                                title=\"Delete item\"\n                              >\n                                <Trash2 className=\"w-3 h-3\" />\n                              </button>\n                            )}\n                          </div>\n                        </div>\n                      );\n                    })}\n                  </div>\n                </div>\n              </div>\n            );\n          })}\n        </div>\n      </div>\n\n      {/* Demo Flow Modal */}\n      {isDemoFlowOpen && demoFlowResult && (\n        <div className=\"fixed inset-0 bg-black/75 z-50 flex items-center justify-center p-4 backdrop-blur-sm animate-in fade-in\">\n          <div className=\"w-full max-w-3xl bg-[#293735] border border-[#3B4B47] rounded-3xl p-6 sm:p-8 shadow-2xl relative max-h-[90vh] overflow-y-auto\">\n            <button\n              onClick={() => setIsDemoFlowOpen(false)}\n              className=\"absolute top-5 right-5 p-1.5 rounded-lg text-[#71817B] hover:text-[#F0F4EE] hover:bg-[#202B2A]\"\n            >\n              <X className=\"w-4 h-4\" />\n            </button>\n\n            <div className=\"flex items-center gap-3 mb-6\">\n              <div className=\"p-3 rounded-2xl bg-[#202B2A] border border-[#3B4B47] text-[#A8E6CF]\">\n                <ListOrdered className=\"w-5 h-5\" />\n              </div>\n              <div>\n                <h2 className=\"text-lg font-bold text-[#F0F4EE]\">3-MINUTE HACKATHON DEMO FLOW</h2>\n                <p className=\"text-xs text-[#71817B]\">Step-by-step presentation blueprint for live judging</p>\n              </div>\n            </div>\n\n            <div className=\"space-y-4 mb-6 text-xs\">\n              <div className=\"p-4 rounded-2xl bg-[#202B2A] border border-[#3B4B47] space-y-2\">\n                <span className=\"text-[10px] font-mono text-[#A8E6CF] font-bold uppercase block\">1. OPENING HOOK (0:00 - 0:20)</span>\n                <p className=\"text-[#F0F4EE] font-medium leading-relaxed\">{demoFlowResult.openingHook}</p>\n              </div>\n\n              <div className=\"p-4 rounded-2xl bg-[#202B2A] border border-[#3B4B47] space-y-2\">\n                <span className=\"text-[10px] font-mono text-[#A8DADC] font-bold uppercase block\">2. PROBLEM SETUP &amp; SOLUTION REVEAL (0:20 - 0:50)</span>\n                <p className=\"text-[#AAB8B2]\">{demoFlowResult.problemSetup}</p>\n                <p className=\"text-[#F0F4EE] font-semibold pt-1 border-t border-[#3B4B47]\">{demoFlowResult.solutionReveal}</p>\n              </div>\n\n              <div className=\"p-4 rounded-2xl bg-[#202B2A] border border-[#3B4B47] space-y-3\">\n                <span className=\"text-[10px] font-mono text-[#C7F9A6] font-bold uppercase block\">3. LIVE DEMO WALKTHROUGH (0:50 - 2:20)</span>\n                <div className=\"space-y-2\">\n                  {demoFlowResult.demoSteps.map((step, idx) => (\n                    <div key={idx} className=\"p-2.5 rounded-xl bg-[#293735] flex items-start gap-2.5\">\n                      <span className=\"w-5 h-5 rounded-full bg-[#C7F9A6] text-[#202B2A] font-bold flex items-center justify-center text-[10px] shrink-0 mt-0.5\">\n                        {step.stepNumber}\n                      </span>\n                      <div className=\"flex-1\">\n                        <div className=\"text-[#F0F4EE] font-bold\">{step.action}</div>\n                        <div className=\"text-[#AAB8B2] mt-0.5 italic\">&ldquo;{step.whatToSay}&rdquo;</div>\n                        <div className=\"text-[10px] font-mono text-[#71817B] mt-1\">Screen: {step.visualCue}</div>\n                      </div>\n                    </div>\n                  ))}\n                </div>\n              </div>\n\n              <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-4\">\n                <div className=\"p-4 rounded-2xl bg-[#202B2A] border border-[#FFE0A3]/30 space-y-1.5\">\n                  <span className=\"text-[10px] font-mono text-[#FFE0A3] font-bold uppercase block\">WOW MOMENT (2:20)</span>\n                  <p className=\"text-[#F0F4EE]\">{demoFlowResult.wowMoment}</p>\n                </div>\n                <div className=\"p-4 rounded-2xl bg-[#202B2A] border border-[#3B4B47] space-y-1.5\">\n                  <span className=\"text-[10px] font-mono text-[#A8DADC] font-bold uppercase block\">TECHNICAL HIGHLIGHTS</span>\n                  <p className=\"text-[#AAB8B2]\">{demoFlowResult.technicalHighlights}</p>\n                </div>\n              </div>\n\n              <div className=\"p-4 rounded-2xl bg-[#202B2A] border border-[#A8E6CF]/30 space-y-1.5\">\n                <span className=\"text-[10px] font-mono text-[#A8E6CF] font-bold uppercase block\">CLOSING CALL TO ACTION (2:50 - 3:00)</span>\n                <p className=\"text-[#F0F4EE] font-bold\">{demoFlowResult.closingCallToAction}</p>\n              </div>\n            </div>\n\n            <div className=\"flex justify-end pt-4 border-t border-[#3B4B47]\">\n              <button\n                onClick={() => setIsDemoFlowOpen(false)}\n                className=\"px-5 py-2 rounded-xl bg-[#C7F9A6] text-[#202B2A] text-xs font-bold font-mono hover:brightness-110\"\n              >\n                Done\n              </button>\n            </div>\n          </div>\n        </div>\n      )}\n    </div>\n  );\n};\n"
    }
