    instruction: "Add stepped loading animation and AI execution to JudgeMode"
    replacement_infos {
      original_chunk {
        target_content: "import { JudgeEvaluation, JudgeFix } from \'../../types\';\n\ninterface JudgeModeProps {\n  evaluation: JudgeEvaluation;\n  onToggleFix: (fixId: number) => void;\n  onRerunJudge: () => void;\n  scopeCutApplied: boolean;\n}\n\nexport const JudgeMode: React.FC<JudgeModeProps> = ({\n  evaluation,\n  onToggleFix,\n  onRerunJudge,\n  scopeCutApplied,\n}) => {\n  const [isAuditing, setIsAuditing] = useState(false);\n\n  const handleRerun = () => {\n    setIsAuditing(true);\n    setTimeout(() => {\n      setIsAuditing(false);\n      onRerunJudge();\n    }, 700);\n  };"
        replacement_content: "import { JudgeEvaluation, JudgeFix } from \'../../types\';\nimport { judgeProject } from \'../../services/aiService\';\n\ninterface JudgeModeProps {\n  evaluation: JudgeEvaluation;\n  onToggleFix: (fixId: number) => void;\n  onRerunJudge: () => void;\n  onUpdateEvaluation?: (ev: JudgeEvaluation) => void;\n  scopeCutApplied: boolean;\n}\n\nexport const JudgeMode: React.FC<JudgeModeProps> = ({\n  evaluation,\n  onToggleFix,\n  onRerunJudge,\n  onUpdateEvaluation,\n  scopeCutApplied,\n}) => {\n  const [isAuditing, setIsAuditing] = useState(false);\n  const [auditStep, setAuditStep] = useState(0);\n\n  const judgeSteps = [\n    \'Auditing DoraHacks 2.0 weighted scoring criteria...\',\n    \'Simulating 180-second judge attention span & retention...\',\n    \'Stress-testing demo failure modes & live risks...\',\n    \'Calibrating pre-submission fixes and bonus recovery...\',\n  ];\n\n  const handleRerun = async () => {\n    setIsAuditing(true);\n    setAuditStep(0);\n\n    const timer = setInterval(() => {\n      setAuditStep((prev) => (prev < judgeSteps.length - 1 ? prev + 1 : prev));\n    }, 600);\n\n    try {\n      const updated = await judgeProject(scopeCutApplied);\n      if (updated && onUpdateEvaluation) {\n        onUpdateEvaluation(updated);\n      } else {\n        onRerunJudge();\n      }\n    } catch (e) {\n      onRerunJudge();\n    } finally {\n      clearInterval(timer);\n      setIsAuditing(false);\n    }\n  };"
      }
      num_matches: 1
    }
  }
}
