  file_change {
    absolute_path_uri: "file:///src/components/tasks/TaskBoard.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { \n  CheckSquare, \n  Plus, \n  Clock, \n  User, \n  Flame, \n  AlertCircle, \n  Play, \n  CheckCircle2, \n  ArrowRight,\n  Filter\n} from \'lucide-react\';\nimport { TaskItem, TaskStatus, TaskPriority, TeamMember } from \'../../types\';\n\ninterface TaskBoardProps {\n  tasks: TaskItem[];\n  teamMembers: TeamMember[];\n  onUpdateTaskStatus: (taskId: string, newStatus: TaskStatus) => void;\n  onAddTask: (task: TaskItem) => void;\n  activeTaskId?: string;\n  onSetActiveTask: (taskId: string) => void;\n}\n\nexport const TaskBoard: React.FC<TaskBoardProps> = ({\n  tasks,\n  teamMembers,\n  onUpdateTaskStatus,\n  onAddTask,\n  activeTaskId,\n  onSetActiveTask,\n}) => {\n  const [filterRole, setFilterRole] = useState<string>(\'ALL\');\n  const [isAddingTask, setIsAddingTask] = useState(false);\n  const [newTitle, setNewTitle] = useState(\'\');\n  const [newOwner, setNewOwner] = useState(\'Alex (Builder)\');\n  const [newPriority, setNewPriority] = useState<TaskPriority>(\'HIGH\');\n  const [newTime, setNewTime] = useState(\'45m\');\n\n  const columns: Array<{ status: TaskStatus; label: string; color: string }> = [\n    { status: \'BACKLOG\', label: \'BACKLOG\', color: \'border-[#71817B]/40 text-[#71817B]\' },\n    { status: \'TODO\', label: \'TODO\', color: \'border-[#A8DADC]/40 text-[#A8DADC]\' },\n    { status: \'IN_PROGRESS\', label: \'IN PROGRESS\', color: \'border-[#C7F9A6]/50 text-[#C7F9A6]\' },\n    { status: \'DONE\', label: \'DONE\', color: \'border-[#B7E4C7]/50 text-[#B7E4C7]\' },\n  ];\n\n  const handleCreateTask = (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!newTitle.trim()) return;\n\n    const newTask: TaskItem = {\n      id: `task-${Date.now()}`,\n      title: newTitle.trim(),\n      owner: newOwner,\n      role: newOwner.includes(\'Builder\') ? \'Builder\' : newOwner.includes(\'Designer\') ? \'Designer\' : newOwner.includes(\'Growth\') ? \'Growth\' : \'Product\',\n      priority: newPriority,\n      status: \'TODO\',\n      estimatedTime: newTime,\n      estimatedMinutes: parseInt(newTime, 10) || 45,\n    };\n\n    onAddTask(newTask);\n    setNewTitle(\'\');\n    setIsAddingTask(false);\n  };\n\n  const filteredTasks = tasks.filter((t) => {\n    if (filterRole === \'ALL\') return true;\n    return t.owner.toLowerCase().includes(filterRole.toLowerCase());\n  });\n\n  return (\n    <div className=\"space-y-8 animate-in fade-in duration-300 pb-12\">\n      {/* Header */}\n      <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-4\">\n        <div>\n          <div className=\"inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#31413F] border border-[#3B4B47] text-xs font-mono text-[#C7F9A6] mb-2\">\n            <CheckSquare className=\"w-3.5 h-3.5\" />\n            <span>SPRINT EXECUTION BOARD</span>\n          </div>\n          <h1 className=\"text-2xl sm:text-4xl font-extrabold text-[#F0F4EE] tracking-tight font-display\">\n            TASKS\n          </h1>\n          <p className=\"text-sm sm:text-base text-[#AAB8B2] mt-1 font-medium\">\n            Prioritize zero-friction live demo delivery. Every ticket directly impacts the 3-minute pitch.\n          </p>\n        </div>\n\n        <button\n          id=\"btn-add-task-modal\"\n          onClick={() => setIsAddingTask(!isAddingTask)}\n          className=\"flex items-center gap-2 px-4 py-2.5 rounded-xl bg-gradient-to-r from-[#C7F9A6] to-[#A8E6CF] text-[#202B2A] font-mono text-xs font-bold hover:brightness-110 shadow-md active:scale-95 transition-all self-start sm:self-auto\"\n        >\n          <Plus className=\"w-4 h-4\" />\n          <span>NEW TASK</span>\n        </button>\n      </div>\n\n      {/* Team Filter & Subtitle */}\n      <div className=\"flex flex-wrap items-center justify-between gap-3 p-4 rounded-xl bg-[#293735] border border-[#3B4B47]\">\n        <div className=\"flex items-center gap-2 text-xs font-mono\">\n          <Filter className=\"w-3.5 h-3.5 text-[#71817B]\" />\n          <span className=\"text-[#71817B]\">Filter Owner:</span>\n          {[\'ALL\', \'Builder\', \'Designer\', \'Product\', \'Growth\'].map((role) => (\n            <button\n              key={role}\n              onClick={() => setFilterRole(role)}\n              className={`px-2.5 py-1 rounded-lg text-xs font-mono transition-all ${\n                filterRole === role\n                  ? \'bg-[#31413F] text-[#F0F4EE] border border-[#C7F9A6]/30\'\n                  : \'text-[#71817B] hover:text-[#F0F4EE]\'\n              }`}\n            >\n              {role}\n            </button>\n          ))}\n        </div>\n\n        <div className=\"flex items-center gap-2 text-xs font-mono text-[#AAB8B2]\">\n          <span className=\"w-2 h-2 rounded-full bg-[#C7F9A6]\" />\n          <span>4 Active Hackers</span>\n        </div>\n      </div>\n\n      {/* Inline Create Form */}\n      {isAddingTask && (\n        <form onSubmit={handleCreateTask} className=\"p-4 rounded-xl bg-[#293735] border border-[#C7F9A6]/40 shadow-xl flex flex-wrap gap-3 items-center animate-in fade-in\">\n          <input\n            type=\"text\"\n            placeholder=\"Task title (e.g. Finish demo video recorder)...\"\n            value={newTitle}\n            onChange={(e) => setNewTitle(e.target.value)}\n            className=\"flex-1 min-w-[240px] px-3 py-2 rounded-lg bg-[#202B2A] border border-[#3B4B47] text-xs text-[#F0F4EE] focus:outline-none focus:border-[#C7F9A6]\"\n          />\n          <select\n            value={newOwner}\n            onChange={(e) => setNewOwner(e.target.value)}\n            className=\"px-3 py-2 rounded-lg bg-[#202B2A] border border-[#3B4B47] text-xs text-[#F0F4EE] focus:outline-none\"\n          >\n            <option value=\"Alex (Builder)\">Alex (Builder)</option>\n            <option value=\"Elena (Designer)\">Elena (Designer)</option>\n            <option value=\"Marcus (Product)\">Marcus (Product)</option>\n            <option value=\"Sam (Growth)\">Sam (Growth)</option>\n          </select>\n          <select\n            value={newPriority}\n            onChange={(e) => setNewPriority(e.target.value as TaskPriority)}\n            className=\"px-3 py-2 rounded-lg bg-[#202B2A] border border-[#3B4B47] text-xs text-[#F0F4EE] focus:outline-none\"\n          >\n            <option value=\"CRITICAL\">CRITICAL</option>\n            <option value=\"HIGH\">HIGH</option>\n            <option value=\"MEDIUM\">MEDIUM</option>\n            <option value=\"LOW\">LOW</option>\n          </select>\n          <input\n            type=\"text\"\n            placeholder=\"Time (e.g. 45m)\"\n            value={newTime}\n            onChange={(e) => setNewTime(e.target.value)}\n            className=\"w-24 px-3 py-2 rounded-lg bg-[#202B2A] border border-[#3B4B47] text-xs text-[#F0F4EE] focus:outline-none\"\n          />\n          <button\n            type=\"submit\"\n            className=\"px-4 py-2 rounded-lg bg-[#C7F9A6] text-[#202B2A] font-mono text-xs font-bold hover:brightness-110\"\n          >\n            Add to Board\n          </button>\n        </form>\n      )}\n\n      {/* 4 Kanban Columns */}\n      <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4\">\n        {columns.map((col) => {\n          const colTasks = filteredTasks.filter((t) => t.status === col.status);\n\n          return (\n            <div\n              key={col.status}\n              className=\"p-4 rounded-2xl bg-[#293735] border border-[#3B4B47] shadow-lg flex flex-col justify-between\"\n            >\n              <div>\n                <div className=\"flex items-center justify-between pb-3 border-b border-[#3B4B47]\">\n                  <span className={`px-2 py-0.5 rounded text-[10px] font-mono font-bold border ${col.color}`}>\n                    {col.label}\n                  </span>\n                  <span className=\"text-xs font-mono text-[#71817B] font-semibold\">\n                    {colTasks.length}\n                  </span>\n                </div>\n\n                <div className=\"space-y-3 mt-3\">\n                  {colTasks.length === 0 ? (\n                    <div className=\"py-8 text-center text-xs font-mono text-[#71817B] border border-dashed border-[#3B4B47] rounded-xl\">\n                      No tasks\n                    </div>\n                  ) : (\n                    colTasks.map((task) => {\n                      const isRunning = activeTaskId === task.id;\n\n                      return (\n                        <div\n                          key={task.id}\n                          className={`p-3.5 rounded-xl border transition-all space-y-2.5 ${\n                            isRunning\n                              ? \'bg-[#31413F] border-[#C7F9A6]/50 shadow-md soft-glow-lime\'\n                              : \'bg-[#202B2A] border-[#3B4B47] hover:border-[#A8E6CF]/30\'\n                          }`}\n                        >\n                          <div className=\"flex items-start justify-between gap-1.5\">\n                            <span className=\"text-xs font-bold text-[#F0F4EE] leading-snug\">\n                              {task.title}\n                            </span>\n                            <span className={`px-1.5 py-0.5 rounded text-[9px] font-mono font-bold shrink-0 ${\n                              task.priority === \'CRITICAL\' \n                                ? \'bg-[#FFB7B2]/20 text-[#FFB7B2]\' \n                                : task.priority === \'HIGH\'\n                                ? \'bg-[#FFE0A3]/20 text-[#FFE0A3]\'\n                                : \'bg-[#293735] text-[#71817B]\'\n                            }`}>\n                              {task.priority}\n                            </span>\n                          </div>\n\n                          {task.reason && (\n                            <p className=\"text-[11px] text-[#71817B] leading-relaxed\">\n                              &ldquo;{task.reason}&rdquo;\n                            </p>\n                          )}\n\n                          <div className=\"pt-2 border-t border-[#3B4B47]/50 flex items-center justify-between text-[11px] font-mono\">\n                            <span className=\"text-[#AAB8B2]\">{task.owner}</span>\n                            <span className=\"text-[#A8E6CF] font-bold\">{task.estimatedTime}</span>\n                          </div>\n\n                          {/* Quick movement buttons */}\n                          <div className=\"pt-1 flex items-center justify-between text-[10px] font-mono\">\n                            {col.status !== \'IN_PROGRESS\' && col.status !== \'DONE\' && (\n                              <button\n                                onClick={() => {\n                                  onUpdateTaskStatus(task.id, \'IN_PROGRESS\');\n                                  onSetActiveTask(task.id);\n                                }}\n                                className=\"flex items-center gap-1 text-[#C7F9A6] hover:underline\"\n                              >\n                                <Play className=\"w-3 h-3\" />\n                                <span>Start Now</span>\n                              </button>\n                            )}\n\n                            {col.status === \'IN_PROGRESS\' && (\n                              <button\n                                onClick={() => onUpdateTaskStatus(task.id, \'DONE\')}\n                                className=\"flex items-center gap-1 text-[#B7E4C7] hover:underline\"\n                              >\n                                <CheckCircle2 className=\"w-3 h-3\" />\n                                <span>Mark Complete</span>\n                              </button>\n                            )}\n\n                            {col.status === \'DONE\' && (\n                              <span className=\"text-[#B7E4C7] flex items-center gap-1\">\n                                <CheckCircle2 className=\"w-3 h-3\" />\n                                <span>Completed</span>\n                              </span>\n                            )}\n\n                            {col.status === \'BACKLOG\' && (\n                              <button\n                                onClick={() => onUpdateTaskStatus(task.id, \'TODO\')}\n                                className=\"text-[#A8DADC] hover:underline ml-auto\"\n                              >\n                                Move to TODO \342\206\222\n                              </button>\n                            )}\n                          </div>\n                        </div>\n                      );\n                    })\n                  )}\n                </div>\n              </div>\n            </div>\n          );\n        })}\n      </div>\n    </div>\n  );\n};\n"
