    replacement_chunks {
      replacement_content: "import { IdeaItem, MVPFeature, ScopeCutItem, JudgeEvaluation, ProjectHealth } from \'../types\';\n\nexport interface IdeaGenerationPrompt {\n  teamSkills: string;\n  frustrations: string;\n  interests: string;\n  targetUsers: string;\n  availableTimeHours: number;\n  hackathonCriteria: string;\n}\n\n/**\n * AI Service Client Interface\n * In this initial frontend build, these return realistic synthesized AI responses.\n * Structured cleanly to swap with real Gemini API server-side endpoints later.\n */\n\nexport async function generateIdeas(input: IdeaGenerationPrompt): Promise<IdeaItem[]> {\n  // Simulate intelligent response delay\n  await new Promise(resolve => setTimeout(resolve, 800));\n\n  const keyword = input.interests || \'AI Developer Tools\';\n\n  return [\n    {\n      id: `idea-gen-${Date.now()}-1`,\n      title: `${keyword} Command Center`,\n      problem: `Teams waste hours on manual context-switching and misaligned milestones during time-compressed ${input.availableTimeHours || 24}h builds.`,\n      targetUser: input.targetUsers || \'Hackathon participants and rapid prototyping teams\',\n      solution: `Real-time AI copilot that monitors commit velocity, cuts bloated features, and ensures a bulletproof judge demo.`,\n      innovationScore: 8.9,\n      problemFitScore: 9.3,\n      feasibilityScore: 8.8,\n      demoPotentialScore: 9.5,\n      verdict: \'BUILD\',\n      verdictReason: `Extremely high demo appeal. Solves a visceral pain point for hackathon judges and organizers.`,\n      tags: [\'Autonomous\', \'High Velocity\', \'AI Agent\'],\n    },\n    {\n      id: `idea-gen-${Date.now()}-2`,\n      title: `PromptTrace: Automated Test Harness for LLMs`,\n      problem: `AI developers struggle to reproduce prompt regression and token explosion during fast iteration cycles.`,\n      targetUser: \'LLM Engineers & Hackathon Builders\',\n      solution: `Single-line SDK interceptor that logs drift, validates schema outputs, and generates automated regression tests.`,\n      innovationScore: 8.4,\n      problemFitScore: 8.7,\n      feasibilityScore: 8.2,\n      demoPotentialScore: 8.1,\n      verdict: \'BUILD\',\n      verdictReason: `Very crisp technical demo with immediate developer utility.`,\n      tags: [\'DevTools\', \'Testing\', \'Reliability\'],\n    },\n    {\n      id: `idea-gen-${Date.now()}-3`,\n      title: `OmniVoice: Universal Meeting Whisperer`,\n      problem: `Remote teams lose context across fragmented video calls and messy chat threads.`,\n      targetUser: \'Distributed teams\',\n      solution: `Passive background bot that detects unassigned action items and cross-references them with Jira.`,\n      innovationScore: 6.8,\n      problemFitScore: 7.2,\n      feasibilityScore: 6.0,\n      demoPotentialScore: 5.9,\n      verdict: \'MODIFY\',\n      verdictReason: `Overcrowded market. Needs a radical twist (e.g. instant code generation from voice) to stand out.`,\n      tags: [\'Audio\', \'Productivity\', \'Red Ocean\'],\n    }\n  ];\n}\n\nexport async function evaluateIdea(idea: Partial<IdeaItem>): Promise<Partial<IdeaItem>> {\n  await new Promise(resolve => setTimeout(resolve, 600));\n\n  const innovation = Number((7.5 + Math.random() * 2).toFixed(1));\n  const problemFit = Number((8.0 + Math.random() * 1.8).toFixed(1));\n  const feasibility = Number((7.0 + Math.random() * 2.5).toFixed(1));\n  const demoPotential = Number((8.0 + Math.random() * 1.8).toFixed(1));\n\n  const avg = (innovation + problemFit + feasibility + demoPotential) / 4;\n  const verdict = avg > 8.2 ? \'BUILD\' : avg > 7.0 ? \'MODIFY\' : \'KILL\';\n\n  return {\n    ...idea,\n    innovationScore: innovation,\n    problemFitScore: problemFit,\n    feasibilityScore: feasibility,\n    demoPotentialScore: demoPotential,\n    verdict,\n    verdictReason: verdict === \'BUILD\' \n      ? \'Strong alignment with judging criteria, clear value proposition, and rapid prototypeability.\' \n      : \'Viable concept but requires substantial simplification to execute reliably in remaining hours.\'\n  };\n}\n\nexport async function generateMVP(ideaTitle: string): Promise<MVPFeature[]> {\n  await new Promise(resolve => setTimeout(resolve, 700));\n\n  return [\n    {\n      id: `mvp-${Date.now()}-1`,\n      name: `Core ${ideaTitle} Engine`,\n      description: \'The single most impressive capability that proves the concept works.\',\n      estimatedHours: 3.0,\n      priority: \'MUST_BUILD\',\n      demoCritical: true,\n      category: \'Core AI\',\n    },\n    {\n      id: `mvp-${Date.now()}-2`,\n      name: \'Real-time Interactive Demo Screen\',\n      description: \'Zero-friction visual UI that judges can watch or test within 30 seconds.\',\n      estimatedHours: 2.0,\n      priority: \'MUST_BUILD\',\n      demoCritical: true,\n      category: \'UI / Polish\',\n    },\n    {\n      id: `mvp-${Date.now()}-3`,\n      name: \'Automated Insight Exporter\',\n      description: \'Generates summary cards or shareable output links.\',\n      estimatedHours: 1.5,\n      priority: \'SHOULD_BUILD\',\n      demoCritical: false,\n      category: \'Infrastructure\',\n    },\n    {\n      id: `mvp-${Date.now()}-4`,\n      name: \'Multi-tenant User Auth & Billing\',\n      description: \'Stripe integration and team role hierarchies.\',\n      estimatedHours: 3.5,\n      priority: \'CUT\',\n      demoCritical: false,\n      category: \'Add-on\',\n    },\n  ];\n}\n\nexport async function recommendNextAction(health: ProjectHealth): Promise<{\n  actionTitle: string;\n  priority: \'CRITICAL\' | \'HIGH\';\n  estimatedTime: string;\n  reason: string;\n}> {\n  await new Promise(resolve => setTimeout(resolve, 400));\n\n  if (health.capacityGapHours > 0) {\n    return {\n      actionTitle: \'Execute scope cut: remove 3h of non-essential features\',\n      priority: \'CRITICAL\',\n      estimatedTime: \'2m\',\n      reason: `You are currently ${health.capacityGapHours}h over capacity. Trimming secondary modules brings your project back into the safe delivery zone.`,\n    };\n  }\n\n  return {\n    actionTitle: \'Finish the core AI evaluation flow\',\n    priority: \'CRITICAL\',\n    estimatedTime: \'1h 20m\',\n    reason: \'Everything else depends on this workflow. Once finished, run judge mode to verify demo scoring.\',\n  };\n}\n\nexport async function recommendScopeCuts(health: ProjectHealth): Promise<ScopeCutItem[]> {\n  await new Promise(resolve => setTimeout(resolve, 500));\n\n  return [\n    {\n      id: \'cut-rec-1\',\n      name: \'Analytics dashboard\',\n      category: \'Reporting & Charts\',\n      timeMinutes: 120,\n      timeFormatted: \'\342\210\2222h\',\n      reason: \'Judges will not click into secondary analytics during a 3-minute pitch. Zero demo impact.\',\n      selectedForCut: true,\n      isCut: false,\n      impactScore: \'0% demo impact\',\n    },\n    {\n      id: \'cut-rec-2\',\n      name: \'Team profiles & bios\',\n      category: \'User Experience\',\n      timeMinutes: 60,\n      timeFormatted: \'\342\210\2221h\',\n      reason: \'Static team badges can be verbally introduced in 10 seconds. Save UI build time.\',\n      selectedForCut: true,\n      isCut: false,\n      impactScore: \'0% demo impact\',\n    },\n    {\n      id: \'cut-rec-3\',\n      name: \'Dark mode customization\',\n      category: \'Styling & Themes\',\n      timeMinutes: 45,\n      timeFormatted: \'\342\210\22245m\',\n      reason: \'Dark theme is already default and polished. Custom theme switchers waste precious testing hours.\',\n      selectedForCut: true,\n      isCut: false,\n      impactScore: \'0% demo impact\',\n    },\n  ];\n}\n\nexport async function judgeProject(scopeCutApplied: boolean): Promise<JudgeEvaluation> {\n  await new Promise(resolve => setTimeout(resolve, 600));\n\n  const baseScore = scopeCutApplied ? 9.2 : 8.55;\n\n  return {\n    overallScore: baseScore,\n    statusLabel: scopeCutApplied ? \'STRONG CONTENDER\' : \'BUILD IT\',\n    summaryFeedback: scopeCutApplied\n      ? \'Exceptional focus on core value delivery. The project has eliminated bloat and presents a razor-sharp demo narrative.\'\n      : \'Compelling hackathon thesis with undeniable judge empathy. Sharp interface and instant utility. The before/after contrast is striking.\',\n    criteria: [\n      { name: \'Innovation\', weight: 25, score: scopeCutApplied ? 9.3 : 8.7, feedback: \'Novel paradigm for active hackathon triage rather than generic chat.\' },\n      { name: \'Problem Fit\', weight: 20, score: scopeCutApplied ? 9.6 : 9.2, feedback: \'Directly solves the #1 reason hackathon teams fail (poor scope management).\' },\n      { name: \'Usability\', weight: 20, score: scopeCutApplied ? 9.1 : 8.1, feedback: \'High contrast and clear CTA hierarchy. Micro-interactions feel natural.\' },\n      { name: \'Execution\', weight: 15, score: scopeCutApplied ? 9.4 : 8.4, feedback: \'Fast, responsive, and mathematically coherent timeline calculations.\' },\n      { name: \'Impact\', weight: 10, score: scopeCutApplied ? 8.6 : 7.8, feedback: \'Broad addressable developer market; potential commercial SaaS applicability.\' },\n      { name: \'Feasibility\', weight: 10, score: scopeCutApplied ? 9.8 : 9.1, feedback: \'No unfeasible dependencies; robust architecture.\' },\n    ],\n    whyYouMightLose: scopeCutApplied \n      ? \'Ensure your 3-minute pitch starts directly with the problem statement before showing the live demo.\'\n      : \'Your problem is strong, but your demo takes too long to reach the core value. If judges do not see the Scope Cutter recalculation within the first 45 seconds, attention will drift.\',\n    fixes: [\n      {\n        id: 1,\n        title: \'Shorten onboarding to 0 clicks\',\n        description: \'Pre-seed sample DoraHacks telemetry immediately so judges see the 3h gap instantly.\',\n        scoreBonus: 0.35,\n        applied: true,\n      },\n      {\n        id: 2,\n        title: \'Demo the core workflow first\',\n        description: \'Trigger the \"Cut Selected Features\" animation within the first 30 seconds of the presentation.\',\n        scoreBonus: 0.25,\n        applied: scopeCutApplied,\n      },\n      {\n        id: 3,\n        title: \'Remove unnecessary analytics & profiles\',\n        description: \'Execute the scope cut to prove disciplined engineering priorities to senior judges.\',\n        scoreBonus: 0.15,\n        applied: scopeCutApplied,\n      },\n    ],\n  };\n}\n"
    }
