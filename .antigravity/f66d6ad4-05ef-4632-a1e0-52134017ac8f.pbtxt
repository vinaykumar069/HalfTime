      target_content: "import React from \'react\';\n\ninterface BrandLogoProps {\n  size?: \'sm\' | \'md\' | \'lg\' | \'xl\';\n  showLabel?: boolean;\n  animated?: boolean;\n}\n\nexport const BrandLogo: React.FC<BrandLogoProps> = ({ \n  size = \'md\', \n  showLabel = true,\n  animated = false \n}) => {\n  const sizeMap = {\n    sm: { icon: \'w-6 h-6\', text: \'text-sm font-bold tracking-wider\', markH: 24, markW: 24 },\n    md: { icon: \'w-8 h-8\', text: \'text-base font-bold tracking-wider\', markH: 32, markW: 32 },\n    lg: { icon: \'w-10 h-10\', text: \'text-xl font-extrabold tracking-wide\', markH: 40, markW: 40 },\n    xl: { icon: \'w-14 h-14\', text: \'text-3xl font-extrabold tracking-wide\', markH: 56, markW: 56 },\n  };\n\n  const current = sizeMap[size];\n\n  return (\n    <div className=\"flex items-center gap-3 select-none\">\n      {/* Abstract H-mark with Pause/Recalculate/Move interruption and pastel rainbow gradient */}\n      <div \n        id=\"halftime-brand-mark\"\n        className={`relative ${current.icon} flex items-center justify-center rounded-lg bg-[#293735] border border-[#3B4B47] shadow-inner overflow-hidden group`}\n      >\n        {/* Subtle background glow */}\n        <div className=\"absolute inset-0 bg-gradient-to-tr from-[#FFB7B2]/20 via-[#FFE0A3]/20 via-[#C7F9A6]/20 via-[#A8E6CF]/20 to-[#CDB4DB]/20 opacity-80 group-hover:opacity-100 transition-opacity\" />\n        \n        {/* SVG geometric H with interruption */}\n        <svg \n          viewBox=\"0 0 48 48\" \n          fill=\"none\" \n          xmlns=\"http://www.w3.org/2000/svg\"\n          className={`w-full h-full p-1.5 ${animated ? \'animate-pulse-subtle\' : \'\'}`}\n        >\n          <defs>\n            <linearGradient id=\"halftime-rainbow-left\" x1=\"0%\" y1=\"0%\" x2=\"0%\" y2=\"100%\">\n              <stop offset=\"0%\" stopColor=\"#FFB7B2\" />\n              <stop offset=\"50%\" stopColor=\"#FFE0A3\" />\n              <stop offset=\"100%\" stopColor=\"#C7F9A6\" />\n            </linearGradient>\n            <linearGradient id=\"halftime-rainbow-right\" x1=\"0%\" y1=\"0%\" x2=\"0%\" y2=\"100%\">\n              <stop offset=\"0%\" stopColor=\"#A8DADC\" />\n              <stop offset=\"50%\" stopColor=\"#B8DDF0\" />\n              <stop offset=\"100%\" stopColor=\"#CDB4DB\" />\n            </linearGradient>\n            <linearGradient id=\"halftime-center-cross\" x1=\"0%\" y1=\"0%\" x2=\"100%\" y2=\"0%\">\n              <stop offset=\"0%\" stopColor=\"#C7F9A6\" />\n              <stop offset=\"50%\" stopColor=\"#A8E6CF\" />\n              <stop offset=\"100%\" stopColor=\"#A8DADC\" />\n            </linearGradient>\n          </defs>\n\n          {/* Left Vertical Pillar */}\n          <rect x=\"8\" y=\"8\" width=\"6\" height=\"32\" rx=\"3\" fill=\"url(#halftime-rainbow-left)\" />\n\n          {/* Right Vertical Pillar */}\n          <rect x=\"34\" y=\"8\" width=\"6\" height=\"32\" rx=\"3\" fill=\"url(#halftime-rainbow-right)\" />\n\n          {/* Interrupted Center Bridge: Left Segment (Pause) */}\n          <rect x=\"14\" y=\"21\" width=\"6\" height=\"6\" rx=\"2\" fill=\"url(#halftime-center-cross)\" />\n\n          {/* Recalculate diamond pulse in the gap */}\n          <circle cx=\"24\" cy=\"24\" r=\"3.5\" fill=\"#C7F9A6\" className=\"animate-pulse\" />\n\n          {/* Interrupted Center Bridge: Right Segment (Move) */}\n          <rect x=\"28\" y=\"21\" width=\"6\" height=\"6\" rx=\"2\" fill=\"url(#halftime-center-cross)\" />\n        </svg>\n      </div>\n\n      {showLabel && (\n        <div className=\"flex flex-col\">\n          <div className=\"flex items-center gap-1.5\">\n            <span className={`font-mono ${current.text} text-[#F0F4EE] leading-none`}>\n              HALFTIME\n            </span>\n          </div>\n          <span className=\"text-[10px] font-mono tracking-widest text-[#71817B] uppercase font-semibold mt-0.5\">\n            HACKATHON OS\n          </span>\n        </div>\n      )}\n    </div>\n  );\n};"
      replacement_content: "import React from \'react\';\n\ninterface BrandLogoProps {\n  size?: \'sm\' | \'md\' | \'lg\' | \'xl\';\n  showLabel?: boolean;\n  animated?: boolean;\n}\n\nexport const BrandLogo: React.FC<BrandLogoProps> = ({ \n  size = \'md\', \n  showLabel = true,\n  animated = false \n}) => {\n  return (\n    <div className=\"flex items-center space-x-3 select-none\">\n      {/* Artistic Flair brand mark */}\n      <div className=\"relative w-8 h-8 flex items-center justify-center shrink-0\">\n        <div className=\"absolute inset-0 bg-gradient-to-tr from-[#FFB7B2] via-[#C7F9A6] to-[#A8DADC] rounded-sm opacity-80\" />\n        <div className=\"z-10 w-full h-full flex items-center justify-center bg-[#202B2A] scale-90\">\n          <div className=\"flex space-x-[2px] items-end\">\n            <div className=\"w-2 h-5 bg-gradient-to-t from-[#FFB7B2] to-[#FFE0A3]\" />\n            <div className=\"w-2 h-3 bg-gradient-to-t from-[#A8E6CF] to-[#C7F9A6] mt-2\" />\n            <div className=\"w-2 h-5 bg-gradient-to-t from-[#B8DDF0] to-[#CDB4DB]\" />\n          </div>\n        </div>\n      </div>\n\n      {showLabel && (\n        <div>\n          <h1 className=\"text-lg font-bold tracking-tight leading-none text-[#F0F4EE]\">\n            HALFTIME\n          </h1>\n          <p className=\"text-[9px] uppercase tracking-[0.2em] text-[#71817B] font-semibold mt-1\">\n            Hackathon OS\n          </p>\n        </div>\n      )}\n    </div>\n  );\n};\n"
    }
