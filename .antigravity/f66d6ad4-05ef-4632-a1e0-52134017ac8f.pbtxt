    replacement_chunks {
      target_content: "import React, { useState, useEffect } from \'react\';\nimport { \n  Sparkles, \n  Clock, \n  AlertTriangle, \n  CheckCircle2, \n  ArrowRight, \n  Play, \n  Check, \n  Scissors, \n  Layers, \n  TrendingUp, \n  ShieldCheck, \n  Cpu, \n  Info, \n  HelpCircle,\n  BarChart3,\n  RefreshCw,\n  Flame,\n  Zap\n} from \'lucide-react\';\nimport { ProjectHealth, ScopeCutItem, ActivityTimelineItem } from \'../../types\';\nimport confetti from \'canvas-confetti\';\n\ninterface OverviewDashboardProps {\n  health: ProjectHealth;\n  scopeItems: ScopeCutItem[];\n  activityLogs: ActivityTimelineItem[];\n  scopeCutApplied: boolean;\n  onExecuteScopeCut: () => void;\n  onToggleScopeSelect: (id: string) => void;\n  onRecalculatePlan: () => void;\n  onOpenReasoning: () => void;\n  onStartNextTask: () => void;\n  isTaskActive: boolean;\n  taskActiveSeconds: number;\n}\n\nexport const OverviewDashboard: React.FC<OverviewDashboardProps> = ({\n  health,\n  scopeItems,\n  activityLogs,\n  scopeCutApplied,\n  onExecuteScopeCut,\n  onToggleScopeSelect,\n  onRecalculatePlan,\n  onOpenReasoning,\n  onStartNextTask,\n  isTaskActive,\n  taskActiveSeconds,\n}) => {\n  const [isRecalculating, setIsRecalculating] = useState(false);\n\n  // Calculate selected recoverable minutes\n  const selectedMinutes = scopeItems\n    .filter((item) => item.selectedForCut && !item.isCut)\n    .reduce((acc, curr) => acc + curr.timeMinutes, 0);\n\n  const selectedFormatted = `${Math.floor(selectedMinutes / 60)}h ${selectedMinutes % 60 ? `${selectedMinutes % 60}m` : \'\'}`.trim();\n\n  const handleRecalculateClick = () => {\n    setIsRecalculating(true);\n    setTimeout(() => {\n      setIsRecalculating(false);\n      onRecalculatePlan();\n    }, 600);\n  };\n\n  const formatActiveTimer = (sec: number) => {\n    const m = Math.floor(sec / 60);\n    const s = sec % 60;\n    return `${m.toString().padStart(2, \'0\')}:${s.toString().padStart(2, \'0\')}`;\n  };\n\n  return (\n    <div className=\"space-y-6 sm:space-y-8 animate-in fade-in duration-300 pb-12\">\n      {/* 1. HERO SECTION */}\n      <div id=\"overview-hero\" className=\"flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4\">\n        <div>\n          <div className=\"inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#31413F] border border-[#3B4B47] text-xs font-mono text-[#A8E6CF] mb-2\">\n            <span className=\"w-1.5 h-1.5 rounded-full bg-[#A8E6CF] animate-ping\" />\n            <span>HACKATHON MIDPOINT TELEMETRY</span>\n          </div>\n          <h1 className=\"text-2xl sm:text-4xl font-extrabold text-[#F0F4EE] tracking-tight font-display\">\n            You&apos;re in the second half.\n          </h1>\n          <p className=\"text-sm sm:text-base text-[#AAB8B2] mt-1 font-medium\">\n            Here&apos;s what matters right now.\n          </p>\n        </div>\n\n        {/* Live Health Dial & Gap Snapshot */}\n        <div className=\"flex items-center gap-3 sm:gap-4 bg-[#293735]/80 p-3 sm:p-4 rounded-2xl border border-[#3B4B47] glass-panel self-start lg:self-auto\">\n          {/* Radial visualizer */}\n          <div className=\"relative w-16 h-16 sm:w-20 sm:h-20 flex items-center justify-center\">\n            <svg className=\"w-full h-full -rotate-90\" viewBox=\"0 0 80 80\">\n              <circle\n                cx=\"40\"\n                cy=\"40\"\n                r=\"34\"\n                stroke=\"#3B4B47\"\n                strokeWidth=\"6\"\n                fill=\"none\"\n              />\n              <circle\n                cx=\"40\"\n                cy=\"40\"\n                r=\"34\"\n                stroke={scopeCutApplied ? \'#B7E4C7\' : \'#FFB7B2\'}\n                strokeWidth=\"6\"\n                strokeDasharray={213}\n                strokeDashoffset={213 - (213 * health.score) / 100}\n                strokeLinecap=\"round\"\n                fill=\"none\"\n                className=\"transition-all duration-700 ease-out\"\n              />\n            </svg>\n            <div className=\"absolute inset-0 flex flex-col items-center justify-center text-center\">\n              <span className=\"font-mono font-bold text-sm sm:text-lg text-[#F0F4EE] leading-none\">\n                {health.score}%\n              </span>\n              <span className={`text-[9px] sm:text-[10px] font-mono font-bold uppercase mt-0.5 ${\n                scopeCutApplied ? \'text-[#B7E4C7]\' : \'text-[#FFB7B2]\'\n              }`}>\n                {scopeCutApplied ? \'ON TRACK\' : \'AT RISK\'}\n              </span>\n            </div>\n          </div>\n\n          <div className=\"h-12 w-[1px] bg-[#3B4B47]\" />\n\n          {/* Key metrics metrics column */}\n          <div className=\"grid grid-cols-3 gap-3 sm:gap-4 text-left\">\n            <div>\n              <div className=\"text-[10px] font-mono text-[#71817B]\">TIME LEFT</div>\n              <div className=\"text-sm sm:text-base font-mono font-bold text-[#F0F4EE]\">11h</div>\n            </div>\n            <div>\n              <div className=\"text-[10px] font-mono text-[#71817B]\">WORK LEFT</div>\n              <div className={`text-sm sm:text-base font-mono font-bold ${scopeCutApplied ? \'text-[#B7E4C7]\' : \'text-[#FFB7B2]\'}`}>\n                {health.workRequiredHours === 10.25 ? \'10h 15m\' : `${health.workRequiredHours}h`}\n              </div>\n            </div>\n            <div>\n              <div className=\"text-[10px] font-mono text-[#71817B]\">CAPACITY GAP</div>\n              <div className={`text-sm sm:text-base font-mono font-bold ${scopeCutApplied ? \'text-[#C7F9A6]\' : \'text-[#FFB7B2]\'}`}>\n                {scopeCutApplied ? \'0h (Safe)\' : \'3h\'}\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n\n      {/* 2. FLOATING AI RECOMMENDATION PANEL */}\n      <div \n        id=\"overview-ai-recommendation\"\n        className=\"relative overflow-hidden rounded-2xl border p-5 sm:p-6 transition-all glass-panel-ai\"\n      >\n        {/* Subtle mint/cyan ambient aurora light */}\n        <div className=\"absolute top-0 right-0 w-80 h-40 bg-gradient-to-bl from-[#A8E6CF]/15 via-[#A8DADC]/10 to-transparent blur-2xl pointer-events-none\" />\n\n        <div className=\"relative z-10 flex flex-col md:flex-row md:items-center justify-between gap-4\">\n          <div className=\"space-y-2 max-w-3xl\">\n            <div className=\"flex items-center gap-2\">\n              <div className=\"w-2.5 h-2.5 rounded-full bg-[#A8E6CF] animate-pulse\" />\n              <span className=\"text-xs font-mono font-bold tracking-widest text-[#A8E6CF] uppercase\">\n                HALFTIME SAYS\n              </span>\n              <span className=\"px-2 py-0.5 text-[10px] font-mono rounded bg-[#202B2A]/80 border border-[#3B4B47] text-[#AAB8B2]\">\n                {scopeCutApplied ? \'PLAN OPTIMIZED\' : \'INTERVENTION REQUIRED\'}\n              </span>\n            </div>\n\n            <p className=\"text-base sm:text-lg font-semibold text-[#F0F4EE] leading-snug\">\n              {scopeCutApplied ? (\n                <span>\n                  &ldquo;Scope streamlined. <strong className=\"text-[#C7F9A6]\">3h 45m recovered</strong>. You have 45m buffer. Focus 100% on finishing the core AI evaluation flow and testing the 3-minute pitch.&rdquo;\n                </span>\n              ) : (\n                <span>\n                  &ldquo;You&apos;re <strong className=\"text-[#FFB7B2]\">3 hours over capacity</strong>. Cut analytics and team profiles. Finish the core AI evaluation flow first.&rdquo;\n                </span>\n              )}\n            </p>\n          </div>\n\n          <div className=\"flex items-center gap-2.5 self-start md:self-auto shrink-0\">\n            <button\n              id=\"btn-recalculate-plan\"\n              onClick={handleRecalculateClick}\n              disabled={isRecalculating}\n              className=\"flex items-center gap-1.5 px-3.5 py-2 rounded-xl bg-[#293735] hover:bg-[#31413F] border border-[#3B4B47] hover:border-[#A8E6CF]/40 text-xs font-mono text-[#F0F4EE] transition-all active:scale-95\"\n            >\n              <RefreshCw className={`w-3.5 h-3.5 text-[#A8E6CF] ${isRecalculating ? \'animate-spin\' : \'\'}`} />\n              <span>{isRecalculating ? \'Recalculating...\' : \'RECALCULATE PLAN\'}</span>\n            </button>\n\n            <button\n              id=\"btn-view-reasoning\"\n              onClick={onOpenReasoning}\n              className=\"flex items-center gap-1.5 px-3.5 py-2 rounded-xl bg-[#31413F] hover:bg-[#3B4B47] border border-[#A8E6CF]/20 text-xs font-mono text-[#A8E6CF] transition-all active:scale-95\"\n            >\n              <Info className=\"w-3.5 h-3.5\" />\n              <span>VIEW REASONING</span>\n            </button>\n          </div>\n        </div>\n      </div>\n\n      {/* 3. NEXT ACTION & TIME PRESSURE COMPARISON */}\n      <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-5 sm:gap-6\">\n        {/* YOUR NEXT MOVE (Hero Action) */}\n        <div \n          id=\"overview-next-action\"\n          className=\"lg:col-span-6 p-5 sm:p-6 rounded-2xl bg-[#293735] border border-[#3B4B47] shadow-lg flex flex-col justify-between relative overflow-hidden group\"\n        >\n          {/* Subtle glow border */}\n          <div className=\"absolute inset-0 bg-gradient-to-r from-[#C7F9A6]/5 to-transparent pointer-events-none\" />\n\n          <div>\n            <div className=\"flex items-center justify-between mb-3\">\n              <span className=\"text-[11px] font-mono font-bold tracking-widest text-[#71817B] uppercase\">\n                YOUR NEXT MOVE\n              </span>\n              <span className=\"px-2 py-0.5 text-[10px] font-mono font-bold rounded-md bg-[#FFB7B2]/20 text-[#FFB7B2] border border-[#FFB7B2]/30\">\n                CRITICAL \342\200\242 1h 20m\n              </span>\n            </div>\n\n            <h3 className=\"text-lg sm:text-xl font-bold text-[#F0F4EE] group-hover:text-[#C7F9A6] transition-colors\">\n              Finish the core AI evaluation flow\n            </h3>\n            \n            <p className=\"text-xs text-[#AAB8B2] mt-2 leading-relaxed\">\n              &ldquo;Everything else depends on this workflow. Once finished, run Judge Mode to benchmark live demo scoring.&rdquo;\n            </p>\n          </div>\n\n          <div className=\"pt-5 mt-4 border-t border-[#3B4B47] flex items-center justify-between\">\n            <div className=\"flex items-center gap-2 text-xs font-mono text-[#71817B]\">\n              <Clock className=\"w-3.5 h-3.5 text-[#C7F9A6]\" />\n              <span>Assigned: Alex (Builder)</span>\n            </div>\n\n            <button\n              id=\"btn-start-next-action\"\n              onClick={onStartNextTask}\n              className={`flex items-center gap-2 px-4 py-2 rounded-xl font-mono text-xs font-bold transition-all shadow-md active:scale-95 ${\n                isTaskActive \n                  ? \'bg-[#202B2A] text-[#C7F9A6] border border-[#C7F9A6]/50 soft-glow-lime\' \n                  : \'bg-[#C7F9A6] text-[#202B2A] hover:brightness-110\'\n              }`}\n            >\n              {isTaskActive ? (\n                <>\n                  <span className=\"w-2 h-2 rounded-full bg-[#C7F9A6] animate-ping\" />\n                  <span>IN PROGRESS ({formatActiveTimer(taskActiveSeconds)})</span>\n                </>\n              ) : (\n                <>\n                  <span>START TASK</span>\n                  <ArrowRight className=\"w-3.5 h-3.5\" />\n                </>\n              )}\n            </button>\n          </div>\n        </div>\n\n        {/* TIME PRESSURE VISUALIZATION */}\n        <div \n          id=\"overview-time-pressure\"\n          className=\"lg:col-span-6 p-5 sm:p-6 rounded-2xl bg-[#293735] border border-[#3B4B47] shadow-lg flex flex-col justify-between\"\n        >\n          <div className=\"flex items-center justify-between mb-2\">\n            <span className=\"text-[11px] font-mono font-bold tracking-widest text-[#71817B] uppercase\">\n              TIME PRESSURE VISUALIZATION\n            </span>\n            <span className={`text-[11px] font-mono font-bold px-2 py-0.5 rounded ${\n              scopeCutApplied ? \'bg-[#B7E4C7]/20 text-[#B7E4C7]\' : \'bg-[#FFB7B2]/20 text-[#FFB7B2]\'\n            }`}>\n              {scopeCutApplied ? \'DELIVERY FEASIBLE\' : \'3h OVER CAPACITY\'}\n            </span>\n          </div>\n\n          {/* Visual Timeline Comparison Bars */}\n          <div className=\"space-y-4 my-auto py-2\">\n            {/* Time Available Bar */}\n            <div className=\"space-y-1.5\">\n              <div className=\"flex justify-between text-xs font-mono\">\n                <span className=\"text-[#AAB8B2]\">TIME AVAILABLE (RUNWAY)</span>\n                <span className=\"text-[#F0F4EE] font-bold\">11h 00m</span>\n              </div>\n              <div className=\"h-3 rounded-full bg-[#202B2A] p-0.5 border border-[#3B4B47] overflow-hidden\">\n                <div className=\"h-full rounded-full bg-gradient-to-r from-[#A8DADC] to-[#B8DDF0] w-[78%]\" />\n              </div>\n            </div>\n\n            {/* Work Required Bar */}\n            <div className=\"space-y-1.5\">\n              <div className=\"flex justify-between text-xs font-mono\">\n                <span className=\"text-[#AAB8B2]\">WORK REQUIRED (BACKLOG)</span>\n                <span className={`font-bold ${scopeCutApplied ? \'text-[#B7E4C7]\' : \'text-[#FFB7B2]\'}`}>\n                  {scopeCutApplied ? \'10h 15m\' : \'14h 00m\'}\n                </span>\n              </div>\n              <div className=\"h-3 rounded-full bg-[#202B2A] p-0.5 border border-[#3B4B47] overflow-hidden\">\n                <div \n                  className={`h-full rounded-full transition-all duration-700 ease-out ${\n                    scopeCutApplied \n                      ? \'bg-gradient-to-r from-[#C7F9A6] to-[#B7E4C7] w-[73%]\' \n                      : \'bg-gradient-to-r from-[#FFE0A3] to-[#FFB7B2] w-[100%]\'\n                  }`} \n                />\n              </div>\n            </div>\n          </div>\n\n          <div className=\"pt-3 border-t border-[#3B4B47] flex items-center justify-between text-xs\">\n            <span className=\"text-[#71817B] font-mono\">Runway Buffer:</span>\n            <span className={`font-mono font-bold ${scopeCutApplied ? \'text-[#C7F9A6]\' : \'text-[#FFB7B2]\'}`}>\n              {scopeCutApplied ? \'+45m Rehearsal Buffer\' : \'\342\210\2223h 00m Deficit\'}\n            </span>\n          </div>\n        </div>\n      </div>\n\n      {/* 4. SCOPE CUTTER \342\200\224 HERO INTERACTION */}\n      <div \n        id=\"overview-scope-cutter\"\n        className={`p-5 sm:p-6 rounded-2xl border transition-all ${\n          scopeCutApplied \n            ? \'bg-[#293735]/90 border-[#B7E4C7]/40 shadow-[0_0_30px_-5px_rgba(183,228,199,0.15)]\' \n            : \'bg-[#293735] border-[#3B4B47] shadow-xl\'\n        }`}\n      >\n        <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-4 border-b border-[#3B4B47]\">\n          <div>\n            <div className=\"flex items-center gap-2\">\n              <Scissors className={`w-4 h-4 ${scopeCutApplied ? \'text-[#B7E4C7]\' : \'text-[#C7F9A6]\'}`} />\n              <h2 className=\"text-base sm:text-lg font-bold text-[#F0F4EE] font-mono\">\n                CUT BEFORE YOU BUILD\n              </h2>\n            </div>\n            <p className=\"text-xs text-[#AAB8B2] mt-0.5\">\n              Recover time without hurting the 3-minute demo score.\n            </p>\n          </div>\n\n          {/* Recoverable Time Pill */}\n          <div className=\"flex items-center gap-3\">\n            <div className=\"text-right\">\n              <div className=\"text-[10px] font-mono text-[#71817B]\">RECOVERABLE TIME</div>\n              <div className={`text-base font-mono font-extrabold ${scopeCutApplied ? \'text-[#B7E4C7]\' : \'text-[#C7F9A6]\'}`}>\n                {scopeCutApplied ? \'3h 45m Recovered\' : selectedFormatted}\n              </div>\n            </div>\n\n            {!scopeCutApplied && (\n              <button\n                id=\"btn-cut-selected-features\"\n                onClick={onExecuteScopeCut}\n                disabled={selectedMinutes === 0}\n                className=\"px-4 py-2.5 rounded-xl bg-gradient-to-r from-[#C7F9A6] to-[#A8E6CF] hover:brightness-110 text-[#202B2A] font-mono text-xs font-bold transition-all shadow-md active:scale-95 disabled:opacity-50 disabled:cursor-not-allowed flex items-center gap-1.5\"\n              >\n                <Scissors className=\"w-3.5 h-3.5\" />\n                <span>CUT SELECTED FEATURES</span>\n              </button>\n            )}\n          </div>\n        </div>\n\n        {/* State Banner when Cut Applied */}\n        {scopeCutApplied && (\n          <div className=\"my-4 p-3.5 rounded-xl bg-[#B7E4C7]/15 border border-[#B7E4C7]/30 flex items-center justify-between animate-in zoom-in-95\">\n            <div className=\"flex items-center gap-2.5 text-xs text-[#F0F4EE]\">\n              <CheckCircle2 className=\"w-4 h-4 text-[#B7E4C7] shrink-0\" />\n              <span>\n                <strong className=\"text-[#B7E4C7]\">3h 45m recovered.</strong> You&apos;re back on track with 45m pitch buffer.\n              </span>\n            </div>\n            <span className=\"text-[10px] font-mono text-[#B7E4C7] uppercase font-bold px-2 py-0.5 rounded bg-[#202B2A]/50\">\n              OPTIMIZED\n            </span>\n          </div>\n        )}\n\n        {/* Feature Trimming List */}\n        <div className=\"grid grid-cols-1 md:grid-cols-3 gap-3.5 mt-4\">\n          {scopeItems.slice(0, 3).map((item) => {\n            const isCut = item.isCut || scopeCutApplied;\n            return (\n              <div\n                key={item.id}\n                onClick={() => !scopeCutApplied && onToggleScopeSelect(item.id)}\n                className={`p-4 rounded-xl border transition-all cursor-pointer select-none flex flex-col justify-between ${\n                  isCut\n                    ? \'bg-[#202B2A]/60 border-[#3B4B47]/60 opacity-60 line-through\'\n                    : item.selectedForCut\n                    ? \'bg-[#31413F] border-[#C7F9A6]/40 shadow-sm\'\n                    : \'bg-[#293735] border-[#3B4B47] hover:bg-[#31413F]/50\'\n                }`}\n              >\n                <div>\n                  <div className=\"flex items-start justify-between gap-2\">\n                    <span className=\"text-xs font-bold text-[#F0F4EE] leading-tight\">\n                      {item.name}\n                    </span>\n                    <span className={`px-2 py-0.5 rounded text-[11px] font-mono font-bold shrink-0 ${\n                      isCut \n                        ? \'bg-[#202B2A] text-[#71817B]\' \n                        : \'bg-[#FFB7B2]/20 text-[#FFB7B2]\'\n                    }`}>\n                      {item.timeFormatted}\n                    </span>\n                  </div>\n\n                  <p className=\"text-[11px] text-[#AAB8B2] mt-2 leading-relaxed\">\n                    {item.reason}\n                  </p>\n                </div>\n\n                <div className=\"mt-3 pt-2.5 border-t border-[#3B4B47]/50 flex items-center justify-between text-[10px] font-mono\">\n                  <span className=\"text-[#71817B]\">{item.impactScore}</span>\n                  <div className=\"flex items-center gap-1.5\">\n                    {isCut ? (\n                      <span className=\"text-[#B7E4C7] font-bold\">TRIMMED</span>\n                    ) : (\n                      <span className={item.selectedForCut ? \'text-[#C7F9A6] font-bold\' : \'text-[#71817B]\'}>\n                        {item.selectedForCut ? \'Marked to Cut\' : \'Keep\'}\n                      </span>\n                    )}\n                  </div>\n                </div>\n              </div>\n            );\n          })}\n        </div>\n      </div>\n\n      {/* 5. PROJECT HEALTH BENTO & AI RESOURCE PRESSURE */}\n      <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-5 sm:gap-6\">\n        {/* BENTO GRID (7 cols) */}\n        <div className=\"lg:col-span-7 space-y-3\">\n          <div className=\"flex items-center justify-between px-1\">\n            <span className=\"text-[11px] font-mono font-bold tracking-widest text-[#71817B] uppercase\">\n              PROJECT HEALTH BENTO\n            </span>\n            <span className=\"text-[10px] font-mono text-[#A8E6CF]\">LIVE SUBSYSTEMS</span>\n          </div>\n\n          <div className=\"grid grid-cols-2 sm:grid-cols-3 gap-3\">\n            {/* MVP (Large tile) */}\n            <div className=\"p-4 rounded-xl bg-[#293735] border border-[#3B4B47] flex flex-col justify-between\">\n              <div className=\"flex items-center justify-between\">\n                <span className=\"text-[10px] font-mono text-[#71817B]\">MVP CORE</span>\n                <span className=\"text-[10px] font-mono text-[#B7E4C7] font-bold\">ON TRACK</span>\n              </div>\n              <div className=\"my-2\">\n                <div className=\"text-2xl font-mono font-extrabold text-[#F0F4EE]\">82%</div>\n                <div className=\"h-1.5 rounded-full bg-[#202B2A] mt-2 overflow-hidden\">\n                  <div className=\"h-full bg-[#B7E4C7] w-[82%]\" />\n                </div>\n              </div>\n              <span className=\"text-[10px] text-[#AAB8B2]\">Key user loop working</span>\n            </div>\n\n            {/* SCOPE (State-aware tile) */}\n            <div className={`p-4 rounded-xl border flex flex-col justify-between transition-colors ${\n              scopeCutApplied ? \'bg-[#293735] border-[#B7E4C7]/30\' : \'bg-[#293735] border-[#FFB7B2]/30\'\n            }`}>\n              <div className=\"flex items-center justify-between\">\n                <span className=\"text-[10px] font-mono text-[#71817B]\">SCOPE</span>\n                <span className={`text-[10px] font-mono font-bold ${scopeCutApplied ? \'text-[#B7E4C7]\' : \'text-[#FFB7B2]\'}`}>\n                  {scopeCutApplied ? \'OPTIMAL\' : \'TOO LARGE\'}\n                </span>\n              </div>\n              <div className=\"my-2\">\n                <div className={`text-2xl font-mono font-extrabold ${scopeCutApplied ? \'text-[#B7E4C7]\' : \'text-[#FFB7B2]\'}`}>\n                  {scopeCutApplied ? \'96%\' : \'64%\'}\n                </div>\n                <div className=\"h-1.5 rounded-full bg-[#202B2A] mt-2 overflow-hidden\">\n                  <div className={`h-full ${scopeCutApplied ? \'bg-[#B7E4C7] w-[96%]\' : \'bg-[#FFB7B2] w-[64%]\'}`} />\n                </div>\n              </div>\n              <span className=\"text-[10px] text-[#AAB8B2]\">\n                {scopeCutApplied ? \'Backlog trimmed\' : \'3 features bloat\'}\n              </span>\n            </div>\n\n            {/* TEAM */}\n            <div className=\"p-4 rounded-xl bg-[#293735] border border-[#3B4B47] flex flex-col justify-between\">\n              <div className=\"flex items-center justify-between\">\n                <span className=\"text-[10px] font-mono text-[#71817B]\">TEAM</span>\n                <span className=\"text-[10px] font-mono text-[#B7E4C7] font-bold\">ON TRACK</span>\n              </div>\n              <div className=\"my-2\">\n                <div className=\"text-2xl font-mono font-extrabold text-[#F0F4EE]\">91%</div>\n                <div className=\"h-1.5 rounded-full bg-[#202B2A] mt-2 overflow-hidden\">\n                  <div className=\"h-full bg-[#B7E4C7] w-[91%]\" />\n                </div>\n              </div>\n              <span className=\"text-[10px] text-[#AAB8B2]\">4 online &amp; coding</span>\n            </div>\n\n            {/* RESOURCES */}\n            <div className=\"p-4 rounded-xl bg-[#293735] border border-[#3B4B47] flex flex-col justify-between\">\n              <div className=\"flex items-center justify-between\">\n                <span className=\"text-[10px] font-mono text-[#71817B]\">RESOURCES</span>\n                <span className=\"text-[10px] font-mono text-[#FFE0A3] font-bold\">LIMITED</span>\n              </div>\n              <div className=\"my-2\">\n                <div className=\"text-2xl font-mono font-extrabold text-[#F0F4EE]\">48%</div>\n                <div className=\"h-1.5 rounded-full bg-[#202B2A] mt-2 overflow-hidden\">\n                  <div className=\"h-full bg-[#FFE0A3] w-[48%]\" />\n                </div>\n              </div>\n              <span className=\"text-[10px] text-[#AAB8B2]\">Base44 rate limited</span>\n            </div>\n\n            {/* TESTING */}\n            <div className=\"p-4 rounded-xl bg-[#293735] border border-[#3B4B47] flex flex-col justify-between col-span-2 sm:col-span-2\">\n              <div className=\"flex items-center justify-between\">\n                <span className=\"text-[10px] font-mono text-[#71817B]\">TESTING &amp; DRY RUN</span>\n                <span className=\"text-[10px] font-mono text-[#FFB7B2] font-bold\">NEEDS ATTENTION</span>\n              </div>\n              <div className=\"my-2 flex items-center gap-4\">\n                <div className=\"text-2xl font-mono font-extrabold text-[#FFB7B2]\">31%</div>\n                <div className=\"flex-1 h-1.5 rounded-full bg-[#202B2A] overflow-hidden\">\n                  <div className=\"h-full bg-[#FFB7B2] w-[31%]\" />\n                </div>\n              </div>\n              <span className=\"text-[10px] text-[#AAB8B2]\">Rehearse 3-minute pitch once core flow merges</span>\n            </div>\n          </div>\n        </div>\n\n        {/* AI RESOURCE PRESSURE & PROJECT SIGNAL (5 cols) */}\n        <div className=\"lg:col-span-5 space-y-4\">\n          {/* AI Resource Pressure widget */}\n          <div className=\"p-5 rounded-2xl bg-[#293735] border border-[#3B4B47] space-y-3.5\">\n            <div className=\"flex items-center justify-between\">\n              <span className=\"text-[11px] font-mono font-bold tracking-widest text-[#71817B] uppercase\">\n                AI RESOURCE PRESSURE\n              </span>\n              <Cpu className=\"w-3.5 h-3.5 text-[#A8E6CF]\" />\n            </div>\n\n            <div className=\"space-y-2.5\">\n              <div>\n                <div className=\"flex justify-between text-xs font-mono mb-1\">\n                  <span className=\"text-[#F0F4EE]\">Gemini 2.5 Flash</span>\n                  <span className=\"text-[#C7F9A6] font-bold\">78%</span>\n                </div>\n                <div className=\"h-1.5 rounded-full bg-[#202B2A] overflow-hidden\">\n                  <div className=\"h-full bg-[#C7F9A6] w-[78%]\" />\n                </div>\n              </div>\n\n              <div>\n                <div className=\"flex justify-between text-xs font-mono mb-1\">\n                  <span className=\"text-[#F0F4EE]\">Base44 UI Engine</span>\n                  <span className=\"text-[#FFE0A3] font-bold\">41%</span>\n                </div>\n                <div className=\"h-1.5 rounded-full bg-[#202B2A] overflow-hidden\">\n                  <div className=\"h-full bg-[#FFE0A3] w-[41%]\" />\n                </div>\n              </div>\n\n              <div>\n                <div className=\"flex justify-between text-xs font-mono mb-1\">\n                  <span className=\"text-[#F0F4EE]\">Claude 3.7 Sonnet</span>\n                  <span className=\"text-[#A8DADC] font-bold\">84%</span>\n                </div>\n                <div className=\"h-1.5 rounded-full bg-[#202B2A] overflow-hidden\">\n                  <div className=\"h-full bg-[#A8DADC] w-[84%]\" />\n                </div>\n              </div>\n            </div>\n\n            <div className=\"pt-2 border-t border-[#3B4B47] flex items-center gap-2 text-[11px] text-[#A8E6CF]\">\n              <Sparkles className=\"w-3.5 h-3.5 shrink-0\" />\n              <span>&ldquo;Save Base44 credits for final polish.&rdquo;</span>\n            </div>\n          </div>\n\n          {/* Activity Timeline Preview */}\n          <div className=\"p-4 rounded-2xl bg-[#293735] border border-[#3B4B47] space-y-2\">\n            <span className=\"text-[10px] font-mono font-bold tracking-widest text-[#71817B] uppercase block\">\n              ACTIVITY TIMELINE\n            </span>\n            <div className=\"space-y-2 pt-1\">\n              {activityLogs.slice(0, 3).map((log) => (\n                <div key={log.id} className=\"flex items-center justify-between text-xs\">\n                  <div className=\"flex items-center gap-2 text-[#AAB8B2]\">\n                    <span \n                      className=\"w-1.5 h-1.5 rounded-full\" \n                      style={{ backgroundColor: log.badgeColor || \'#A8E6CF\' }} \n                    />\n                    <span className=\"truncate max-w-[200px] text-[#F0F4EE]\">{log.title}</span>\n                  </div>\n                  <span className=\"text-[10px] font-mono text-[#71817B] shrink-0\">{log.timestamp}</span>\n                </div>\n              ))}\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n};"
      replacement_content: "import React, { useState } from \'react\';\nimport { \n  Scissors, \n  RefreshCw,\n  Info,\n  CheckCircle2,\n  Cpu,\n  Clock,\n  Sparkles,\n  ArrowRight\n} from \'lucide-react\';\nimport { ProjectHealth, ScopeCutItem, ActivityTimelineItem } from \'../../types\';\n\ninterface OverviewDashboardProps {\n  health: ProjectHealth;\n  scopeItems: ScopeCutItem[];\n  activityLogs: ActivityTimelineItem[];\n  scopeCutApplied: boolean;\n  onExecuteScopeCut: () => void;\n  onToggleScopeSelect: (id: string) => void;\n  onRecalculatePlan: () => void;\n  onOpenReasoning: () => void;\n  onStartNextTask: () => void;\n  isTaskActive: boolean;\n  taskActiveSeconds: number;\n}\n\nexport const OverviewDashboard: React.FC<OverviewDashboardProps> = ({\n  health,\n  scopeItems,\n  activityLogs,\n  scopeCutApplied,\n  onExecuteScopeCut,\n  onToggleScopeSelect,\n  onRecalculatePlan,\n  onOpenReasoning,\n  onStartNextTask,\n  isTaskActive,\n  taskActiveSeconds,\n}) => {\n  const [isRecalculating, setIsRecalculating] = useState(false);\n\n  // Calculate selected recoverable minutes\n  const selectedMinutes = scopeItems\n    .filter((item) => item.selectedForCut && !item.isCut)\n    .reduce((acc, curr) => acc + curr.timeMinutes, 0);\n\n  const selectedFormatted = `${Math.floor(selectedMinutes / 60)}h ${selectedMinutes % 60 ? `${selectedMinutes % 60}m` : \'\'}`.trim();\n\n  const handleRecalculateClick = () => {\n    setIsRecalculating(true);\n    setTimeout(() => {\n      setIsRecalculating(false);\n      onRecalculatePlan();\n    }, 600);\n  };\n\n  const formatActiveTimer = (sec: number) => {\n    const m = Math.floor(sec / 60);\n    const s = sec % 60;\n    return `${m.toString().padStart(2, \'0\')}:${s.toString().padStart(2, \'0\')}`;\n  };\n\n  return (\n    <div className=\"space-y-8 animate-in fade-in duration-300 pb-16\">\n      {/* 1. Header Section */}\n      <div className=\"flex flex-col sm:flex-row sm:items-end justify-between gap-4\">\n        <div>\n          <h2 className=\"text-3xl sm:text-4xl font-bold tracking-tight mb-2 text-[#F0F4EE]\">\n            You&apos;re in the second half.\n          </h2>\n          <p className=\"text-[#AAB8B2] text-base sm:text-lg\">\n            Here&apos;s what matters right now.\n          </p>\n        </div>\n\n        <div className=\"flex space-x-4 self-start sm:self-auto\">\n          <div className=\"text-left sm:text-right\">\n            <p className=\"text-[10px] text-[#71817B] uppercase font-bold tracking-wider\">\n              Status\n            </p>\n            <p className={`text-sm font-bold flex items-center mt-0.5 ${\n              scopeCutApplied ? \'text-[#B7E4C7]\' : \'text-[#FFB7B2]\'\n            }`}>\n              <span className={`w-2 h-2 rounded-full mr-2 ${\n                scopeCutApplied ? \'bg-[#B7E4C7]\' : \'bg-[#FFB7B2] animate-pulse\'\n              }`} />\n              {scopeCutApplied ? \'ON TRACK\' : \'AT RISK\'}\n            </p>\n          </div>\n        </div>\n      </div>\n\n      {/* 2. Primary 4-Card Hero Grid */}\n      <div className=\"grid grid-cols-12 gap-5\">\n        {/* Card 1: Project Health (col-span-12 lg:col-span-4) */}\n        <div className=\"col-span-12 lg:col-span-4 bg-[#293735] rounded-[32px] p-6 sm:p-7 border border-[#3B4B47] flex flex-col justify-between relative overflow-hidden shadow-xl min-h-[320px]\">\n          <div className=\"absolute -top-10 -left-10 w-32 h-32 bg-[#A8E6CF] opacity-5 blur-3xl pointer-events-none\" />\n          \n          <span className=\"text-[10px] uppercase font-bold tracking-widest text-[#71817B]\">\n            Project Health\n          </span>\n\n          <div className=\"flex-1 flex items-center justify-center py-4\">\n            <div className=\"relative w-32 h-32\">\n              <svg viewBox=\"0 0 36 36\" className=\"w-full h-full transform -rotate-90\">\n                <path\n                  className=\"stroke-[#202B2A]\"\n                  strokeWidth=\"3\"\n                  fill=\"none\"\n                  d=\"M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831\"\n                />\n                <path\n                  className={scopeCutApplied ? \'stroke-[#B7E4C7]\' : \'stroke-[#C7F9A6]\'}\n                  strokeDasharray={`${health.score}, 100`}\n                  strokeWidth=\"3\"\n                  strokeLinecap=\"round\"\n                  fill=\"none\"\n                  d=\"M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831\"\n                />\n              </svg>\n              <div className=\"absolute inset-0 flex flex-col items-center justify-center\">\n                <span className=\"text-3xl font-mono font-bold leading-none text-[#F0F4EE]\">\n                  {health.score}\n                  <small className=\"text-sm opacity-50 ml-0.5\">%</small>\n                </span>\n              </div>\n            </div>\n          </div>\n\n          <div className=\"grid grid-cols-2 gap-4 mt-auto pt-2 border-t border-[#3B4B47]/40\">\n            <div>\n              <p className=\"text-[9px] text-[#71817B] uppercase font-bold\">MVP Progress</p>\n              <p className=\"text-sm font-bold text-[#B7E4C7]\">82%</p>\n            </div>\n            <div>\n              <p className=\"text-[9px] text-[#71817B] uppercase font-bold\">Resource Util</p>\n              <p className=\"text-sm font-bold text-[#FFE0A3]\">48%</p>\n            </div>\n          </div>\n        </div>\n\n        {/* Card 2: Halftime Rec / Intelligent Correction (col-span-12 lg:col-span-8) */}\n        <div className=\"col-span-12 lg:col-span-8 bg-white/5 backdrop-blur-2xl rounded-[32px] p-6 sm:p-8 border border-white/10 relative overflow-hidden flex flex-col justify-between shadow-2xl min-h-[320px]\">\n          {/* Top right badge */}\n          <div className=\"flex items-center justify-between pb-2\">\n            <h3 className=\"text-xs font-bold text-[#A8E6CF] uppercase tracking-widest\">\n              Intelligent Correction\n            </h3>\n\n            <div className=\"flex items-center space-x-2 bg-[#A8E6CF]/20 px-3 py-1 rounded-full border border-[#A8E6CF]/30\">\n              <span className=\"w-1.5 h-1.5 rounded-full bg-[#A8E6CF] animate-pulse\" />\n              <span className=\"text-[10px] font-bold text-[#A8E6CF] uppercase tracking-tighter\">\n                Halftime Rec\n              </span>\n            </div>\n          </div>\n\n          <div className=\"max-w-[540px] my-4\">\n            <p className=\"text-xl sm:text-2xl font-medium leading-tight text-white mb-6\">\n              {scopeCutApplied ? (\n                <>\n                  &ldquo;Scope streamlined. <span className=\"text-[#C7F9A6]\">3h 45m recovered</span>. Focus 100% on the core AI evaluation flow and testing the 3-minute pitch.&rdquo;\n                </>\n              ) : (\n                <>\n                  &ldquo;You&apos;re <span className=\"text-[#FFB7B2]\">3 hours over capacity</span>. Cut analytics and team profiles. Finish the core AI evaluation flow first.&rdquo;\n                </>\n              )}\n            </p>\n\n            <div className=\"flex flex-wrap items-center gap-3\">\n              <button\n                id=\"btn-recalculate-plan\"\n                onClick={handleRecalculateClick}\n                disabled={isRecalculating}\n                className=\"bg-[#C7F9A6] text-[#202B2A] font-bold text-xs px-6 py-3 rounded-xl hover:opacity-90 transition-all shadow-[0_0_20px_rgba(199,249,166,0.2)] active:scale-95 cursor-pointer flex items-center gap-1.5\"\n              >\n                <RefreshCw className={`w-3.5 h-3.5 ${isRecalculating ? \'animate-spin\' : \'\'}`} />\n                <span>{isRecalculating ? \'RECALCULATING...\' : \'RECALCULATE PLAN\'}</span>\n              </button>\n\n              <button\n                id=\"btn-view-reasoning\"\n                onClick={onOpenReasoning}\n                className=\"bg-white/10 text-white font-bold text-xs px-6 py-3 rounded-xl border border-white/10 hover:bg-white/20 transition-all active:scale-95 cursor-pointer flex items-center gap-1.5\"\n              >\n                <Info className=\"w-3.5 h-3.5 text-[#A8E6CF]\" />\n                <span>VIEW REASONING</span>\n              </button>\n            </div>\n          </div>\n\n          {/* Artistic geometric background motif */}\n          <div className=\"absolute bottom-[-40px] right-[-20px] opacity-10 pointer-events-none\">\n            <svg width=\"200\" height=\"200\" viewBox=\"0 0 200 200\">\n              <circle cx=\"100\" cy=\"100\" r=\"80\" stroke=\"#A8E6CF\" strokeWidth=\"1\" fill=\"none\" strokeDasharray=\"10 5\" />\n              <circle cx=\"100\" cy=\"100\" r=\"60\" stroke=\"#A8E6CF\" strokeWidth=\"0.5\" fill=\"none\" />\n            </svg>\n          </div>\n        </div>\n\n        {/* Card 3: Your Next Move (col-span-12 lg:col-span-5) */}\n        <div className=\"col-span-12 lg:col-span-5 bg-[#293735] rounded-[32px] p-6 sm:p-8 border border-[#3B4B47] flex flex-col justify-between relative overflow-hidden shadow-xl min-h-[360px]\">\n          <span className=\"text-[10px] uppercase font-bold tracking-widest text-[#71817B] mb-4\">\n            Your Next Move\n          </span>\n\n          <div className=\"flex-1 flex flex-col justify-center\">\n            <div className=\"flex items-start mb-4\">\n              <div className=\"w-10 h-10 bg-[#FFB7B2]/20 rounded-xl flex items-center justify-center mr-4 shrink-0 border border-[#FFB7B2]/30\">\n                <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#FFB7B2\" strokeWidth=\"2.5\" strokeLinecap=\"round\" strokeLinejoin=\"round\">\n                  <path d=\"M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83\"/>\n                </svg>\n              </div>\n              <div>\n                <h4 className=\"font-bold text-lg sm:text-xl leading-tight mb-1 text-[#F0F4EE]\">\n                  Finish the core AI evaluation flow\n                </h4>\n                <div className=\"flex items-center space-x-3\">\n                  <span className=\"text-[10px] bg-[#FFB7B2] text-[#202B2A] font-black px-2 py-0.5 rounded\">\n                    CRITICAL\n                  </span>\n                  <span className=\"text-xs font-mono text-[#AAB8B2]\">\n                    1h 20m est.\n                  </span>\n                </div>\n              </div>\n            </div>\n\n            <p className=\"text-xs text-[#71817B] mb-6 leading-relaxed\">\n              &ldquo;Everything else depends on this workflow. Without this, your demo has no anchor.&rdquo;\n            </p>\n\n            <button\n              id=\"btn-start-next-action\"\n              onClick={onStartNextTask}\n              className={`w-full border-2 border-[#C7F9A6] text-[#C7F9A6] font-black text-xs py-4 rounded-2xl hover:bg-[#C7F9A6] hover:text-[#202B2A] transition-all tracking-widest active:scale-95 cursor-pointer ${\n                isTaskActive ? \'bg-[#C7F9A6] text-[#202B2A] shadow-[0_0_20px_rgba(199,249,166,0.3)]\' : \'\'\n              }`}\n            >\n              {isTaskActive ? `IN PROGRESS (${formatActiveTimer(taskActiveSeconds)})` : \'START TASK \342\206\222\'}\n            </button>\n          </div>\n        </div>\n\n        {/* Card 4: Scope Cutter (col-span-12 lg:col-span-7) */}\n        <div className=\"col-span-12 lg:col-span-7 bg-[#202B2A] rounded-[32px] p-6 sm:p-8 border border-[#3B4B47] shadow-inner relative flex flex-col justify-between min-h-[360px]\">\n          <div>\n            <div className=\"flex items-center justify-between mb-6\">\n              <div className=\"flex items-center space-x-3\">\n                <span className=\"text-xl\">\342\234\202\357\270\217</span>\n                <h3 className=\"text-lg font-bold tracking-tight text-[#F0F4EE]\">Scope Cutter</h3>\n              </div>\n              <div className=\"text-right\">\n                <p className=\"text-[9px] text-[#71817B] uppercase font-bold tracking-widest\">\n                  {scopeCutApplied ? \'Recovered\' : \'Recoverable\'}\n                </p>\n                <p className=\"text-xl font-mono font-bold text-[#A8DADC]\">\n                  {scopeCutApplied ? \'03:45:00\' : \'03:45:00\'}\n                </p>\n              </div>\n            </div>\n\n            <div className=\"space-y-3\">\n              {scopeItems.slice(0, 3).map((item) => {\n                const isCut = item.isCut || scopeCutApplied;\n                return (\n                  <div\n                    key={item.id}\n                    onClick={() => !scopeCutApplied && onToggleScopeSelect(item.id)}\n                    className={`group flex items-center justify-between p-4 bg-[#293735] rounded-2xl border transition-all cursor-pointer ${\n                      isCut \n                        ? \'border-transparent opacity-60 line-through\' \n                        : item.selectedForCut\n                        ? \'border-[#FFB7B2]/40 shadow-sm\'\n                        : \'border-transparent hover:border-[#FFB7B2]/30 opacity-70\'\n                    }`}\n                  >\n                    <div className=\"flex items-center space-x-4\">\n                      <div className={`w-5 h-5 rounded border-2 flex items-center justify-center ${\n                        item.selectedForCut || isCut ? \'border-[#FFB7B2]\' : \'border-[#3B4B47]\'\n                      }`}>\n                        {(item.selectedForCut || isCut) && (\n                          <div className=\"w-2.5 h-0.5 bg-[#FFB7B2]\" />\n                        )}\n                      </div>\n                      <span className=\"text-sm font-medium text-[#F0F4EE]\">{item.name}</span>\n                    </div>\n                    <span className=\"text-xs font-mono text-[#71817B] group-hover:text-[#FFB7B2]\">\n                      - {item.timeFormatted}\n                    </span>\n                  </div>\n                );\n              })}\n            </div>\n          </div>\n\n          <div className=\"mt-6 pt-6 border-t border-[#3B4B47] flex items-center justify-between\">\n            <p className=\"text-[10px] text-[#71817B] max-w-[280px]\">\n              Removing non-essential features recovers time without hurting the final demo score.\n            </p>\n            <button\n              id=\"btn-execute-scope-cuts\"\n              onClick={onExecuteScopeCut}\n              disabled={scopeCutApplied}\n              className={`text-[10px] font-bold uppercase tracking-widest border-b pb-1 hover:pb-2 transition-all cursor-pointer ${\n                scopeCutApplied \n                  ? \'text-[#B7E4C7] border-[#B7E4C7]\' \n                  : \'text-[#FFB7B2] border-[#FFB7B2]\'\n              }`}\n            >\n              {scopeCutApplied ? \'\342\234\223 Scope Streamlined\' : \'Execute Cuts\'}\n            </button>\n          </div>\n        </div>\n      </div>\n\n      {/* 3. Subsystem Health Bento Grid & AI Telemetry Bar */}\n      <div className=\"grid grid-cols-1 md:grid-cols-12 gap-5 pt-4\">\n        {/* Bento Subsystems */}\n        <div className=\"md:col-span-8 p-6 rounded-[28px] bg-[#293735] border border-[#3B4B47] space-y-4\">\n          <div className=\"flex items-center justify-between pb-2 border-b border-[#3B4B47]\">\n            <span className=\"text-xs font-mono font-bold tracking-widest text-[#71817B] uppercase\">\n              PROJECT HEALTH SUBSYSTEMS\n            </span>\n            <span className=\"text-[10px] font-mono text-[#A8E6CF]\">DORAHACKS SYNCHRONIZED</span>\n          </div>\n\n          <div className=\"grid grid-cols-2 sm:grid-cols-4 gap-3\">\n            <div className=\"p-3.5 rounded-xl bg-[#202B2A] border border-[#3B4B47]\">\n              <span className=\"text-[10px] font-mono text-[#71817B] block mb-1\">MVP CORE</span>\n              <span className=\"text-xl font-mono font-extrabold text-[#F0F4EE]\">82%</span>\n              <span className=\"text-[9px] text-[#B7E4C7] block mt-1 font-mono\">ON TRACK</span>\n            </div>\n\n            <div className=\"p-3.5 rounded-xl bg-[#202B2A] border border-[#3B4B47]\">\n              <span className=\"text-[10px] font-mono text-[#71817B] block mb-1\">SCOPE</span>\n              <span className={`text-xl font-mono font-extrabold ${scopeCutApplied ? \'text-[#B7E4C7]\' : \'text-[#FFB7B2]\'}`}>\n                {scopeCutApplied ? \'96%\' : \'64%\'}\n              </span>\n              <span className={`text-[9px] block mt-1 font-mono ${scopeCutApplied ? \'text-[#B7E4C7]\' : \'text-[#FFB7B2]\'}`}>\n                {scopeCutApplied ? \'OPTIMAL\' : \'TOO LARGE\'}\n              </span>\n            </div>\n\n            <div className=\"p-3.5 rounded-xl bg-[#202B2A] border border-[#3B4B47]\">\n              <span className=\"text-[10px] font-mono text-[#71817B] block mb-1\">TEAM STATUS</span>\n              <span className=\"text-xl font-mono font-extrabold text-[#F0F4EE]\">91%</span>\n              <span className=\"text-[9px] text-[#B7E4C7] block mt-1 font-mono\">4 ACTIVE</span>\n            </div>\n\n            <div className=\"p-3.5 rounded-xl bg-[#202B2A] border border-[#3B4B47]\">\n              <span className=\"text-[10px] font-mono text-[#71817B] block mb-1\">RUNWAY BUFFER</span>\n              <span className={`text-xl font-mono font-extrabold ${scopeCutApplied ? \'text-[#C7F9A6]\' : \'text-[#FFB7B2]\'}`}>\n                {scopeCutApplied ? \'+45m\' : \'\342\210\2223h\'}\n              </span>\n              <span className=\"text-[9px] text-[#71817B] block mt-1 font-mono\">PITCH REHEARSAL</span>\n            </div>\n          </div>\n        </div>\n\n        {/* AI Resource Telemetry Snippet */}\n        <div className=\"md:col-span-4 p-6 rounded-[28px] bg-[#293735] border border-[#3B4B47] flex flex-col justify-between\">\n          <div>\n            <div className=\"flex items-center justify-between pb-2 border-b border-[#3B4B47]\">\n              <span className=\"text-xs font-mono font-bold tracking-widest text-[#71817B] uppercase\">\n                AI RESOURCE RUNWAY\n              </span>\n              <Cpu className=\"w-3.5 h-3.5 text-[#A8E6CF]\" />\n            </div>\n\n            <div className=\"space-y-2 mt-3 text-xs font-mono\">\n              <div className=\"flex justify-between\">\n                <span className=\"text-[#AAB8B2]\">Gemini 2.5 Flash</span>\n                <span className=\"text-[#C7F9A6] font-bold\">78%</span>\n              </div>\n              <div className=\"flex justify-between\">\n                <span className=\"text-[#AAB8B2]\">Base44 UI Engine</span>\n                <span className=\"text-[#FFE0A3] font-bold\">41%</span>\n              </div>\n              <div className=\"flex justify-between\">\n                <span className=\"text-[#AAB8B2]\">Claude 3.7 Sonnet</span>\n                <span className=\"text-[#A8DADC] font-bold\">84%</span>\n              </div>\n            </div>\n          </div>\n\n          <div className=\"pt-3 border-t border-[#3B4B47] text-[11px] text-[#A8E6CF] flex items-center gap-1.5\">\n            <Sparkles className=\"w-3.5 h-3.5 shrink-0\" />\n            <span>Save Base44 credits for final UI polish.</span>\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n};\n"
    }
