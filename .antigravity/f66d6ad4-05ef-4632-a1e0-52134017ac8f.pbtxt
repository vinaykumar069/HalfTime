    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { \n  Scissors, \n  RefreshCw,\n  Info,\n  CheckCircle2,\n  Cpu,\n  Clock,\n  Sparkles,\n  ArrowRight,\n  AlertTriangle,\n  Flame,\n  Award,\n  Play,\n  RotateCcw\n} from \'lucide-react\';\nimport { ProjectHealth, ScopeCutItem, ActivityTimelineItem } from \'../../types\';\n\ninterface OverviewDashboardProps {\n  health: ProjectHealth;\n  scopeItems: ScopeCutItem[];\n  activityLogs: ActivityTimelineItem[];\n  scopeCutApplied: boolean;\n  onExecuteScopeCut: () => void;\n  onResetScopeCut?: () => void;\n  onToggleScopeSelect: (id: string) => void;\n  onRecalculatePlan: () => void;\n  onOpenReasoning: () => void;\n  onStartNextTask: () => void;\n  isTaskActive: boolean;\n  taskActiveSeconds: number;\n}\n\nexport const OverviewDashboard: React.FC<OverviewDashboardProps> = ({\n  health,\n  scopeItems,\n  activityLogs,\n  scopeCutApplied,\n  onExecuteScopeCut,\n  onResetScopeCut,\n  onToggleScopeSelect,\n  onRecalculatePlan,\n  onOpenReasoning,\n  onStartNextTask,\n  isTaskActive,\n  taskActiveSeconds,\n}) => {\n  const [isRecalculating, setIsRecalculating] = useState(false);\n\n  // Calculate selected recoverable minutes for features currently checked and not yet cut\n  const selectedItems = scopeItems.filter((item) => item.selectedForCut && !item.isCut);\n  const selectedMinutes = selectedItems.reduce((acc, curr) => acc + curr.timeMinutes, 0);\n\n  // Formatter for minutes\n  const formatMins = (minutes: number) => {\n    const h = Math.floor(minutes / 60);\n    const m = minutes % 60;\n    if (h > 0 && m > 0) return `${h}h ${m}m`;\n    if (h > 0) return `${h}h`;\n    return `${m}m`;\n  };\n\n  const selectedFormatted = selectedMinutes > 0 ? formatMins(selectedMinutes) : \'0m\';\n\n  // Calculate total cut minutes\n  const cutMinutes = scopeItems\n    .filter((item) => item.isCut)\n    .reduce((acc, curr) => acc + curr.timeMinutes, 0);\n\n  const handleRecalculateClick = () => {\n    setIsRecalculating(true);\n    setTimeout(() => {\n      setIsRecalculating(false);\n      onRecalculatePlan();\n    }, 600);\n  };\n\n  const formatActiveTimer = (sec: number) => {\n    const h = Math.floor(sec / 3600);\n    const m = Math.floor((sec % 3600) / 60);\n    const s = sec % 60;\n    if (h > 0) {\n      return `${h}:${m.toString().padStart(2, \'0\')}:${s.toString().padStart(2, \'0\')}`;\n    }\n    return `${m.toString().padStart(2, \'0\')}:${s.toString().padStart(2, \'0\')}`;\n  };\n\n  const isCritical = health.status === \'at-risk\' || health.status === \'critical\';\n\n  return (\n    <div className=\"space-y-8 animate-in fade-in duration-300 pb-16\">\n      {/* 1. Header Section */}\n      <div className=\"flex flex-col sm:flex-row sm:items-end justify-between gap-4\">\n        <div>\n          <h2 className=\"text-3xl sm:text-4xl font-bold tracking-tight mb-2 text-[#F0F4EE]\">\n            You&apos;re in the second half.\n          </h2>\n          <p className=\"text-[#AAB8B2] text-base sm:text-lg\">\n            Here&apos;s what matters right now.\n          </p>\n        </div>\n\n        <div className=\"flex items-center space-x-4 self-start sm:self-auto\">\n          <div className=\"text-left sm:text-right\">\n            <p className=\"text-[10px] text-[#71817B] uppercase font-bold tracking-wider\">\n              Status\n            </p>\n            <p className={`text-sm font-bold flex items-center mt-0.5 ${\n              scopeCutApplied ? \'text-[#B7E4C7]\' : \'text-[#FFB7B2]\'\n            }`}>\n              <span className={`w-2 h-2 rounded-full mr-2 ${\n                scopeCutApplied ? \'bg-[#B7E4C7]\' : \'bg-[#FFB7B2] animate-pulse\'\n              }`} />\n              {scopeCutApplied ? \'ON TRACK\' : \'AT RISK\'}\n            </p>\n          </div>\n        </div>\n      </div>\n\n      {/* 2. Primary 4-Card Hero Grid */}\n      <div className=\"grid grid-cols-12 gap-5\">\n        {/* Card 1: Project Health (col-span-12 lg:col-span-4) */}\n        <div \n          id=\"card-project-health\"\n          className=\"col-span-12 lg:col-span-4 bg-[#293735] rounded-[32px] p-6 sm:p-7 border border-[#3B4B47] flex flex-col justify-between relative overflow-hidden shadow-xl min-h-[320px]\"\n        >\n          <div className=\"absolute -top-10 -left-10 w-32 h-32 bg-[#A8E6CF] opacity-5 blur-3xl pointer-events-none\" />\n          \n          <div className=\"flex items-center justify-between\">\n            <span className=\"text-[10px] uppercase font-bold tracking-widest text-[#71817B]\">\n              Project Health\n            </span>\n            <span className={`text-[10px] font-mono px-2 py-0.5 rounded border ${\n              scopeCutApplied \n                ? \'bg-[#B7E4C7]/20 text-[#B7E4C7] border-[#B7E4C7]/40\' \n                : \'bg-[#FFB7B2]/20 text-[#FFB7B2] border-[#FFB7B2]/40\'\n            }`}>\n              {scopeCutApplied ? \'94% OPTIMAL\' : \'72% AT RISK\'}\n            </span>\n          </div>\n\n          <div className=\"flex-1 flex items-center justify-center py-4\">\n            <div className=\"relative w-36 h-36\">\n              <svg viewBox=\"0 0 36 36\" className=\"w-full h-full transform -rotate-90\">\n                <path\n                  className=\"stroke-[#202B2A]\"\n                  strokeWidth=\"3\"\n                  fill=\"none\"\n                  d=\"M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831\"\n                />\n                <path\n                  className={`transition-all duration-700 ${scopeCutApplied ? \'stroke-[#B7E4C7]\' : \'stroke-[#FFB7B2]\'}`}\n                  strokeDasharray={`${health.score}, 100`}\n                  strokeWidth=\"3\"\n                  strokeLinecap=\"round\"\n                  fill=\"none\"\n                  d=\"M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831\"\n                />\n              </svg>\n              <div className=\"absolute inset-0 flex flex-col items-center justify-center\">\n                <span className=\"text-3xl font-mono font-bold leading-none text-[#F0F4EE]\">\n                  {health.score}\n                  <small className=\"text-sm opacity-50 ml-0.5\">%</small>\n                </span>\n                <span className=\"text-[10px] font-mono text-[#71817B] mt-1 uppercase\">\n                  {health.status.replace(\'-\', \' \')}\n                </span>\n              </div>\n            </div>\n          </div>\n\n          <div className=\"grid grid-cols-2 gap-4 mt-auto pt-3 border-t border-[#3B4B47]/40\">\n            <div>\n              <p className=\"text-[9px] text-[#71817B] uppercase font-bold\">MVP Progress</p>\n              <p className=\"text-sm font-bold text-[#B7E4C7]\">{health.mvpPercent}%</p>\n            </div>\n            <div>\n              <p className=\"text-[9px] text-[#71817B] uppercase font-bold\">Resource Util</p>\n              <p className=\"text-sm font-bold text-[#FFE0A3]\">{health.resourcesPercent}%</p>\n            </div>\n          </div>\n        </div>\n\n        {/* Card 2: Halftime Rec / Intelligent Correction (col-span-12 lg:col-span-8) */}\n        <div \n          id=\"card-intelligent-correction\"\n          className=\"col-span-12 lg:col-span-8 bg-white/5 backdrop-blur-2xl rounded-[32px] p-6 sm:p-8 border border-white/10 relative overflow-hidden flex flex-col justify-between shadow-2xl min-h-[320px]\"\n        >\n          {/* Top right badge */}\n          <div className=\"flex items-center justify-between pb-2\">\n            <h3 className=\"text-xs font-bold text-[#A8E6CF] uppercase tracking-widest flex items-center gap-2\">\n              <Sparkles className=\"w-3.5 h-3.5 text-[#A8E6CF]\" />\n              <span>Intelligent Correction</span>\n            </h3>\n\n            <div className=\"flex items-center space-x-2 bg-[#A8E6CF]/20 px-3 py-1 rounded-full border border-[#A8E6CF]/30\">\n              <span className=\"w-1.5 h-1.5 rounded-full bg-[#A8E6CF] animate-pulse\" />\n              <span className=\"text-[10px] font-bold text-[#A8E6CF] uppercase tracking-tighter\">\n                Halftime Rec\n              </span>\n            </div>\n          </div>\n\n          <div className=\"max-w-[560px] my-4\">\n            <p className=\"text-xl sm:text-2xl font-medium leading-tight text-white mb-6\">\n              {scopeCutApplied ? (\n                <>\n                  &ldquo;Scope streamlined. <span className=\"text-[#C7F9A6] font-bold\">3h 45m recovered</span>. Focus 100% on the core AI evaluation flow and testing the 3-minute pitch.&rdquo;\n                </>\n              ) : (\n                <>\n                  &ldquo;You&apos;re <span className=\"text-[#FFB7B2] font-bold\">3 hours over capacity</span>. Cut analytics and team profiles. Finish the core AI evaluation flow first.&rdquo;\n                </>\n              )}\n            </p>\n\n            <div className=\"flex flex-wrap items-center gap-3\">\n              <button\n                id=\"btn-recalculate-plan\"\n                onClick={handleRecalculateClick}\n                disabled={isRecalculating}\n                className=\"bg-[#C7F9A6] text-[#202B2A] font-bold text-xs px-6 py-3 rounded-xl hover:opacity-90 transition-all shadow-[0_0_20px_rgba(199,249,166,0.2)] active:scale-95 cursor-pointer flex items-center gap-1.5\"\n              >\n                <RefreshCw className={`w-3.5 h-3.5 ${isRecalculating ? \'animate-spin\' : \'\'}`} />\n                <span>{isRecalculating ? \'RECALCULATING...\' : \'RECALCULATE PLAN\'}</span>\n              </button>\n\n              <button\n                id=\"btn-view-reasoning\"\n                onClick={onOpenReasoning}\n                className=\"bg-white/10 text-white font-bold text-xs px-6 py-3 rounded-xl border border-white/10 hover:bg-white/20 transition-all active:scale-95 cursor-pointer flex items-center gap-1.5\"\n              >\n                <Info className=\"w-3.5 h-3.5 text-[#A8E6CF]\" />\n                <span>VIEW REASONING</span>\n              </button>\n            </div>\n          </div>\n\n          {/* Artistic geometric background motif */}\n          <div className=\"absolute bottom-[-40px] right-[-20px] opacity-10 pointer-events-none\">\n            <svg width=\"200\" height=\"200\" viewBox=\"0 0 200 200\">\n              <circle cx=\"100\" cy=\"100\" r=\"80\" stroke=\"#A8E6CF\" strokeWidth=\"1\" fill=\"none\" strokeDasharray=\"10 5\" />\n              <circle cx=\"100\" cy=\"100\" r=\"60\" stroke=\"#A8E6CF\" strokeWidth=\"0.5\" fill=\"none\" />\n            </svg>\n          </div>\n        </div>\n\n        {/* Card 3: Your Next Move (col-span-12 lg:col-span-5) */}\n        <div \n          id=\"card-your-next-move\"\n          className=\"col-span-12 lg:col-span-5 bg-[#293735] rounded-[32px] p-6 sm:p-8 border border-[#3B4B47] flex flex-col justify-between relative overflow-hidden shadow-xl min-h-[360px]\"\n        >\n          <div className=\"flex items-center justify-between mb-4\">\n            <span className=\"text-[10px] uppercase font-bold tracking-widest text-[#71817B]\">\n              Your Next Move\n            </span>\n            <span className=\"text-[10px] font-mono text-[#A8E6CF] bg-[#202B2A] px-2 py-0.5 rounded border border-[#3B4B47]\">\n              RECOMMENDED FOCUS\n            </span>\n          </div>\n\n          <div className=\"flex-1 flex flex-col justify-center\">\n            <div className=\"flex items-start mb-4\">\n              <div className={`w-10 h-10 rounded-xl flex items-center justify-center mr-4 shrink-0 border ${\n                isTaskActive \n                  ? \'bg-[#C7F9A6]/20 border-[#C7F9A6]/40 text-[#C7F9A6]\' \n                  : \'bg-[#FFB7B2]/20 border-[#FFB7B2]/30 text-[#FFB7B2]\'\n              }`}>\n                {isTaskActive ? (\n                  <Play className=\"w-5 h-5 fill-current animate-pulse\" />\n                ) : (\n                  <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2.5\" strokeLinecap=\"round\" strokeLinejoin=\"round\">\n                    <path d=\"M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83\"/>\n                  </svg>\n                )}\n              </div>\n              <div>\n                <h4 className=\"font-bold text-lg sm:text-xl leading-tight mb-1 text-[#F0F4EE]\">\n                  Finish the core AI evaluation flow\n                </h4>\n                <div className=\"flex items-center space-x-3\">\n                  <span className={`text-[10px] font-black px-2 py-0.5 rounded ${\n                    isTaskActive \n                      ? \'bg-[#C7F9A6] text-[#202B2A]\' \n                      : \'bg-[#FFB7B2] text-[#202B2A]\'\n                  }`}>\n                    {isTaskActive ? \'IN PROGRESS\' : \'CRITICAL\'}\n                  </span>\n                  <span className=\"text-xs font-mono text-[#AAB8B2]\">\n                    1h 20m est.\n                  </span>\n                  {isTaskActive && (\n                    <span className=\"text-xs font-mono font-bold text-[#C7F9A6] animate-pulse\">\n                      [{formatActiveTimer(taskActiveSeconds)}]\n                    </span>\n                  )}\n                </div>\n              </div>\n            </div>\n\n            <p className=\"text-xs text-[#71817B] mb-6 leading-relaxed\">\n              &ldquo;Everything else depends on this workflow. Without this, your demo has no anchor.&rdquo;\n            </p>\n\n            <button\n              id=\"btn-start-next-action\"\n              onClick={onStartNextTask}\n              className={`w-full border-2 font-black text-xs py-4 rounded-2xl transition-all tracking-widest active:scale-95 cursor-pointer flex items-center justify-center gap-2 ${\n                isTaskActive \n                  ? \'bg-[#C7F9A6] text-[#202B2A] border-[#C7F9A6] shadow-[0_0_20px_rgba(199,249,166,0.3)]\' \n                  : \'border-[#C7F9A6] text-[#C7F9A6] hover:bg-[#C7F9A6] hover:text-[#202B2A]\'\n              }`}\n            >\n              {isTaskActive ? (\n                <>\n                  <span>ACTIVE / IN PROGRESS ({formatActiveTimer(taskActiveSeconds)})</span>\n                </>\n              ) : (\n                <>\n                  <span>START TASK \342\206\222</span>\n                </>\n              )}\n            </button>\n          </div>\n        </div>\n\n        {/* Card 4: Scope Cutter \342\200\224 CORE DEMO FEATURE (col-span-12 lg:col-span-7) */}\n        <div \n          id=\"card-scope-cutter\"\n          className=\"col-span-12 lg:col-span-7 bg-[#202B2A] rounded-[32px] p-6 sm:p-8 border border-[#3B4B47] shadow-inner relative flex flex-col justify-between min-h-[360px]\"\n        >\n          <div>\n            <div className=\"flex items-center justify-between mb-5 pb-3 border-b border-[#3B4B47]/60\">\n              <div className=\"flex items-center space-x-3\">\n                <span className=\"text-xl\">\342\234\202\357\270\217</span>\n                <div>\n                  <h3 className=\"text-lg font-bold tracking-tight text-[#F0F4EE]\">Scope Cutter</h3>\n                  <span className=\"text-[10px] font-mono text-[#A8E6CF]\">\n                    {scopeCutApplied \n                      ? \'\342\234\223 3 FEATURES TRIMMED\' \n                      : `SELECTED: ${selectedItems.length} features`}\n                  </span>\n                </div>\n              </div>\n              <div className=\"text-right\">\n                <p className=\"text-[9px] text-[#71817B] uppercase font-bold tracking-widest font-mono\">\n                  {scopeCutApplied ? \'RECOVERED\' : \'RECOVERABLE\'}\n                </p>\n                <p className=\"text-xl font-mono font-bold text-[#A8DADC]\">\n                  {scopeCutApplied ? \'3h 45m\' : selectedFormatted}\n                </p>\n              </div>\n            </div>\n\n            {/* Scope Cut Item Checkbox List */}\n            <div className=\"space-y-3\">\n              {scopeItems.slice(0, 3).map((item) => {\n                const isCut = item.isCut || scopeCutApplied;\n                const isChecked = item.selectedForCut && !isCut;\n\n                return (\n                  <div\n                    key={item.id}\n                    onClick={() => !scopeCutApplied && onToggleScopeSelect(item.id)}\n                    className={`group flex items-center justify-between p-3.5 sm:p-4 bg-[#293735] rounded-2xl border transition-all select-none ${\n                      isCut \n                        ? \'border-transparent opacity-60 line-through cursor-default\' \n                        : isChecked\n                        ? \'border-[#FFB7B2]/60 bg-[#31413F] shadow-sm cursor-pointer\'\n                        : \'border-transparent hover:border-[#FFB7B2]/30 opacity-70 cursor-pointer\'\n                    }`}\n                  >\n                    <div className=\"flex items-center space-x-3.5\">\n                      <div className={`w-5 h-5 rounded border-2 flex items-center justify-center transition-all ${\n                        isCut \n                          ? \'border-[#71817B] bg-[#202B2A]\' \n                          : isChecked \n                          ? \'border-[#FFB7B2] bg-[#FFB7B2]/20\' \n                          : \'border-[#3B4B47]\'\n                      }`}>\n                        {isCut ? (\n                          <CheckCircle2 className=\"w-3.5 h-3.5 text-[#B7E4C7]\" />\n                        ) : isChecked ? (\n                          <div className=\"w-2.5 h-0.5 bg-[#FFB7B2]\" />\n                        ) : null}\n                      </div>\n                      <div>\n                        <span className=\"text-sm font-medium text-[#F0F4EE] block leading-tight\">\n                          {item.name}\n                        </span>\n                        <span className=\"text-[10px] text-[#71817B] font-mono\">\n                          {item.reason}\n                        </span>\n                      </div>\n                    </div>\n                    <span className=\"text-xs font-mono font-bold text-[#FFB7B2] shrink-0 ml-2\">\n                      {item.timeFormatted}\n                    </span>\n                  </div>\n                );\n              })}\n            </div>\n          </div>\n\n          <div className=\"mt-5 pt-4 border-t border-[#3B4B47] flex flex-col sm:flex-row items-center justify-between gap-3\">\n            <p className=\"text-[10px] text-[#71817B] max-w-[260px] text-center sm:text-left\">\n              Removing non-essential features recovers time without hurting the final demo score.\n            </p>\n\n            <div className=\"flex items-center gap-3\">\n              {scopeCutApplied && onResetScopeCut && (\n                <button\n                  onClick={onResetScopeCut}\n                  className=\"text-[10px] font-mono text-[#71817B] hover:text-[#F0F4EE] flex items-center gap-1 hover:underline\"\n                  title=\"Reset scope to demo state\"\n                >\n                  <RotateCcw className=\"w-3 h-3\" />\n                  <span>Reset Demo</span>\n                </button>\n              )}\n\n              <button\n                id=\"btn-execute-scope-cuts\"\n                onClick={onExecuteScopeCut}\n                disabled={scopeCutApplied || selectedItems.length === 0}\n                className={`px-5 py-2.5 rounded-xl font-mono text-xs font-bold transition-all shadow-md active:scale-95 cursor-pointer ${\n                  scopeCutApplied \n                    ? \'bg-[#B7E4C7]/20 text-[#B7E4C7] border border-[#B7E4C7]/40 cursor-default\' \n                    : selectedItems.length === 0\n                    ? \'bg-[#31413F] text-[#71817B] border border-[#3B4B47] cursor-not-allowed\'\n                    : \'bg-gradient-to-r from-[#FFB7B2] to-[#FFE0A3] text-[#202B2A] hover:brightness-110\'\n                }`}\n              >\n                {scopeCutApplied \n                  ? \'\342\234\223 SCOPE STREAMLINED\' \n                  : selectedItems.length > 0\n                  ? `CUT SELECTED FEATURES (${selectedFormatted})`\n                  : \'SELECT FEATURES TO CUT\'}\n              </button>\n            </div>\n          </div>\n        </div>\n      </div>\n\n      {/* 3. TIME VS WORK VISUALIZATION (Section 6) */}\n      <div \n        id=\"section-time-vs-work\"\n        className=\"p-6 sm:p-7 rounded-[28px] bg-[#293735] border border-[#3B4B47] shadow-xl space-y-5\"\n      >\n        <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-2 pb-3 border-b border-[#3B4B47]\">\n          <div>\n            <div className=\"flex items-center gap-2\">\n              <Clock className=\"w-4 h-4 text-[#A8DADC]\" />\n              <h3 className=\"text-xs font-mono font-bold tracking-widest text-[#F0F4EE] uppercase\">\n                TIME PRESSURE &amp; CAPACITY GAUGE\n              </h3>\n            </div>\n            <p className=\"text-xs text-[#AAB8B2] mt-0.5\">\n              Deterministic backlog effort vs available hackathon runway before submission freeze.\n            </p>\n          </div>\n\n          <div className=\"flex items-center gap-3\">\n            <span className={`text-xs font-mono font-bold px-3 py-1 rounded-full border ${\n              scopeCutApplied \n                ? \'bg-[#C7F9A6]/20 text-[#C7F9A6] border-[#C7F9A6]/40\' \n                : \'bg-[#FFB7B2]/20 text-[#FFB7B2] border-[#FFB7B2]/40\'\n            }`}>\n              {scopeCutApplied ? \'45m BUFFER (ON TRACK)\' : \'3h OVER CAPACITY (AT RISK)\'}\n            </span>\n          </div>\n        </div>\n\n        {/* Dynamic Visual Progress Bars */}\n        <div className=\"space-y-4\">\n          {/* Time Available Bar */}\n          <div className=\"space-y-1.5\">\n            <div className=\"flex justify-between text-xs font-mono\">\n              <span className=\"text-[#AAB8B2]\">TIME AVAILABLE BEFORE FREEZE</span>\n              <span className=\"text-[#F0F4EE] font-bold\">11h 00m</span>\n            </div>\n            <div className=\"h-3 rounded-full bg-[#202B2A] border border-[#3B4B47] overflow-hidden\">\n              <div \n                className=\"h-full bg-gradient-to-r from-[#A8DADC] to-[#A8E6CF] rounded-full transition-all duration-700\" \n                style={{ width: \'78%\' }}\n              />\n            </div>\n          </div>\n\n          {/* Work Required Bar */}\n          <div className=\"space-y-1.5\">\n            <div className=\"flex justify-between text-xs font-mono\">\n              <span className=\"text-[#AAB8B2]\">WORK REQUIRED (BACKLOG EFFORT)</span>\n              <span className={`font-bold font-mono ${scopeCutApplied ? \'text-[#C7F9A6]\' : \'text-[#FFB7B2]\'}`}>\n                {scopeCutApplied ? \'10h 15m\' : \'14h 00m\'}\n              </span>\n            </div>\n            <div className=\"h-3 rounded-full bg-[#202B2A] border border-[#3B4B47] overflow-hidden\">\n              <div \n                className={`h-full rounded-full transition-all duration-700 ${\n                  scopeCutApplied \n                    ? \'bg-[#C7F9A6] w-[72%]\' \n                    : \'bg-[#FFB7B2] w-[100%]\'\n                }`} \n              />\n            </div>\n          </div>\n        </div>\n\n        {/* Legend / Metrics Grid */}\n        <div className=\"grid grid-cols-1 sm:grid-cols-3 gap-3 pt-2\">\n          <div className=\"p-3 rounded-xl bg-[#202B2A] border border-[#3B4B47] text-center\">\n            <span className=\"text-[10px] font-mono text-[#71817B] block\">TIME AVAILABLE</span>\n            <span className=\"text-base font-mono font-bold text-[#F0F4EE]\">11h</span>\n          </div>\n          <div className=\"p-3 rounded-xl bg-[#202B2A] border border-[#3B4B47] text-center\">\n            <span className=\"text-[10px] font-mono text-[#71817B] block\">WORK REMAINING</span>\n            <span className={`text-base font-mono font-bold ${scopeCutApplied ? \'text-[#C7F9A6]\' : \'text-[#FFB7B2]\'}`}>\n              {scopeCutApplied ? \'10h 15m\' : \'14h\'}\n            </span>\n          </div>\n          <div className=\"p-3 rounded-xl bg-[#202B2A] border border-[#3B4B47] text-center\">\n            <span className=\"text-[10px] font-mono text-[#71817B] block\">CAPACITY DELTA</span>\n            <span className={`text-base font-mono font-bold ${scopeCutApplied ? \'text-[#C7F9A6]\' : \'text-[#FFB7B2]\'}`}>\n              {scopeCutApplied ? \'+45m Buffer\' : \'\342\210\2223h Deficit\'}\n            </span>\n          </div>\n        </div>\n      </div>\n\n      {/* 4. Subsystem Health Bento Grid & AI Telemetry Bar */}\n      <div className=\"grid grid-cols-1 md:grid-cols-12 gap-5 pt-2\">\n        {/* Bento Subsystems */}\n        <div className=\"md:col-span-7 p-6 rounded-[28px] bg-[#293735] border border-[#3B4B47] space-y-4\">\n          <div className=\"flex items-center justify-between pb-2 border-b border-[#3B4B47]\">\n            <span className=\"text-xs font-mono font-bold tracking-widest text-[#71817B] uppercase\">\n              PROJECT HEALTH SUBSYSTEMS\n            </span>\n            <span className=\"text-[10px] font-mono text-[#A8E6CF]\">DORAHACKS SYNCHRONIZED</span>\n          </div>\n\n          <div className=\"grid grid-cols-2 sm:grid-cols-4 gap-3\">\n            <div className=\"p-3.5 rounded-xl bg-[#202B2A] border border-[#3B4B47]\">\n              <span className=\"text-[10px] font-mono text-[#71817B] block mb-1\">MVP CORE</span>\n              <span className=\"text-xl font-mono font-extrabold text-[#F0F4EE]\">82%</span>\n              <span className=\"text-[9px] text-[#B7E4C7] block mt-1 font-mono\">ON TRACK</span>\n            </div>\n\n            <div className=\"p-3.5 rounded-xl bg-[#202B2A] border border-[#3B4B47]\">\n              <span className=\"text-[10px] font-mono text-[#71817B] block mb-1\">SCOPE</span>\n              <span className={`text-xl font-mono font-extrabold ${scopeCutApplied ? \'text-[#B7E4C7]\' : \'text-[#FFB7B2]\'}`}>\n                {scopeCutApplied ? \'96%\' : \'64%\'}\n              </span>\n              <span className={`text-[9px] block mt-1 font-mono ${scopeCutApplied ? \'text-[#B7E4C7]\' : \'text-[#FFB7B2]\'}`}>\n                {scopeCutApplied ? \'OPTIMAL\' : \'TOO LARGE\'}\n              </span>\n            </div>\n\n            <div className=\"p-3.5 rounded-xl bg-[#202B2A] border border-[#3B4B47]\">\n              <span className=\"text-[10px] font-mono text-[#71817B] block mb-1\">TEAM STATUS</span>\n              <span className=\"text-xl font-mono font-extrabold text-[#F0F4EE]\">91%</span>\n              <span className=\"text-[9px] text-[#B7E4C7] block mt-1 font-mono\">4 ACTIVE</span>\n            </div>\n\n            <div className=\"p-3.5 rounded-xl bg-[#202B2A] border border-[#3B4B47]\">\n              <span className=\"text-[10px] font-mono text-[#71817B] block mb-1\">RUNWAY BUFFER</span>\n              <span className={`text-xl font-mono font-extrabold ${scopeCutApplied ? \'text-[#C7F9A6]\' : \'text-[#FFB7B2]\'}`}>\n                {scopeCutApplied ? \'+45m\' : \'\342\210\2223h\'}\n              </span>\n              <span className=\"text-[9px] text-[#71817B] block mt-1 font-mono\">PITCH REHEARSAL</span>\n            </div>\n          </div>\n        </div>\n\n        {/* Project Signal (Section 7) & AI Copilot Evaluation */}\n        <div \n          id=\"card-project-signal\"\n          className=\"md:col-span-5 p-6 rounded-[28px] bg-[#293735] border border-[#3B4B47] flex flex-col justify-between shadow-xl\"\n        >\n          <div>\n            <div className=\"flex items-center justify-between pb-2 border-b border-[#3B4B47]\">\n              <span className=\"text-xs font-mono font-bold tracking-widest text-[#71817B] uppercase flex items-center gap-1.5\">\n                <Award className=\"w-3.5 h-3.5 text-[#FFE0A3]\" />\n                <span>PROJECT SIGNAL</span>\n              </span>\n              <span className=\"text-[10px] font-mono text-[#FFE0A3]\">AUDIT V2.4</span>\n            </div>\n\n            <div className=\"mt-3 flex items-center justify-between\">\n              <div>\n                <span className=\"text-[11px] font-mono text-[#AAB8B2] block\">JUDGE SIMULATOR SCORE</span>\n                <div className=\"text-2xl font-mono font-black text-[#F0F4EE] mt-0.5\">\n                  {scopeCutApplied ? \'9.20\' : \'8.55\'} <span className=\"text-sm font-normal text-[#71817B]\">/ 10</span>\n                </div>\n              </div>\n              <span className={`px-2.5 py-1 rounded-full text-xs font-mono font-bold border ${\n                scopeCutApplied \n                  ? \'bg-[#B7E4C7]/20 text-[#B7E4C7] border-[#B7E4C7]/40\' \n                  : \'bg-[#FFE0A3]/20 text-[#FFE0A3] border-[#FFE0A3]/40\'\n              }`}>\n                {scopeCutApplied ? \'STRONG CONTENDER\' : \'BUILD IT\'}\n              </span>\n            </div>\n\n            <p className=\"text-xs text-[#AAB8B2] mt-2.5 leading-relaxed\">\n              &ldquo;Strong hackathon thesis with undeniable judge empathy. Sharp interface and instant before/after utility.&rdquo;\n            </p>\n          </div>\n\n          <div className=\"pt-3 mt-3 border-t border-[#3B4B47] text-[11px] text-[#A8E6CF] flex items-center justify-between font-mono\">\n            <span>DoraHacks Rubric Matrix</span>\n            <span className=\"text-[#FFE0A3]\">Top 5% Hackathon Tier</span>\n          </div>\n        </div>\n      </div>\n\n      {/* 5. RECENT ACTIVITY TIMELINE (Section 8) */}\n      <div \n        id=\"section-recent-activity\"\n        className=\"p-6 sm:p-7 rounded-[28px] bg-[#202B2A] border border-[#3B4B47] space-y-4\"\n      >\n        <div className=\"flex items-center justify-between pb-3 border-b border-[#3B4B47]\">\n          <span className=\"text-xs font-mono font-bold tracking-widest text-[#F0F4EE] uppercase flex items-center gap-2\">\n            <span className=\"w-2 h-2 rounded-full bg-[#A8E6CF] animate-pulse\" />\n            <span>RECENT ACTIVITY &amp; AUDIT TRAIL</span>\n          </span>\n          <span className=\"text-[10px] font-mono text-[#71817B]\">REAL-TIME LOG</span>\n        </div>\n\n        <div className=\"space-y-2.5\">\n          {activityLogs.slice(0, 5).map((log) => (\n            <div \n              key={log.id}\n              className=\"flex items-center justify-between p-3 rounded-xl bg-[#293735]/60 border border-[#3B4B47]/60 text-xs text-[#AAB8B2]\"\n            >\n              <div className=\"flex items-center gap-3\">\n                <span \n                  className=\"w-1.5 h-1.5 rounded-full shrink-0\" \n                  style={{ backgroundColor: log.badgeColor || \'#A8E6CF\' }}\n                />\n                <span className=\"font-medium text-[#F0F4EE]\">{log.title}</span>\n              </div>\n              <span className=\"font-mono text-[11px] text-[#71817B] shrink-0 ml-3\">\n                {log.timestamp}\n              </span>\n            </div>\n          ))}\n        </div>\n      </div>\n    </div>\n  );\n};\n"
