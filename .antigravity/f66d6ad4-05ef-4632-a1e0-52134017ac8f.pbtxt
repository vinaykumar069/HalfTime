  file_change {
    absolute_path_uri: "file:///src/components/mvp/MVPPlanner.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { \n  Layers, \n  Plus, \n  ArrowRight, \n  ArrowLeft, \n  Scissors, \n  Check, \n  Sparkles, \n  Clock, \n  AlertCircle,\n  HelpCircle,\n  Calendar,\n  Trash2,\n  AlertTriangle,\n  X\n} from \'lucide-react\';\nimport { MVPFeature, FeaturePriority, TaskItem } from \'../../types\';\nimport { generateMVP, generateRoadmap, RoadmapResult } from \'../../services/aiService\';\n\ninterface MVPPlannerProps {\n  features: MVPFeature[];\n  onChangeFeaturePriority: (id: string, newPriority: FeaturePriority) => void;\n  onAddFeature: (feature: MVPFeature) => void;\n  onDeleteFeature?: (id: string) => void;\n  onSetAllFeatures?: (features: MVPFeature[]) => void;\n  onAddTasksFromRoadmap?: (tasks: TaskItem[]) => void;\n  activeIdeaTitle?: string;\n  availableHours?: number;\n  teamSkills?: string[];\n  teamMembers?: string[];\n}\n\nexport const MVPPlanner: React.FC<MVPPlannerProps> = ({\n  features,\n  onChangeFeaturePriority,\n  onAddFeature,\n  onDeleteFeature,\n  onSetAllFeatures,\n  onAddTasksFromRoadmap,\n  activeIdeaTitle = \'HALFTIME (Hackathon Copilot)\',\n  availableHours = 12,\n  teamSkills = [],\n  teamMembers = [\'Builder\', \'Designer\', \'Product\', \'Growth\'],\n}) => {\n  const [newFeatureName, setNewFeatureName] = useState(\'\');\n  const [newFeatureHours, setNewFeatureHours] = useState(\'1.5\');\n  const [newFeatureCategory, setNewFeatureCategory] = useState<\'Core AI\' | \'UI / Polish\' | \'Infrastructure\' | \'Add-on\'>(\'Core AI\');\n  const [isAdding, setIsAdding] = useState(false);\n  const [isSynthesizing, setIsSynthesizing] = useState(false);\n  const [synthesisStep, setSynthesisStep] = useState(0);\n  const [errorMessage, setErrorMessage] = useState<string | null>(null);\n\n  // Roadmap State\n  const [isRoadmapOpen, setIsRoadmapOpen] = useState(false);\n  const [isGeneratingRoadmap, setIsGeneratingRoadmap] = useState(false);\n  const [roadmapResult, setRoadmapResult] = useState<RoadmapResult | null>(null);\n  const [roadmapSuccessMsg, setRoadmapSuccessMsg] = useState<string | null>(null);\n\n  const mvpSteps = [\n    `Analyzing hackathon constraints & ${availableHours}h runway...`,\n    \'Isolating core 30-second judge demo loops...\',\n    \'Demoting high-risk scope traps (Auth, Stripe, deep settings)...\',\n    \'Calibrating MUST vs SHOULD feature balance...\',\n  ];\n\n  const handleSynthesizeMVP = async () => {\n    setErrorMessage(null);\n    setIsSynthesizing(true);\n    setSynthesisStep(0);\n\n    const timer = setInterval(() => {\n      setSynthesisStep((prev) => (prev < mvpSteps.length - 1 ? prev + 1 : prev));\n    }, 600);\n\n    try {\n      const plan = await generateMVP(activeIdeaTitle, availableHours, {\n        teamSkills: teamSkills.join(\', \'),\n      });\n      if (plan?.features && plan.features.length > 0 && onSetAllFeatures) {\n        onSetAllFeatures(plan.features);\n      }\n    } catch (e: any) {\n      setErrorMessage(e?.message || \'HALFTIME AI is temporarily unavailable. Please try again.\');\n    } finally {\n      clearInterval(timer);\n      setIsSynthesizing(false);\n    }\n  };\n\n  const handleGenerateRoadmap = async () => {\n    setErrorMessage(null);\n    setRoadmapSuccessMsg(null);\n    setIsGeneratingRoadmap(true);\n\n    try {\n      const res = await generateRoadmap({\n        projectTitle: activeIdeaTitle,\n        mvpFeatures: features,\n        teamMembers,\n        availableHours,\n      });\n      setRoadmapResult(res);\n      setIsRoadmapOpen(true);\n    } catch (e: any) {\n      setErrorMessage(e?.message || \'Failed to generate roadmap with Gemini.\');\n    } finally {\n      setIsGeneratingRoadmap(false);\n    }\n  };\n\n  const handleImportRoadmapToTasks = () => {\n    if (!roadmapResult || !onAddTasksFromRoadmap) return;\n\n    const newTasks: TaskItem[] = [];\n    roadmapResult.phases.forEach((phase) => {\n      phase.tasks.forEach((t, i) => {\n        newTasks.push({\n          id: `task-roadmap-${Date.now()}-${i}`,\n          title: `[${phase.phaseName}] ${t.title}`,\n          owner: t.owner,\n          role: t.owner.includes(\'Builder\') ? \'Builder\' : t.owner.includes(\'Designer\') ? \'Designer\' : \'Product\',\n          priority: t.priority,\n          status: \'TODO\',\n          estimatedTime: `${t.estimatedMinutes}m`,\n          estimatedMinutes: t.estimatedMinutes,\n        });\n      });\n    });\n\n    onAddTasksFromRoadmap(newTasks);\n    setRoadmapSuccessMsg(`Imported ${newTasks.length} roadmap tasks into the Task Board!`);\n  };\n\n  const groups: Array<{\n    priority: FeaturePriority;\n    title: string;\n    description: string;\n    badgeColor: string;\n    borderAccent: string;\n  }> = [\n    {\n      priority: \'MUST_BUILD\',\n      title: \'MUST BUILD\',\n      description: \'Without this, there is no demo. 100% essential.\',\n      badgeColor: \'bg-[#C7F9A6]/20 text-[#C7F9A6] border-[#C7F9A6]/40\',\n      borderAccent: \'border-[#C7F9A6]/30\',\n    },\n    {\n      priority: \'SHOULD_BUILD\',\n      title: \'SHOULD BUILD\',\n      description: \'Strengthens the pitch. Build if runway permits.\',\n      badgeColor: \'bg-[#A8DADC]/20 text-[#A8DADC] border-[#A8DADC]/40\',\n      borderAccent: \'border-[#A8DADC]/30\',\n    },\n    {\n      priority: \'NICE_TO_HAVE\',\n      title: \'NICE TO HAVE\',\n      description: \'Extra polish. Do not risk submission deadline for this.\',\n      badgeColor: \'bg-[#FFE0A3]/20 text-[#FFE0A3] border-[#FFE0A3]/40\',\n      borderAccent: \'border-[#FFE0A3]/30\',\n    },\n    {\n      priority: \'CUT\',\n      title: \'CUT FROM MVP\',\n      description: \'Safely discarded to protect the core demo experience.\',\n      badgeColor: \'bg-[#FFB7B2]/20 text-[#FFB7B2] border-[#FFB7B2]/40\',\n      borderAccent: \'border-[#FFB7B2]/30\',\n    },\n  ];\n\n  const handleCreateFeature = (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!newFeatureName.trim()) return;\n\n    const newFeat: MVPFeature = {\n      id: `custom-feat-${Date.now()}`,\n      name: newFeatureName.trim(),\n      description: \'Team custom feature added during midpoint planning.\',\n      estimatedHours: parseFloat(newFeatureHours) || 1.0,\n      priority: \'SHOULD_BUILD\',\n      demoCritical: false,\n      category: newFeatureCategory,\n    };\n\n    onAddFeature(newFeat);\n    setNewFeatureName(\'\');\n    setIsAdding(false);\n  };\n\n  const totalMustHours = features\n    .filter(f => f.priority === \'MUST_BUILD\')\n    .reduce((acc, f) => acc + f.estimatedHours, 0);\n\n  const totalShouldHours = features\n    .filter(f => f.priority === \'SHOULD_BUILD\')\n    .reduce((acc, f) => acc + f.estimatedHours, 0);\n\n  return (\n    <div className=\"space-y-8 animate-in fade-in duration-300 pb-12\">\n      {/* Header */}\n      <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-4\">\n        <div>\n          <div className=\"inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#31413F] border border-[#3B4B47] text-xs font-mono text-[#B8DDF0] mb-2\">\n            <Layers className=\"w-3.5 h-3.5\" />\n            <span>MVP ARCHITECTURE MATRIX</span>\n          </div>\n          <h1 className=\"text-2xl sm:text-4xl font-extrabold text-[#F0F4EE] tracking-tight font-display\">\n            MVP PLANNER\n          </h1>\n          <p className=\"text-sm sm:text-base text-[#AAB8B2] mt-1 font-medium\">\n            Differentiate essential core loops from scope traps. Move items between tiers to recalculate demo runway.\n          </p>\n        </div>\n\n        <div className=\"flex flex-wrap items-center gap-2 self-start sm:self-auto\">\n          <button\n            id=\"btn-generate-roadmap-gemini\"\n            onClick={handleGenerateRoadmap}\n            disabled={isGeneratingRoadmap}\n            className=\"flex items-center gap-2 px-3.5 py-2.5 rounded-xl bg-[#293735] hover:bg-[#31413F] border border-[#3B4B47] text-xs font-mono text-[#F0F4EE] hover:text-[#C7F9A6] transition-all cursor-pointer disabled:opacity-50\"\n          >\n            <Calendar className={`w-3.5 h-3.5 ${isGeneratingRoadmap ? \'animate-spin\' : \'\'}`} />\n            <span>{isGeneratingRoadmap ? \'GENERATING ROADMAP...\' : \'GENERATE BUILD ROADMAP\'}</span>\n          </button>\n\n          <button\n            id=\"btn-recalculate-mvp-gemini\"\n            onClick={handleSynthesizeMVP}\n            disabled={isSynthesizing}\n            className=\"flex items-center gap-2 px-4 py-2.5 rounded-xl bg-gradient-to-r from-[#A8E6CF] to-[#A8DADC] text-[#202B2A] font-mono text-xs font-bold hover:brightness-110 shadow-md active:scale-95 disabled:opacity-50 transition-all cursor-pointer\"\n          >\n            <Sparkles className={`w-3.5 h-3.5 ${isSynthesizing ? \'animate-spin\' : \'\'}`} />\n            <span>{isSynthesizing ? \'HALFTIME IS THINKING...\' : \'SYNTHESIZE MVP WITH GEMINI\'}</span>\n          </button>\n        </div>\n      </div>\n\n      {errorMessage && (\n        <div className=\"p-4 rounded-xl bg-[#FFB7B2]/10 border border-[#FFB7B2]/30 flex items-center justify-between gap-3 text-xs text-[#FFB7B2] animate-in fade-in\">\n          <div className=\"flex items-center gap-2.5\">\n            <AlertTriangle className=\"w-4 h-4 shrink-0\" />\n            <span>{errorMessage}</span>\n          </div>\n          <button\n            onClick={handleSynthesizeMVP}\n            className=\"px-3 py-1 rounded-lg bg-[#FFB7B2]/20 hover:bg-[#FFB7B2]/30 font-mono text-[11px] font-bold text-[#FFB7B2] transition-colors\"\n          >\n            TRY AGAIN\n          </button>\n        </div>\n      )}\n\n      {isSynthesizing && (\n        <div className=\"p-4 rounded-xl bg-[#293735] border border-[#A8E6CF]/40 space-y-2 animate-in fade-in\">\n          <div className=\"flex items-center justify-between text-xs font-mono\">\n            <span className=\"font-bold text-[#A8E6CF] flex items-center gap-2\">\n              <Sparkles className=\"w-3.5 h-3.5 animate-spin\" />\n              HALFTIME IS THINKING...\n            </span>\n            <span className=\"text-[#71817B]\">Step {synthesisStep + 1} of 4</span>\n          </div>\n          <p className=\"text-xs text-[#F0F4EE] font-mono\">{mvpSteps[synthesisStep]}</p>\n          <div className=\"h-1.5 w-full bg-[#3B4B47] rounded-full overflow-hidden\">\n            <div\n              className=\"h-full bg-gradient-to-r from-[#A8E6CF] to-[#B8DDF0] transition-all duration-500\"\n              style={{ width: `${((synthesisStep + 1) / mvpSteps.length) * 100}%` }}\n            />\n          </div>\n        </div>\n      )}\n\n      {/* Runway Summary Bar */}\n      <div className=\"grid grid-cols-1 sm:grid-cols-3 gap-4 p-5 rounded-2xl bg-[#293735] border border-[#3B4B47]\">\n        <div>\n          <span className=\"text-[11px] font-mono text-[#71817B] uppercase block\">MUST BUILD RUNWAY</span>\n          <div className=\"text-xl sm:text-2xl font-mono font-extrabold text-[#C7F9A6] mt-1\">\n            {totalMustHours.toFixed(1)}h <span className=\"text-xs text-[#71817B] font-normal\">/ {availableHours}h</span>\n          </div>\n        </div>\n        <div>\n          <span className=\"text-[11px] font-mono text-[#71817B] uppercase block\">SHOULD BUILD LOAD</span>\n          <div className=\"text-xl sm:text-2xl font-mono font-extrabold text-[#A8DADC] mt-1\">\n            {totalShouldHours.toFixed(1)}h\n          </div>\n        </div>\n        <div>\n          <span className=\"text-[11px] font-mono text-[#71817B] uppercase block\">CAPACITY BUFFER</span>\n          <div className={`text-xl sm:text-2xl font-mono font-extrabold mt-1 ${\n            totalMustHours <= availableHours ? \'text-[#C7F9A6]\' : \'text-[#FFB7B2]\'\n          }`}>\n            {(availableHours - totalMustHours).toFixed(1)}h\n          </div>\n        </div>\n      </div>\n\n      {/* Add Custom Feature Button / Form */}\n      <div>\n        {!isAdding ? (\n          <button\n            onClick={() => setIsAdding(true)}\n            className=\"flex items-center gap-2 px-4 py-2 rounded-xl bg-[#202B2A] hover:bg-[#31413F] border border-[#3B4B47] text-xs font-mono text-[#AAB8B2] hover:text-[#F0F4EE] transition-all cursor-pointer\"\n          >\n            <Plus className=\"w-3.5 h-3.5 text-[#C7F9A6]\" />\n            <span>ADD CUSTOM FEATURE</span>\n          </button>\n        ) : (\n          <form onSubmit={handleCreateFeature} className=\"p-4 rounded-xl bg-[#293735] border border-[#C7F9A6]/40 flex flex-wrap items-center gap-3 animate-in fade-in\">\n            <input\n              type=\"text\"\n              required\n              placeholder=\"Feature name...\"\n              value={newFeatureName}\n              onChange={e => setNewFeatureName(e.target.value)}\n              className=\"flex-1 min-w-[200px] px-3 py-2 rounded-lg bg-[#202B2A] border border-[#3B4B47] text-xs text-[#F0F4EE] focus:outline-none focus:border-[#C7F9A6]\"\n            />\n            <input\n              type=\"number\"\n              step=\"0.5\"\n              min=\"0.5\"\n              placeholder=\"Hours (e.g. 1.5)\"\n              value={newFeatureHours}\n              onChange={e => setNewFeatureHours(e.target.value)}\n              className=\"w-24 px-3 py-2 rounded-lg bg-[#202B2A] border border-[#3B4B47] text-xs text-[#F0F4EE] focus:outline-none focus:border-[#C7F9A6]\"\n            />\n            <select\n              value={newFeatureCategory}\n              onChange={e => setNewFeatureCategory(e.target.value as any)}\n              className=\"px-3 py-2 rounded-lg bg-[#202B2A] border border-[#3B4B47] text-xs text-[#F0F4EE] focus:outline-none\"\n            >\n              <option value=\"Core AI\">Core AI</option>\n              <option value=\"UI / Polish\">UI / Polish</option>\n              <option value=\"Infrastructure\">Infrastructure</option>\n              <option value=\"Add-on\">Add-on</option>\n            </select>\n            <button\n              type=\"submit\"\n              className=\"px-4 py-2 rounded-lg bg-[#C7F9A6] text-[#202B2A] text-xs font-mono font-bold hover:brightness-110\"\n            >\n              Add\n            </button>\n            <button\n              type=\"button\"\n              onClick={() => setIsAdding(false)}\n              className=\"px-3 py-2 rounded-lg text-xs font-mono text-[#71817B] hover:text-[#F0F4EE]\"\n            >\n              Cancel\n            </button>\n          </form>\n        )}\n      </div>\n\n      {/* Feature Tiers Grid */}\n      <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-5\">\n        {groups.map((group) => {\n          const groupFeatures = features.filter((f) => f.priority === group.priority);\n\n          return (\n            <div\n              key={group.priority}\n              className={`p-5 rounded-2xl bg-[#293735] border ${group.borderAccent} flex flex-col justify-between min-h-[380px] shadow-lg`}\n            >\n              <div>\n                {/* Column Header */}\n                <div className=\"pb-3 border-b border-[#3B4B47]\">\n                  <div className=\"flex items-center justify-between\">\n                    <span className={`px-2.5 py-0.5 rounded-full text-xs font-mono font-bold border ${group.badgeColor}`}>\n                      {group.title}\n                    </span>\n                    <span className=\"text-xs font-mono text-[#71817B]\">\n                      {groupFeatures.length}\n                    </span>\n                  </div>\n                  <p className=\"text-[11px] text-[#AAB8B2] mt-1.5 leading-snug\">\n                    {group.description}\n                  </p>\n                </div>\n\n                {/* Features List */}\n                <div className=\"py-3 space-y-2.5\">\n                  {groupFeatures.map((feat) => (\n                    <div\n                      key={feat.id}\n                      className=\"p-3 rounded-xl bg-[#202B2A] border border-[#3B4B47] hover:border-[#71817B] transition-all space-y-2 group\"\n                    >\n                      <div className=\"flex items-start justify-between gap-1.5\">\n                        <span className=\"text-xs font-bold text-[#F0F4EE] leading-tight\">\n                          {feat.name}\n                        </span>\n                        {onDeleteFeature && (\n                          <button\n                            onClick={() => onDeleteFeature(feat.id)}\n                            className=\"text-[#71817B] hover:text-[#FFB7B2] opacity-0 group-hover:opacity-100 transition-opacity p-0.5\"\n                          >\n                            <Trash2 className=\"w-3 h-3\" />\n                          </button>\n                        )}\n                      </div>\n\n                      <p className=\"text-[11px] text-[#AAB8B2] leading-snug\">\n                        {feat.description}\n                      </p>\n\n                      <div className=\"flex items-center justify-between text-[10px] font-mono text-[#71817B] pt-1 border-t border-[#3B4B47]/60\">\n                        <span>{feat.category}</span>\n                        <span className=\"text-[#A8E6CF] font-bold\">{feat.estimatedHours}h</span>\n                      </div>\n\n                      {/* Move Tier Controls */}\n                      <div className=\"pt-1.5 flex flex-wrap gap-1\">\n                        {groups.map((targetGroup) => {\n                          if (targetGroup.priority === feat.priority) return null;\n                          return (\n                            <button\n                              key={targetGroup.priority}\n                              onClick={() => onChangeFeaturePriority(feat.id, targetGroup.priority)}\n                              className=\"px-1.5 py-0.5 rounded text-[9px] font-mono bg-[#31413F] hover:bg-[#3B4B47] text-[#AAB8B2] hover:text-[#F0F4EE] transition-all\"\n                              title={`Move to ${targetGroup.title}`}\n                            >\n                              \342\206\222 {targetGroup.priority === \'MUST_BUILD\' ? \'MUST\' : targetGroup.priority === \'SHOULD_BUILD\' ? \'SHOULD\' : targetGroup.priority === \'NICE_TO_HAVE\' ? \'NICE\' : \'CUT\'}\n                            </button>\n                          );\n                        })}\n                      </div>\n                    </div>\n                  ))}\n\n                  {groupFeatures.length === 0 && (\n                    <div className=\"p-4 rounded-xl border border-dashed border-[#3B4B47] text-center text-xs font-mono text-[#71817B]\">\n                      No items in this tier\n                    </div>\n                  )}\n                </div>\n              </div>\n            </div>\n          );\n        })}\n      </div>\n\n      {/* Build Roadmap Modal */}\n      {isRoadmapOpen && roadmapResult && (\n        <div className=\"fixed inset-0 bg-black/75 z-50 flex items-center justify-center p-4 backdrop-blur-sm animate-in fade-in\">\n          <div className=\"w-full max-w-3xl bg-[#293735] border border-[#3B4B47] rounded-3xl p-6 sm:p-8 shadow-2xl relative max-h-[90vh] overflow-y-auto\">\n            <button\n              onClick={() => setIsRoadmapOpen(false)}\n              className=\"absolute top-5 right-5 p-1.5 rounded-lg text-[#71817B] hover:text-[#F0F4EE] hover:bg-[#202B2A]\"\n            >\n              <X className=\"w-4 h-4\" />\n            </button>\n\n            <div className=\"flex items-center gap-3 mb-6\">\n              <div className=\"p-3 rounded-2xl bg-[#202B2A] border border-[#3B4B47] text-[#C7F9A6]\">\n                <Calendar className=\"w-5 h-5\" />\n              </div>\n              <div>\n                <h2 className=\"text-lg font-bold text-[#F0F4EE]\">AI BUILD ROADMAP</h2>\n                <p className=\"text-xs text-[#71817B]\">Chronological sprint phases with team member assignments</p>\n              </div>\n            </div>\n\n            {roadmapSuccessMsg && (\n              <div className=\"mb-4 p-3 rounded-xl bg-[#C7F9A6]/10 border border-[#C7F9A6]/30 text-xs font-mono text-[#C7F9A6]\">\n                {roadmapSuccessMsg}\n              </div>\n            )}\n\n            <div className=\"space-y-4 mb-6\">\n              {roadmapResult.phases.map((phase, pIdx) => (\n                <div key={pIdx} className=\"p-4 rounded-2xl bg-[#202B2A] border border-[#3B4B47] space-y-2.5\">\n                  <div className=\"flex items-center justify-between pb-2 border-b border-[#3B4B47]\">\n                    <span className=\"text-xs font-bold font-mono text-[#A8E6CF] uppercase\">\n                      {phase.phaseName}\n                    </span>\n                    <span className=\"text-[10px] font-mono text-[#71817B]\">\n                      {phase.estimatedTime}\n                    </span>\n                  </div>\n\n                  <div className=\"space-y-2\">\n                    {phase.tasks.map((t, tIdx) => (\n                      <div key={tIdx} className=\"flex items-center justify-between p-2.5 rounded-xl bg-[#293735] text-xs\">\n                        <div>\n                          <div className=\"text-[#F0F4EE] font-semibold\">{t.title}</div>\n                          <div className=\"text-[10px] font-mono text-[#71817B]\">\n                            Assignee: <span className=\"text-[#AAB8B2]\">{t.owner}</span> \342\200\242 Deps: {t.dependencies}\n                          </div>\n                        </div>\n                        <div className=\"text-right\">\n                          <span className={`px-2 py-0.5 rounded text-[9px] font-mono font-bold ${\n                            t.priority === \'CRITICAL\' ? \'bg-[#FFB7B2]/20 text-[#FFB7B2]\' : \'bg-[#FFE0A3]/20 text-[#FFE0A3]\'\n                          }`}>\n                            {t.priority}\n                          </span>\n                          <div className=\"text-[10px] font-mono text-[#71817B] mt-0.5\">{t.estimatedMinutes}m</div>\n                        </div>\n                      </div>\n                    ))}\n                  </div>\n                </div>\n              ))}\n            </div>\n\n            <div className=\"flex items-center justify-between pt-4 border-t border-[#3B4B47]\">\n              <button\n                onClick={() => setIsRoadmapOpen(false)}\n                className=\"px-4 py-2 rounded-xl bg-[#202B2A] text-xs font-mono text-[#71817B] hover:text-[#F0F4EE]\"\n              >\n                Close\n              </button>\n              {onAddTasksFromRoadmap && (\n                <button\n                  onClick={handleImportRoadmapToTasks}\n                  className=\"px-5 py-2 rounded-xl bg-[#C7F9A6] text-[#202B2A] text-xs font-bold font-mono hover:brightness-110 shadow-md flex items-center gap-2\"\n                >\n                  <Plus className=\"w-3.5 h-3.5\" />\n                  <span>IMPORT ALL TO TASK BOARD</span>\n                </button>\n              )}\n            </div>\n          </div>\n        </div>\n      )}\n    </div>\n  );\n};\n"
    }
