    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React from \'react\';\nimport { CheckCircle2, AlertCircle, Sparkles, X, Info } from \'lucide-react\';\n\nexport interface ToastMessage {\n  id: string;\n  type: \'success\' | \'warning\' | \'info\' | \'ai\';\n  title: string;\n  message: string;\n}\n\ninterface ToastContainerProps {\n  toasts: ToastMessage[];\n  onDismiss: (id: string) => void;\n}\n\nexport const ToastContainer: React.FC<ToastContainerProps> = ({ toasts, onDismiss }) => {\n  if (toasts.length === 0) return null;\n\n  return (\n    <div className=\"fixed bottom-5 right-5 z-50 flex flex-col gap-2 max-w-sm w-full pointer-events-none\">\n      {toasts.map((toast) => {\n        const getIcon = () => {\n          switch (toast.type) {\n            case \'success\':\n              return <CheckCircle2 className=\"w-4 h-4 text-[#B7E4C7]\" />;\n            case \'warning\':\n              return <AlertCircle className=\"w-4 h-4 text-[#FFE0A3]\" />;\n            case \'ai\':\n              return <Sparkles className=\"w-4 h-4 text-[#A8E6CF]\" />;\n            default:\n              return <Info className=\"w-4 h-4 text-[#A8DADC]\" />;\n          }\n        };\n\n        const getBorder = () => {\n          switch (toast.type) {\n            case \'success\':\n              return \'border-[#B7E4C7]/40 bg-[#293735] text-[#F0F4EE]\';\n            case \'warning\':\n              return \'border-[#FFE0A3]/40 bg-[#293735] text-[#F0F4EE]\';\n            case \'ai\':\n              return \'border-[#A8E6CF]/50 bg-[#293735] text-[#F0F4EE] shadow-[0_0_20px_-5px_rgba(168,230,207,0.3)]\';\n            default:\n              return \'border-[#3B4B47] bg-[#293735] text-[#F0F4EE]\';\n          }\n        };\n\n        return (\n          <div\n            key={toast.id}\n            className={`pointer-events-auto p-4 rounded-xl border shadow-xl flex items-start gap-3 backdrop-blur-lg animate-in slide-in-from-bottom-3 duration-200 ${getBorder()}`}\n          >\n            <div className=\"mt-0.5\">{getIcon()}</div>\n            <div className=\"flex-1 min-w-0\">\n              <div className=\"text-xs font-bold font-mono tracking-tight text-[#F0F4EE]\">\n                {toast.title}\n              </div>\n              <div className=\"text-xs text-[#AAB8B2] mt-0.5 leading-snug\">\n                {toast.message}\n              </div>\n            </div>\n            <button\n              onClick={() => onDismiss(toast.id)}\n              className=\"text-[#71817B] hover:text-[#F0F4EE] p-0.5 rounded transition-colors\"\n            >\n              <X className=\"w-3.5 h-3.5\" />\n            </button>\n          </div>\n        );\n      })}\n    </div>\n  );\n};\n"
    }
