  file_change {
    absolute_path_uri: "file:///src/components/modals/ProjectSwitcherModal.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React from \'react\';\nimport { \n  FolderGit2, \n  Plus, \n  Check, \n  X, \n  Sparkles, \n  Calendar, \n  Users, \n  Clock \n} from \'lucide-react\';\nimport { Project } from \'../../types\';\nimport { formatMinutes } from \'../../services/projectEngine\';\n\ninterface ProjectSwitcherModalProps {\n  isOpen: boolean;\n  onClose: () => void;\n  projects: Project[];\n  activeProjectId: string;\n  onSelectProject: (projectId: string) => void;\n  onOpenCreateNew: () => void;\n}\n\nexport const ProjectSwitcherModal: React.FC<ProjectSwitcherModalProps> = ({\n  isOpen,\n  onClose,\n  projects,\n  activeProjectId,\n  onSelectProject,\n  onOpenCreateNew,\n}) => {\n  if (!isOpen) return null;\n\n  return (\n    <div className=\"fixed inset-0 bg-black/75 z-50 flex items-center justify-center p-4 backdrop-blur-sm\">\n      <div className=\"w-full max-w-lg bg-[#293735] border border-[#3B4B47] rounded-3xl p-6 shadow-2xl relative animate-in fade-in zoom-in-95 duration-200\">\n        {/* Header */}\n        <div className=\"flex items-center justify-between pb-4 border-b border-[#3B4B47]\">\n          <div className=\"flex items-center space-x-2.5\">\n            <div className=\"p-2 rounded-xl bg-[#202B2A] border border-[#3B4B47] text-[#C7F9A6]\">\n              <FolderGit2 className=\"w-4 h-4\" />\n            </div>\n            <div>\n              <h2 className=\"text-base font-bold text-[#F0F4EE]\">YOUR HACKATHONS</h2>\n              <p className=\"text-xs text-[#71817B]\">Select or switch active project sandbox</p>\n            </div>\n          </div>\n          <button\n            onClick={onClose}\n            className=\"p-1.5 rounded-lg text-[#71817B] hover:text-[#F0F4EE] hover:bg-[#202B2A] transition-colors\"\n          >\n            <X className=\"w-4 h-4\" />\n          </button>\n        </div>\n\n        {/* Project List */}\n        <div className=\"py-4 space-y-2.5 max-h-[360px] overflow-y-auto\">\n          {projects.map((proj) => {\n            const isActive = proj.id === activeProjectId;\n            const msLeft = new Date(proj.deadline).getTime() - Date.now();\n            const minsLeft = Math.max(0, Math.floor(msLeft / 60000));\n            const timeLeftFormatted = minsLeft > 0 ? formatMinutes(minsLeft) : \'Ended\';\n\n            return (\n              <div\n                key={proj.id}\n                onClick={() => {\n                  onSelectProject(proj.id);\n                  onClose();\n                }}\n                className={`p-3.5 rounded-2xl border transition-all cursor-pointer flex items-center justify-between group ${\n                  isActive\n                    ? \'bg-[#202B2A] border-[#C7F9A6] shadow-[0_0_15px_rgba(199,249,166,0.15)]\'\n                    : \'bg-[#202B2A]/50 border-[#3B4B47] hover:border-[#71817B] hover:bg-[#202B2A]\'\n                }`}\n              >\n                <div className=\"flex-1 min-w-0 pr-3\">\n                  <div className=\"flex items-center gap-2\">\n                    <span className=\"text-sm font-bold text-[#F0F4EE] truncate\">\n                      {proj.name}\n                    </span>\n                    {proj.isDemo && (\n                      <span className=\"text-[9px] font-mono px-2 py-0.5 rounded bg-[#FFE0A3]/20 text-[#FFE0A3] border border-[#FFE0A3]/30 font-semibold\">\n                        DEMO MODE\n                      </span>\n                    )}\n                  </div>\n                  <div className=\"flex items-center gap-3 mt-1 text-xs text-[#71817B]\">\n                    <span className=\"truncate\">{proj.hackathonName}</span>\n                    <span>\342\200\242</span>\n                    <span className=\"flex items-center gap-1 font-mono text-[#A8E6CF]\">\n                      <Clock className=\"w-3 h-3\" />\n                      <span>{timeLeftFormatted}</span>\n                    </span>\n                  </div>\n                </div>\n\n                <div className=\"flex items-center\">\n                  {isActive ? (\n                    <div className=\"w-6 h-6 rounded-full bg-[#C7F9A6] text-[#202B2A] flex items-center justify-center font-bold\">\n                      <Check className=\"w-3.5 h-3.5\" />\n                    </div>\n                  ) : (\n                    <div className=\"w-6 h-6 rounded-full border border-[#3B4B47] group-hover:border-[#C7F9A6] transition-colors\" />\n                  )}\n                </div>\n              </div>\n            );\n          })}\n        </div>\n\n        {/* Footer Actions */}\n        <div className=\"pt-4 border-t border-[#3B4B47] flex items-center justify-between gap-3\">\n          <button\n            onClick={() => {\n              onClose();\n              onOpenCreateNew();\n            }}\n            className=\"flex-1 py-2.5 px-4 rounded-xl bg-[#C7F9A6] hover:bg-[#b5f58c] text-[#202B2A] font-bold text-xs flex items-center justify-center gap-2 shadow-[0_0_15px_rgba(199,249,166,0.2)] transition-all cursor-pointer\"\n          >\n            <Plus className=\"w-3.5 h-3.5\" />\n            <span>CREATE NEW HACKATHON</span>\n          </button>\n        </div>\n      </div>\n    </div>\n  );\n};\n"
    }
