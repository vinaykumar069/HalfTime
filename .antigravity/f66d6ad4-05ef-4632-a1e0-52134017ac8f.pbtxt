    file_change_type: FILE_CHANGE_TYPE_EDIT
    replacement_chunks {
      target_content: "import React, { useState, useEffect } from \'react\';\nimport { User, KeyRound, Mail, LogOut, CheckCircle2, AlertCircle, X, Shield, Sparkles, Database } from \'lucide-react\';\nimport { supabase, isSupabaseConfigured, getCurrentAuthenticatedUser } from \'../../lib/supabase\';\n\ninterface AuthModalProps {\n  isOpen: boolean;\n  onClose: () => void;\n  onAuthChange?: () => void;\n}\n\nexport const AuthModal: React.FC<AuthModalProps> = ({\n  isOpen,\n  onClose,\n  onAuthChange,\n}) => {\n  const [mode, setMode] = useState<\'signin\' | \'signup\'>(\'signin\');\n  const [email, setEmail] = useState(\'\');\n  const [password, setPassword] = useState(\'\');\n  const [userSession, setUserSession] = useState<any>(null);\n  const [isLoading, setIsLoading] = useState(false);\n  const [errorMsg, setErrorMsg] = useState<string | null>(null);\n  const [successMsg, setSuccessMsg] = useState<string | null>(null);\n\n  useEffect(() => {\n    if (!isOpen) return;\n    checkAuth();\n  }, [isOpen]);\n\n  const checkAuth = async () => {\n    if (isSupabaseConfigured && supabase) {\n      const user = await getCurrentAuthenticatedUser();\n      setUserSession(user);\n    } else {\n      setUserSession(null);\n    }\n  };\n\n  if (!isOpen) return null;\n\n  const handleSignIn = async (e: React.FormEvent) => {\n    e.preventDefault();\n    setErrorMsg(null);\n    setSuccessMsg(null);\n    setIsLoading(true);\n\n    try {\n      if (!isSupabaseConfigured || !supabase) {\n        throw new Error(\'Supabase storage is not configured. Please add VITE_SUPABASE_URL and VITE_SUPABASE_ANON_KEY.\');\n      }\n\n      const { data, error } = await supabase.auth.signInWithPassword({\n        email: email.trim(),\n        password,\n      });\n\n      if (error) {\n        setErrorMsg(error.message);\n      } else if (data.user) {\n        setUserSession(data.user);\n        setSuccessMsg(\'Successfully signed in! Your projects and data are isolated with Supabase RLS.\');\n        setTimeout(() => {\n          onClose();\n          onAuthChange?.();\n        }, 1000);\n      }\n    } catch (err: any) {\n      setErrorMsg(err.message || \'Authentication error.\');\n    } finally {\n      setIsLoading(false);\n    }\n  };\n\n  const handleSignUp = async (e: React.FormEvent) => {\n    e.preventDefault();\n    setErrorMsg(null);\n    setSuccessMsg(null);\n    setIsLoading(true);\n\n    try {\n      if (!isSupabaseConfigured || !supabase) {\n        throw new Error(\'Supabase storage is not configured. Please configure valid Supabase credentials.\');\n      }\n\n      const { data, error } = await supabase.auth.signUp({\n        email: email.trim(),\n        password,\n      });\n\n      if (error) {\n        setErrorMsg(error.message);\n      } else if (data.user) {\n        setUserSession(data.user);\n        setSuccessMsg(\'Account created successfully! You are now signed in.\');\n        setTimeout(() => {\n          onClose();\n          onAuthChange?.();\n        }, 1200);\n      }\n    } catch (err: any) {\n      setErrorMsg(err.message || \'Signup error.\');\n    } finally {\n      setIsLoading(false);\n    }\n  };\n\n  const handleSignOut = async () => {\n    setIsLoading(true);\n    setErrorMsg(null);\n    try {\n      if (supabase) {\n        await supabase.auth.signOut();\n      }\n      setUserSession(null);\n      setSuccessMsg(\'Signed out successfully.\');\n      setTimeout(() => {\n        onClose();\n        onAuthChange?.();\n      }, 800);\n    } catch (err: any) {\n      setErrorMsg(err.message || \'Sign out failed.\');\n    } finally {\n      setIsLoading(false);\n    }\n  };\n\n  return (\n    <div className=\"fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/80 backdrop-blur-sm animate-fadeIn\">\n      <div className=\"bg-[#202B2A] border border-[#3B4B47] rounded-2xl w-full max-w-md p-6 sm:p-8 shadow-2xl relative\">\n        <button\n          onClick={onClose}\n          className=\"absolute top-4 right-4 p-2 text-[#71817B] hover:text-[#F0F4EE] rounded-lg transition-colors cursor-pointer\"\n        >\n          <X className=\"w-5 h-5\" />\n        </button>\n\n        <div className=\"flex items-center gap-3 mb-6\">\n          <div className=\"w-10 h-10 rounded-xl bg-[#293735] border border-[#3B4B47] flex items-center justify-center text-[#C7F9A6]\">\n            <Shield className=\"w-5 h-5\" />\n          </div>\n          <div>\n            <h2 className=\"text-xl font-bold text-[#F0F4EE] font-mono\">\n              {userSession ? \'Authenticated Account\' : mode === \'signin\' ? \'Sign In\' : \'Create Account\'}\n            </h2>\n            <p className=\"text-xs text-[#71817B]\">\n              Supabase Auth & Row Level Security\n            </p>\n          </div>\n        </div>\n\n        {errorMsg && (\n          <div className=\"mb-4 p-3 rounded-xl bg-[#FFB7B2]/10 border border-[#FFB7B2]/30 flex items-start gap-2.5 text-xs text-[#FFB7B2]\">\n            <AlertCircle className=\"w-4 h-4 shrink-0 mt-0.5\" />\n            <span>{errorMsg}</span>\n          </div>\n        )}\n\n        {successMsg && (\n          <div className=\"mb-4 p-3 rounded-xl bg-[#C7F9A6]/10 border border-[#C7F9A6]/30 flex items-start gap-2.5 text-xs text-[#C7F9A6]\">\n            <CheckCircle2 className=\"w-4 h-4 shrink-0 mt-0.5\" />\n            <span>{successMsg}</span>\n          </div>\n        )}\n\n        {userSession ? (\n          <div className=\"space-y-4\">\n            <div className=\"p-4 rounded-xl bg-[#293735] border border-[#3B4B47] space-y-3\">\n              <div className=\"flex items-center justify-between\">\n                <span className=\"text-xs text-[#71817B] font-mono uppercase\">Status</span>\n                <span className=\"inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full text-[10px] font-mono font-medium bg-[#C7F9A6]/20 text-[#C7F9A6]\">\n                  <span className=\"w-1.5 h-1.5 rounded-full bg-[#C7F9A6] animate-pulse\" />\n                  AUTHENTICATED\n                </span>\n              </div>\n              <div>\n                <span className=\"text-[11px] text-[#71817B] font-mono block mb-0.5\">Email</span>\n                <span className=\"text-sm font-mono text-[#F0F4EE]\">{userSession.email || \'Supabase User\'}</span>\n              </div>\n              <div>\n                <span className=\"text-[11px] text-[#71817B] font-mono block mb-0.5\">User ID (RLS Protected)</span>\n                <span className=\"text-xs font-mono text-[#AAB8B2] break-all\">{userSession.id}</span>\n              </div>\n            </div>\n\n            <button\n              onClick={handleSignOut}\n              disabled={isLoading}\n              className=\"w-full flex items-center justify-center gap-2 py-3 rounded-xl bg-[#FFB7B2]/20 hover:bg-[#FFB7B2]/30 text-[#FFB7B2] border border-[#FFB7B2]/40 font-mono text-xs font-bold transition-all cursor-pointer disabled:opacity-50\"\n            >\n              <LogOut className=\"w-4 h-4\" />\n              {isLoading ? \'SIGNING OUT...\' : \'SIGN OUT\'}\n            </button>\n          </div>\n        ) : (\n          <div>\n            {!isSupabaseConfigured && (\n              <div className=\"mb-4 p-3 rounded-xl bg-amber-500/10 border border-amber-500/20 text-amber-300 text-xs flex items-start gap-2\">\n                <Database className=\"w-4 h-4 shrink-0 mt-0.5\" />\n                <span>Supabase is not configured yet. Configure VITE_SUPABASE_URL and VITE_SUPABASE_ANON_KEY to enable live cloud sign-in.</span>\n              </div>\n            )}\n\n            <form onSubmit={mode === \'signin\' ? handleSignIn : handleSignUp} className=\"space-y-4\">\n              <div>\n                <label className=\"block text-xs font-mono text-[#AAB8B2] mb-1.5\">Email Address</label>\n                <div className=\"relative\">\n                  <Mail className=\"w-4 h-4 absolute left-3.5 top-1/2 -translate-y-1/2 text-[#71817B]\" />\n                  <input\n                    type=\"email\"\n                    required\n                    value={email}\n                    onChange={e => setEmail(e.target.value)}\n                    placeholder=\"builder@hackathon.com\"\n                    className=\"w-full bg-[#293735] border border-[#3B4B47] rounded-xl pl-10 pr-4 py-2.5 text-xs text-[#F0F4EE] placeholder-[#71817B] focus:outline-none focus:border-[#C7F9A6] font-mono\"\n                  />\n                </div>\n              </div>\n\n              <div>\n                <label className=\"block text-xs font-mono text-[#AAB8B2] mb-1.5\">Password</label>\n                <div className=\"relative\">\n                  <KeyRound className=\"w-4 h-4 absolute left-3.5 top-1/2 -translate-y-1/2 text-[#71817B]\" />\n                  <input\n                    type=\"password\"\n                    required\n                    minLength={6}\n                    value={password}\n                    onChange={e => setPassword(e.target.value)}\n                    placeholder=\"\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\"\n                    className=\"w-full bg-[#293735] border border-[#3B4B47] rounded-xl pl-10 pr-4 py-2.5 text-xs text-[#F0F4EE] placeholder-[#71817B] focus:outline-none focus:border-[#C7F9A6] font-mono\"\n                  />\n                </div>\n              </div>\n\n              <button\n                type=\"submit\"\n                disabled={isLoading}\n                className=\"w-full flex items-center justify-center gap-2 py-3 rounded-xl bg-[#C7F9A6] hover:bg-[#b8f590] text-[#141E1D] font-mono text-xs font-bold transition-all shadow-lg shadow-[#C7F9A6]/20 cursor-pointer disabled:opacity-50 mt-6\"\n              >\n                {isLoading ? (\n                  <span>AUTHENTICATING...</span>\n                ) : (\n                  <>\n                    <Sparkles className=\"w-4 h-4\" />\n                    <span>{mode === \'signin\' ? \'SIGN IN WITH SUPABASE\' : \'CREATE SUPABASE ACCOUNT\'}</span>\n                  </>\n                )}\n              </button>\n            </form>\n\n            <div className=\"mt-5 text-center\">\n              <button\n                onClick={() => {\n                  setMode(mode === \'signin\' ? \'signup\' : \'signin\');\n                  setErrorMsg(null);\n                  setSuccessMsg(null);\n                }}\n                className=\"text-xs text-[#A8E6CF] hover:underline font-mono cursor-pointer\"\n              >\n                {mode === \'signin\'\n                  ? \"Don\'t have an account? Sign up\"\n                  : \'Already have an account? Sign in\'}\n              </button>\n            </div>\n          </div>\n        )}\n      </div>\n    </div>\n  );\n};\n"
      replacement_content: "import React, { useState, useEffect } from \'react\';\nimport { \n  KeyRound, \n  Mail, \n  LogOut, \n  CheckCircle2, \n  AlertCircle, \n  X, \n  Shield, \n  Sparkles, \n  Database,\n  ExternalLink,\n  RefreshCw,\n  ArrowLeft,\n  Inbox,\n  Clock\n} from \'lucide-react\';\nimport { \n  supabase, \n  isSupabaseConfigured, \n  getCurrentAuthenticatedUser,\n  getFriendlyAuthErrorMessage,\n  getEmailProviderUrl,\n  resendConfirmationEmail\n} from \'../../lib/supabase\';\n\nexport type AuthModalView = \'signin\' | \'signup\' | \'unconfirmed\' | \'confirmed\' | \'authenticated\';\n\nexport type UnconfirmedSource = \'signup\' | \'signin\';\n\ninterface AuthModalProps {\n  isOpen: boolean;\n  onClose: () => void;\n  onAuthChange?: () => void;\n  initialView?: AuthModalView;\n  initialEmail?: string;\n  initialUnconfirmedSource?: UnconfirmedSource;\n}\n\nexport const AuthModal: React.FC<AuthModalProps> = ({\n  isOpen,\n  onClose,\n  onAuthChange,\n  initialView = \'signin\',\n  initialEmail = \'\',\n  initialUnconfirmedSource = \'signup\',\n}) => {\n  const [view, setView] = useState<AuthModalView>(initialView);\n  const [unconfirmedSource, setUnconfirmedSource] = useState<UnconfirmedSource>(initialUnconfirmedSource);\n  const [email, setEmail] = useState(initialEmail);\n  const [password, setPassword] = useState(\'\');\n  const [userSession, setUserSession] = useState<any>(null);\n  \n  // Action Loading & Errors\n  const [isLoading, setIsLoading] = useState(false);\n  const [errorMsg, setErrorMsg] = useState<string | null>(null);\n  const [successMsg, setSuccessMsg] = useState<string | null>(null);\n\n  // Resend State & Cooldown\n  const [isResending, setIsResending] = useState(false);\n  const [resendCooldown, setResendCooldown] = useState(0);\n  const [resendStatusMsg, setResendStatusMsg] = useState<string | null>(null);\n  const [resendErrorMsg, setResendErrorMsg] = useState<string | null>(null);\n\n  // Sync initial state when modal opens\n  useEffect(() => {\n    if (!isOpen) return;\n    setErrorMsg(null);\n    setSuccessMsg(null);\n    setResendStatusMsg(null);\n    setResendErrorMsg(null);\n\n    if (initialEmail) {\n      setEmail(initialEmail);\n    }\n    if (initialView) {\n      setView(initialView);\n    }\n    if (initialUnconfirmedSource) {\n      setUnconfirmedSource(initialUnconfirmedSource);\n    }\n\n    checkAuth();\n  }, [isOpen, initialView, initialEmail, initialUnconfirmedSource]);\n\n  // Cooldown countdown timer for resend\n  useEffect(() => {\n    if (resendCooldown <= 0) return;\n    const timer = setInterval(() => {\n      setResendCooldown(prev => {\n        if (prev <= 1) {\n          clearInterval(timer);\n          return 0;\n        }\n        return prev - 1;\n      });\n    }, 1000);\n\n    return () => clearInterval(timer);\n  }, [resendCooldown]);\n\n  const checkAuth = async () => {\n    if (isSupabaseConfigured && supabase) {\n      const user = await getCurrentAuthenticatedUser();\n      setUserSession(user);\n      if (user && view !== \'confirmed\' && view !== \'unconfirmed\') {\n        setView(\'authenticated\');\n      }\n    } else {\n      setUserSession(null);\n    }\n  };\n\n  if (!isOpen) return null;\n\n  // 1. Sign In Handler\n  const handleSignIn = async (e: React.FormEvent) => {\n    e.preventDefault();\n    setErrorMsg(null);\n    setSuccessMsg(null);\n    setResendStatusMsg(null);\n    setResendErrorMsg(null);\n    setIsLoading(true);\n\n    try {\n      if (!isSupabaseConfigured || !supabase) {\n        throw new Error(\'Supabase storage is not configured. Please add VITE_SUPABASE_URL and VITE_SUPABASE_ANON_KEY.\');\n      }\n\n      const cleanEmail = email.trim();\n      const { data, error } = await supabase.auth.signInWithPassword({\n        email: cleanEmail,\n        password,\n      });\n\n      if (error) {\n        const friendly = getFriendlyAuthErrorMessage(error);\n        if (friendly.isUnconfirmed) {\n          // Switch directly to unconfirmed screen with clear instructions\n          setUnconfirmedSource(\'signin\');\n          setView(\'unconfirmed\');\n          return;\n        }\n        setErrorMsg(friendly.message);\n      } else if (data.user) {\n        setUserSession(data.user);\n        setSuccessMsg(\'Successfully signed in! Your workspace is ready.\');\n        setTimeout(() => {\n          onClose();\n          onAuthChange?.();\n        }, 800);\n      }\n    } catch (err: any) {\n      const friendly = getFriendlyAuthErrorMessage(err);\n      setErrorMsg(friendly.message);\n    } finally {\n      setIsLoading(false);\n    }\n  };\n\n  // 2. Sign Up Handler\n  const handleSignUp = async (e: React.FormEvent) => {\n    e.preventDefault();\n    setErrorMsg(null);\n    setSuccessMsg(null);\n    setResendStatusMsg(null);\n    setResendErrorMsg(null);\n    setIsLoading(true);\n\n    try {\n      if (!isSupabaseConfigured || !supabase) {\n        throw new Error(\'Supabase storage is not configured. Please configure valid Supabase credentials.\');\n      }\n\n      const cleanEmail = email.trim();\n      const { data, error } = await supabase.auth.signUp({\n        email: cleanEmail,\n        password,\n        options: {\n          emailRedirectTo: `${window.location.origin}/`,\n        },\n      });\n\n      if (error) {\n        const friendly = getFriendlyAuthErrorMessage(error);\n        setErrorMsg(friendly.message);\n      } else if (data.user) {\n        // If Supabase does NOT require email confirmation (session exists immediately)\n        if (data.session) {\n          setUserSession(data.user);\n          setSuccessMsg(\'Account created successfully! You are now signed in.\');\n          setTimeout(() => {\n            onClose();\n            onAuthChange?.();\n          }, 1000);\n        } else {\n          // Supabase REQUIRES email confirmation\n          setPassword(\'\'); // clear password for safety\n          setUnconfirmedSource(\'signup\');\n          setView(\'unconfirmed\');\n          setResendCooldown(60); // Start 60s cooldown for safety\n        }\n      }\n    } catch (err: any) {\n      const friendly = getFriendlyAuthErrorMessage(err);\n      setErrorMsg(friendly.message);\n    } finally {\n      setIsLoading(false);\n    }\n  };\n\n  // 3. Resend Confirmation Handler\n  const handleResend = async () => {\n    if (resendCooldown > 0 || isResending) return;\n    setIsResending(true);\n    setResendStatusMsg(null);\n    setResendErrorMsg(null);\n\n    const { success, error } = await resendConfirmationEmail(email);\n\n    setIsResending(false);\n    if (success) {\n      setResendStatusMsg(\'Confirmation email sent.\');\n      setResendCooldown(60);\n    } else {\n      setResendErrorMsg(error || \'Failed to resend confirmation email. Please try again.\');\n    }\n  };\n\n  // 4. Sign Out Handler\n  const handleSignOut = async () => {\n    setIsLoading(true);\n    setErrorMsg(null);\n    try {\n      if (supabase) {\n        await supabase.auth.signOut();\n      }\n      setUserSession(null);\n      setView(\'signin\');\n      setSuccessMsg(\'Signed out successfully.\');\n      setTimeout(() => {\n        onClose();\n        onAuthChange?.();\n      }, 700);\n    } catch (err: any) {\n      const friendly = getFriendlyAuthErrorMessage(err);\n      setErrorMsg(friendly.message);\n    } finally {\n      setIsLoading(false);\n    }\n  };\n\n  const providerInfo = getEmailProviderUrl(email);\n\n  return (\n    <div id=\"halftime-auth-modal\" className=\"fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/80 backdrop-blur-sm animate-fadeIn\">\n      <div className=\"bg-[#202B2A] border border-[#3B4B47] rounded-2xl w-full max-w-md p-6 sm:p-8 shadow-2xl relative text-[#F0F4EE]\">\n        {/* Close Button */}\n        <button\n          id=\"auth-modal-close-btn\"\n          onClick={onClose}\n          className=\"absolute top-4 right-4 p-2 text-[#71817B] hover:text-[#F0F4EE] rounded-lg transition-colors cursor-pointer\"\n          title=\"Close dialog\"\n        >\n          <X className=\"w-5 h-5\" />\n        </button>\n\n        {/* ========================================================================= */}\n        {/* VIEW 1: UNCONFIRMED EMAIL SCREEN (Check Email or Email Not Confirmed)      */}\n        {/* ========================================================================= */}\n        {view === \'unconfirmed\' && (\n          <div id=\"auth-unconfirmed-screen\" className=\"space-y-5 animate-fadeIn\">\n            {/* Header Icon */}\n            <div className=\"flex items-center gap-3\">\n              <div className=\"w-12 h-12 rounded-2xl bg-[#293735] border border-[#3B4B47] flex items-center justify-center text-[#FFE0A3] shadow-inner\">\n                <Inbox className=\"w-6 h-6 animate-pulse\" />\n              </div>\n              <div>\n                <h2 className=\"text-lg sm:text-xl font-bold text-[#F0F4EE] font-mono tracking-tight\">\n                  {unconfirmedSource === \'signup\' ? \'CHECK YOUR EMAIL\' : \'EMAIL NOT CONFIRMED\'}\n                </h2>\n                <p className=\"text-xs text-[#AAB8B2] font-mono\">\n                  {unconfirmedSource === \'signup\' ? \'Supabase Account Verification\' : \'Verification Required\'}\n                </p>\n              </div>\n            </div>\n\n            {/* Explanatory Message */}\n            <div className=\"p-4 rounded-xl bg-[#293735]/80 border border-[#3B4B47] space-y-2 text-xs text-[#F0F4EE] leading-relaxed\">\n              {unconfirmedSource === \'signup\' ? (\n                <>\n                  <p className=\"font-medium\">\n                    We&apos;ve created your <span className=\"text-[#C7F9A6] font-bold\">HALFTIME</span> account.\n                  </p>\n                  <p className=\"text-[#AAB8B2]\">\n                    Please confirm your email address using the link we sent you before signing in.\n                  </p>\n                </>\n              ) : (\n                <p className=\"font-medium text-[#FFE0A3]\">\n                  Please confirm your email address before signing in.\n                </p>\n              )}\n\n              {/* Target Email Box */}\n              <div className=\"pt-2\">\n                <div className=\"px-3 py-2 rounded-lg bg-[#202B2A] border border-[#3B4B47] flex items-center justify-between text-xs font-mono\">\n                  <div className=\"flex items-center gap-2 truncate\">\n                    <Mail className=\"w-3.5 h-3.5 text-[#C7F9A6] shrink-0\" />\n                    <span className=\"text-[#F0F4EE] font-medium truncate\">{email || \'your email\'}</span>\n                  </div>\n                  <span className=\"text-[10px] px-1.5 py-0.5 rounded bg-[#FFE0A3]/20 text-[#FFE0A3] font-bold uppercase tracking-wider shrink-0\">\n                    PENDING\n                  </span>\n                </div>\n              </div>\n            </div>\n\n            {/* Resend Status / Error Feedback */}\n            {resendStatusMsg && (\n              <div className=\"p-3 rounded-xl bg-[#C7F9A6]/10 border border-[#C7F9A6]/30 flex items-center gap-2.5 text-xs text-[#C7F9A6] font-mono animate-fadeIn\">\n                <CheckCircle2 className=\"w-4 h-4 shrink-0\" />\n                <span>{resendStatusMsg}</span>\n              </div>\n            )}\n\n            {resendErrorMsg && (\n              <div className=\"p-3 rounded-xl bg-[#FFB7B2]/10 border border-[#FFB7B2]/30 flex items-center gap-2.5 text-xs text-[#FFB7B2] font-mono animate-fadeIn\">\n                <AlertCircle className=\"w-4 h-4 shrink-0\" />\n                <span>{resendErrorMsg}</span>\n              </div>\n            )}\n\n            {/* Action Buttons */}\n            <div className=\"space-y-2.5 pt-1\">\n              {/* Button 1: Open Webmail Client */}\n              <a\n                id=\"auth-open-email-btn\"\n                href={providerInfo.url}\n                target=\"_blank\"\n                rel=\"noopener noreferrer\"\n                className=\"w-full flex items-center justify-center gap-2 py-3 rounded-xl bg-[#C7F9A6] hover:bg-[#b5f58c] text-[#141E1D] font-mono text-xs font-bold transition shadow-lg shadow-[#C7F9A6]/20 cursor-pointer\"\n              >\n                <span>{providerInfo.name}</span>\n                <ExternalLink className=\"w-3.5 h-3.5\" />\n              </a>\n\n              {/* Button 2: Resend Confirmation Email */}\n              <button\n                id=\"auth-resend-email-btn\"\n                type=\"button\"\n                onClick={handleResend}\n                disabled={isResending || resendCooldown > 0}\n                className=\"w-full flex items-center justify-center gap-2 py-2.5 rounded-xl bg-[#293735] hover:bg-[#31413F] text-[#F0F4EE] border border-[#3B4B47] font-mono text-xs font-semibold transition disabled:opacity-50 disabled:cursor-not-allowed cursor-pointer\"\n              >\n                {isResending ? (\n                  <>\n                    <RefreshCw className=\"w-3.5 h-3.5 animate-spin\" />\n                    <span>SENDING...</span>\n                  </>\n                ) : resendCooldown > 0 ? (\n                  <>\n                    <Clock className=\"w-3.5 h-3.5 text-[#FFE0A3]\" />\n                    <span>RESEND IN {resendCooldown}s</span>\n                  </>\n                ) : (\n                  <>\n                    <Mail className=\"w-3.5 h-3.5 text-[#A8E6CF]\" />\n                    <span>RESEND CONFIRMATION EMAIL</span>\n                  </>\n                )}\n              </button>\n\n              {/* Button 3: Back to Sign In / Try Again */}\n              <button\n                id=\"auth-back-to-signin-btn\"\n                type=\"button\"\n                onClick={() => {\n                  setView(\'signin\');\n                  setErrorMsg(null);\n                  setSuccessMsg(null);\n                }}\n                className=\"w-full flex items-center justify-center gap-2 py-2 rounded-xl text-[#AAB8B2] hover:text-[#F0F4EE] font-mono text-xs transition cursor-pointer\"\n              >\n                <ArrowLeft className=\"w-3.5 h-3.5\" />\n                <span>{unconfirmedSource === \'signin\' ? \'TRY AGAIN\' : \'BACK TO SIGN IN\'}</span>\n              </button>\n            </div>\n\n            {/* Helpful Instructions Card */}\n            <div className=\"p-3.5 rounded-xl bg-[#182120] border border-[#293735] text-[11px] text-[#71817B] space-y-1\">\n              <p className=\"font-semibold text-[#AAB8B2] font-mono\">Didn&apos;t receive it?</p>\n              <ul className=\"space-y-1 list-disc list-inside leading-relaxed\">\n                <li>Check your spam or junk folder.</li>\n                <li>If you still don&apos;t see it, resend the confirmation email.</li>\n              </ul>\n            </div>\n          </div>\n        )}\n\n        {/* ========================================================================= */}\n        {/* VIEW 2: CONFIRMED SUCCESS SCREEN                                          */}\n        {/* ========================================================================= */}\n        {view === \'confirmed\' && (\n          <div id=\"auth-confirmed-screen\" className=\"space-y-6 text-center animate-fadeIn py-2\">\n            <div className=\"w-14 h-14 rounded-2xl bg-[#C7F9A6]/10 border border-[#C7F9A6]/30 flex items-center justify-center text-[#C7F9A6] mx-auto shadow-lg shadow-[#C7F9A6]/10\">\n              <CheckCircle2 className=\"w-8 h-8\" />\n            </div>\n\n            <div className=\"space-y-1.5\">\n              <h2 className=\"text-xl font-bold text-[#F0F4EE] font-mono\">EMAIL CONFIRMED</h2>\n              <p className=\"text-xs text-[#AAB8B2] leading-relaxed\">\n                Your account is ready. You can now sign in to your workspace.\n              </p>\n            </div>\n\n            <button\n              id=\"auth-confirmed-signin-btn\"\n              onClick={() => {\n                setView(\'signin\');\n                setErrorMsg(null);\n              }}\n              className=\"w-full py-3 rounded-xl bg-[#C7F9A6] hover:bg-[#b5f58c] text-[#141E1D] font-mono text-xs font-bold transition shadow-lg shadow-[#C7F9A6]/20 cursor-pointer\"\n            >\n              SIGN IN\n            </button>\n          </div>\n        )}\n\n        {/* ========================================================================= */}\n        {/* VIEW 3: AUTHENTICATED ACCOUNT SCREEN (When User is already logged in)     */}\n        {/* ========================================================================= */}\n        {view === \'authenticated\' && userSession && (\n          <div id=\"auth-authenticated-screen\" className=\"space-y-5 animate-fadeIn\">\n            <div className=\"flex items-center gap-3\">\n              <div className=\"w-10 h-10 rounded-xl bg-[#293735] border border-[#3B4B47] flex items-center justify-center text-[#C7F9A6]\">\n                <Shield className=\"w-5 h-5\" />\n              </div>\n              <div>\n                <h2 className=\"text-lg font-bold text-[#F0F4EE] font-mono\">Authenticated Account</h2>\n                <p className=\"text-xs text-[#71817B]\">Supabase Auth & Row Level Security</p>\n              </div>\n            </div>\n\n            {successMsg && (\n              <div className=\"p-3 rounded-xl bg-[#C7F9A6]/10 border border-[#C7F9A6]/30 flex items-start gap-2.5 text-xs text-[#C7F9A6]\">\n                <CheckCircle2 className=\"w-4 h-4 shrink-0 mt-0.5\" />\n                <span>{successMsg}</span>\n              </div>\n            )}\n\n            <div className=\"p-4 rounded-xl bg-[#293735] border border-[#3B4B47] space-y-3\">\n              <div className=\"flex items-center justify-between\">\n                <span className=\"text-xs text-[#71817B] font-mono uppercase\">Status</span>\n                <span className=\"inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full text-[10px] font-mono font-medium bg-[#C7F9A6]/20 text-[#C7F9A6]\">\n                  <span className=\"w-1.5 h-1.5 rounded-full bg-[#C7F9A6] animate-pulse\" />\n                  AUTHENTICATED\n                </span>\n              </div>\n              <div>\n                <span className=\"text-[11px] text-[#71817B] font-mono block mb-0.5\">Email</span>\n                <span className=\"text-sm font-mono text-[#F0F4EE] break-all\">{userSession.email || \'Supabase User\'}</span>\n              </div>\n              <div>\n                <span className=\"text-[11px] text-[#71817B] font-mono block mb-0.5\">User ID (RLS Protected)</span>\n                <span className=\"text-xs font-mono text-[#AAB8B2] break-all\">{userSession.id}</span>\n              </div>\n            </div>\n\n            <button\n              id=\"auth-signout-btn\"\n              onClick={handleSignOut}\n              disabled={isLoading}\n              className=\"w-full flex items-center justify-center gap-2 py-3 rounded-xl bg-[#FFB7B2]/20 hover:bg-[#FFB7B2]/30 text-[#FFB7B2] border border-[#FFB7B2]/40 font-mono text-xs font-bold transition-all cursor-pointer disabled:opacity-50\"\n            >\n              <LogOut className=\"w-4 h-4\" />\n              {isLoading ? \'SIGNING OUT...\' : \'SIGN OUT\'}\n            </button>\n          </div>\n        )}\n\n        {/* ========================================================================= */}\n        {/* VIEW 4: SIGN IN / SIGN UP FORM                                            */}\n        {/* ========================================================================= */}\n        {(view === \'signin\' || view === \'signup\') && (\n          <div id=\"auth-form-screen\" className=\"animate-fadeIn\">\n            <div className=\"flex items-center gap-3 mb-6\">\n              <div className=\"w-10 h-10 rounded-xl bg-[#293735] border border-[#3B4B47] flex items-center justify-center text-[#C7F9A6]\">\n                <Shield className=\"w-5 h-5\" />\n              </div>\n              <div>\n                <h2 className=\"text-xl font-bold text-[#F0F4EE] font-mono\">\n                  {view === \'signin\' ? \'Sign In\' : \'Create Account\'}\n                </h2>\n                <p className=\"text-xs text-[#71817B]\">\n                  Supabase Auth & Row Level Security\n                </p>\n              </div>\n            </div>\n\n            {/* Error Message Banner */}\n            {errorMsg && (\n              <div className=\"mb-4 p-3 rounded-xl bg-[#FFB7B2]/10 border border-[#FFB7B2]/30 flex items-start gap-2.5 text-xs text-[#FFB7B2] animate-fadeIn\">\n                <AlertCircle className=\"w-4 h-4 shrink-0 mt-0.5\" />\n                <span className=\"leading-relaxed\">{errorMsg}</span>\n              </div>\n            )}\n\n            {/* Success Message Banner */}\n            {successMsg && (\n              <div className=\"mb-4 p-3 rounded-xl bg-[#C7F9A6]/10 border border-[#C7F9A6]/30 flex items-start gap-2.5 text-xs text-[#C7F9A6] animate-fadeIn\">\n                <CheckCircle2 className=\"w-4 h-4 shrink-0 mt-0.5\" />\n                <span>{successMsg}</span>\n              </div>\n            )}\n\n            {!isSupabaseConfigured && (\n              <div className=\"mb-4 p-3 rounded-xl bg-amber-500/10 border border-amber-500/20 text-amber-300 text-xs flex items-start gap-2\">\n                <Database className=\"w-4 h-4 shrink-0 mt-0.5\" />\n                <span>Supabase is not configured yet. Configure VITE_SUPABASE_URL and VITE_SUPABASE_ANON_KEY to enable live cloud sign-in.</span>\n              </div>\n            )}\n\n            <form onSubmit={view === \'signin\' ? handleSignIn : handleSignUp} className=\"space-y-4\">\n              <div>\n                <label className=\"block text-xs font-mono text-[#AAB8B2] mb-1.5\">Email Address</label>\n                <div className=\"relative\">\n                  <Mail className=\"w-4 h-4 absolute left-3.5 top-1/2 -translate-y-1/2 text-[#71817B]\" />\n                  <input\n                    id=\"auth-input-email\"\n                    type=\"email\"\n                    required\n                    value={email}\n                    onChange={e => setEmail(e.target.value)}\n                    placeholder=\"builder@hackathon.com\"\n                    className=\"w-full bg-[#293735] border border-[#3B4B47] rounded-xl pl-10 pr-4 py-2.5 text-xs text-[#F0F4EE] placeholder-[#71817B] focus:outline-none focus:border-[#C7F9A6] font-mono\"\n                  />\n                </div>\n              </div>\n\n              <div>\n                <div className=\"flex items-center justify-between mb-1.5\">\n                  <label className=\"block text-xs font-mono text-[#AAB8B2]\">Password</label>\n                  {view === \'signup\' && (\n                    <span className=\"text-[10px] text-[#71817B] font-mono\">Min 6 chars</span>\n                  )}\n                </div>\n                <div className=\"relative\">\n                  <KeyRound className=\"w-4 h-4 absolute left-3.5 top-1/2 -translate-y-1/2 text-[#71817B]\" />\n                  <input\n                    id=\"auth-input-password\"\n                    type=\"password\"\n                    required\n                    minLength={6}\n                    value={password}\n                    onChange={e => setPassword(e.target.value)}\n                    placeholder=\"\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\"\n                    className=\"w-full bg-[#293735] border border-[#3B4B47] rounded-xl pl-10 pr-4 py-2.5 text-xs text-[#F0F4EE] placeholder-[#71817B] focus:outline-none focus:border-[#C7F9A6] font-mono\"\n                  />\n                </div>\n              </div>\n\n              <button\n                id=\"auth-submit-btn\"\n                type=\"submit\"\n                disabled={isLoading}\n                className=\"w-full flex items-center justify-center gap-2 py-3 rounded-xl bg-[#C7F9A6] hover:bg-[#b8f590] text-[#141E1D] font-mono text-xs font-bold transition-all shadow-lg shadow-[#C7F9A6]/20 cursor-pointer disabled:opacity-50 mt-6\"\n              >\n                {isLoading ? (\n                  <span>AUTHENTICATING...</span>\n                ) : (\n                  <>\n                    <Sparkles className=\"w-4 h-4\" />\n                    <span>{view === \'signin\' ? \'SIGN IN WITH SUPABASE\' : \'CREATE ACCOUNT\'}</span>\n                  </>\n                )}\n              </button>\n            </form>\n\n            <div className=\"mt-5 text-center\">\n              <button\n                id=\"auth-toggle-mode-btn\"\n                onClick={() => {\n                  setView(view === \'signin\' ? \'signup\' : \'signin\');\n                  setErrorMsg(null);\n                  setSuccessMsg(null);\n                }}\n                className=\"text-xs text-[#A8E6CF] hover:underline font-mono cursor-pointer\"\n              >\n                {view === \'signin\'\n                  ? \"Don\'t have an account? Sign up\"\n                  : \'Already have an account? Sign in\'}\n              </button>\n            </div>\n          </div>\n        )}\n      </div>\n    </div>\n  );\n};\n"
    }
