    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useEffect, useState } from \'react\';\nimport { Sparkles, Terminal, Activity, ShieldAlert, CheckCircle2 } from \'lucide-react\';\nimport { HealthStatus } from \'../types\';\n\ninterface TopBarProps {\n  healthStatus: HealthStatus;\n  onOpenCommandPalette: () => void;\n  onOpenShipMode: () => void;\n  shipModeReady: boolean;\n}\n\nexport const TopBar: React.FC<TopBarProps> = ({\n  healthStatus,\n  onOpenCommandPalette,\n  onOpenShipMode,\n  shipModeReady,\n}) => {\n  // Live ticking countdown simulation (31h 42m 17s counting down)\n  const [secondsLeft, setSecondsLeft] = useState(31 * 3600 + 42 * 60 + 17);\n\n  useEffect(() => {\n    const timer = setInterval(() => {\n      setSecondsLeft((prev) => (prev > 0 ? prev - 1 : 0));\n    }, 1000);\n    return () => clearInterval(timer);\n  }, []);\n\n  const hours = Math.floor(secondsLeft / 3600);\n  const minutes = Math.floor((secondsLeft % 3600) / 60);\n  const seconds = secondsLeft % 60;\n\n  const pad = (n: number) => n.toString().padStart(2, \'0\');\n\n  const isCritical = healthStatus === \'critical\' || healthStatus === \'at-risk\';\n\n  return (\n    <header \n      id=\"halftime-topbar\"\n      className=\"sticky top-0 z-30 h-16 w-full bg-[#202B2A]/90 backdrop-blur-md border-b border-[#3B4B47] px-4 md:px-8 flex items-center justify-between transition-colors\"\n    >\n      {/* Left hackathon context */}\n      <div className=\"flex items-center gap-3\">\n        <div className=\"flex items-center gap-2 px-2.5 py-1 rounded-md bg-[#293735] border border-[#3B4B47] text-xs font-mono text-[#AAB8B2]\">\n          <span className=\"w-2 h-2 rounded-full bg-[#C7F9A6] animate-pulse\" />\n          <span className=\"font-semibold text-[#F0F4EE]\">DORAHACKS 2.0</span>\n        </div>\n\n        <div className=\"hidden sm:flex items-center gap-1.5 px-2.5 py-1 rounded-md bg-[#293735]/60 border border-[#3B4B47]/60 text-xs font-mono text-[#AAB8B2]\">\n          <span className=\"text-[#71817B]\">TEAM:</span>\n          <span className=\"text-[#CDB4DB] font-semibold\">TEAM DOOM</span>\n        </div>\n\n        {/* Status pill */}\n        <div className={`hidden lg:flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-mono border transition-all ${\n          healthStatus === \'on-track\' \n            ? \'bg-[#B7E4C7]/10 text-[#B7E4C7] border-[#B7E4C7]/30\' \n            : \'bg-[#FFB7B2]/10 text-[#FFB7B2] border-[#FFB7B2]/30\'\n        }`}>\n          {healthStatus === \'on-track\' ? (\n            <>\n              <CheckCircle2 className=\"w-3.5 h-3.5 text-[#B7E4C7]\" />\n              <span>DELIVERY SECURED</span>\n            </>\n          ) : (\n            <>\n              <ShieldAlert className=\"w-3.5 h-3.5 text-[#FFB7B2] animate-bounce\" />\n              <span>3H CAPACITY RISK</span>\n            </>\n          )}\n        </div>\n      </div>\n\n      {/* Right Controls: Command palette trigger, Countdown capsule, Ship Mode trigger */}\n      <div className=\"flex items-center gap-3\">\n        {/* Command palette search button */}\n        <button\n          id=\"btn-topbar-command-palette\"\n          onClick={onOpenCommandPalette}\n          className=\"hidden md:flex items-center gap-2 px-3 py-1.5 rounded-lg bg-[#293735] hover:bg-[#31413F] border border-[#3B4B47] text-xs text-[#AAB8B2] hover:text-[#F0F4EE] transition-all group\"\n          title=\"Quick actions and navigation (\342\214\230K)\"\n        >\n          <Terminal className=\"w-3.5 h-3.5 text-[#71817B] group-hover:text-[#A8E6CF] transition-colors\" />\n          <span>Quick Command</span>\n          <kbd className=\"px-1.5 py-0.5 rounded bg-[#202B2A] border border-[#3B4B47] text-[10px] text-[#71817B] font-mono\">\342\214\230K</kbd>\n        </button>\n\n        {/* Floating Timer Capsule */}\n        <div \n          id=\"halftime-countdown-capsule\"\n          className={`flex items-center gap-2.5 px-3.5 py-1.5 rounded-full border transition-all ${\n            isCritical\n              ? \'bg-[#293735] border-[#FFB7B2]/40 shadow-[0_0_15px_-3px_rgba(255,183,178,0.25)]\'\n              : \'bg-[#293735] border-[#C7F9A6]/40 shadow-[0_0_15px_-3px_rgba(199,249,166,0.2)]\'\n          }`}\n        >\n          <Activity className={`w-3.5 h-3.5 ${isCritical ? \'text-[#FFB7B2] animate-pulse\' : \'text-[#C7F9A6]\'}`} />\n          <div className=\"flex items-center gap-1 font-mono font-bold text-sm tracking-wider text-[#F0F4EE]\">\n            <span>{pad(hours)}</span>\n            <span className=\"text-[#71817B] animate-pulse\">:</span>\n            <span>{pad(minutes)}</span>\n            <span className=\"text-[#71817B] animate-pulse\">:</span>\n            <span className={`${isCritical ? \'text-[#FFB7B2]\' : \'text-[#C7F9A6]\'}`}>{pad(seconds)}</span>\n          </div>\n          <span className=\"text-[10px] font-mono tracking-widest text-[#71817B] uppercase font-medium hidden sm:inline\">\n            TIME LEFT\n          </span>\n        </div>\n\n        {/* Enter Ship Mode button */}\n        <button\n          id=\"btn-topbar-ship-mode\"\n          onClick={onOpenShipMode}\n          className=\"flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-gradient-to-r from-[#C7F9A6] to-[#A8E6CF] text-[#202B2A] hover:brightness-110 font-mono text-xs font-bold transition-all shadow-sm active:scale-95\"\n        >\n          <Sparkles className=\"w-3.5 h-3.5 fill-[#202B2A]\" />\n          <span className=\"hidden sm:inline\">SHIP MODE</span>\n        </button>\n      </div>\n    </header>\n  );\n};\n"
    }
