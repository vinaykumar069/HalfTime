  file_change {
    absolute_path_uri: "file:///src/App.tsx"
    file_change_type: FILE_CHANGE_TYPE_EDIT
    replacement_chunks {
      target_content: "  return (\n    <div className=\"min-h-screen bg-[#202B2A] text-[#F0F4EE] flex flex-col selection:bg-[#C7F9A6] selection:text-[#202B2A]\">\n      {/* Sidebar Navigation */}\n      <Sidebar\n        activeTab={activeTab}\n        onSelectTab={setActiveTab}\n        scopeCutApplied={scopeCutApplied}\n        isOpenMobile={isMobileMenuOpen}\n        onCloseMobile={() => setIsMobileMenuOpen(false)}\n      />\n\n      {/* Main Content Layout with Left Offset for Desktop Sidebar */}\n      <div className=\"lg:pl-64 flex flex-col flex-1 min-w-0\">\n        {/* Mobile Top Header Toggle Bar */}\n        <div className=\"lg:hidden h-14 bg-[#202B2A] border-b border-[#3B4B47] px-4 flex items-center justify-between sticky top-0 z-40\">\n          <button\n            onClick={() => setIsMobileMenuOpen(true)}\n            className=\"p-2 rounded-lg bg-[#293735] text-[#F0F4EE] border border-[#3B4B47]\"\n          >\n            <Menu className=\"w-5 h-5\" />\n          </button>\n          <span className=\"font-mono font-bold text-sm tracking-wider text-[#F0F4EE]\">\n            HALFTIME\n          </span>\n          <span className=\"text-[10px] font-mono px-2 py-0.5 rounded bg-[#31413F] text-[#A8E6CF]\">\n            TEAM DOOM\n          </span>\n        </div>\n\n        {/* Global Top Bar */}\n        <TopBar\n          healthStatus={health.status}\n          onOpenCommandPalette={() => setIsCommandPaletteOpen(true)}\n          onOpenShipMode={() => setIsShipModeOpen(true)}\n          shipModeReady={launchChecklist.filter(i => i.status === \'COMPLETE\').length >= 8}\n        />\n\n        {/* Dynamic Main View Container */}\n        <main className=\"flex-1 px-4 sm:px-8 py-6 sm:py-8 max-w-7xl w-full mx-auto\">\n          {activeTab === \'overview\' && (\n            <OverviewDashboard\n              health={health}\n              scopeItems={scopeItems}\n              activityLogs={activityLogs}\n              scopeCutApplied={scopeCutApplied}\n              onExecuteScopeCut={handleExecuteScopeCut}\n              onToggleScopeSelect={handleToggleScopeSelect}\n              onRecalculatePlan={handleRecalculatePlan}\n              onOpenReasoning={() => setIsReasoningOpen(true)}\n              onStartNextTask={handleStartNextTask}\n              isTaskActive={isTaskActive}\n              taskActiveSeconds={activeTaskSeconds}\n            />\n          )}\n\n          {activeTab === \'idea-lab\' && (\n            <IdeaLab\n              ideas={ideas}\n              onSelectActiveIdea={handleSelectActiveIdea}\n              onAddGeneratedIdeas={handleAddGeneratedIdeas}\n            />\n          )}\n\n          {activeTab === \'mvp-planner\' && (\n            <MVPPlanner\n              features={mvpFeatures}\n              onChangeFeaturePriority={handleChangeFeaturePriority}\n              onAddFeature={handleAddFeature}\n            />\n          )}\n\n          {activeTab === \'tasks\' && (\n            <TaskBoard\n              tasks={tasks}\n              teamMembers={teamMembers}\n              onUpdateTaskStatus={handleUpdateTaskStatus}\n              onAddTask={handleAddTask}\n              activeTaskId={activeTaskId}\n              onSetActiveTask={setActiveTaskId}\n            />\n          )}\n\n          {activeTab === \'resources\' && (\n            <ResourcesView\n              resources={resources}\n              onOptimizeCredits={() => {\n                addToast(\'ai\', \'CREDIT OPTIMIZATION ACTIVE\', \'Prompt tokens pruned; Base44 calls throttled for demo.\');\n              }}\n            />\n          )}\n\n          {activeTab === \'judge-mode\' && (\n            <JudgeMode\n              evaluation={judgeEval}\n              onToggleFix={handleToggleJudgeFix}\n              onRerunJudge={handleRerunJudge}\n              scopeCutApplied={scopeCutApplied}\n            />\n          )}\n\n          {activeTab === \'launch\' && (\n            <LaunchView\n              checklist={launchChecklist}\n              onToggleStatus={handleToggleLaunchStatus}\n              onOpenShipMode={() => setIsShipModeOpen(true)}\n              scopeCutApplied={scopeCutApplied}\n            />\n          )}\n        </main>\n      </div>\n\n      {/* Command Palette (\342\214\230K) */}\n      <CommandPalette\n        isOpen={isCommandPaletteOpen}\n        onClose={() => setIsCommandPaletteOpen(false)}\n        onSelectTab={setActiveTab}\n        onTriggerScopeCut={handleExecuteScopeCut}\n        onTriggerShipMode={() => setIsShipModeOpen(true)}\n        onStartNextTask={handleStartNextTask}\n      />\n\n      {/* AI Reasoning Deep Dive Modal */}\n      <ReasoningModal\n        isOpen={isReasoningOpen}\n        onClose={() => setIsReasoningOpen(false)}\n        health={health}\n        scopeCutApplied={scopeCutApplied}\n      />\n\n      {/* Hero Ship Mode Modal */}\n      <ShipModeModal\n        isOpen={isShipModeOpen}\n        onClose={() => setIsShipModeOpen(false)}\n        scopeCutApplied={scopeCutApplied}\n        score={judgeEval.overallScore}\n      />\n\n      {/* Global Toast Container */}\n      <ToastContainer toasts={toasts} onDismiss={dismissToast} />\n    </div>\n  );"
      replacement_content: "  return (\n    <div className=\"min-h-screen bg-[#202B2A] text-[#F0F4EE] flex flex-col selection:bg-[#C7F9A6] selection:text-[#202B2A] relative overflow-x-hidden\">\n      {/* Ambient background blur aura from Artistic Flair */}\n      <div className=\"fixed top-[-100px] right-[-100px] w-[500px] h-[500px] bg-[#A8E6CF] opacity-[0.03] blur-[120px] rounded-full pointer-events-none z-0\" />\n\n      {/* Sidebar Navigation */}\n      <Sidebar\n        activeTab={activeTab}\n        onSelectTab={setActiveTab}\n        scopeCutApplied={scopeCutApplied}\n        isOpenMobile={isMobileMenuOpen}\n        onCloseMobile={() => setIsMobileMenuOpen(false)}\n      />\n\n      {/* Main Content Layout with Left Offset for Desktop Sidebar */}\n      <div className=\"lg:pl-64 flex flex-col flex-1 min-w-0 relative z-10\">\n        {/* Mobile Top Header Toggle Bar */}\n        <div className=\"lg:hidden h-14 bg-[#202B2A] border-b border-[#3B4B47] px-4 flex items-center justify-between sticky top-0 z-40\">\n          <button\n            onClick={() => setIsMobileMenuOpen(true)}\n            className=\"p-2 rounded-lg bg-[#293735] text-[#F0F4EE] border border-[#3B4B47]\"\n          >\n            <Menu className=\"w-5 h-5\" />\n          </button>\n          <span className=\"font-mono font-bold text-sm tracking-wider text-[#F0F4EE]\">\n            HALFTIME\n          </span>\n          <span className=\"text-[10px] font-mono px-2 py-0.5 rounded bg-[#31413F] text-[#A8E6CF]\">\n            TEAM DOOM\n          </span>\n        </div>\n\n        {/* Global Top Bar */}\n        <TopBar\n          healthStatus={health.status}\n          onOpenCommandPalette={() => setIsCommandPaletteOpen(true)}\n          onOpenShipMode={() => setIsShipModeOpen(true)}\n          shipModeReady={launchChecklist.filter(i => i.status === \'COMPLETE\').length >= 8}\n        />\n\n        {/* Dynamic Main View Container */}\n        <main className=\"flex-1 px-4 sm:px-8 py-6 sm:py-8 max-w-7xl w-full mx-auto\">\n          {activeTab === \'overview\' && (\n            <OverviewDashboard\n              health={health}\n              scopeItems={scopeItems}\n              activityLogs={activityLogs}\n              scopeCutApplied={scopeCutApplied}\n              onExecuteScopeCut={handleExecuteScopeCut}\n              onToggleScopeSelect={handleToggleScopeSelect}\n              onRecalculatePlan={handleRecalculatePlan}\n              onOpenReasoning={() => setIsReasoningOpen(true)}\n              onStartNextTask={handleStartNextTask}\n              isTaskActive={isTaskActive}\n              taskActiveSeconds={activeTaskSeconds}\n            />\n          )}\n\n          {activeTab === \'idea-lab\' && (\n            <IdeaLab\n              ideas={ideas}\n              onSelectActiveIdea={handleSelectActiveIdea}\n              onAddGeneratedIdeas={handleAddGeneratedIdeas}\n            />\n          )}\n\n          {activeTab === \'mvp-planner\' && (\n            <MVPPlanner\n              features={mvpFeatures}\n              onChangeFeaturePriority={handleChangeFeaturePriority}\n              onAddFeature={handleAddFeature}\n            />\n          )}\n\n          {activeTab === \'tasks\' && (\n            <TaskBoard\n              tasks={tasks}\n              teamMembers={teamMembers}\n              onUpdateTaskStatus={handleUpdateTaskStatus}\n              onAddTask={handleAddTask}\n              activeTaskId={activeTaskId}\n              onSetActiveTask={setActiveTaskId}\n            />\n          )}\n\n          {activeTab === \'resources\' && (\n            <ResourcesView\n              resources={resources}\n              onOptimizeCredits={() => {\n                addToast(\'ai\', \'CREDIT OPTIMIZATION ACTIVE\', \'Prompt tokens pruned; Base44 calls throttled for demo.\');\n              }}\n            />\n          )}\n\n          {activeTab === \'judge-mode\' && (\n            <JudgeMode\n              evaluation={judgeEval}\n              onToggleFix={handleToggleJudgeFix}\n              onRerunJudge={handleRerunJudge}\n              scopeCutApplied={scopeCutApplied}\n            />\n          )}\n\n          {activeTab === \'launch\' && (\n            <LaunchView\n              checklist={launchChecklist}\n              onToggleStatus={handleToggleLaunchStatus}\n              onOpenShipMode={() => setIsShipModeOpen(true)}\n              scopeCutApplied={scopeCutApplied}\n            />\n          )}\n        </main>\n      </div>\n\n      {/* Floating Bottom-Right Corner Widget from Artistic Flair Design */}\n      <div className=\"fixed bottom-6 right-6 sm:bottom-8 sm:right-8 z-40 flex items-center space-x-3 pointer-events-auto\">\n        <div className=\"bg-[#293735]/85 backdrop-blur-md px-4 py-2 rounded-full border border-white/5 flex items-center space-x-2.5 shadow-2xl\">\n          <span className=\"w-2 h-2 rounded-full bg-[#A8E6CF] animate-pulse\" />\n          <span className=\"text-[10px] font-bold tracking-tight text-[#F0F4EE]\">AI ONLINE</span>\n        </div>\n        <button\n          onClick={() => setIsCommandPaletteOpen(true)}\n          className=\"bg-[#C7F9A6] text-[#202B2A] w-11 h-11 sm:w-12 sm:h-12 rounded-full flex items-center justify-center shadow-[0_0_30px_rgba(199,249,166,0.4)] cursor-pointer hover:scale-105 active:scale-95 transition-transform\"\n          title=\"Open Quick Command Palette (\342\214\230K)\"\n        >\n          <span className=\"text-xs font-black\">\342\214\230K</span>\n        </button>\n      </div>\n\n      {/* Command Palette (\342\214\230K) */}\n      <CommandPalette\n        isOpen={isCommandPaletteOpen}\n        onClose={() => setIsCommandPaletteOpen(false)}\n        onSelectTab={setActiveTab}\n        onTriggerScopeCut={handleExecuteScopeCut}\n        onTriggerShipMode={() => setIsShipModeOpen(true)}\n        onStartNextTask={handleStartNextTask}\n      />\n\n      {/* AI Reasoning Deep Dive Modal */}\n      <ReasoningModal\n        isOpen={isReasoningOpen}\n        onClose={() => setIsReasoningOpen(false)}\n        health={health}\n        scopeCutApplied={scopeCutApplied}\n      />\n\n      {/* Hero Ship Mode Modal */}\n      <ShipModeModal\n        isOpen={isShipModeOpen}\n        onClose={() => setIsShipModeOpen(false)}\n        scopeCutApplied={scopeCutApplied}\n        score={judgeEval.overallScore}\n      />\n\n      {/* Global Toast Container */}\n      <ToastContainer toasts={toasts} onDismiss={dismissToast} />\n    </div>\n  );"
