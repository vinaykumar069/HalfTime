  file_change {
    absolute_path_uri: "file:///src/components/mvp/MVPPlanner.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { \n  Layers, \n  Plus, \n  ArrowRight, \n  ArrowLeft, \n  Scissors, \n  Check, \n  Sparkles, \n  Clock, \n  AlertCircle,\n  HelpCircle\n} from \'lucide-react\';\nimport { MVPFeature, FeaturePriority } from \'../../types\';\n\ninterface MVPPlannerProps {\n  features: MVPFeature[];\n  onChangeFeaturePriority: (id: string, newPriority: FeaturePriority) => void;\n  onAddFeature: (feature: MVPFeature) => void;\n}\n\nexport const MVPPlanner: React.FC<MVPPlannerProps> = ({\n  features,\n  onChangeFeaturePriority,\n  onAddFeature,\n}) => {\n  const [newFeatureName, setNewFeatureName] = useState(\'\');\n  const [newFeatureHours, setNewFeatureHours] = useState(\'1.5\');\n  const [newFeatureCategory, setNewFeatureCategory] = useState<\'Core AI\' | \'UI / Polish\' | \'Infrastructure\' | \'Add-on\'>(\'Core AI\');\n  const [isAdding, setIsAdding] = useState(false);\n\n  const groups: Array<{\n    priority: FeaturePriority;\n    title: string;\n    description: string;\n    badgeColor: string;\n    borderAccent: string;\n  }> = [\n    {\n      priority: \'MUST_BUILD\',\n      title: \'MUST BUILD\',\n      description: \'Without this, there is no demo. 100% essential.\',\n      badgeColor: \'bg-[#C7F9A6]/20 text-[#C7F9A6] border-[#C7F9A6]/40\',\n      borderAccent: \'border-[#C7F9A6]/30\',\n    },\n    {\n      priority: \'SHOULD_BUILD\',\n      title: \'SHOULD BUILD\',\n      description: \'Strengthens the pitch. Build if runway permits.\',\n      badgeColor: \'bg-[#A8DADC]/20 text-[#A8DADC] border-[#A8DADC]/40\',\n      borderAccent: \'border-[#A8DADC]/30\',\n    },\n    {\n      priority: \'NICE_TO_HAVE\',\n      title: \'NICE TO HAVE\',\n      description: \'Extra polish. Do not risk submission deadline for this.\',\n      badgeColor: \'bg-[#FFE0A3]/20 text-[#FFE0A3] border-[#FFE0A3]/40\',\n      borderAccent: \'border-[#FFE0A3]/30\',\n    },\n    {\n      priority: \'CUT\',\n      title: \'CUT FROM MVP\',\n      description: \'Safely discarded to protect the core demo experience.\',\n      badgeColor: \'bg-[#FFB7B2]/20 text-[#FFB7B2] border-[#FFB7B2]/40\',\n      borderAccent: \'border-[#FFB7B2]/30\',\n    },\n  ];\n\n  const handleCreateFeature = (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!newFeatureName.trim()) return;\n\n    const newFeat: MVPFeature = {\n      id: `custom-feat-${Date.now()}`,\n      name: newFeatureName.trim(),\n      description: \'Team custom feature added during midpoint planning.\',\n      estimatedHours: parseFloat(newFeatureHours) || 1.0,\n      priority: \'SHOULD_BUILD\',\n      demoCritical: false,\n      category: newFeatureCategory,\n    };\n\n    onAddFeature(newFeat);\n    setNewFeatureName(\'\');\n    setIsAdding(false);\n  };\n\n  const totalMustHours = features\n    .filter(f => f.priority === \'MUST_BUILD\')\n    .reduce((acc, f) => acc + f.estimatedHours, 0);\n\n  const totalShouldHours = features\n    .filter(f => f.priority === \'SHOULD_BUILD\')\n    .reduce((acc, f) => acc + f.estimatedHours, 0);\n\n  return (\n    <div className=\"space-y-8 animate-in fade-in duration-300 pb-12\">\n      {/* Header */}\n      <div>\n        <div className=\"inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#31413F] border border-[#3B4B47] text-xs font-mono text-[#B8DDF0] mb-2\">\n          <Layers className=\"w-3.5 h-3.5\" />\n          <span>MVP ARCHITECTURE MATRIX</span>\n        </div>\n        <h1 className=\"text-2xl sm:text-4xl font-extrabold text-[#F0F4EE] tracking-tight font-display\">\n          MVP PLANNER\n        </h1>\n        <p className=\"text-sm sm:text-base text-[#AAB8B2] mt-1 font-medium\">\n          Differentiate essential core loops from scope traps. Move items between tiers to recalculate demo runway.\n        </p>\n      </div>\n\n      {/* Selected Idea Strategy Summary */}\n      <div className=\"p-6 rounded-2xl bg-[#293735] border border-[#3B4B47] shadow-xl space-y-4\">\n        <div className=\"flex flex-col sm:flex-row sm:items-center justify-between pb-3 border-b border-[#3B4B47] gap-2\">\n          <div>\n            <span className=\"text-[10px] font-mono text-[#71817B] uppercase\">SELECTED TARGET CONCEPT</span>\n            <h2 className=\"text-lg font-bold text-[#F0F4EE] font-mono\">\n              HALFTIME (Hackathon Copilot)\n            </h2>\n          </div>\n          <div className=\"flex items-center gap-2\">\n            <span className=\"px-2.5 py-1 rounded-full bg-[#C7F9A6]/20 text-[#C7F9A6] border border-[#C7F9A6]/30 text-xs font-mono font-bold\">\n              MUST HOURS: {totalMustHours}h\n            </span>\n            <span className=\"px-2.5 py-1 rounded-full bg-[#A8DADC]/20 text-[#A8DADC] border border-[#A8DADC]/30 text-xs font-mono font-bold\">\n              SHOULD: {totalShouldHours}h\n            </span>\n          </div>\n        </div>\n\n        <div className=\"grid grid-cols-1 md:grid-cols-3 gap-4 text-xs text-[#AAB8B2]\">\n          <div className=\"p-3 rounded-xl bg-[#202B2A] border border-[#3B4B47]\">\n            <span className=\"font-mono text-[#71817B] font-semibold text-[10px] block mb-1\">THE PROBLEM</span>\n            Hackathon teams waste 60% of their limited 36-48 hours building the wrong features, running out of time before shipping a working demo.\n          </div>\n          <div className=\"p-3 rounded-xl bg-[#202B2A] border border-[#3B4B47]\">\n            <span className=\"font-mono text-[#71817B] font-semibold text-[10px] block mb-1\">THE SOLUTION</span>\n            An AI mission control that continuously recalculates work vs. remaining time, flags judge risks, and executes ruthless scope cuts.\n          </div>\n          <div className=\"p-3 rounded-xl bg-[#202B2A] border border-[#3B4B47]\">\n            <span className=\"font-mono text-[#71817B] font-semibold text-[10px] block mb-1\">THE DEMO VALUE</span>\n            Instant 30-second wow factor: showing how 3h of bloat is cut in one click, transitioning the project from AT RISK to ON TRACK.\n          </div>\n        </div>\n      </div>\n\n      {/* Add Feature Row */}\n      <div className=\"flex items-center justify-between\">\n        <span className=\"text-xs font-mono text-[#71817B]\">\n          Drag or click arrows to promote/demote features across tiers.\n        </span>\n        <button\n          onClick={() => setIsAdding(!isAdding)}\n          className=\"flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-[#31413F] hover:bg-[#3B4B47] text-xs font-mono text-[#F0F4EE] border border-[#3B4B47] transition-all\"\n        >\n          <Plus className=\"w-3.5 h-3.5 text-[#C7F9A6]\" />\n          <span>Add Custom Feature</span>\n        </button>\n      </div>\n\n      {/* Inline Feature Add Form */}\n      {isAdding && (\n        <form onSubmit={handleCreateFeature} className=\"p-4 rounded-xl bg-[#293735] border border-[#C7F9A6]/30 shadow-lg flex flex-wrap gap-3 items-center animate-in fade-in\">\n          <input\n            type=\"text\"\n            placeholder=\"Feature name...\"\n            value={newFeatureName}\n            onChange={(e) => setNewFeatureName(e.target.value)}\n            className=\"flex-1 min-w-[200px] px-3 py-2 rounded-lg bg-[#202B2A] border border-[#3B4B47] text-xs text-[#F0F4EE] focus:outline-none focus:border-[#C7F9A6]\"\n          />\n          <input\n            type=\"number\"\n            step=\"0.5\"\n            placeholder=\"Hours...\"\n            value={newFeatureHours}\n            onChange={(e) => setNewFeatureHours(e.target.value)}\n            className=\"w-24 px-3 py-2 rounded-lg bg-[#202B2A] border border-[#3B4B47] text-xs text-[#F0F4EE] focus:outline-none\"\n          />\n          <select\n            value={newFeatureCategory}\n            onChange={(e) => setNewFeatureCategory(e.target.value as any)}\n            className=\"px-3 py-2 rounded-lg bg-[#202B2A] border border-[#3B4B47] text-xs text-[#F0F4EE] focus:outline-none\"\n          >\n            <option value=\"Core AI\">Core AI</option>\n            <option value=\"UI / Polish\">UI / Polish</option>\n            <option value=\"Infrastructure\">Infrastructure</option>\n            <option value=\"Add-on\">Add-on</option>\n          </select>\n          <button\n            type=\"submit\"\n            className=\"px-4 py-2 rounded-lg bg-[#C7F9A6] text-[#202B2A] font-mono text-xs font-bold hover:brightness-110\"\n          >\n            Save to Plan\n          </button>\n        </form>\n      )}\n\n      {/* 4 MVP Priority Tiers */}\n      <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4\">\n        {groups.map((group) => {\n          const groupFeatures = features.filter((f) => f.priority === group.priority);\n          const totalHours = groupFeatures.reduce((acc, curr) => acc + curr.estimatedHours, 0);\n\n          return (\n            <div\n              key={group.priority}\n              className={`p-4 rounded-2xl bg-[#293735] border ${group.borderAccent} shadow-lg flex flex-col justify-between`}\n            >\n              <div>\n                {/* Column header */}\n                <div className=\"flex items-center justify-between pb-2 border-b border-[#3B4B47]\">\n                  <span className={`px-2 py-0.5 rounded text-[11px] font-mono font-bold border ${group.badgeColor}`}>\n                    {group.title}\n                  </span>\n                  <span className=\"text-xs font-mono font-bold text-[#F0F4EE]\">\n                    {totalHours}h\n                  </span>\n                </div>\n                <p className=\"text-[10px] text-[#71817B] mt-1.5 leading-snug\">\n                  {group.description}\n                </p>\n\n                {/* Feature cards list */}\n                <div className=\"space-y-2.5 mt-3\">\n                  {groupFeatures.length === 0 ? (\n                    <div className=\"py-6 text-center text-[11px] font-mono text-[#71817B] border border-dashed border-[#3B4B47] rounded-xl\">\n                      Empty tier\n                    </div>\n                  ) : (\n                    groupFeatures.map((feat) => (\n                      <div\n                        key={feat.id}\n                        className=\"p-3 rounded-xl bg-[#202B2A] border border-[#3B4B47] hover:border-[#A8E6CF]/30 transition-all space-y-2 group\"\n                      >\n                        <div className=\"flex items-start justify-between gap-1\">\n                          <span className=\"text-xs font-semibold text-[#F0F4EE] leading-tight\">\n                            {feat.name}\n                          </span>\n                          <span className=\"text-[10px] font-mono font-bold text-[#A8E6CF] shrink-0\">\n                            {feat.estimatedHours}h\n                          </span>\n                        </div>\n\n                        <p className=\"text-[11px] text-[#71817B] leading-relaxed\">\n                          {feat.description}\n                        </p>\n\n                        <div className=\"pt-2 border-t border-[#3B4B47]/50 flex items-center justify-between text-[10px]\">\n                          <span className=\"px-1.5 py-0.5 rounded bg-[#293735] text-[#AAB8B2] font-mono\">\n                            {feat.category}\n                          </span>\n\n                          {/* Quick movement selectors */}\n                          <div className=\"flex items-center gap-1 opacity-80 group-hover:opacity-100 transition-opacity\">\n                            {group.priority !== \'MUST_BUILD\' && (\n                              <button\n                                title=\"Move up\"\n                                onClick={() => {\n                                  const order: FeaturePriority[] = [\'CUT\', \'NICE_TO_HAVE\', \'SHOULD_BUILD\', \'MUST_BUILD\'];\n                                  const idx = order.indexOf(group.priority);\n                                  if (idx < order.length - 1) {\n                                    onChangeFeaturePriority(feat.id, order[idx + 1]);\n                                  }\n                                }}\n                                className=\"px-1.5 py-0.5 rounded bg-[#31413F] text-[#C7F9A6] hover:bg-[#3B4B47] font-mono text-[9px]\"\n                              >\n                                \342\206\221 UP\n                              </button>\n                            )}\n\n                            {group.priority !== \'CUT\' && (\n                              <button\n                                title=\"Demote or Cut\"\n                                onClick={() => {\n                                  const order: FeaturePriority[] = [\'MUST_BUILD\', \'SHOULD_BUILD\', \'NICE_TO_HAVE\', \'CUT\'];\n                                  const idx = order.indexOf(group.priority);\n                                  if (idx < order.length - 1) {\n                                    onChangeFeaturePriority(feat.id, order[idx + 1]);\n                                  }\n                                }}\n                                className=\"px-1.5 py-0.5 rounded bg-[#31413F] text-[#FFB7B2] hover:bg-[#3B4B47] font-mono text-[9px]\"\n                              >\n                                \342\206\223 CUT\n                              </button>\n                            )}\n                          </div>\n                        </div>\n                      </div>\n                    ))\n                  )}\n                </div>\n              </div>\n            </div>\n          );\n        })}\n      </div>\n    </div>\n  );\n};\n"
    }
