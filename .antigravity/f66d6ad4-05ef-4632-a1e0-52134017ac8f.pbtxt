  file_change {
    absolute_path_uri: "file:///src/components/modals/AuthModal.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState, useEffect } from \'react\';\nimport { User, KeyRound, Mail, LogOut, CheckCircle2, AlertCircle, X, Shield, Sparkles, Database } from \'lucide-react\';\nimport { supabase, isSupabaseConfigured, getCurrentAuthenticatedUser } from \'../../lib/supabase\';\n\ninterface AuthModalProps {\n  isOpen: boolean;\n  onClose: () => void;\n  onAuthChange?: () => void;\n}\n\nexport const AuthModal: React.FC<AuthModalProps> = ({\n  isOpen,\n  onClose,\n  onAuthChange,\n}) => {\n  const [mode, setMode] = useState<\'signin\' | \'signup\'>(\'signin\');\n  const [email, setEmail] = useState(\'\');\n  const [password, setPassword] = useState(\'\');\n  const [userSession, setUserSession] = useState<any>(null);\n  const [isLoading, setIsLoading] = useState(false);\n  const [errorMsg, setErrorMsg] = useState<string | null>(null);\n  const [successMsg, setSuccessMsg] = useState<string | null>(null);\n\n  useEffect(() => {\n    if (!isOpen) return;\n    checkAuth();\n  }, [isOpen]);\n\n  const checkAuth = async () => {\n    if (isSupabaseConfigured && supabase) {\n      const user = await getCurrentAuthenticatedUser();\n      setUserSession(user);\n    } else {\n      setUserSession(null);\n    }\n  };\n\n  if (!isOpen) return null;\n\n  const handleSignIn = async (e: React.FormEvent) => {\n    e.preventDefault();\n    setErrorMsg(null);\n    setSuccessMsg(null);\n    setIsLoading(true);\n\n    try {\n      if (!isSupabaseConfigured || !supabase) {\n        throw new Error(\'Supabase storage is not configured. Please add VITE_SUPABASE_URL and VITE_SUPABASE_ANON_KEY.\');\n      }\n\n      const { data, error } = await supabase.auth.signInWithPassword({\n        email: email.trim(),\n        password,\n      });\n\n      if (error) {\n        setErrorMsg(error.message);\n      } else if (data.user) {\n        setUserSession(data.user);\n        setSuccessMsg(\'Successfully signed in! Your projects and data are isolated with Supabase RLS.\');\n        setTimeout(() => {\n          onClose();\n          onAuthChange?.();\n        }, 1000);\n      }\n    } catch (err: any) {\n      setErrorMsg(err.message || \'Authentication error.\');\n    } finally {\n      setIsLoading(false);\n    }\n  };\n\n  const handleSignUp = async (e: React.FormEvent) => {\n    e.preventDefault();\n    setErrorMsg(null);\n    setSuccessMsg(null);\n    setIsLoading(true);\n\n    try {\n      if (!isSupabaseConfigured || !supabase) {\n        throw new Error(\'Supabase storage is not configured. Please configure valid Supabase credentials.\');\n      }\n\n      const { data, error } = await supabase.auth.signUp({\n        email: email.trim(),\n        password,\n      });\n\n      if (error) {\n        setErrorMsg(error.message);\n      } else if (data.user) {\n        setUserSession(data.user);\n        setSuccessMsg(\'Account created successfully! You are now signed in.\');\n        setTimeout(() => {\n          onClose();\n          onAuthChange?.();\n        }, 1200);\n      }\n    } catch (err: any) {\n      setErrorMsg(err.message || \'Signup error.\');\n    } finally {\n      setIsLoading(false);\n    }\n  };\n\n  const handleSignOut = async () => {\n    setIsLoading(true);\n    setErrorMsg(null);\n    try {\n      if (supabase) {\n        await supabase.auth.signOut();\n      }\n      setUserSession(null);\n      setSuccessMsg(\'Signed out successfully.\');\n      setTimeout(() => {\n        onClose();\n        onAuthChange?.();\n      }, 800);\n    } catch (err: any) {\n      setErrorMsg(err.message || \'Sign out failed.\');\n    } finally {\n      setIsLoading(false);\n    }\n  };\n\n  return (\n    <div className=\"fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/80 backdrop-blur-sm animate-fadeIn\">\n      <div className=\"bg-[#202B2A] border border-[#3B4B47] rounded-2xl w-full max-w-md p-6 sm:p-8 shadow-2xl relative\">\n        <button\n          onClick={onClose}\n          className=\"absolute top-4 right-4 p-2 text-[#71817B] hover:text-[#F0F4EE] rounded-lg transition-colors cursor-pointer\"\n        >\n          <X className=\"w-5 h-5\" />\n        </button>\n\n        <div className=\"flex items-center gap-3 mb-6\">\n          <div className=\"w-10 h-10 rounded-xl bg-[#293735] border border-[#3B4B47] flex items-center justify-center text-[#C7F9A6]\">\n            <Shield className=\"w-5 h-5\" />\n          </div>\n          <div>\n            <h2 className=\"text-xl font-bold text-[#F0F4EE] font-mono\">\n              {userSession ? \'Authenticated Account\' : mode === \'signin\' ? \'Sign In\' : \'Create Account\'}\n            </h2>\n            <p className=\"text-xs text-[#71817B]\">\n              Supabase Auth & Row Level Security\n            </p>\n          </div>\n        </div>\n\n        {errorMsg && (\n          <div className=\"mb-4 p-3 rounded-xl bg-[#FFB7B2]/10 border border-[#FFB7B2]/30 flex items-start gap-2.5 text-xs text-[#FFB7B2]\">\n            <AlertCircle className=\"w-4 h-4 shrink-0 mt-0.5\" />\n            <span>{errorMsg}</span>\n          </div>\n        )}\n\n        {successMsg && (\n          <div className=\"mb-4 p-3 rounded-xl bg-[#C7F9A6]/10 border border-[#C7F9A6]/30 flex items-start gap-2.5 text-xs text-[#C7F9A6]\">\n            <CheckCircle2 className=\"w-4 h-4 shrink-0 mt-0.5\" />\n            <span>{successMsg}</span>\n          </div>\n        )}\n\n        {userSession ? (\n          <div className=\"space-y-4\">\n            <div className=\"p-4 rounded-xl bg-[#293735] border border-[#3B4B47] space-y-3\">\n              <div className=\"flex items-center justify-between\">\n                <span className=\"text-xs text-[#71817B] font-mono uppercase\">Status</span>\n                <span className=\"inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full text-[10px] font-mono font-medium bg-[#C7F9A6]/20 text-[#C7F9A6]\">\n                  <span className=\"w-1.5 h-1.5 rounded-full bg-[#C7F9A6] animate-pulse\" />\n                  AUTHENTICATED\n                </span>\n              </div>\n              <div>\n                <span className=\"text-[11px] text-[#71817B] font-mono block mb-0.5\">Email</span>\n                <span className=\"text-sm font-mono text-[#F0F4EE]\">{userSession.email || \'Supabase User\'}</span>\n              </div>\n              <div>\n                <span className=\"text-[11px] text-[#71817B] font-mono block mb-0.5\">User ID (RLS Protected)</span>\n                <span className=\"text-xs font-mono text-[#AAB8B2] break-all\">{userSession.id}</span>\n              </div>\n            </div>\n\n            <button\n              onClick={handleSignOut}\n              disabled={isLoading}\n              className=\"w-full flex items-center justify-center gap-2 py-3 rounded-xl bg-[#FFB7B2]/20 hover:bg-[#FFB7B2]/30 text-[#FFB7B2] border border-[#FFB7B2]/40 font-mono text-xs font-bold transition-all cursor-pointer disabled:opacity-50\"\n            >\n              <LogOut className=\"w-4 h-4\" />\n              {isLoading ? \'SIGNING OUT...\' : \'SIGN OUT\'}\n            </button>\n          </div>\n        ) : (\n          <div>\n            {!isSupabaseConfigured && (\n              <div className=\"mb-4 p-3 rounded-xl bg-amber-500/10 border border-amber-500/20 text-amber-300 text-xs flex items-start gap-2\">\n                <Database className=\"w-4 h-4 shrink-0 mt-0.5\" />\n                <span>Supabase is not configured yet. Configure VITE_SUPABASE_URL and VITE_SUPABASE_ANON_KEY to enable live cloud sign-in.</span>\n              </div>\n            )}\n\n            <form onSubmit={mode === \'signin\' ? handleSignIn : handleSignUp} className=\"space-y-4\">\n              <div>\n                <label className=\"block text-xs font-mono text-[#AAB8B2] mb-1.5\">Email Address</label>\n                <div className=\"relative\">\n                  <Mail className=\"w-4 h-4 absolute left-3.5 top-1/2 -translate-y-1/2 text-[#71817B]\" />\n                  <input\n                    type=\"email\"\n                    required\n                    value={email}\n                    onChange={e => setEmail(e.target.value)}\n                    placeholder=\"builder@hackathon.com\"\n                    className=\"w-full bg-[#293735] border border-[#3B4B47] rounded-xl pl-10 pr-4 py-2.5 text-xs text-[#F0F4EE] placeholder-[#71817B] focus:outline-none focus:border-[#C7F9A6] font-mono\"\n                  />\n                </div>\n              </div>\n\n              <div>\n                <label className=\"block text-xs font-mono text-[#AAB8B2] mb-1.5\">Password</label>\n                <div className=\"relative\">\n                  <KeyRound className=\"w-4 h-4 absolute left-3.5 top-1/2 -translate-y-1/2 text-[#71817B]\" />\n                  <input\n                    type=\"password\"\n                    required\n                    minLength={6}\n                    value={password}\n                    onChange={e => setPassword(e.target.value)}\n                    placeholder=\"\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\"\n                    className=\"w-full bg-[#293735] border border-[#3B4B47] rounded-xl pl-10 pr-4 py-2.5 text-xs text-[#F0F4EE] placeholder-[#71817B] focus:outline-none focus:border-[#C7F9A6] font-mono\"\n                  />\n                </div>\n              </div>\n\n              <button\n                type=\"submit\"\n                disabled={isLoading}\n                className=\"w-full flex items-center justify-center gap-2 py-3 rounded-xl bg-[#C7F9A6] hover:bg-[#b8f590] text-[#141E1D] font-mono text-xs font-bold transition-all shadow-lg shadow-[#C7F9A6]/20 cursor-pointer disabled:opacity-50 mt-6\"\n              >\n                {isLoading ? (\n                  <span>AUTHENTICATING...</span>\n                ) : (\n                  <>\n                    <Sparkles className=\"w-4 h-4\" />\n                    <span>{mode === \'signin\' ? \'SIGN IN WITH SUPABASE\' : \'CREATE SUPABASE ACCOUNT\'}</span>\n                  </>\n                )}\n              </button>\n            </form>\n\n            <div className=\"mt-5 text-center\">\n              <button\n                onClick={() => {\n                  setMode(mode === \'signin\' ? \'signup\' : \'signin\');\n                  setErrorMsg(null);\n                  setSuccessMsg(null);\n                }}\n                className=\"text-xs text-[#A8E6CF] hover:underline font-mono cursor-pointer\"\n              >\n                {mode === \'signin\'\n                  ? \"Don\'t have an account? Sign up\"\n                  : \'Already have an account? Sign in\'}\n              </button>\n            </div>\n          </div>\n        )}\n      </div>\n    </div>\n  );\n};\n"
