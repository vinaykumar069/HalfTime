  file_change {
    absolute_path_uri: "file:///src/components/judge/JudgeMode.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { \n  Scale, \n  AlertTriangle, \n  CheckCircle2, \n  Sparkles, \n  TrendingUp, \n  HelpCircle, \n  ArrowRight, \n  ShieldAlert,\n  Zap,\n  Target,\n  RefreshCw\n} from \'lucide-react\';\nimport { JudgeEvaluation, JudgeFix } from \'../../types\';\n\ninterface JudgeModeProps {\n  evaluation: JudgeEvaluation;\n  onToggleFix: (fixId: number) => void;\n  onRerunJudge: () => void;\n  scopeCutApplied: boolean;\n}\n\nexport const JudgeMode: React.FC<JudgeModeProps> = ({\n  evaluation,\n  onToggleFix,\n  onRerunJudge,\n  scopeCutApplied,\n}) => {\n  const [isAuditing, setIsAuditing] = useState(false);\n\n  const handleRerun = () => {\n    setIsAuditing(true);\n    setTimeout(() => {\n      setIsAuditing(false);\n      onRerunJudge();\n    }, 700);\n  };\n\n  // Calculate dynamic overall score based on applied fixes\n  const fixedBonus = evaluation.fixes\n    .filter((f) => f.applied)\n    .reduce((acc, curr) => acc + curr.scoreBonus, 0);\n\n  const computedScore = Math.min(10, Number((evaluation.overallScore + (scopeCutApplied ? 0.35 : 0) + fixedBonus * 0.3).toFixed(2)));\n\n  return (\n    <div className=\"space-y-8 animate-in fade-in duration-300 pb-12\">\n      {/* Header */}\n      <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-4\">\n        <div>\n          <div className=\"inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#31413F] border border-[#3B4B47] text-xs font-mono text-[#FFE0A3] mb-2\">\n            <Scale className=\"w-3.5 h-3.5\" />\n            <span>AI JUDGE SIMULATION &amp; RUBRIC AUDIT</span>\n          </div>\n          <h1 className=\"text-2xl sm:text-4xl font-extrabold text-[#F0F4EE] tracking-tight font-display\">\n            JUDGE MODE\n          </h1>\n          <p className=\"text-sm sm:text-base text-[#AAB8B2] mt-1 font-medium\">\n            Brutally honest feedback calibrated against DoraHacks 2.0 scoring rubrics.\n          </p>\n        </div>\n\n        <button\n          id=\"btn-rerun-judge-audit\"\n          onClick={handleRerun}\n          disabled={isAuditing}\n          className=\"flex items-center gap-2 px-4 py-2.5 rounded-xl bg-[#293735] hover:bg-[#31413F] border border-[#3B4B47] hover:border-[#FFE0A3]/40 text-xs font-mono text-[#F0F4EE] transition-all active:scale-95 self-start sm:self-auto\"\n        >\n          <RefreshCw className={`w-3.5 h-3.5 text-[#FFE0A3] ${isAuditing ? \'animate-spin\' : \'\'}`} />\n          <span>{isAuditing ? \'Auditing Rubric...\' : \'RE-RUN JUDGE AUDIT\'}</span>\n        </button>\n      </div>\n\n      {/* Hero Score & Status Banner */}\n      <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-5 sm:gap-6\">\n        {/* Score Radial & High-Level Verdict */}\n        <div className=\"lg:col-span-5 p-6 rounded-2xl bg-[#293735] border border-[#3B4B47] shadow-xl flex flex-col justify-between glass-panel\">\n          <div>\n            <div className=\"flex items-center justify-between pb-3 border-b border-[#3B4B47]\">\n              <span className=\"text-[11px] font-mono font-bold text-[#71817B] uppercase\">\n                PREDICTED OVERALL SCORE\n              </span>\n              <span className=\"px-2.5 py-0.5 rounded-full text-xs font-mono font-bold bg-[#C7F9A6]/20 text-[#C7F9A6] border border-[#C7F9A6]/40\">\n                {computedScore >= 9.0 ? \'TOP TIER CONTENDER\' : \'BUILD IT\'}\n              </span>\n            </div>\n\n            <div className=\"my-6 flex items-baseline gap-2\">\n              <span className=\"text-5xl sm:text-6xl font-mono font-extrabold text-[#F0F4EE]\">\n                {computedScore}\n              </span>\n              <span className=\"text-xl font-mono text-[#71817B]\">/ 10</span>\n            </div>\n\n            <p className=\"text-xs text-[#AAB8B2] leading-relaxed\">\n              &ldquo;{evaluation.summaryFeedback}&rdquo;\n            </p>\n          </div>\n\n          <div className=\"pt-4 mt-4 border-t border-[#3B4B47] flex items-center justify-between text-xs font-mono\">\n            <span className=\"text-[#71817B]\">Benchmark:</span>\n            <span className=\"text-[#B7E4C7] font-bold\">Top 5% of Submissions</span>\n          </div>\n        </div>\n\n        {/* 2. WHY YOU MIGHT LOSE (Hero Brutal Honesty) */}\n        <div className=\"lg:col-span-7 p-6 rounded-2xl bg-[#293735] border border-[#FFB7B2]/40 shadow-xl flex flex-col justify-between relative overflow-hidden\">\n          <div className=\"absolute top-0 right-0 w-60 h-60 bg-gradient-to-bl from-[#FFB7B2]/10 to-transparent blur-3xl pointer-events-none\" />\n\n          <div className=\"space-y-3\">\n            <div className=\"flex items-center gap-2 text-xs font-mono font-bold text-[#FFB7B2]\">\n              <ShieldAlert className=\"w-4 h-4 text-[#FFB7B2] animate-pulse\" />\n              <span>WHY YOU MIGHT LOSE</span>\n            </div>\n\n            <h3 className=\"text-base sm:text-lg font-bold text-[#F0F4EE] leading-snug\">\n              &ldquo;{evaluation.whyYouMightLose}&rdquo;\n            </h3>\n\n            <p className=\"text-xs text-[#AAB8B2] leading-relaxed\">\n              Hackathon judges spend an average of 180 seconds evaluating your product. If the first 45 seconds are spent logging in or configuring settings, you receive a baseline score regardless of technical depth.\n            </p>\n          </div>\n\n          <div className=\"pt-4 mt-4 border-t border-[#3B4B47] flex items-center gap-2 text-xs font-mono text-[#FFE0A3]\">\n            <Zap className=\"w-3.5 h-3.5\" />\n            <span>Remedy: Apply the 3 fixes below to guarantee maximum score conversion.</span>\n          </div>\n        </div>\n      </div>\n\n      {/* 3. FIX BEFORE SUBMISSION \342\200\224 Interactive Checklist */}\n      <div \n        id=\"judge-fix-checklist\"\n        className=\"p-6 rounded-2xl bg-[#293735] border border-[#3B4B47] shadow-xl space-y-4\"\n      >\n        <div className=\"flex items-center justify-between pb-3 border-b border-[#3B4B47]\">\n          <div className=\"flex items-center gap-2\">\n            <Target className=\"w-4 h-4 text-[#C7F9A6]\" />\n            <h2 className=\"text-sm font-bold font-mono text-[#F0F4EE] uppercase\">\n              FIX BEFORE SUBMISSION\n            </h2>\n          </div>\n          <span className=\"text-xs font-mono text-[#A8E6CF]\">\n            +{fixedBonus.toFixed(2)} pts potential recovery\n          </span>\n        </div>\n\n        <div className=\"grid grid-cols-1 md:grid-cols-3 gap-3.5\">\n          {evaluation.fixes.map((fix) => (\n            <div\n              key={fix.id}\n              onClick={() => onToggleFix(fix.id)}\n              className={`p-4 rounded-xl border transition-all cursor-pointer select-none flex flex-col justify-between ${\n                fix.applied\n                  ? \'bg-[#31413F] border-[#B7E4C7]/40 shadow-sm\'\n                  : \'bg-[#202B2A] border-[#3B4B47] hover:border-[#FFE0A3]/40\'\n              }`}\n            >\n              <div>\n                <div className=\"flex items-start justify-between gap-2\">\n                  <span className=\"text-xs font-bold text-[#F0F4EE] leading-tight\">\n                    {fix.id}. {fix.title}\n                  </span>\n                  <span className=\"text-[10px] font-mono font-bold px-1.5 py-0.5 rounded bg-[#293735] text-[#C7F9A6]\">\n                    +{fix.scoreBonus}\n                  </span>\n                </div>\n\n                <p className=\"text-[11px] text-[#AAB8B2] mt-2 leading-relaxed\">\n                  {fix.description}\n                </p>\n              </div>\n\n              <div className=\"mt-3 pt-2 border-t border-[#3B4B47]/50 flex items-center justify-between text-[11px] font-mono\">\n                <span className={fix.applied ? \'text-[#B7E4C7] font-bold\' : \'text-[#71817B]\'}>\n                  {fix.applied ? \'\342\234\223 APPLIED\' : \'ACTION NEEDED\'}\n                </span>\n                <span className=\"text-[#A8DADC] text-[10px] hover:underline\">\n                  {fix.applied ? \'Toggle\' : \'Apply fix\'}\n                </span>\n              </div>\n            </div>\n          ))}\n        </div>\n      </div>\n\n      {/* 4. Weighted Rubric Criteria Matrix */}\n      <div className=\"p-6 rounded-2xl bg-[#293735] border border-[#3B4B47] shadow-xl space-y-4\">\n        <div className=\"flex items-center justify-between pb-3 border-b border-[#3B4B47]\">\n          <span className=\"text-xs font-mono font-bold text-[#F0F4EE] uppercase\">\n            WEIGHTED JUDGING CRITERIA BREAKDOWN\n          </span>\n          <span className=\"text-[10px] font-mono text-[#71817B]\">DORAHACKS 2.0 OFFICIAL RUBRIC</span>\n        </div>\n\n        <div className=\"space-y-4\">\n          {evaluation.criteria.map((crit) => {\n            const currentScore = scopeCutApplied \n              ? Math.min(10, crit.score + 0.5) \n              : crit.score;\n\n            return (\n              <div key={crit.name} className=\"space-y-1.5\">\n                <div className=\"flex justify-between text-xs font-mono\">\n                  <div className=\"flex items-center gap-2\">\n                    <span className=\"text-[#F0F4EE] font-bold\">{crit.name}</span>\n                    <span className=\"text-[#71817B] text-[10px]\">({crit.weight}% weight)</span>\n                  </div>\n                  <span className=\"text-[#C7F9A6] font-bold\">{currentScore.toFixed(1)} / 10</span>\n                </div>\n\n                <div className=\"h-2 rounded-full bg-[#202B2A] overflow-hidden border border-[#3B4B47]\">\n                  <div\n                    className=\"h-full bg-gradient-to-r from-[#A8E6CF] to-[#C7F9A6] transition-all duration-700\"\n                    style={{ width: `${(currentScore / 10) * 100}%` }}\n                  />\n                </div>\n\n                <p className=\"text-[11px] text-[#AAB8B2] leading-tight pt-0.5\">\n                  {crit.feedback}\n                </p>\n              </div>\n            );\n          })}\n        </div>\n      </div>\n    </div>\n  );\n};\n"
    }
