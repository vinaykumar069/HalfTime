    replacement_chunks {
      replacement_content: "import React from \'react\';\nimport { Cpu, Sparkles, AlertTriangle, ShieldCheck, Zap, Server, Database, RefreshCw } from \'lucide-react\';\nimport { AIResourceItem } from \'../../types\';\n\ninterface ResourcesViewProps {\n  resources: AIResourceItem[];\n  onOptimizeCredits: () => void;\n}\n\nexport const ResourcesView: React.FC<ResourcesViewProps> = ({\n  resources,\n  onOptimizeCredits,\n}) => {\n  return (\n    <div className=\"space-y-8 animate-in fade-in duration-300 pb-12\">\n      {/* Header */}\n      <div>\n        <div className=\"inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#31413F] border border-[#3B4B47] text-xs font-mono text-[#CDB4DB] mb-2\">\n          <Cpu className=\"w-3.5 h-3.5\" />\n          <span>COMPUTE &amp; TOKEN TELEMETRY</span>\n        </div>\n        <h1 className=\"text-2xl sm:text-4xl font-extrabold text-[#F0F4EE] tracking-tight font-display\">\n          AI RESOURCE PRESSURE\n        </h1>\n        <p className=\"text-sm sm:text-base text-[#AAB8B2] mt-1 font-medium\">\n          Monitor API rate limits, model quotas, and UI generation tokens to prevent exhaustion during live judge demos.\n        </p>\n      </div>\n\n      {/* Hero Resource Status & HALFTIME Recommendation */}\n      <div className=\"p-6 rounded-2xl bg-[#293735] border border-[#3B4B47] shadow-xl glass-panel-ai space-y-4\">\n        <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-3 border-b border-[#3B4B47]\">\n          <div className=\"flex items-center gap-2 text-xs font-mono text-[#A8E6CF] font-bold\">\n            <Sparkles className=\"w-4 h-4\" />\n            <span>HALFTIME RESOURCE ADVISORY</span>\n          </div>\n          <span className=\"text-[10px] font-mono text-[#71817B] bg-[#202B2A] px-2.5 py-1 rounded border border-[#3B4B47]\">\n            SYNCHRONIZED WITH DORAHACKS PROMETHEUS\n          </span>\n        </div>\n\n        <p className=\"text-sm sm:text-base font-semibold text-[#F0F4EE]\">\n          &ldquo;Save <strong className=\"text-[#FFE0A3]\">Base44 credits</strong> strictly for final UI polish. Shift high-frequency prompt iterations to <strong className=\"text-[#C7F9A6]\">Gemini 2.5 Flash</strong> to conserve quota for the 3-minute live evaluation.&rdquo;\n        </p>\n\n        <div className=\"pt-2 flex flex-wrap items-center gap-4 text-xs font-mono text-[#AAB8B2]\">\n          <div className=\"flex items-center gap-1.5\">\n            <span className=\"w-2 h-2 rounded-full bg-[#C7F9A6]\" />\n            <span>Gemini: Healthy Runway</span>\n          </div>\n          <div className=\"flex items-center gap-1.5\">\n            <span className=\"w-2 h-2 rounded-full bg-[#FFE0A3]\" />\n            <span>Base44: Approaching 40% Threshold</span>\n          </div>\n          <div className=\"flex items-center gap-1.5\">\n            <span className=\"w-2 h-2 rounded-full bg-[#A8DADC]\" />\n            <span>Claude: 84% Available</span>\n          </div>\n        </div>\n      </div>\n\n      {/* Detailed Resource Cards */}\n      <div className=\"grid grid-cols-1 md:grid-cols-3 gap-5\">\n        {resources.map((res) => {\n          const isWarning = res.remainingPercent < 50;\n\n          return (\n            <div\n              key={res.id}\n              className={`p-5 sm:p-6 rounded-2xl bg-[#293735] border transition-all shadow-lg flex flex-col justify-between ${\n                isWarning ? \'border-[#FFE0A3]/40\' : \'border-[#3B4B47]\'\n              }`}\n            >\n              <div className=\"space-y-4\">\n                <div className=\"flex items-start justify-between gap-2\">\n                  <div>\n                    <h3 className=\"text-base font-bold text-[#F0F4EE]\">\n                      {res.tool}\n                    </h3>\n                    <span className=\"text-[11px] font-mono text-[#71817B]\">\n                      {res.provider}\n                    </span>\n                  </div>\n\n                  <span className={`px-2.5 py-1 rounded-full text-xs font-mono font-bold border ${\n                    isWarning \n                      ? \'bg-[#FFE0A3]/20 text-[#FFE0A3] border-[#FFE0A3]/40\' \n                      : \'bg-[#C7F9A6]/20 text-[#C7F9A6] border-[#C7F9A6]/40\'\n                  }`}>\n                    {res.remainingPercent}%\n                  </span>\n                </div>\n\n                {/* Progress bar */}\n                <div>\n                  <div className=\"h-2 rounded-full bg-[#202B2A] overflow-hidden border border-[#3B4B47]\">\n                    <div\n                      className={`h-full transition-all duration-500 ${\n                        isWarning ? \'bg-[#FFE0A3]\' : \'bg-[#C7F9A6]\'\n                      }`}\n                      style={{ width: `${res.remainingPercent}%` }}\n                    />\n                  </div>\n                  <div className=\"flex justify-between text-[10px] font-mono text-[#71817B] mt-1.5\">\n                    <span>{res.creditsLabel}</span>\n                    <span>Burn: {res.burnRate}</span>\n                  </div>\n                </div>\n\n                {/* Recommended Use */}\n                <div className=\"p-3 rounded-xl bg-[#202B2A] border border-[#3B4B47] text-xs space-y-1\">\n                  <span className=\"text-[10px] font-mono text-[#A8E6CF] font-bold block\">\n                    RECOMMENDED ALLOCATION:\n                  </span>\n                  <p className=\"text-[#AAB8B2] text-[11px] leading-relaxed\">\n                    {res.recommendedUse}\n                  </p>\n                </div>\n\n                <div className=\"text-[11px] text-[#71817B] italic\">\n                  &ldquo;{res.statusNote}&rdquo;\n                </div>\n              </div>\n\n              <div className=\"pt-4 mt-4 border-t border-[#3B4B47] flex items-center justify-between text-[11px] font-mono\">\n                <span className=\"text-[#71817B]\">Telemetry Active</span>\n                <button\n                  onClick={onOptimizeCredits}\n                  className=\"text-[#A8E6CF] hover:underline flex items-center gap-1\"\n                >\n                  <RefreshCw className=\"w-3 h-3\" />\n                  <span>Refresh quota</span>\n                </button>\n              </div>\n            </div>\n          );\n        })}\n      </div>\n\n      {/* Architecture & Quota Strategy Note */}\n      <div className=\"p-5 rounded-2xl bg-[#202B2A] border border-[#3B4B47] text-xs text-[#71817B] space-y-2\">\n        <div className=\"flex items-center gap-2 text-[#F0F4EE] font-mono font-bold\">\n          <Server className=\"w-4 h-4 text-[#A8DADC]\" />\n          <span>PROTOTYPING &amp; JUDGE DEMO SECURITY POLICY</span>\n        </div>\n        <p>\n          Resource telemetry displays manual and simulated credit consumption monitoring for Gemini 2.5 Flash, Base44 Cloud, and Claude 3.7 Sonnet. All sensitive API keys remain securely guarded server-side and never exposed to the client bundle.\n        </p>\n      </div>\n    </div>\n  );\n};\n"
    }
