  file_change {
    absolute_path_uri: "file:///src/components/ideas/IdeaLab.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { \n  Lightbulb, \n  Sparkles, \n  Layers, \n  TrendingUp, \n  CheckCircle, \n  AlertOctagon, \n  XCircle, \n  ArrowRight,\n  Filter,\n  Plus,\n  RefreshCw\n} from \'lucide-react\';\nimport { IdeaItem } from \'../../types\';\nimport { generateIdeas } from \'../../services/aiService\';\n\ninterface IdeaLabProps {\n  ideas: IdeaItem[];\n  onSelectActiveIdea: (idea: IdeaItem) => void;\n  onAddGeneratedIdeas: (newIdeas: IdeaItem[]) => void;\n}\n\nexport const IdeaLab: React.FC<IdeaLabProps> = ({\n  ideas,\n  onSelectActiveIdea,\n  onAddGeneratedIdeas,\n}) => {\n  const [teamSkills, setTeamSkills] = useState(\'React, TypeScript, Python FastAPI, LLM Prompt Engineering\');\n  const [frustrations, setFrustrations] = useState(\'Teams waste 60% of hackathons coding non-essential features and running out of time\');\n  const [interests, setInterests] = useState(\'AI Developer Tools & Mission Control\');\n  const [targetUsers, setTargetUsers] = useState(\'Hackathon builders, fast-prototyping dev teams, and solo founders\');\n  const [availableTime, setAvailableTime] = useState(\'24\');\n  const [criteria, setCriteria] = useState(\'Innovation 25%, Problem Fit 20%, Usability 20%, Execution 15%\');\n  const [isGenerating, setIsGenerating] = useState(false);\n  const [filterVerdict, setFilterVerdict] = useState<string>(\'ALL\');\n\n  const handleGenerate = async () => {\n    setIsGenerating(true);\n    try {\n      const generated = await generateIdeas({\n        teamSkills,\n        frustrations,\n        interests,\n        targetUsers,\n        availableTimeHours: parseInt(availableTime, 10) || 24,\n        hackathonCriteria: criteria,\n      });\n      onAddGeneratedIdeas(generated);\n    } catch (err) {\n      // handled\n    } finally {\n      setIsGenerating(false);\n    }\n  };\n\n  const filteredIdeas = ideas.filter(idea => {\n    if (filterVerdict === \'ALL\') return true;\n    return idea.verdict === filterVerdict;\n  });\n\n  return (\n    <div className=\"space-y-8 animate-in fade-in duration-300 pb-12\">\n      {/* Header */}\n      <div>\n        <div className=\"inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#31413F] border border-[#3B4B47] text-xs font-mono text-[#A8DADC] mb-2\">\n          <Lightbulb className=\"w-3.5 h-3.5\" />\n          <span>IDEA VALIDATOR &amp; MATRIX</span>\n        </div>\n        <h1 className=\"text-2xl sm:text-4xl font-extrabold text-[#F0F4EE] tracking-tight font-display\">\n          FIND SOMETHING WORTH BUILDING.\n        </h1>\n        <p className=\"text-sm sm:text-base text-[#AAB8B2] mt-1 font-medium\">\n          Filter through hackathon noise. Score ideas by feasibility and 3-minute demo potential before writing a single line of code.\n        </p>\n      </div>\n\n      {/* Idea Generation Form Card */}\n      <div \n        id=\"idea-generation-form\"\n        className=\"p-6 rounded-2xl bg-[#293735] border border-[#3B4B47] shadow-xl space-y-4\"\n      >\n        <div className=\"flex items-center justify-between pb-3 border-b border-[#3B4B47]\">\n          <span className=\"text-xs font-mono font-bold text-[#F0F4EE] flex items-center gap-2\">\n            <Sparkles className=\"w-4 h-4 text-[#A8E6CF]\" />\n            AI IDEA SYNTHESIZER\n          </span>\n          <span className=\"text-[10px] font-mono text-[#71817B]\">PROMPT-ASSISTED</span>\n        </div>\n\n        <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 text-xs\">\n          {/* Team skills */}\n          <div className=\"space-y-1.5\">\n            <label className=\"text-[11px] font-mono text-[#AAB8B2] font-semibold\">\n              Team Skills &amp; Stack\n            </label>\n            <input\n              type=\"text\"\n              value={teamSkills}\n              onChange={(e) => setTeamSkills(e.target.value)}\n              className=\"w-full px-3 py-2 rounded-xl bg-[#202B2A] border border-[#3B4B47] text-[#F0F4EE] focus:outline-none focus:border-[#A8E6CF]\"\n            />\n          </div>\n\n          {/* Personal frustrations */}\n          <div className=\"space-y-1.5\">\n            <label className=\"text-[11px] font-mono text-[#AAB8B2] font-semibold\">\n              Personal Frustrations / Problem Space\n            </label>\n            <input\n              type=\"text\"\n              value={frustrations}\n              onChange={(e) => setFrustrations(e.target.value)}\n              className=\"w-full px-3 py-2 rounded-xl bg-[#202B2A] border border-[#3B4B47] text-[#F0F4EE] focus:outline-none focus:border-[#A8E6CF]\"\n            />\n          </div>\n\n          {/* Interests */}\n          <div className=\"space-y-1.5\">\n            <label className=\"text-[11px] font-mono text-[#AAB8B2] font-semibold\">\n              Target Tech / Interests\n            </label>\n            <input\n              type=\"text\"\n              value={interests}\n              onChange={(e) => setInterests(e.target.value)}\n              className=\"w-full px-3 py-2 rounded-xl bg-[#202B2A] border border-[#3B4B47] text-[#F0F4EE] focus:outline-none focus:border-[#A8E6CF]\"\n            />\n          </div>\n\n          {/* Target users */}\n          <div className=\"space-y-1.5\">\n            <label className=\"text-[11px] font-mono text-[#AAB8B2] font-semibold\">\n              Target Users\n            </label>\n            <input\n              type=\"text\"\n              value={targetUsers}\n              onChange={(e) => setTargetUsers(e.target.value)}\n              className=\"w-full px-3 py-2 rounded-xl bg-[#202B2A] border border-[#3B4B47] text-[#F0F4EE] focus:outline-none focus:border-[#A8E6CF]\"\n            />\n          </div>\n\n          {/* Available time */}\n          <div className=\"space-y-1.5\">\n            <label className=\"text-[11px] font-mono text-[#AAB8B2] font-semibold\">\n              Available Hackathon Hours\n            </label>\n            <input\n              type=\"number\"\n              value={availableTime}\n              onChange={(e) => setAvailableTime(e.target.value)}\n              className=\"w-full px-3 py-2 rounded-xl bg-[#202B2A] border border-[#3B4B47] text-[#F0F4EE] focus:outline-none focus:border-[#A8E6CF]\"\n            />\n          </div>\n\n          {/* Hackathon Criteria */}\n          <div className=\"space-y-1.5\">\n            <label className=\"text-[11px] font-mono text-[#AAB8B2] font-semibold\">\n              Hackathon Rubric Criteria\n            </label>\n            <input\n              type=\"text\"\n              value={criteria}\n              onChange={(e) => setCriteria(e.target.value)}\n              className=\"w-full px-3 py-2 rounded-xl bg-[#202B2A] border border-[#3B4B47] text-[#F0F4EE] focus:outline-none focus:border-[#A8E6CF]\"\n            />\n          </div>\n        </div>\n\n        <div className=\"pt-2 flex justify-end\">\n          <button\n            id=\"btn-generate-ideas\"\n            onClick={handleGenerate}\n            disabled={isGenerating}\n            className=\"flex items-center gap-2 px-5 py-2.5 rounded-xl bg-gradient-to-r from-[#A8E6CF] to-[#A8DADC] text-[#202B2A] font-mono text-xs font-bold hover:brightness-110 shadow-md active:scale-95 disabled:opacity-50 transition-all\"\n          >\n            <Sparkles className={`w-4 h-4 ${isGenerating ? \'animate-spin\' : \'\'}`} />\n            <span>{isGenerating ? \'Synthesizing ideas with Gemini...\' : \'GENERATE IDEAS\'}</span>\n          </button>\n        </div>\n      </div>\n\n      {/* Filter Tabs */}\n      <div className=\"flex items-center justify-between\">\n        <div className=\"flex items-center gap-2 text-xs font-mono\">\n          <span className=\"text-[#71817B]\">Filter Verdict:</span>\n          {[\'ALL\', \'BUILD\', \'MODIFY\', \'KILL\'].map((v) => (\n            <button\n              key={v}\n              onClick={() => setFilterVerdict(v)}\n              className={`px-3 py-1 rounded-lg border transition-all ${\n                filterVerdict === v\n                  ? \'bg-[#31413F] text-[#F0F4EE] border-[#C7F9A6]/30\'\n                  : \'bg-[#202B2A] text-[#71817B] border-[#3B4B47] hover:text-[#AAB8B2]\'\n              }`}\n            >\n              {v}\n            </button>\n          ))}\n        </div>\n        <span className=\"text-xs font-mono text-[#71817B]\">{filteredIdeas.length} evaluated</span>\n      </div>\n\n      {/* Idea Cards Grid */}\n      <div className=\"grid grid-cols-1 md:grid-cols-2 gap-5\">\n        {filteredIdeas.map((idea) => {\n          const getVerdictBadge = () => {\n            switch (idea.verdict) {\n              case \'BUILD\':\n                return {\n                  bg: \'bg-[#B7E4C7]/20 text-[#B7E4C7] border-[#B7E4C7]/40\',\n                  icon: <CheckCircle className=\"w-3.5 h-3.5 text-[#B7E4C7]\" />,\n                  label: \'BUILD THIS\'\n                };\n              case \'MODIFY\':\n                return {\n                  bg: \'bg-[#FFE0A3]/20 text-[#FFE0A3] border-[#FFE0A3]/40\',\n                  icon: <AlertOctagon className=\"w-3.5 h-3.5 text-[#FFE0A3]\" />,\n                  label: \'MODIFY SCOPE\'\n                };\n              case \'KILL\':\n                return {\n                  bg: \'bg-[#FFB7B2]/20 text-[#FFB7B2] border-[#FFB7B2]/40\',\n                  icon: <XCircle className=\"w-3.5 h-3.5 text-[#FFB7B2]\" />,\n                  label: \'KILL IT\'\n                };\n            }\n          };\n\n          const verdict = getVerdictBadge();\n\n          return (\n            <div\n              key={idea.id}\n              className=\"p-5 sm:p-6 rounded-2xl bg-[#293735] border border-[#3B4B47] hover:border-[#A8E6CF]/40 transition-all shadow-lg flex flex-col justify-between group\"\n            >\n              <div className=\"space-y-3\">\n                {/* Verdict Pill & Tags */}\n                <div className=\"flex items-center justify-between\">\n                  <div className={`flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-mono font-bold border ${verdict.bg}`}>\n                    {verdict.icon}\n                    <span>{verdict.label}</span>\n                  </div>\n\n                  <div className=\"flex items-center gap-1.5\">\n                    {idea.tags.map((t) => (\n                      <span key={t} className=\"px-2 py-0.5 rounded bg-[#202B2A] text-[10px] font-mono text-[#71817B] border border-[#3B4B47]\">\n                        {t}\n                      </span>\n                    ))}\n                  </div>\n                </div>\n\n                {/* Title */}\n                <h3 className=\"text-lg font-bold text-[#F0F4EE] group-hover:text-[#A8E6CF] transition-colors\">\n                  {idea.title}\n                </h3>\n\n                {/* Problem & Solution */}\n                <div className=\"space-y-1.5 text-xs text-[#AAB8B2]\">\n                  <div>\n                    <span className=\"font-mono text-[#71817B] font-semibold\">PROBLEM: </span>\n                    <span>{idea.problem}</span>\n                  </div>\n                  <div>\n                    <span className=\"font-mono text-[#71817B] font-semibold\">SOLUTION: </span>\n                    <span className=\"text-[#F0F4EE]\">{idea.solution}</span>\n                  </div>\n                  <div>\n                    <span className=\"font-mono text-[#71817B] font-semibold\">TARGET USER: </span>\n                    <span>{idea.targetUser}</span>\n                  </div>\n                </div>\n\n                {/* Score Meters */}\n                <div className=\"grid grid-cols-2 sm:grid-cols-4 gap-2 pt-2 border-t border-[#3B4B47]\">\n                  <div className=\"p-2 rounded-lg bg-[#202B2A] border border-[#3B4B47] text-center\">\n                    <div className=\"text-[10px] font-mono text-[#71817B]\">INNOVATION</div>\n                    <div className=\"text-xs font-mono font-bold text-[#C7F9A6] mt-0.5\">{idea.innovationScore}</div>\n                  </div>\n                  <div className=\"p-2 rounded-lg bg-[#202B2A] border border-[#3B4B47] text-center\">\n                    <div className=\"text-[10px] font-mono text-[#71817B]\">PROBLEM FIT</div>\n                    <div className=\"text-xs font-mono font-bold text-[#A8E6CF] mt-0.5\">{idea.problemFitScore}</div>\n                  </div>\n                  <div className=\"p-2 rounded-lg bg-[#202B2A] border border-[#3B4B47] text-center\">\n                    <div className=\"text-[10px] font-mono text-[#71817B]\">FEASIBILITY</div>\n                    <div className=\"text-xs font-mono font-bold text-[#A8DADC] mt-0.5\">{idea.feasibilityScore}</div>\n                  </div>\n                  <div className=\"p-2 rounded-lg bg-[#202B2A] border border-[#3B4B47] text-center\">\n                    <div className=\"text-[10px] font-mono text-[#71817B]\">DEMO IMPACT</div>\n                    <div className=\"text-xs font-mono font-bold text-[#FFE0A3] mt-0.5\">{idea.demoPotentialScore}</div>\n                  </div>\n                </div>\n\n                {/* Reason */}\n                <div className=\"p-3 rounded-xl bg-[#202B2A]/70 border border-[#3B4B47]/60 text-[11px] text-[#AAB8B2] italic\">\n                  &ldquo;{idea.verdictReason}&rdquo;\n                </div>\n              </div>\n\n              {/* Action */}\n              <div className=\"pt-4 mt-3 border-t border-[#3B4B47] flex justify-end\">\n                <button\n                  onClick={() => onSelectActiveIdea(idea)}\n                  className=\"flex items-center gap-1.5 px-3.5 py-1.5 rounded-lg bg-[#31413F] hover:bg-[#3B4B47] border border-[#3B4B47] hover:border-[#C7F9A6]/40 text-xs font-mono text-[#F0F4EE] hover:text-[#C7F9A6] transition-all\"\n                >\n                  <span>Select for MVP Plan</span>\n                  <ArrowRight className=\"w-3.5 h-3.5\" />\n                </button>\n              </div>\n            </div>\n          );\n        })}\n      </div>\n    </div>\n  );\n};\n"
    }
