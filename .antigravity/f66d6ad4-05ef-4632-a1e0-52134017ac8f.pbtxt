  file_change {
    absolute_path_uri: "file:///src/services/aiService.ts"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import { IdeaItem, MVPFeature, ScopeCutItem, JudgeEvaluation, ProjectHealth } from \'../types\';\n\nexport interface IdeaGenerationPrompt {\n  teamSkills: string;\n  frustrations: string;\n  interests: string;\n  targetUsers: string;\n  availableTimeHours: number;\n  hackathonCriteria: string;\n}\n\nexport interface PitchCoachResult {\n  problem: string;\n  whyItMatters: string;\n  solution: string;\n  howItWorks: string;\n  demoMoment: string;\n  impact: string;\n  whyNow: string;\n  script: string;\n  durationSeconds: number;\n  keyTakeaway: string;\n}\n\n/**\n * 1. GENERATE IDEAS\n * Connects to server-side Gemini route with fallback\n */\nexport async function generateIdeas(input: IdeaGenerationPrompt): Promise<IdeaItem[]> {\n  try {\n    const res = await fetch(\'/api/ai/generate-ideas\', {\n      method: \'POST\',\n      headers: { \'Content-Type\': \'application/json\' },\n      body: JSON.stringify(input),\n    });\n\n    if (res.ok) {\n      const data = await res.json();\n      if (data?.success && Array.isArray(data.ideas) && data.ideas.length > 0) {\n        return data.ideas;\n      }\n    }\n  } catch (err) {\n    console.warn(\'[AI Client] generateIdeas fallback active:\', err);\n  }\n\n  // Graceful fallback\n  const keyword = input.interests || \'AI Developer Tools\';\n  return [\n    {\n      id: `idea-gen-${Date.now()}-1`,\n      title: `${keyword} Command Center`,\n      problem: `Teams waste hours on manual context-switching and misaligned milestones during time-compressed ${input.availableTimeHours || 24}h builds.`,\n      targetUser: input.targetUsers || \'Hackathon participants and rapid prototyping teams\',\n      solution: `Real-time AI copilot that monitors commit velocity, cuts bloated features, and ensures a bulletproof judge demo.`,\n      innovationScore: 8.9,\n      problemFitScore: 9.3,\n      feasibilityScore: 8.8,\n      demoPotentialScore: 9.5,\n      verdict: \'BUILD\',\n      verdictReason: `Extremely high demo appeal. Solves a visceral pain point for hackathon judges and organizers.`,\n      tags: [\'Autonomous\', \'High Velocity\', \'AI Agent\'],\n    },\n    {\n      id: `idea-gen-${Date.now()}-2`,\n      title: `PromptTrace: Automated Test Harness for LLMs`,\n      problem: `AI developers struggle to reproduce prompt regression and token explosion during fast iteration cycles.`,\n      targetUser: \'LLM Engineers & Hackathon Builders\',\n      solution: `Single-line SDK interceptor that logs drift, validates schema outputs, and generates automated regression tests.`,\n      innovationScore: 8.4,\n      problemFitScore: 8.7,\n      feasibilityScore: 8.2,\n      demoPotentialScore: 8.1,\n      verdict: \'BUILD\',\n      verdictReason: `Very crisp technical demo with immediate developer utility.`,\n      tags: [\'DevTools\', \'Testing\', \'Reliability\'],\n    },\n    {\n      id: `idea-gen-${Date.now()}-3`,\n      title: `OmniVoice: Universal Meeting Whisperer`,\n      problem: `Remote teams lose context across fragmented video calls and messy chat threads.`,\n      targetUser: \'Distributed teams\',\n      solution: `Passive background bot that detects unassigned action items and cross-references them with Jira.`,\n      innovationScore: 6.8,\n      problemFitScore: 7.2,\n      feasibilityScore: 6.0,\n      demoPotentialScore: 5.9,\n      verdict: \'MODIFY\',\n      verdictReason: `Overcrowded market. Needs a radical twist (e.g. instant code generation from voice) to stand out.`,\n      tags: [\'Audio\', \'Productivity\', \'Red Ocean\'],\n    },\n  ];\n}\n\n/**\n * 2. EVALUATE IDEA (Idea Killer / Validator)\n */\nexport async function evaluateIdea(idea: Partial<IdeaItem>): Promise<any> {\n  try {\n    const res = await fetch(\'/api/ai/evaluate-idea\', {\n      method: \'POST\',\n      headers: { \'Content-Type\': \'application/json\' },\n      body: JSON.stringify({\n        idea: idea.title,\n        problem: idea.problem,\n        targetUser: idea.targetUser,\n        solution: idea.solution,\n      }),\n    });\n\n    if (res.ok) {\n      const data = await res.json();\n      if (data?.success && data.evaluation) {\n        return {\n          ...idea,\n          ...data.evaluation,\n          innovationScore: data.evaluation.innovation || idea.innovationScore || 8.5,\n          problemFitScore: data.evaluation.problemFit || idea.problemFitScore || 8.5,\n          feasibilityScore: data.evaluation.feasibility || idea.feasibilityScore || 8.5,\n          demoPotentialScore: data.evaluation.demoPotential || idea.demoPotentialScore || 8.5,\n          verdict: data.evaluation.verdict || \'BUILD\',\n          verdictReason: data.evaluation.verdictReason || \'Evaluated successfully by Gemini.\',\n        };\n      }\n    }\n  } catch (err) {\n    console.warn(\'[AI Client] evaluateIdea fallback active:\', err);\n  }\n\n  const innovation = Number((7.8 + Math.random() * 1.5).toFixed(1));\n  const problemFit = Number((8.2 + Math.random() * 1.4).toFixed(1));\n  const feasibility = Number((7.4 + Math.random() * 2.0).toFixed(1));\n  const demoPotential = Number((8.1 + Math.random() * 1.5).toFixed(1));\n  const avg = (innovation + problemFit + feasibility + demoPotential) / 4;\n  const verdict = avg > 8.0 ? \'BUILD\' : avg > 6.8 ? \'MODIFY\' : \'KILL\';\n\n  return {\n    ...idea,\n    innovationScore: innovation,\n    problemFitScore: problemFit,\n    feasibilityScore: feasibility,\n    demoPotentialScore: demoPotential,\n    verdict,\n    verdictReason: verdict === \'BUILD\'\n      ? \'Strong alignment with judging criteria, clear value proposition, and rapid prototypeability.\'\n      : \'Viable concept but requires substantial simplification to execute reliably in remaining hours.\',\n  };\n}\n\n/**\n * 3. GENERATE MVP PLAN\n */\nexport async function generateMVP(ideaTitle: string, remainingHours: number = 16): Promise<{\n  features: MVPFeature[];\n  problemStatement?: string;\n  targetUser?: string;\n  coreSolution?: string;\n  valueProposition?: string;\n}> {\n  try {\n    const res = await fetch(\'/api/ai/generate-mvp\', {\n      method: \'POST\',\n      headers: { \'Content-Type\': \'application/json\' },\n      body: JSON.stringify({ ideaTitle, remainingHours }),\n    });\n\n    if (res.ok) {\n      const data = await res.json();\n      if (data?.success && data.plan?.features) {\n        return {\n          features: data.plan.features,\n          problemStatement: data.plan.problemStatement,\n          targetUser: data.plan.targetUser,\n          coreSolution: data.plan.coreSolution,\n          valueProposition: data.plan.valueProposition,\n        };\n      }\n    }\n  } catch (err) {\n    console.warn(\'[AI Client] generateMVP fallback active:\', err);\n  }\n\n  return {\n    features: [\n      {\n        id: `mvp-${Date.now()}-1`,\n        name: `Core ${ideaTitle} Engine`,\n        description: \'The single most impressive capability that proves the concept works.\',\n        estimatedHours: 3.0,\n        priority: \'MUST_BUILD\',\n        demoCritical: true,\n        category: \'Core AI\',\n      },\n      {\n        id: `mvp-${Date.now()}-2`,\n        name: \'Real-time Interactive Demo Screen\',\n        description: \'Zero-friction visual UI that judges can watch or test within 30 seconds.\',\n        estimatedHours: 2.0,\n        priority: \'MUST_BUILD\',\n        demoCritical: true,\n        category: \'UI / Polish\',\n      },\n      {\n        id: `mvp-${Date.now()}-3`,\n        name: \'Automated Insight Exporter\',\n        description: \'Generates summary cards or shareable output links.\',\n        estimatedHours: 1.5,\n        priority: \'SHOULD_BUILD\',\n        demoCritical: false,\n        category: \'Infrastructure\',\n      },\n      {\n        id: `mvp-${Date.now()}-4`,\n        name: \'Multi-tenant User Auth & Billing\',\n        description: \'Stripe integration and team role hierarchies.\',\n        estimatedHours: 3.5,\n        priority: \'CUT\',\n        demoCritical: false,\n        category: \'Add-on\',\n      },\n    ],\n  };\n}\n\n/**\n * 4. NEXT ACTION RECOMMENDATION (Halftime Says)\n */\nexport async function recommendNextAction(\n  health: ProjectHealth,\n  currentProject: string = \'HALFTIME Command Center\',\n  scopeCutApplied: boolean = false\n): Promise<{\n  actionTitle: string;\n  priority: \'CRITICAL\' | \'HIGH\';\n  estimatedTime: string;\n  reason: string;\n  risk?: string;\n  alternativeAction?: string;\n}> {\n  try {\n    const res = await fetch(\'/api/ai/recommend-next-action\', {\n      method: \'POST\',\n      headers: { \'Content-Type\': \'application/json\' },\n      body: JSON.stringify({\n        timeRemaining: `${health.timeAvailableHours}h 00m`,\n        workRemaining: `${health.workRequiredHours}h`,\n        riskStatus: health.status === \'on-track\' ? \'ON TRACK\' : \'AT RISK\',\n        currentProject,\n        scopeCutApplied,\n      }),\n    });\n\n    if (res.ok) {\n      const data = await res.json();\n      if (data?.success && data.recommendation) {\n        return {\n          actionTitle: data.recommendation.nextAction,\n          priority: data.recommendation.priority || \'CRITICAL\',\n          estimatedTime: data.recommendation.estimatedTime || \'1h 20m\',\n          reason: data.recommendation.reason,\n          risk: data.recommendation.risk,\n          alternativeAction: data.recommendation.alternativeAction,\n        };\n      }\n    }\n  } catch (err) {\n    console.warn(\'[AI Client] recommendNextAction fallback active:\', err);\n  }\n\n  if (health.capacityGapHours > 0 && !scopeCutApplied) {\n    return {\n      actionTitle: \'Execute scope cut: remove 3h of non-essential features\',\n      priority: \'CRITICAL\',\n      estimatedTime: \'2m\',\n      reason: `You are currently ${health.capacityGapHours}h over capacity. Trimming secondary modules brings your project back into the safe delivery zone.`,\n      risk: \'Without cutting scope now, the live demo will be incomplete during judging.\',\n      alternativeAction: \'Descope non-essential database schemas.\',\n    };\n  }\n\n  return {\n    actionTitle: \'Finish the core AI evaluation flow\',\n    priority: \'CRITICAL\',\n    estimatedTime: \'1h 20m\',\n    reason: \'Everything else depends on this workflow. Once finished, run judge mode to verify demo scoring.\',\n    risk: \'Delays here push demo video recording into the final 30 minutes.\',\n    alternativeAction: \'Polish the live interactive simulator UI.\',\n  };\n}\n\n/**\n * 5. RECOMMEND SCOPE CUTS\n */\nexport async function recommendScopeCuts(health: ProjectHealth): Promise<ScopeCutItem[]> {\n  try {\n    const res = await fetch(\'/api/ai/recommend-scope-cuts\', {\n      method: \'POST\',\n      headers: { \'Content-Type\': \'application/json\' },\n      body: JSON.stringify({\n        remainingTime: `${health.timeAvailableHours} hours`,\n        remainingWork: `${health.workRequiredHours} hours`,\n      }),\n    });\n\n    if (res.ok) {\n      const data = await res.json();\n      if (data?.success && data.scopeCuts?.cuts) {\n        return data.scopeCuts.cuts.map((c: any, i: number) => ({\n          id: c.id || `cut-rec-${i + 1}`,\n          name: c.name,\n          category: c.category || \'Feature Scope\',\n          timeMinutes: Number(c.timeMinutes) || 60,\n          timeFormatted: c.timeFormatted || \'\342\210\2221h\',\n          reason: c.reason,\n          selectedForCut: true,\n          isCut: false,\n          impactScore: c.impactScore || \'0% demo impact\',\n        }));\n      }\n    }\n  } catch (err) {\n    console.warn(\'[AI Client] recommendScopeCuts fallback active:\', err);\n  }\n\n  return [\n    {\n      id: \'cut-rec-1\',\n      name: \'Analytics dashboard\',\n      category: \'Reporting & Charts\',\n      timeMinutes: 120,\n      timeFormatted: \'\342\210\2222h\',\n      reason: \'Judges will not click into secondary analytics during a 3-minute pitch. Zero demo impact.\',\n      selectedForCut: true,\n      isCut: false,\n      impactScore: \'0% demo impact\',\n    },\n    {\n      id: \'cut-rec-2\',\n      name: \'Team profiles & bios\',\n      category: \'User Experience\',\n      timeMinutes: 60,\n      timeFormatted: \'\342\210\2221h\',\n      reason: \'Static team badges can be verbally introduced in 10 seconds. Save UI build time.\',\n      selectedForCut: true,\n      isCut: false,\n      impactScore: \'0% demo impact\',\n    },\n    {\n      id: \'cut-rec-3\',\n      name: \'Dark mode customization\',\n      category: \'Styling & Themes\',\n      timeMinutes: 45,\n      timeFormatted: \'\342\210\22245m\',\n      reason: \'Dark theme is already default and polished. Custom theme switchers waste precious testing hours.\',\n      selectedForCut: true,\n      isCut: false,\n      impactScore: \'0% demo impact\',\n    },\n  ];\n}\n\n/**\n * 6. JUDGE PROJECT SIMULATION\n */\nexport async function judgeProject(scopeCutApplied: boolean): Promise<JudgeEvaluation> {\n  try {\n    const res = await fetch(\'/api/ai/judge-project\', {\n      method: \'POST\',\n      headers: { \'Content-Type\': \'application/json\' },\n      body: JSON.stringify({ scopeCutApplied }),\n    });\n\n    if (res.ok) {\n      const data = await res.json();\n      if (data?.success && data.evaluation) {\n        const ev = data.evaluation;\n        return {\n          overallScore: Number(ev.overallScore) || (scopeCutApplied ? 9.2 : 8.55),\n          statusLabel: ev.statusLabel || (scopeCutApplied ? \'STRONG CONTENDER\' : \'BUILD IT\'),\n          summaryFeedback: ev.summaryFeedback || \'Evaluation completed.\',\n          whyYouMightLose: ev.whyYouMightLose || \'Make sure the demo reaches the core hook within 30 seconds.\',\n          criteria: ev.criteria || [],\n          fixes: ev.fixes || [],\n        };\n      }\n    }\n  } catch (err) {\n    console.warn(\'[AI Client] judgeProject fallback active:\', err);\n  }\n\n  const baseScore = scopeCutApplied ? 9.2 : 8.55;\n  return {\n    overallScore: baseScore,\n    statusLabel: scopeCutApplied ? \'STRONG CONTENDER\' : \'BUILD IT\',\n    summaryFeedback: scopeCutApplied\n      ? \'Exceptional focus on core value delivery. The project has eliminated bloat and presents a razor-sharp demo narrative.\'\n      : \'Compelling hackathon thesis with undeniable judge empathy. Sharp interface and instant utility. The before/after contrast is striking.\',\n    criteria: [\n      { name: \'Innovation\', weight: 25, score: scopeCutApplied ? 9.3 : 8.7, feedback: \'Novel paradigm for active hackathon triage rather than generic chat.\' },\n      { name: \'Problem Fit\', weight: 20, score: scopeCutApplied ? 9.6 : 9.2, feedback: \'Directly solves the #1 reason hackathon teams fail (poor scope management).\' },\n      { name: \'Usability\', weight: 20, score: scopeCutApplied ? 9.1 : 8.1, feedback: \'High contrast and clear CTA hierarchy. Micro-interactions feel natural.\' },\n      { name: \'Execution\', weight: 15, score: scopeCutApplied ? 9.4 : 8.4, feedback: \'Fast, responsive, and mathematically coherent timeline calculations.\' },\n      { name: \'Impact\', weight: 10, score: scopeCutApplied ? 8.6 : 7.8, feedback: \'Broad addressable developer market; potential commercial SaaS applicability.\' },\n      { name: \'Feasibility\', weight: 10, score: scopeCutApplied ? 9.8 : 9.1, feedback: \'No unfeasible dependencies; robust architecture.\' },\n    ],\n    whyYouMightLose: scopeCutApplied\n      ? \'Ensure your 3-minute pitch starts directly with the problem statement before showing the live demo.\'\n      : \'Your problem is strong, but your demo takes too long to reach the core value. If judges do not see the Scope Cutter recalculation within the first 45 seconds, attention will drift.\',\n    fixes: [\n      {\n        id: 1,\n        title: \'Shorten onboarding to 0 clicks\',\n        description: \'Pre-seed sample DoraHacks telemetry immediately so judges see the 3h gap instantly.\',\n        scoreBonus: 0.35,\n        applied: true,\n      },\n      {\n        id: 2,\n        title: \'Demo the core workflow first\',\n        description: \'Trigger the \"Cut Selected Features\" animation within the first 30 seconds of the presentation.\',\n        scoreBonus: 0.25,\n        applied: scopeCutApplied,\n      },\n      {\n        id: 3,\n        title: \'Remove unnecessary analytics & profiles\',\n        description: \'Execute the scope cut to prove disciplined engineering priorities to senior judges.\',\n        scoreBonus: 0.15,\n        applied: scopeCutApplied,\n      },\n    ],\n  };\n}\n\n/**\n * 7. PITCH COACH\n */\nexport async function improvePitch(params: {\n  problem?: string;\n  solution?: string;\n  demoMoment?: string;\n  impact?: string;\n}): Promise<PitchCoachResult> {\n  try {\n    const res = await fetch(\'/api/ai/pitch-coach\', {\n      method: \'POST\',\n      headers: { \'Content-Type\': \'application/json\' },\n      body: JSON.stringify(params),\n    });\n\n    if (res.ok) {\n      const data = await res.json();\n      if (data?.success && data.pitch) {\n        return data.pitch;\n      }\n    }\n  } catch (err) {\n    console.warn(\'[AI Client] improvePitch fallback active:\', err);\n  }\n\n  return {\n    problem: \'Hackathon teams waste 60% of their build time on features judges never click, leading to rushed, broken demos.\',\n    whyItMatters: \'Every weekend, thousands of talented engineers burn out and fail to submit their prototypes.\',\n    solution: \'HALFTIME is the real-time mission control copilot that constantly recalculates runway and ruthlessly cuts scope.\',\n    howItWorks: \'1. Connects to project backlog. 2. Tracks real-time velocity against DoraHacks deadline. 3. Recommends 1-click feature cuts with 0 demo sacrifice.\',\n    demoMoment: \'In one click, HALFTIME cuts 3 hours of bloat and moves the project from AT RISK to ON TRACK.\',\n    impact: \'Helps 100,000+ hackathon builders globally ship working MVPs on time.\',\n    whyNow: \'LLM reasoning makes instant scope triage possible at zero cognitive overhead.\',\n    script: `Judges, 60% of hackathon teams fail before the finish line. Not because they can\'t code, but because they build the wrong things.\n\nMeet HALFTIME: the AI mission control for hackathon teams.\n\nHALFTIME monitors our build time against the deadline in real time. 20 minutes ago, we were 3 hours over capacity. In one click, HALFTIME executed a surgical scope cut\342\200\224saving 3 hours and 45 minutes of bloat without sacrificing a single judging point.\n\nInstead of an unfinished monolith, we shipped a rock-solid, production-ready product. Stop. Recalculate. Ship.`,\n    durationSeconds: 75,\n    keyTakeaway: \'Don\342\200\231t build more. Ship what matters.\',\n  };\n}\n"
    }
