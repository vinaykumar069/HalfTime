    replacement_chunks {
      replacement_content: "import React, { useEffect } from \'react\';\nimport { Sparkles, X, CheckCircle2, Rocket, ArrowRight, Github, ExternalLink, Video, Award, Shield } from \'lucide-react\';\nimport confetti from \'canvas-confetti\';\n\ninterface ShipModeModalProps {\n  isOpen: boolean;\n  onClose: () => void;\n  scopeCutApplied: boolean;\n  score: number;\n}\n\nexport const ShipModeModal: React.FC<ShipModeModalProps> = ({\n  isOpen,\n  onClose,\n  scopeCutApplied,\n  score,\n}) => {\n  useEffect(() => {\n    if (isOpen) {\n      // Trigger elegant confetti celebration\n      try {\n        confetti({\n          particleCount: 80,\n          spread: 70,\n          origin: { y: 0.6 },\n          colors: [\'#C7F9A6\', \'#A8E6CF\', \'#A8DADC\', \'#FFE0A3\', \'#CDB4DB\'],\n        });\n      } catch (e) {\n        // Fallback gracefully\n      }\n    }\n  }, [isOpen]);\n\n  if (!isOpen) return null;\n\n  return (\n    <div className=\"fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/85 backdrop-blur-xl animate-in fade-in duration-200\">\n      <div \n        id=\"halftime-ship-mode-modal\"\n        className=\"relative w-full max-w-3xl bg-gradient-to-b from-[#293735] via-[#202B2A] to-[#1a2322] border border-[#C7F9A6]/40 rounded-3xl shadow-[0_0_80px_-10px_rgba(199,249,166,0.2)] overflow-hidden flex flex-col max-h-[90vh]\"\n      >\n        {/* Subtle top aurora mesh gradient */}\n        <div className=\"absolute top-0 left-1/4 right-1/4 h-32 bg-gradient-to-b from-[#C7F9A6]/15 via-[#A8E6CF]/10 to-transparent blur-3xl pointer-events-none\" />\n\n        {/* Close Button */}\n        <button\n          onClick={onClose}\n          className=\"absolute top-5 right-5 z-20 p-2 rounded-full bg-[#202B2A]/80 border border-[#3B4B47] text-[#71817B] hover:text-[#F0F4EE] hover:bg-[#31413F] transition-all\"\n        >\n          <X className=\"w-4 h-4\" />\n        </button>\n\n        {/* Header Hero */}\n        <div className=\"pt-10 pb-6 px-8 text-center relative z-10 border-b border-[#3B4B47]/60\">\n          <div className=\"inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#C7F9A6]/10 border border-[#C7F9A6]/30 text-[#C7F9A6] font-mono text-xs font-semibold mb-4\">\n            <Sparkles className=\"w-3.5 h-3.5\" />\n            <span>SHIP MODE ACTIVE</span>\n          </div>\n\n          <h2 className=\"text-2xl sm:text-4xl font-extrabold text-[#F0F4EE] tracking-tight font-display\">\n            You&apos;re not out of time.\n          </h2>\n          <p className=\"text-lg sm:text-2xl font-bold bg-gradient-to-r from-[#C7F9A6] via-[#A8E6CF] to-[#A8DADC] bg-clip-text text-transparent mt-1\">\n            You&apos;re out of unnecessary features.\n          </p>\n\n          <p className=\"text-xs sm:text-sm text-[#AAB8B2] max-w-lg mx-auto mt-3\">\n            Team DOOM has stripped away the friction. The core AI evaluation engine is stable, tested, and ready to stun DoraHacks 2.0 judges.\n          </p>\n        </div>\n\n        {/* Submission Telemetry Bento */}\n        <div className=\"p-6 sm:p-8 overflow-y-auto space-y-5\">\n          <div className=\"grid grid-cols-1 sm:grid-cols-3 gap-3\">\n            <div className=\"p-4 rounded-2xl bg-[#293735]/60 border border-[#3B4B47] flex flex-col justify-between\">\n              <span className=\"text-[11px] font-mono text-[#71817B]\">ESTIMATED JUDGE SCORE</span>\n              <div className=\"text-2xl font-mono font-bold text-[#C7F9A6] mt-2\">\n                {scopeCutApplied ? \'9.20\' : \'8.55\'} <span className=\"text-xs text-[#71817B]\">/ 10</span>\n              </div>\n              <span className=\"text-[10px] text-[#B7E4C7] font-mono mt-1\">Top 3% Hackathon Tier</span>\n            </div>\n\n            <div className=\"p-4 rounded-2xl bg-[#293735]/60 border border-[#3B4B47] flex flex-col justify-between\">\n              <span className=\"text-[11px] font-mono text-[#71817B]\">RECOVERED TIME</span>\n              <div className=\"text-2xl font-mono font-bold text-[#A8E6CF] mt-2\">\n                3h 45m\n              </div>\n              <span className=\"text-[10px] text-[#A8E6CF] font-mono mt-1\">Zero Demo Sacrifice</span>\n            </div>\n\n            <div className=\"p-4 rounded-2xl bg-[#293735]/60 border border-[#3B4B47] flex flex-col justify-between\">\n              <span className=\"text-[11px] font-mono text-[#71817B]\">SUBMISSION STATUS</span>\n              <div className=\"text-2xl font-mono font-bold text-[#B8DDF0] mt-2\">\n                READY\n              </div>\n              <span className=\"text-[10px] text-[#B8DDF0] font-mono mt-1\">DoraHacks 2.0 Port</span>\n            </div>\n          </div>\n\n          {/* Submission checklist verified */}\n          <div className=\"p-4 rounded-2xl bg-[#202B2A]/90 border border-[#3B4B47] space-y-3\">\n            <div className=\"text-xs font-mono font-bold text-[#F0F4EE] flex items-center justify-between\">\n              <span>HACKATHON ARTIFACTS VERIFICATION</span>\n              <span className=\"text-[#C7F9A6] text-[10px]\">ALL CRITICAL PASS</span>\n            </div>\n\n            <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs\">\n              <div className=\"flex items-center gap-2 p-2.5 rounded-xl bg-[#293735]/50 border border-[#3B4B47]/60 text-[#F0F4EE]\">\n                <CheckCircle2 className=\"w-4 h-4 text-[#B7E4C7] shrink-0\" />\n                <span className=\"truncate\">Cloud Run Live Preview Deployed</span>\n              </div>\n              <div className=\"flex items-center gap-2 p-2.5 rounded-xl bg-[#293735]/50 border border-[#3B4B47]/60 text-[#F0F4EE]\">\n                <CheckCircle2 className=\"w-4 h-4 text-[#B7E4C7] shrink-0\" />\n                <span className=\"truncate\">GitHub Public Repo & README.md</span>\n              </div>\n              <div className=\"flex items-center gap-2 p-2.5 rounded-xl bg-[#293735]/50 border border-[#3B4B47]/60 text-[#F0F4EE]\">\n                <CheckCircle2 className=\"w-4 h-4 text-[#B7E4C7] shrink-0\" />\n                <span className=\"truncate\">3-Minute Live Demo Pitch Script</span>\n              </div>\n              <div className=\"flex items-center gap-2 p-2.5 rounded-xl bg-[#293735]/50 border border-[#3B4B47]/60 text-[#F0F4EE]\">\n                <CheckCircle2 className=\"w-4 h-4 text-[#B7E4C7] shrink-0\" />\n                <span className=\"truncate\">Backup 60s Video Screen Recording</span>\n              </div>\n            </div>\n          </div>\n\n          {/* Quote */}\n          <div className=\"p-4 rounded-2xl bg-[#293735]/30 border border-[#C7F9A6]/20 text-center\">\n            <p className=\"text-xs italic text-[#AAB8B2]\">\n              &ldquo;The difference between amateur and winning hackathon teams isn&apos;t lines of code written. It&apos;s having the guts to ship exactly what matters.&rdquo;\n            </p>\n            <div className=\"text-[10px] font-mono text-[#C7F9A6] mt-1 font-bold\">\342\200\224 HALFTIME Copilot</div>\n          </div>\n        </div>\n\n        {/* Action Bottom Bar */}\n        <div className=\"p-6 bg-[#202B2A] border-t border-[#3B4B47] flex flex-col sm:flex-row items-center justify-between gap-3\">\n          <div className=\"flex items-center gap-2 text-xs text-[#71817B] font-mono\">\n            <Shield className=\"w-4 h-4 text-[#C7F9A6]\" />\n            <span>Ready for DoraHacks submission window</span>\n          </div>\n\n          <div className=\"flex items-center gap-3 w-full sm:w-auto\">\n            <button\n              onClick={onClose}\n              className=\"px-4 py-2 rounded-xl bg-[#293735] hover:bg-[#31413F] text-xs font-mono text-[#AAB8B2] hover:text-[#F0F4EE] border border-[#3B4B47] transition-all flex-1 sm:flex-none\"\n            >\n              Back to Command Center\n            </button>\n            <button\n              onClick={() => {\n                confetti({ particleCount: 120, spread: 80 });\n                onClose();\n              }}\n              className=\"px-6 py-2.5 rounded-xl bg-gradient-to-r from-[#C7F9A6] via-[#A8E6CF] to-[#A8DADC] text-[#202B2A] font-mono text-xs font-extrabold hover:brightness-110 shadow-lg soft-glow-lime transition-all active:scale-95 flex items-center justify-center gap-2 flex-1 sm:flex-none\"\n            >\n              <span>SUBMIT &amp; SHIP TO DORAHACKS</span>\n              <Rocket className=\"w-4 h-4\" />\n            </button>\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n};\n"
    }
