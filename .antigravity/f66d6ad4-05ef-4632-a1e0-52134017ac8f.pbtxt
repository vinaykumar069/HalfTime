  file_change {
    absolute_path_uri: "file:///src/components/modals/AuthModal.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState, useEffect } from \'react\';\nimport { User, KeyRound, Mail, LogOut, CheckCircle2, AlertCircle, X, Shield, Sparkles } from \'lucide-react\';\nimport { supabase, isSupabaseConfigured, getOrCreateUserId } from \'../../lib/supabase\';\n\ninterface AuthModalProps {\n  isOpen: boolean;\n  onClose: () => void;\n  onAuthChange?: () => void;\n}\n\nexport const AuthModal: React.FC<AuthModalProps> = ({\n  isOpen,\n  onClose,\n  onAuthChange,\n}) => {\n  const [mode, setMode] = useState<\'signin\' | \'signup\'>(\'signin\');\n  const [email, setEmail] = useState(\'\');\n  const [password, setPassword] = useState(\'\');\n  const [userSession, setUserSession] = useState<any>(null);\n  const [currentUserId, setCurrentUserId] = useState<string>(\'\');\n  const [isLoading, setIsLoading] = useState(false);\n  const [errorMsg, setErrorMsg] = useState<string | null>(null);\n  const [successMsg, setSuccessMsg] = useState<string | null>(null);\n\n  useEffect(() => {\n    if (!isOpen) return;\n    checkAuth();\n  }, [isOpen]);\n\n  const checkAuth = async () => {\n    const uid = await getOrCreateUserId();\n    setCurrentUserId(uid);\n\n    if (supabase) {\n      const { data } = await supabase.auth.getSession();\n      setUserSession(data?.session?.user || null);\n    }\n  };\n\n  if (!isOpen) return null;\n\n  const handleSignIn = async (e: React.FormEvent) => {\n    e.preventDefault();\n    setErrorMsg(null);\n    setSuccessMsg(null);\n    setIsLoading(true);\n\n    try {\n      if (!isSupabaseConfigured || !supabase) {\n        // Local mode fallback\n        localStorage.setItem(\'halftime_user_email\', email);\n        setSuccessMsg(`Signed in locally as ${email}`);\n        setTimeout(() => {\n          onClose();\n          onAuthChange?.();\n        }, 1200);\n        return;\n      }\n\n      const { data, error } = await supabase.auth.signInWithPassword({\n        email: email.trim(),\n        password,\n      });\n\n      if (error) {\n        setErrorMsg(error.message);\n      } else if (data.user) {\n        setUserSession(data.user);\n        setSuccessMsg(\'Successfully signed in! Your projects are isolated and securely synced.\');\n        setTimeout(() => {\n          onClose();\n          onAuthChange?.();\n        }, 1200);\n      }\n    } catch (err: any) {\n      setErrorMsg(err.message || \'Authentication error.\');\n    } finally {\n      setIsLoading(false);\n    }\n  };\n\n  const handleSignUp = async (e: React.FormEvent) => {\n    e.preventDefault();\n    setErrorMsg(null);\n    setSuccessMsg(null);\n    setIsLoading(true);\n\n    try {\n      if (!isSupabaseConfigured || !supabase) {\n        localStorage.setItem(\'halftime_user_email\', email);\n        setSuccessMsg(`Account created locally for ${email}!`);\n        setTimeout(() => {\n          onClose();\n          onAuthChange?.();\n        }, 1200);\n        return;\n      }\n\n      const { data, error } = await supabase.auth.signUp({\n        email: email.trim(),\n        password,\n      });\n\n      if (error) {\n        setErrorMsg(error.message);\n      } else if (data.user) {\n        setUserSession(data.user);\n        setSuccessMsg(\'Account created successfully! You are now logged in.\');\n        setTimeout(() => {\n          onClose();\n          onAuthChange?.();\n        }, 1200);\n      }\n    } catch (err: any) {\n      setErrorMsg(err.message || \'Signup error.\');\n    } finally {\n      setIsLoading(false);\n    }\n  };\n\n  const handleSignOut = async () => {\n    setIsLoading(true);\n    setErrorMsg(null);\n    try {\n      if (supabase) {\n        await supabase.auth.signOut();\n      }\n      localStorage.removeItem(\'halftime_user_email\');\n      setUserSession(null);\n      setSuccessMsg(\'Signed out successfully.\');\n      setTimeout(() => {\n        onClose();\n        onAuthChange?.();\n      }, 1000);\n    } catch (err: any) {\n      setErrorMsg(err.message || \'Sign out failed.\');\n    } finally {\n      setIsLoading(false);\n    }\n  };\n\n  return (\n    <div className=\"fixed inset-0 bg-black/75 z-50 flex items-center justify-center p-4 backdrop-blur-sm animate-in fade-in\">\n      <div className=\"w-full max-w-md bg-[#293735] border border-[#3B4B47] rounded-3xl p-6 sm:p-8 shadow-2xl relative\">\n        {/* Close Button */}\n        <button\n          onClick={onClose}\n          className=\"absolute top-5 right-5 p-1.5 rounded-lg text-[#71817B] hover:text-[#F0F4EE] hover:bg-[#202B2A] transition-colors\"\n        >\n          <X className=\"w-4 h-4\" />\n        </button>\n\n        {/* Header */}\n        <div className=\"flex items-center gap-3 mb-6\">\n          <div className=\"p-3 rounded-2xl bg-[#202B2A] border border-[#3B4B47] text-[#C7F9A6]\">\n            <Shield className=\"w-5 h-5\" />\n          </div>\n          <div>\n            <h2 className=\"text-lg font-bold text-[#F0F4EE]\">HALFTIME ACCOUNT</h2>\n            <p className=\"text-xs text-[#71817B]\">Supabase Authentication & Project Isolation</p>\n          </div>\n        </div>\n\n        {errorMsg && (\n          <div className=\"mb-4 p-3 rounded-xl bg-[#FFB7B2]/10 border border-[#FFB7B2]/30 flex items-center gap-2.5 text-xs text-[#FFB7B2]\">\n            <AlertCircle className=\"w-4 h-4 shrink-0\" />\n            <span>{errorMsg}</span>\n          </div>\n        )}\n\n        {successMsg && (\n          <div className=\"mb-4 p-3 rounded-xl bg-[#C7F9A6]/10 border border-[#C7F9A6]/30 flex items-center gap-2.5 text-xs text-[#C7F9A6]\">\n            <CheckCircle2 className=\"w-4 h-4 shrink-0\" />\n            <span>{successMsg}</span>\n          </div>\n        )}\n\n        {userSession ? (\n          /* Logged In View */\n          <div className=\"space-y-4\">\n            <div className=\"p-4 rounded-2xl bg-[#202B2A] border border-[#3B4B47] space-y-2\">\n              <div className=\"flex items-center justify-between\">\n                <span className=\"text-[11px] font-mono text-[#71817B]\">CURRENT USER</span>\n                <span className=\"text-[10px] font-mono px-2 py-0.5 rounded bg-[#C7F9A6]/20 text-[#C7F9A6] border border-[#C7F9A6]/30 font-bold\">\n                  AUTHENTICATED\n                </span>\n              </div>\n              <p className=\"text-sm font-bold text-[#F0F4EE]\">{userSession.email || \'Anonymous Session\'}</p>\n              <p className=\"text-[10px] font-mono text-[#71817B] truncate\">ID: {userSession.id || currentUserId}</p>\n            </div>\n\n            <p className=\"text-xs text-[#AAB8B2] leading-relaxed\">\n              Your projects, custom tasks, scope decisions, and AI roadmap are isolated under your account via Supabase Row-Level Security.\n            </p>\n\n            <button\n              onClick={handleSignOut}\n              disabled={isLoading}\n              className=\"w-full py-2.5 px-4 rounded-xl bg-[#31413F] hover:bg-[#FFB7B2]/20 border border-[#3B4B47] hover:border-[#FFB7B2]/40 text-xs font-mono text-[#FFB7B2] flex items-center justify-center gap-2 transition-all cursor-pointer\"\n            >\n              <LogOut className=\"w-3.5 h-3.5\" />\n              <span>SIGN OUT</span>\n            </button>\n          </div>\n        ) : (\n          /* Sign In / Sign Up Forms */\n          <div>\n            <div className=\"flex items-center p-1 bg-[#202B2A] border border-[#3B4B47] rounded-xl mb-5\">\n              <button\n                type=\"button\"\n                onClick={() => setMode(\'signin\')}\n                className={`flex-1 py-1.5 rounded-lg text-xs font-mono font-bold transition-all ${\n                  mode === \'signin\'\n                    ? \'bg-[#31413F] text-[#F0F4EE] shadow-sm\'\n                    : \'text-[#71817B] hover:text-[#F0F4EE]\'\n                }`}\n              >\n                SIGN IN\n              </button>\n              <button\n                type=\"button\"\n                onClick={() => setMode(\'signup\')}\n                className={`flex-1 py-1.5 rounded-lg text-xs font-mono font-bold transition-all ${\n                  mode === \'signup\'\n                    ? \'bg-[#31413F] text-[#F0F4EE] shadow-sm\'\n                    : \'text-[#71817B] hover:text-[#F0F4EE]\'\n                }`}\n              >\n                CREATE ACCOUNT\n              </button>\n            </div>\n\n            <form onSubmit={mode === \'signin\' ? handleSignIn : handleSignUp} className=\"space-y-4\">\n              <div>\n                <label className=\"block text-xs font-mono text-[#AAB8B2] uppercase mb-1.5\">\n                  Email Address\n                </label>\n                <div className=\"relative\">\n                  <Mail className=\"w-4 h-4 text-[#71817B] absolute left-3.5 top-3\" />\n                  <input\n                    type=\"email\"\n                    required\n                    value={email}\n                    onChange={(e) => setEmail(e.target.value)}\n                    placeholder=\"builder@hackathon.dev\"\n                    className=\"w-full pl-10 pr-3.5 py-2.5 rounded-xl bg-[#202B2A] border border-[#3B4B47] text-xs text-[#F0F4EE] placeholder-[#71817B] focus:outline-none focus:border-[#C7F9A6] transition-colors\"\n                  />\n                </div>\n              </div>\n\n              <div>\n                <label className=\"block text-xs font-mono text-[#AAB8B2] uppercase mb-1.5\">\n                  Password\n                </label>\n                <div className=\"relative\">\n                  <KeyRound className=\"w-4 h-4 text-[#71817B] absolute left-3.5 top-3\" />\n                  <input\n                    type=\"password\"\n                    required\n                    minLength={6}\n                    value={password}\n                    onChange={(e) => setPassword(e.target.value)}\n                    placeholder=\"\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\"\n                    className=\"w-full pl-10 pr-3.5 py-2.5 rounded-xl bg-[#202B2A] border border-[#3B4B47] text-xs text-[#F0F4EE] placeholder-[#71817B] focus:outline-none focus:border-[#C7F9A6] transition-colors\"\n                  />\n                </div>\n              </div>\n\n              <button\n                type=\"submit\"\n                disabled={isLoading}\n                className=\"w-full py-2.5 px-4 rounded-xl bg-[#C7F9A6] hover:bg-[#b5f58c] text-[#202B2A] font-bold font-mono text-xs flex items-center justify-center gap-2 shadow-[0_0_15px_rgba(199,249,166,0.2)] transition-all cursor-pointer disabled:opacity-50 mt-2\"\n              >\n                <Sparkles className=\"w-3.5 h-3.5\" />\n                <span>{isLoading ? \'PROCESSING...\' : mode === \'signin\' ? \'SIGN IN\' : \'CREATE ACCOUNT\'}</span>\n              </button>\n            </form>\n\n            <div className=\"mt-4 pt-4 border-t border-[#3B4B47] text-center\">\n              <span className=\"text-[10px] font-mono text-[#71817B]\">\n                Anonymous session active ({currentUserId.substring(0, 12)}...)\n              </span>\n            </div>\n          </div>\n        )}\n      </div>\n    </div>\n  );\n};\n"
    }
