EDIUM\' | \'LOW\';\n\nexport interface TaskItem {\n  id: string;\n  title: string;\n  owner: string;\n  role: string;\n  priority: TaskPriority;\n  status: TaskStatus;\n  estimatedTime: string;\n  estimatedMinutes: number;\n  reason?: string;\n  activeSince?: number;\n}\n\nexport interface TeamMember {\n  id: string;\n  name: string;\n  role: \'Builder\' | \'Designer\' | \'Growth\' | \'Product\' | \'AI Eng\';\n  avatar: string;\n  tasksActiveCount: number;\n  status: \'online\' | \'busy\' | \'away\';\n}\n\nexport interface AIResourceItem {\n  id: string;\n  tool: string;\n  provider: string;\n  remainingPercent: number;\n  creditsLabel: string;\n  recommendedUse: string;\n  burnRate: \'Low\' | \'Medium\' | \'High\';\n  statusNote: string;\n}\n\nexport interface JudgeCriterion {\n  name: string;\n  weight: number; // percentage, e.g. 25\n  score: number; // out of 10\n  feedback: string;\n}\n\nexport interface JudgeFix {\n  id: number;\n  title: string;\n  description: string;\n  scoreBonus: number;\n  applied: boolean;\n}\n\nexport interface JudgeEvaluation {\n  overallScore: number;\n  statusLabel: string;\n  criteria: JudgeCriterion[];\n  whyYouMightLose: string;\n  fixes: JudgeFix[];\n  summaryFeedback: string;\n}\n\nexport type LaunchStatus = \'COMPLETE\' | \'NEEDS_ATTENTION\' | \'NOT_STARTED\';\n\nexport interface LaunchChecklistItem {\n  id: string;\n  label: string;\n  category: \'Product\' | \'Pitch & Demo\' | \'Distribution\';\n  status: LaunchStatus;\n  detail: string;\n  timeToFinish: string;\n}\n\nexport interface ActivityTimelineItem {\n  id: string;\n  title: string;\n  timestamp: string;\n  type: \'ai\' | \'dashboard\' | \'scope\' | \'builder\' | \'judge\';\n  badgeColor?: string;\n}\n"
