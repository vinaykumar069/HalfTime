  file_change {
    absolute_path_uri: "file:///src/components/tasks/TaskBoard.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { \n  CheckSquare, \n  Plus, \n  Clock, \n  User, \n  Flame, \n  AlertCircle, \n  Play, \n  CheckCircle2, \n  ArrowRight,\n  Filter,\n  Trash2,\n  Users,\n  X,\n  Edit2\n} from \'lucide-react\';\nimport { TaskItem, TaskStatus, TaskPriority, TeamMember } from \'../../types\';\n\ninterface TaskBoardProps {\n  tasks: TaskItem[];\n  teamMembers?: string[];\n  onUpdateTaskStatus: (taskId: string, newStatus: TaskStatus) => void;\n  onAddTask: (task: TaskItem) => void;\n  onDeleteTask?: (taskId: string) => void;\n  onAddTeamMember?: (memberName: string) => void;\n  activeTaskId?: string;\n  onSetActiveTask: (taskId: string) => void;\n}\n\nexport const TaskBoard: React.FC<TaskBoardProps> = ({\n  tasks,\n  teamMembers = [\'Builder\', \'Designer\', \'Product\', \'Growth\'],\n  onUpdateTaskStatus,\n  onAddTask,\n  onDeleteTask,\n  onAddTeamMember,\n  activeTaskId,\n  onSetActiveTask,\n}) => {\n  const [filterOwner, setFilterOwner] = useState<string>(\'ALL\');\n  const [isAddingTask, setIsAddingTask] = useState(false);\n  const [isAddingMember, setIsAddingMember] = useState(false);\n  const [newMemberName, setNewMemberName] = useState(\'\');\n\n  const [newTitle, setNewTitle] = useState(\'\');\n  const [newOwner, setNewOwner] = useState(teamMembers[0] || \'Builder\');\n  const [newPriority, setNewPriority] = useState<TaskPriority>(\'HIGH\');\n  const [newMinutes, setNewMinutes] = useState(\'45\');\n\n  const columns: Array<{ status: TaskStatus; label: string; color: string }> = [\n    { status: \'BACKLOG\', label: \'BACKLOG\', color: \'border-[#71817B]/40 text-[#71817B]\' },\n    { status: \'TODO\', label: \'TODO\', color: \'border-[#A8DADC]/40 text-[#A8DADC]\' },\n    { status: \'IN_PROGRESS\', label: \'IN PROGRESS\', color: \'border-[#C7F9A6]/50 text-[#C7F9A6]\' },\n    { status: \'DONE\', label: \'DONE\', color: \'border-[#B7E4C7]/50 text-[#B7E4C7]\' },\n  ];\n\n  const handleCreateTask = (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!newTitle.trim()) return;\n\n    const mins = parseInt(newMinutes, 10) || 45;\n    const newTask: TaskItem = {\n      id: `task-${Date.now()}`,\n      title: newTitle.trim(),\n      owner: newOwner || teamMembers[0] || \'Unassigned\',\n      role: newOwner.includes(\'Designer\') ? \'Designer\' : newOwner.includes(\'Product\') ? \'Product\' : newOwner.includes(\'Growth\') ? \'Growth\' : \'Builder\',\n      priority: newPriority,\n      status: \'TODO\',\n      estimatedTime: `${mins}m`,\n      estimatedMinutes: mins,\n    };\n\n    onAddTask(newTask);\n    setNewTitle(\'\');\n    setIsAddingTask(false);\n  };\n\n  const handleCreateMember = (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!newMemberName.trim() || !onAddTeamMember) return;\n    onAddTeamMember(newMemberName.trim());\n    setNewMemberName(\'\');\n    setIsAddingMember(false);\n  };\n\n  const filteredTasks = tasks.filter((t) => {\n    if (filterOwner === \'ALL\') return true;\n    return t.owner.toLowerCase().includes(filterOwner.toLowerCase());\n  });\n\n  return (\n    <div className=\"space-y-8 animate-in fade-in duration-300 pb-12\">\n      {/* Header */}\n      <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-4\">\n        <div>\n          <div className=\"inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#31413F] border border-[#3B4B47] text-xs font-mono text-[#C7F9A6] mb-2\">\n            <CheckSquare className=\"w-3.5 h-3.5\" />\n            <span>SPRINT EXECUTION BOARD</span>\n          </div>\n          <h1 className=\"text-2xl sm:text-4xl font-extrabold text-[#F0F4EE] tracking-tight font-display\">\n            TASKS\n          </h1>\n          <p className=\"text-sm sm:text-base text-[#AAB8B2] mt-1 font-medium\">\n            Prioritize zero-friction live demo delivery. Every ticket directly impacts the 3-minute pitch.\n          </p>\n        </div>\n\n        <div className=\"flex items-center gap-2 self-start sm:self-auto\">\n          {onAddTeamMember && (\n            <button\n              onClick={() => setIsAddingMember(!isAddingMember)}\n              className=\"flex items-center gap-1.5 px-3.5 py-2.5 rounded-xl bg-[#293735] hover:bg-[#31413F] border border-[#3B4B47] text-xs font-mono text-[#AAB8B2] hover:text-[#F0F4EE] transition-all cursor-pointer\"\n            >\n              <Users className=\"w-3.5 h-3.5 text-[#A8DADC]\" />\n              <span>TEAM ({teamMembers.length})</span>\n            </button>\n          )}\n\n          <button\n            id=\"btn-add-task-modal\"\n            onClick={() => setIsAddingTask(!isAddingTask)}\n            className=\"flex items-center gap-2 px-4 py-2.5 rounded-xl bg-gradient-to-r from-[#C7F9A6] to-[#A8E6CF] text-[#202B2A] font-mono text-xs font-bold hover:brightness-110 shadow-md active:scale-95 transition-all cursor-pointer\"\n          >\n            <Plus className=\"w-4 h-4\" />\n            <span>NEW TASK</span>\n          </button>\n        </div>\n      </div>\n\n      {/* Add Member Form */}\n      {isAddingMember && (\n        <form onSubmit={handleCreateMember} className=\"p-4 rounded-xl bg-[#293735] border border-[#A8DADC]/40 flex items-center gap-3 animate-in fade-in\">\n          <input\n            type=\"text\"\n            required\n            placeholder=\"Member name & role (e.g. Maya - Backend Eng)...\"\n            value={newMemberName}\n            onChange={e => setNewMemberName(e.target.value)}\n            className=\"flex-1 px-3 py-2 rounded-lg bg-[#202B2A] border border-[#3B4B47] text-xs text-[#F0F4EE] focus:outline-none focus:border-[#A8DADC]\"\n          />\n          <button\n            type=\"submit\"\n            className=\"px-4 py-2 rounded-lg bg-[#A8DADC] text-[#202B2A] text-xs font-mono font-bold hover:brightness-110\"\n          >\n            Add to Team\n          </button>\n          <button\n            type=\"button\"\n            onClick={() => setIsAddingMember(false)}\n            className=\"px-3 py-2 rounded-lg text-xs font-mono text-[#71817B] hover:text-[#F0F4EE]\"\n          >\n            Cancel\n          </button>\n        </form>\n      )}\n\n      {/* Inline Create Task Form */}\n      {isAddingTask && (\n        <form onSubmit={handleCreateTask} className=\"p-4 rounded-xl bg-[#293735] border border-[#C7F9A6]/40 shadow-xl flex flex-wrap gap-3 items-center animate-in fade-in\">\n          <input\n            type=\"text\"\n            required\n            placeholder=\"Task title (e.g. Implement Gemini API streaming)...\"\n            value={newTitle}\n            onChange={(e) => setNewTitle(e.target.value)}\n            className=\"flex-1 min-w-[240px] px-3 py-2 rounded-lg bg-[#202B2A] border border-[#3B4B47] text-xs text-[#F0F4EE] focus:outline-none focus:border-[#C7F9A6]\"\n          />\n          <select\n            value={newOwner}\n            onChange={(e) => setNewOwner(e.target.value)}\n            className=\"px-3 py-2 rounded-lg bg-[#202B2A] border border-[#3B4B47] text-xs text-[#F0F4EE] focus:outline-none\"\n          >\n            {teamMembers.map((m) => (\n              <option key={m} value={m}>{m}</option>\n            ))}\n          </select>\n          <select\n            value={newPriority}\n            onChange={(e) => setNewPriority(e.target.value as TaskPriority)}\n            className=\"px-3 py-2 rounded-lg bg-[#202B2A] border border-[#3B4B47] text-xs text-[#F0F4EE] focus:outline-none\"\n          >\n            <option value=\"CRITICAL\">CRITICAL</option>\n            <option value=\"HIGH\">HIGH</option>\n            <option value=\"MEDIUM\">MEDIUM</option>\n            <option value=\"LOW\">LOW</option>\n          </select>\n          <div className=\"flex items-center gap-1\">\n            <input\n              type=\"number\"\n              min=\"5\"\n              step=\"5\"\n              placeholder=\"Minutes\"\n              value={newMinutes}\n              onChange={(e) => setNewMinutes(e.target.value)}\n              className=\"w-20 px-3 py-2 rounded-lg bg-[#202B2A] border border-[#3B4B47] text-xs text-[#F0F4EE] focus:outline-none\"\n            />\n            <span className=\"text-xs text-[#71817B] font-mono\">min</span>\n          </div>\n          <button\n            type=\"submit\"\n            className=\"px-4 py-2 rounded-lg bg-[#C7F9A6] text-[#202B2A] text-xs font-mono font-bold hover:brightness-110 shadow-sm\"\n          >\n            Create Task\n          </button>\n          <button\n            type=\"button\"\n            onClick={() => setIsAddingTask(false)}\n            className=\"px-3 py-2 rounded-lg text-xs font-mono text-[#71817B] hover:text-[#F0F4EE]\"\n          >\n            Cancel\n          </button>\n        </form>\n      )}\n\n      {/* Team Filter & Subtitle */}\n      <div className=\"flex flex-wrap items-center justify-between gap-3 p-4 rounded-xl bg-[#293735] border border-[#3B4B47]\">\n        <div className=\"flex items-center gap-2 text-xs font-mono\">\n          <Filter className=\"w-3.5 h-3.5 text-[#71817B]\" />\n          <span className=\"text-[#71817B]\">Filter:</span>\n          <button\n            onClick={() => setFilterOwner(\'ALL\')}\n            className={`px-2.5 py-1 rounded-lg text-xs font-mono transition-all ${\n              filterOwner === \'ALL\'\n                ? \'bg-[#31413F] text-[#F0F4EE] border border-[#C7F9A6]/30\'\n                : \'text-[#71817B] hover:text-[#F0F4EE]\'\n            }`}\n          >\n            ALL ({tasks.length})\n          </button>\n          {teamMembers.map((m) => (\n            <button\n              key={m}\n              onClick={() => setFilterOwner(m)}\n              className={`px-2.5 py-1 rounded-lg text-xs font-mono transition-all truncate max-w-[140px] ${\n                filterOwner === m\n                  ? \'bg-[#31413F] text-[#F0F4EE] border border-[#C7F9A6]/30\'\n                  : \'text-[#71817B] hover:text-[#F0F4EE]\'\n              }`}\n            >\n              {m.split(\' \')[0]}\n            </button>\n          ))}\n        </div>\n\n        <div className=\"flex items-center gap-2 text-xs font-mono text-[#AAB8B2]\">\n          <span className=\"w-2 h-2 rounded-full bg-[#C7F9A6]\" />\n          <span>{teamMembers.length} Active Hackers</span>\n        </div>\n      </div>\n\n      {/* Task Columns */}\n      <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-5\">\n        {columns.map((col) => {\n          const colTasks = filteredTasks.filter((t) => t.status === col.status);\n\n          return (\n            <div\n              key={col.status}\n              className=\"p-4 sm:p-5 rounded-2xl bg-[#293735] border border-[#3B4B47] flex flex-col justify-between min-h-[420px] shadow-lg\"\n            >\n              <div>\n                {/* Column Title */}\n                <div className=\"flex items-center justify-between pb-3 border-b border-[#3B4B47]\">\n                  <span className={`text-xs font-mono font-bold tracking-wider ${col.color}`}>\n                    {col.label}\n                  </span>\n                  <span className=\"text-xs font-mono text-[#71817B]\">\n                    {colTasks.length}\n                  </span>\n                </div>\n\n                {/* Task Cards */}\n                <div className=\"py-3 space-y-3\">\n                  {colTasks.map((task) => {\n                    const isFocus = task.id === activeTaskId;\n\n                    return (\n                      <div\n                        key={task.id}\n                        className={`p-3.5 rounded-xl border transition-all space-y-2 group relative ${\n                          isFocus\n                            ? \'bg-[#202B2A] border-[#C7F9A6] shadow-[0_0_15px_rgba(199,249,166,0.15)]\'\n                            : \'bg-[#202B2A] border-[#3B4B47] hover:border-[#71817B]\'\n                        }`}\n                      >\n                        <div className=\"flex items-start justify-between gap-1.5\">\n                          <span className=\"text-xs font-bold text-[#F0F4EE] leading-snug\">\n                            {task.title}\n                          </span>\n                          {onDeleteTask && (\n                            <button\n                              onClick={() => onDeleteTask(task.id)}\n                              className=\"text-[#71817B] hover:text-[#FFB7B2] opacity-0 group-hover:opacity-100 transition-opacity p-0.5\"\n                              title=\"Delete task\"\n                            >\n                              <Trash2 className=\"w-3 h-3\" />\n                            </button>\n                          )}\n                        </div>\n\n                        <div className=\"flex items-center justify-between text-[10px] font-mono text-[#71817B]\">\n                          <span className=\"text-[#AAB8B2] truncate max-w-[120px]\">{task.owner}</span>\n                          <span className={`px-1.5 py-0.5 rounded font-bold ${\n                            task.priority === \'CRITICAL\'\n                              ? \'bg-[#FFB7B2]/20 text-[#FFB7B2]\'\n                              : task.priority === \'HIGH\'\n                              ? \'bg-[#FFE0A3]/20 text-[#FFE0A3]\'\n                              : \'bg-[#A8DADC]/20 text-[#A8DADC]\'\n                          }`}>\n                            {task.priority}\n                          </span>\n                        </div>\n\n                        <div className=\"flex items-center justify-between text-[10px] font-mono text-[#71817B] pt-1.5 border-t border-[#3B4B47]/60\">\n                          <span className=\"flex items-center gap-1\">\n                            <Clock className=\"w-3 h-3 text-[#71817B]\" />\n                            <span>{task.estimatedTime}</span>\n                          </span>\n\n                          <button\n                            onClick={() => onSetActiveTask(task.id)}\n                            className={`flex items-center gap-1 transition-colors ${\n                              isFocus ? \'text-[#C7F9A6] font-bold\' : \'text-[#71817B] hover:text-[#F0F4EE]\'\n                            }`}\n                          >\n                            <Play className=\"w-2.5 h-2.5\" />\n                            <span>{isFocus ? \'Focus Active\' : \'Focus\'}</span>\n                          </button>\n                        </div>\n\n                        {/* Status Move Dropdown/Buttons */}\n                        <div className=\"pt-1 flex flex-wrap gap-1\">\n                          {columns.map((c) => {\n                            if (c.status === task.status) return null;\n                            return (\n                              <button\n                                key={c.status}\n                                onClick={() => onUpdateTaskStatus(task.id, c.status)}\n                                className=\"px-1.5 py-0.5 rounded text-[9px] font-mono bg-[#31413F] hover:bg-[#3B4B47] text-[#AAB8B2] hover:text-[#F0F4EE] transition-all\"\n                              >\n                                \342\206\222 {c.status}\n                              </button>\n                            );\n                          })}\n                        </div>\n                      </div>\n                    );\n                  })}\n\n                  {colTasks.length === 0 && (\n                    <div className=\"p-4 rounded-xl border border-dashed border-[#3B4B47] text-center text-xs font-mono text-[#71817B]\">\n                      No tasks in this lane\n                    </div>\n                  )}\n                </div>\n              </div>\n            </div>\n          );\n        })}\n      </div>\n    </div>\n  );\n};\n"
