  file_change {
    absolute_path_uri: "file:///src/components/launch/LaunchView.tsx"
    file_change_type: FILE_CHANGE_TYPE_EDIT
    replacement_chunks {
      target_content: "interface LaunchViewProps {\n  checklist: LaunchChecklistItem[];\n  onToggleStatus: (id: string) => void;\n  onAddChecklistItem?: (item: LaunchChecklistItem) => void;\n  onDeleteChecklistItem?: (id: string) => void;\n  onOpenShipMode: () => void;\n  scopeCutApplied: boolean;\n  projectName?: string;\n  problem?: string;\n  solution?: string;\n  features?: MVPFeature[];\n}\n\nexport const LaunchView: React.FC<LaunchViewProps> = ({\n  checklist,\n  onToggleStatus,\n  onAddChecklistItem,\n  onDeleteChecklistItem,\n  onOpenShipMode,\n  scopeCutApplied,\n  projectName = \'Hackathon Project\',\n  problem = \'Hackathon teams waste time on non-demo features.\',\n  solution = \'HALFTIME: AI mission control for hackathons.\',\n  features = [],\n}) => {\n  const [pitchData, setPitchData] = useState<PitchCoachResult | null>({\n    problem: problem || \'Hackathon teams waste 60% of their build time on features judges never click, leading to rushed, broken demos.\',\n    whyItMatters: \'Every weekend, thousands of talented engineers burn out and fail to submit their prototypes.\',\n    solution: solution || \'HALFTIME is the real-time mission control copilot that constantly recalculates runway and ruthlessly cuts scope.\',\n    howItWorks: \'1. Connects to project backlog. 2. Tracks real-time velocity against hackathon deadline. 3. Recommends 1-click feature cuts with 0 demo sacrifice.\',\n    demoMoment: \'In one click, HALFTIME cuts 3 hours of bloat and moves the project from AT RISK to ON TRACK.\',\n    impact: \'Helps 100,000+ hackathon builders globally ship working MVPs on time.\',\n    whyNow: \'LLM reasoning makes instant scope triage possible at zero cognitive overhead.\',\n    script: `Judges, 60% of hackathon teams fail before the finish line. Not because they can\'t code, but because they build the wrong things.\n\nMeet ${projectName}: the AI mission control for hackathon teams.\n\n${projectName} monitors build velocity against the deadline in real time. In one click, we executed a surgical scope cut\342\200\224saving hours of bloat without sacrificing a single judging point.\n\nInstead of an unfinished monolith, we shipped a rock-solid, production-ready product. Stop. Recalculate. Ship.`,\n    durationSeconds: 75,\n    keyTakeaway: \'Don\342\200\231t build more. Ship what matters.\',\n  });\n\n  const [isGeneratingPitch, setIsGeneratingPitch] = useState(false);\n  const [copiedScript, setCopiedScript] = useState(false);\n  const [pitchStep, setPitchStep] = useState(0);\n  const [errorMessage, setErrorMessage] = useState<string | null>(null);\n\n  // Demo Flow State\n  const [isDemoFlowOpen, setIsDemoFlowOpen] = useState(false);\n  const [isGeneratingDemoFlow, setIsGeneratingDemoFlow] = useState(false);\n  const [demoFlowResult, setDemoFlowResult] = useState<DemoFlowResult | null>(null);"
      replacement_content: "interface LaunchViewProps {\n  checklist: LaunchChecklistItem[];\n  onToggleStatus: (id: string) => void;\n  onAddChecklistItem?: (item: LaunchChecklistItem) => void;\n  onDeleteChecklistItem?: (id: string) => void;\n  onOpenShipMode: () => void;\n  scopeCutApplied: boolean;\n  projectName?: string;\n  problem?: string;\n  solution?: string;\n  features?: MVPFeature[];\n  initialPitch?: PitchCoachResult | null;\n  initialDemoFlow?: DemoFlowResult | null;\n  onSavePitch?: (pitch: PitchCoachResult) => void;\n  onSaveDemoFlow?: (flow: DemoFlowResult) => void;\n}\n\nexport const LaunchView: React.FC<LaunchViewProps> = ({\n  checklist,\n  onToggleStatus,\n  onAddChecklistItem,\n  onDeleteChecklistItem,\n  onOpenShipMode,\n  scopeCutApplied,\n  projectName = \'Hackathon Project\',\n  problem = \'Hackathon teams waste time on non-demo features.\',\n  solution = \'HALFTIME: AI mission control for hackathons.\',\n  features = [],\n  initialPitch,\n  initialDemoFlow,\n  onSavePitch,\n  onSaveDemoFlow,\n}) => {\n  const defaultPitch: PitchCoachResult = {\n    problem: problem || \'Hackathon teams waste 60% of their build time on features judges never click, leading to rushed, broken demos.\',\n    whyItMatters: \'Every weekend, thousands of talented engineers burn out and fail to submit their prototypes.\',\n    solution: solution || \'HALFTIME is the real-time mission control copilot that constantly recalculates runway and ruthlessly cuts scope.\',\n    howItWorks: \'1. Connects to project backlog. 2. Tracks real-time velocity against hackathon deadline. 3. Recommends 1-click feature cuts with 0 demo sacrifice.\',\n    demoMoment: \'In one click, HALFTIME cuts 3 hours of bloat and moves the project from AT RISK to ON TRACK.\',\n    impact: \'Helps 100,000+ hackathon builders globally ship working MVPs on time.\',\n    whyNow: \'LLM reasoning makes instant scope triage possible at zero cognitive overhead.\',\n    script: `Judges, 60% of hackathon teams fail before the finish line. Not because they can\'t code, but because they build the wrong things.\n\nMeet ${projectName}: the AI mission control for hackathon teams.\n\n${projectName} monitors build velocity against the deadline in real time. In one click, we executed a surgical scope cut\342\200\224saving hours of bloat without sacrificing a single judging point.\n\nInstead of an unfinished monolith, we shipped a rock-solid, production-ready product. Stop. Recalculate. Ship.`,\n    durationSeconds: 75,\n    keyTakeaway: \'Don\342\200\231t build more. Ship what matters.\',\n  };\n\n  const [pitchData, setPitchData] = useState<PitchCoachResult | null>(initialPitch || defaultPitch);\n\n  // Sync state if initialPitch changes\n  React.useEffect(() => {\n    if (initialPitch) {\n      setPitchData(initialPitch);\n    }\n  }, [initialPitch]);\n\n  const [isGeneratingPitch, setIsGeneratingPitch] = useState(false);\n  const [copiedScript, setCopiedScript] = useState(false);\n  const [pitchStep, setPitchStep] = useState(0);\n  const [errorMessage, setErrorMessage] = useState<string | null>(null);\n\n  // Demo Flow State\n  const [isDemoFlowOpen, setIsDemoFlowOpen] = useState(false);\n  const [isGeneratingDemoFlow, setIsGeneratingDemoFlow] = useState(false);\n  const [demoFlowResult, setDemoFlowResult] = useState<DemoFlowResult | null>(initialDemoFlow || null);\n\n  React.useEffect(() => {\n    if (initialDemoFlow) {\n      setDemoFlowResult(initialDemoFlow);\n    }\n  }, [initialDemoFlow]);"
    }
