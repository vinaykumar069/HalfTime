    replacement_chunks {
      target_content: "@import \"tailwindcss\";\n"
      replacement_content: "@import \"tailwindcss\";\n\n@layer base {\n  :root {\n    --bg-base: #202B2A;\n    --bg-surface: #293735;\n    --bg-elevated: #31413F;\n    --border-color: #3B4B47;\n    --color-lime: #C7F9A6;\n    --color-mint: #A8E6CF;\n    --color-cyan: #A8DADC;\n    --color-yellow: #FFE0A3;\n    --color-coral: #FFB7B2;\n    --color-green: #B7E4C7;\n    --color-blue: #B8DDF0;\n    --color-violet: #CDB4DB;\n    --text-primary: #F0F4EE;\n    --text-secondary: #AAB8B2;\n    --text-muted: #71817B;\n  }\n\n  body {\n    font-family: \'Plus Jakarta Sans\', -apple-system, BlinkMacSystemFont, \'Segoe UI\', Roboto, sans-serif;\n    background-color: #202B2A;\n    color: #F0F4EE;\n    overflow-x: hidden;\n  }\n\n  code, pre, .font-mono {\n    font-family: \'JetBrains Mono\', ui-monospace, SFMono-Regular, monospace;\n  }\n}\n\n/* Custom subtle scrollbar */\n::-webkit-scrollbar {\n  width: 6px;\n  height: 6px;\n}\n::-webkit-scrollbar-track {\n  background: #202B2A;\n}\n::-webkit-scrollbar-thumb {\n  background: #3B4B47;\n  border-radius: 9999px;\n}\n::-webkit-scrollbar-thumb:hover {\n  background: #71817B;\n}\n\n/* Custom Glass & Soft Neumorphic utilities */\n.glass-panel {\n  background: rgba(41, 55, 53, 0.7);\n  backdrop-filter: blur(16px);\n  -webkit-backdrop-filter: blur(16px);\n  border: 1px solid rgba(59, 75, 71, 0.8);\n}\n\n.glass-panel-elevated {\n  background: rgba(49, 65, 63, 0.75);\n  backdrop-filter: blur(20px);\n  -webkit-backdrop-filter: blur(20px);\n  border: 1px solid rgba(168, 230, 207, 0.15);\n}\n\n.glass-panel-ai {\n  background: linear-gradient(135deg, rgba(49, 65, 63, 0.85) 0%, rgba(32, 43, 42, 0.95) 100%);\n  backdrop-filter: blur(20px);\n  border: 1px solid rgba(168, 230, 207, 0.25);\n  box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.37);\n}\n\n.soft-glow-lime {\n  box-shadow: 0 0 25px -4px rgba(199, 249, 166, 0.35);\n}\n\n.soft-glow-mint {\n  box-shadow: 0 0 25px -4px rgba(168, 230, 207, 0.35);\n}\n\n.soft-glow-coral {\n  box-shadow: 0 0 25px -4px rgba(255, 183, 178, 0.35);\n}\n\n@keyframes pulse-subtle {\n  0%, 100% { opacity: 1; transform: scale(1); }\n  50% { opacity: 0.85; transform: scale(1.02); }\n}\n\n.animate-pulse-subtle {\n  animation: pulse-subtle 4s ease-in-out infinite;\n}\n"
    }
