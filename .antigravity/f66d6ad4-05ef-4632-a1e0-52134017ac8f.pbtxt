  file_change {
    absolute_path_uri: "file:///src/components/launch/LaunchView.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React from \'react\';\nimport { \n  Rocket, \n  Sparkles, \n  CheckCircle2, \n  AlertCircle, \n  Clock, \n  ArrowRight,\n  ExternalLink,\n  ShieldCheck\n} from \'lucide-react\';\nimport { LaunchChecklistItem, LaunchStatus } from \'../../types\';\n\ninterface LaunchViewProps {\n  checklist: LaunchChecklistItem[];\n  onToggleStatus: (id: string) => void;\n  onOpenShipMode: () => void;\n  scopeCutApplied: boolean;\n}\n\nexport const LaunchView: React.FC<LaunchViewProps> = ({\n  checklist,\n  onToggleStatus,\n  onOpenShipMode,\n  scopeCutApplied,\n}) => {\n  const completedCount = checklist.filter((item) => item.status === \'COMPLETE\').length;\n  const readinessPercent = Math.round((completedCount / checklist.length) * 100);\n\n  const categories: Array<\'Product\' | \'Pitch & Demo\' | \'Distribution\'> = [\n    \'Product\',\n    \'Pitch & Demo\',\n    \'Distribution\',\n  ];\n\n  return (\n    <div className=\"space-y-8 animate-in fade-in duration-300 pb-12\">\n      {/* Header */}\n      <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-4\">\n        <div>\n          <div className=\"inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#31413F] border border-[#3B4B47] text-xs font-mono text-[#A8DADC] mb-2\">\n            <Rocket className=\"w-3.5 h-3.5\" />\n            <span>SUBMISSION &amp; DEMO DAY GATE</span>\n          </div>\n          <h1 className=\"text-2xl sm:text-4xl font-extrabold text-[#F0F4EE] tracking-tight font-display\">\n            LAUNCH READINESS\n          </h1>\n          <p className=\"text-sm sm:text-base text-[#AAB8B2] mt-1 font-medium\">\n            Lock in all pitch assets, smoke tests, and repository links before the submission clock expires.\n          </p>\n        </div>\n\n        <button\n          id=\"btn-enter-ship-mode\"\n          onClick={onOpenShipMode}\n          className=\"flex items-center gap-2 px-6 py-3 rounded-2xl bg-gradient-to-r from-[#C7F9A6] via-[#A8E6CF] to-[#A8DADC] text-[#202B2A] font-mono text-sm font-extrabold hover:brightness-110 shadow-lg soft-glow-lime active:scale-95 transition-all self-start sm:self-auto\"\n        >\n          <Sparkles className=\"w-4 h-4 fill-[#202B2A]\" />\n          <span>ENTER SHIP MODE \342\206\222</span>\n        </button>\n      </div>\n\n      {/* Hero Readiness Dial Card */}\n      <div className=\"p-6 rounded-2xl bg-[#293735] border border-[#3B4B47] shadow-xl glass-panel-ai flex flex-col md:flex-row md:items-center justify-between gap-6\">\n        <div className=\"flex items-center gap-5\">\n          {/* Radial meter */}\n          <div className=\"relative w-20 h-20 flex items-center justify-center shrink-0\">\n            <svg className=\"w-full h-full -rotate-90\" viewBox=\"0 0 80 80\">\n              <circle cx=\"40\" cy=\"40\" r=\"34\" stroke=\"#3B4B47\" strokeWidth=\"6\" fill=\"none\" />\n              <circle\n                cx=\"40\"\n                cy=\"40\"\n                r=\"34\"\n                stroke={readinessPercent >= 80 ? \'#C7F9A6\' : \'#FFE0A3\'}\n                strokeWidth=\"6\"\n                strokeDasharray={213}\n                strokeDashoffset={213 - (213 * readinessPercent) / 100}\n                strokeLinecap=\"round\"\n                fill=\"none\"\n                className=\"transition-all duration-700\"\n              />\n            </svg>\n            <span className=\"absolute font-mono font-extrabold text-lg text-[#F0F4EE]\">\n              {readinessPercent}%\n            </span>\n          </div>\n\n          <div>\n            <div className=\"text-xs font-mono font-bold text-[#A8E6CF] uppercase\">\n              {readinessPercent >= 80 ? \'READY FOR FINAL POLISH\' : \'ACTION REQUIRED\'}\n            </div>\n            <h2 className=\"text-xl font-bold text-[#F0F4EE] mt-0.5\">\n              {completedCount} of {checklist.length} Hackathon Gates Cleared\n            </h2>\n            <p className=\"text-xs text-[#AAB8B2] mt-1\">\n              Estimated 45m remaining to finalize backup video and submission metadata.\n            </p>\n          </div>\n        </div>\n\n        <div className=\"flex items-center gap-3\">\n          <button\n            onClick={onOpenShipMode}\n            className=\"px-4 py-2 rounded-xl bg-[#31413F] hover:bg-[#3B4B47] text-xs font-mono text-[#F0F4EE] border border-[#3B4B47] transition-all\"\n          >\n            Preview Final Submission Card\n          </button>\n        </div>\n      </div>\n\n      {/* Categorized Checklist Grid */}\n      <div className=\"grid grid-cols-1 md:grid-cols-3 gap-5\">\n        {categories.map((category) => {\n          const items = checklist.filter((i) => i.category === category);\n\n          return (\n            <div\n              key={category}\n              className=\"p-5 rounded-2xl bg-[#293735] border border-[#3B4B47] shadow-lg flex flex-col justify-between\"\n            >\n              <div>\n                <div className=\"flex items-center justify-between pb-3 border-b border-[#3B4B47]\">\n                  <h3 className=\"text-xs font-mono font-bold text-[#F0F4EE] uppercase tracking-wider\">\n                    {category}\n                  </h3>\n                  <span className=\"text-[10px] font-mono text-[#71817B]\">\n                    {items.filter((i) => i.status === \'COMPLETE\').length} / {items.length}\n                  </span>\n                </div>\n\n                <div className=\"space-y-3 mt-3\">\n                  {items.map((item) => {\n                    const isDone = item.status === \'COMPLETE\';\n                    const isAttn = item.status === \'NEEDS_ATTENTION\';\n\n                    return (\n                      <div\n                        key={item.id}\n                        onClick={() => onToggleStatus(item.id)}\n                        className={`p-3.5 rounded-xl border transition-all cursor-pointer select-none space-y-2 ${\n                          isDone\n                            ? \'bg-[#202B2A] border-[#B7E4C7]/30\'\n                            : isAttn\n                            ? \'bg-[#31413F] border-[#FFE0A3]/30\'\n                            : \'bg-[#202B2A] border-[#3B4B47] opacity-60\'\n                        }`}\n                      >\n                        <div className=\"flex items-start justify-between gap-2\">\n                          <span className=\"text-xs font-bold text-[#F0F4EE] leading-tight\">\n                            {item.label}\n                          </span>\n                          <span className={`px-1.5 py-0.5 rounded text-[9px] font-mono font-bold shrink-0 ${\n                            isDone\n                              ? \'bg-[#B7E4C7]/20 text-[#B7E4C7]\'\n                              : isAttn\n                              ? \'bg-[#FFE0A3]/20 text-[#FFE0A3]\'\n                              : \'bg-[#202B2A] text-[#71817B]\'\n                          }`}>\n                            {item.status.replace(\'_\', \' \')}\n                          </span>\n                        </div>\n\n                        <p className=\"text-[11px] text-[#AAB8B2] leading-snug\">\n                          {item.detail}\n                        </p>\n\n                        <div className=\"pt-1.5 border-t border-[#3B4B47]/50 flex items-center justify-between text-[10px] font-mono text-[#71817B]\">\n                          <span>Time: {item.timeToFinish}</span>\n                          <span className=\"text-[#A8E6CF] hover:underline\">\n                            {isDone ? \'\342\234\223 Verified\' : \'Mark Complete\'}\n                          </span>\n                        </div>\n                      </div>\n                    );\n                  })}\n                </div>\n              </div>\n            </div>\n          );\n        })}\n      </div>\n    </div>\n  );\n};\n"
    }
