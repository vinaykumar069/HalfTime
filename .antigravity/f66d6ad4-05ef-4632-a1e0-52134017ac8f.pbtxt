core: 8.7, feedback: \'Novel paradigm for active hackathon triage rather than generic chat.\' },\n    { name: \'Problem Fit\', weight: 20, score: 9.2, feedback: \'Directly solves the #1 reason hackathon teams fail (poor scope management).\' },\n    { name: \'Usability\', weight: 20, score: 8.1, feedback: \'High contrast and clear CTA hierarchy. Micro-interactions feel natural.\' },\n    { name: \'Execution\', weight: 15, score: 8.4, feedback: \'Fast, responsive, and mathematically coherent timeline calculations.\' },\n    { name: \'Impact\', weight: 10, score: 7.8, feedback: \'Broad addressable developer market; potential commercial SaaS applicability.\' },\n    { name: \'Feasibility\', weight: 10, score: 9.1, feedback: \'No unfeasible dependencies; robust architecture.\' },\n  ],\n  whyYouMightLose: \'Your problem is strong, but your demo takes too long to reach the core value. If judges do not see the Scope Cutter recalculation within the first 45 seconds, attention will drift.\',\n  fixes: [\n    {\n      id: 1,\n      title: \'Shorten onboarding to 0 clicks\',\n      description: \'Pre-seed sample DoraHacks telemetry immediately so judges see the 3h gap instantly.\',\n      scoreBonus: 0.35,\n      applied: true,\n    },\n    {\n      id: 2,\n      title: \'Demo the core workflow first\',\n      description: \'Trigger the \"Cut Selected Features\" animation within the first 30 seconds of the presentation.\',\n      scoreBonus: 0.25,\n      applied: false,\n    },\n    {\n      id: 3,\n      title: \'Remove unnecessary analytics & profiles\',\n      description: \'Execute the scope cut to prove disciplined engineering priorities to senior judges.\',\n      scoreBonus: 0.15,\n      applied: false,\n    },\n  ],\n};\n\nexport const initialLaunchChecklist: LaunchChecklistItem[] = [\n  { id: \'l-1\', label: \'Core MVP Functional Flow\', category: \'Product\', status: \'COMPLETE\', detail: \'Scope Cutter, Health dial, and AI recommendations operational.\', timeToFinish: \'0m\' },\n  { id: \'l-2\', label: \'End-to-End User Testing\', category: \'Product\', status: \'NEEDS_ATTENTION\', detail: \'Smoke test all interactive tabs on desktop and mobile viewports.\', timeToFinish: \'20m\' },\n  { id: \'l-3\', label: \'Zero Critical Console Bugs\', category: \'Product\', status: \'COMPLETE\', detail: \'Clean console with robust error boundaries in place.\', timeToFinish: \'0m\' },\n  { id: \'l-4\', label: \'Interactive Live Demo Link\', category: \'Pitch & Demo\', status: \'COMPLETE\', detail: \'Cloud Run deployed and publicly accessible via HTTPS.\', timeToFinish: \'0m\' },\n  { id: \'l-5\', label: \'3-Minute Pitch Script\', category: \'Pitch & Demo\', status: \'NEEDS_ATTENTION\', detail: \'Rehearse opening hook: \"You are in the second half. What matters right now?\"\', timeToFinish: \'15m\' },\n  { id: \'l-6\', label: \'GitHub README & Architecture Diagram\', category: \'Pitch & Demo\', status: \'COMPLETE\', detail: \'Clear installation steps, tech stack breakdown, and logo.\', timeToFinish: \'0m\' },\n  { id: \'l-7\', label: \'High-Res Hero Screenshots\', category: \'Pitch & Demo\', status: \'COMPLETE\', detail: \'Crisp 16:9 UI captures highlighting the bento grid and scope cutter.\', timeToFinish: \'0m\' },\n  { id: \'l-8\', label: \'60-Second Backup Demo Video\', category: \'Pitch & Demo\', status: \'NEEDS_ATTENTION\', detail: \'Render and upload to YouTube/Loom as fallback.\', timeToFinish: \'25m\' },\n  { id: \'l-9\', label: \'Product Hunt Launch Draft\', category: \'Distribution\', status: \'NOT_STARTED\', detail: \'Optional post-hackathon distribution teaser.\', timeToFinish: \'15m\' },\n  { id: \'l-10\', label: \'X / Twitter Demo Thread\', category: \'Distribution\', status: \'NOT_STARTED\', detail: \'Draft 4-tweet thread with video clip and repo link.\', timeToFinish: \'10m\' },\n  { id: \'l-11\', label: \'DoraHacks 2.0 Final Submission Form\', category: \'Distribution\', status: \'NEEDS_ATTENTION\', detail: \'Fill repo URL,