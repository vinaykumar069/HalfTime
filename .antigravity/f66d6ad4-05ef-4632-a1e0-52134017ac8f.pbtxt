    replacement_chunks {
      replacement_content: "import React from \'react\';\nimport { X, Brain, CheckCircle, AlertTriangle, ArrowRight, Zap, Target } from \'lucide-react\';\nimport { ProjectHealth } from \'../../types\';\n\ninterface ReasoningModalProps {\n  isOpen: boolean;\n  onClose: () => void;\n  health: ProjectHealth;\n  scopeCutApplied: boolean;\n}\n\nexport const ReasoningModal: React.FC<ReasoningModalProps> = ({\n  isOpen,\n  onClose,\n  health,\n  scopeCutApplied,\n}) => {\n  if (!isOpen) return null;\n\n  return (\n    <div className=\"fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/75 backdrop-blur-md animate-in fade-in\">\n      <div \n        id=\"halftime-reasoning-modal\"\n        className=\"w-full max-w-2xl bg-[#293735] border border-[#A8E6CF]/30 rounded-2xl shadow-2xl overflow-hidden glass-panel-elevated flex flex-col max-h-[90vh]\"\n      >\n        {/* Header */}\n        <div className=\"flex items-center justify-between px-6 py-4 border-b border-[#3B4B47] bg-[#202B2A]/50\">\n          <div className=\"flex items-center gap-3\">\n            <div className=\"w-8 h-8 rounded-lg bg-[#A8E6CF]/10 border border-[#A8E6CF]/30 flex items-center justify-center text-[#A8E6CF]\">\n              <Brain className=\"w-4 h-4\" />\n            </div>\n            <div>\n              <h3 className=\"text-sm font-bold text-[#F0F4EE]\">HALFTIME AI Reasoning Engine</h3>\n              <p className=\"text-[11px] font-mono text-[#A8E6CF]\">Deterministic Capacity & Judge Risk Model</p>\n            </div>\n          </div>\n          <button\n            onClick={onClose}\n            className=\"p-1.5 rounded-lg text-[#71817B] hover:text-[#F0F4EE] hover:bg-[#31413F] transition-colors\"\n          >\n            <X className=\"w-4 h-4\" />\n          </button>\n        </div>\n\n        {/* Content Body */}\n        <div className=\"p-6 overflow-y-auto space-y-6 text-xs text-[#AAB8B2] leading-relaxed\">\n          {/* Situation Analysis */}\n          <div className=\"p-4 rounded-xl bg-[#202B2A] border border-[#3B4B47] space-y-2.5\">\n            <div className=\"flex items-center justify-between text-[#F0F4EE] font-mono font-semibold\">\n              <span className=\"flex items-center gap-2\">\n                <Target className=\"w-4 h-4 text-[#FFE0A3]\" />\n                1. Situation Telemetry\n              </span>\n              <span className=\"text-[#A8E6CF] text-[11px]\">T-11:00h Remaining</span>\n            </div>\n            <p>\n              Your backlog contains <strong className=\"text-[#F0F4EE]\">14.0 hours</strong> of estimated engineering effort across 4 team members. With <strong className=\"text-[#F0F4EE]\">11.0 hours</strong> left before submission freeze and an estimated 1.5h required for live smoke testing, pitch rehearsal, and video rendering, your true engineering runway is <strong className=\"text-[#FFB7B2]\">9.5 hours</strong>.\n            </p>\n          </div>\n\n          {/* Core Problem Detected */}\n          <div className=\"p-4 rounded-xl bg-[#FFB7B2]/10 border border-[#FFB7B2]/30 space-y-2\">\n            <div className=\"flex items-center gap-2 text-[#FFB7B2] font-mono font-bold\">\n              <AlertTriangle className=\"w-4 h-4\" />\n              2. What is Wrong (The 3-Hour Capacity Gap)\n            </div>\n            <p className=\"text-[#F0F4EE]/90\">\n              {scopeCutApplied ? (\n                <span>\n                  <strong className=\"text-[#B7E4C7]\">RESOLVED:</strong> Scope cuts were executed. 3h 45m of secondary features were eliminated, bringing total remaining work to 10h 15m.\n                </span>\n              ) : (\n                <span>\n                  Team DOOM is <strong className=\"text-[#FFB7B2]\">3.0 hours over capacity</strong>. In 89% of hackathon post-mortems, teams that refuse to cut scope in the second half ship half-finished features, broken authentication flows, or unstyled dashboards that fail during judge evaluation.\n                </span>\n              )}\n            </p>\n          </div>\n\n          {/* Mathematical recommendation breakdown */}\n          <div className=\"space-y-3\">\n            <div className=\"flex items-center gap-2 text-[#F0F4EE] font-mono font-bold\">\n              <Zap className=\"w-4 h-4 text-[#C7F9A6]\" />\n              3. Recommended Intervention\n            </div>\n            \n            <div className=\"grid grid-cols-1 sm:grid-cols-3 gap-3\">\n              <div className=\"p-3 rounded-xl bg-[#202B2A] border border-[#3B4B47]\">\n                <div className=\"text-[10px] font-mono text-[#71817B]\">FEATURE CUT #1</div>\n                <div className=\"font-bold text-[#F0F4EE] text-xs mt-1\">Analytics Dashboard</div>\n                <div className=\"text-[#C7F9A6] font-mono font-bold text-xs mt-0.5\">\342\210\2222h 00m</div>\n                <div className=\"text-[10px] text-[#71817B] mt-1\">0% impact on 3-min demo</div>\n              </div>\n\n              <div className=\"p-3 rounded-xl bg-[#202B2A] border border-[#3B4B47]\">\n                <div className=\"text-[10px] font-mono text-[#71817B]\">FEATURE CUT #2</div>\n                <div className=\"font-bold text-[#F0F4EE] text-xs mt-1\">Team Profiles & Bios</div>\n                <div className=\"text-[#C7F9A6] font-mono font-bold text-xs mt-0.5\">\342\210\2221h 00m</div>\n                <div className=\"text-[10px] text-[#71817B] mt-1\">Replace with verbal intro</div>\n              </div>\n\n              <div className=\"p-3 rounded-xl bg-[#202B2A] border border-[#3B4B47]\">\n                <div className=\"text-[10px] font-mono text-[#71817B]\">FEATURE CUT #3</div>\n                <div className=\"font-bold text-[#F0F4EE] text-xs mt-1\">Dark Mode Toggle</div>\n                <div className=\"text-[#C7F9A6] font-mono font-bold text-xs mt-0.5\">\342\210\22245m</div>\n                <div className=\"text-[10px] text-[#71817B] mt-1\">Default theme is already dark</div>\n              </div>\n            </div>\n          </div>\n\n          {/* Outcome projection */}\n          <div className=\"p-4 rounded-xl bg-[#202B2A] border border-[#3B4B47] space-y-2\">\n            <div className=\"text-[#B7E4C7] font-mono font-bold flex items-center gap-2\">\n              <CheckCircle className=\"w-4 h-4\" />\n              4. Expected Outcome\n            </div>\n            <p>\n              By trimming 3h 45m of secondary fluff, 100% of Alex & Elena&apos;s bandwidth shifts to stabilizing the <strong>Core AI evaluation flow</strong> and rehearsing the <strong>3-minute demo script</strong>. Judge feasibility score increases from 9.1 to 9.8.\n            </p>\n          </div>\n        </div>\n\n        {/* Footer */}\n        <div className=\"px-6 py-3.5 border-t border-[#3B4B47] bg-[#202B2A]/80 flex justify-end\">\n          <button\n            onClick={onClose}\n            className=\"px-4 py-1.5 rounded-lg bg-[#C7F9A6] text-[#202B2A] font-mono text-xs font-bold hover:brightness-110 transition-all\"\n          >\n            Got it, close reasoning\n          </button>\n        </div>\n      </div>\n    </div>\n  );\n};\n"
    }
