        replacement_content: "    try {\n      const res = await improvePitch({\n        projectName,\n        problem,\n        solution,\n        demoMoment: \'Live interactive demo workflow with Gemini 2.5 Flash\',\n        impact: \'Maximized judge demo score and zero submission panic\',\n      });\n      if (res) {\n        setPitchData(res);\n        if (onSavePitch) {\n          onSavePitch(res);\n        }\n      }\n    } catch (e: any) {\n      setErrorMessage(e?.message || \'HALFTIME AI is temporarily unavailable. Please try again.\');\n    } finally {\n      clearInterval(timer);\n      setIsGeneratingPitch(false);\n    }\n  };\n\n  const handleGenerateDemoFlow = async () => {\n    setErrorMessage(null);\n    setIsGeneratingDemoFlow(true);\n\n    try {\n      const res = await generateDemoFlow({\n        projectName,\n        solution,\n        features,\n      });\n      if (res) {\n        setDemoFlowResult(res);\n        setIsDemoFlowOpen(true);\n        if (onSaveDemoFlow) {\n          onSaveDemoFlow(res);\n        }\n      }\n    } catch (e: any) {\n      setErrorMessage(e?.message || \'Failed to generate demo flow with Gemini.\');\n    } finally {\n      setIsGeneratingDemoFlow(false);\n    }\n  };"
