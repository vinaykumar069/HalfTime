  file_change {
    absolute_path_uri: "file:///src/components/judge/JudgeMode.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { \n  Scale, \n  AlertTriangle, \n  CheckCircle2, \n  Sparkles, \n  TrendingUp, \n  HelpCircle, \n  ArrowRight, \n  ShieldAlert,\n  Zap,\n  Target,\n  RefreshCw,\n  AlertCircle\n} from \'lucide-react\';\nimport { JudgeEvaluation, JudgeFix, MVPFeature } from \'../../types\';\nimport { judgeProject } from \'../../services/aiService\';\n\ninterface JudgeModeProps {\n  evaluation: JudgeEvaluation;\n  onToggleFix: (fixId: number) => void;\n  onRerunJudge?: () => void;\n  onUpdateEvaluation?: (ev: JudgeEvaluation) => void;\n  scopeCutApplied: boolean;\n  projectName?: string;\n  problem?: string;\n  solution?: string;\n  features?: MVPFeature[];\n}\n\nexport const JudgeMode: React.FC<JudgeModeProps> = ({\n  evaluation,\n  onToggleFix,\n  onRerunJudge,\n  onUpdateEvaluation,\n  scopeCutApplied,\n  projectName = \'Hackathon Project\',\n  problem = \'Teams run out of time and fail demos.\',\n  solution = \'Halftime copilot that auto-cuts scope and plans 3-minute demos.\',\n  features = [],\n}) => {\n  const [isAuditing, setIsAuditing] = useState(false);\n  const [auditStep, setAuditStep] = useState(0);\n  const [errorMessage, setErrorMessage] = useState<string | null>(null);\n\n  const judgeSteps = [\n    `Auditing hackathon criteria for ${projectName}...`,\n    \'Simulating 180-second judge attention span & live retention...\',\n    \'Stress-testing demo failure modes & live edge risks...\',\n    \'Calibrating pre-submission fixes and bonus recovery...\',\n  ];\n\n  const handleRerun = async () => {\n    setErrorMessage(null);\n    setIsAuditing(true);\n    setAuditStep(0);\n\n    const timer = setInterval(() => {\n      setAuditStep((prev) => (prev < judgeSteps.length - 1 ? prev + 1 : prev));\n    }, 600);\n\n    try {\n      const updated = await judgeProject({\n        scopeCutApplied,\n        projectName,\n        problem,\n        solution,\n        features,\n      });\n      if (updated && onUpdateEvaluation) {\n        onUpdateEvaluation(updated);\n      } else if (onRerunJudge) {\n        onRerunJudge();\n      }\n    } catch (e: any) {\n      setErrorMessage(e?.message || \'HALFTIME AI is temporarily unavailable. Please try again.\');\n    } finally {\n      clearInterval(timer);\n      setIsAuditing(false);\n    }\n  };\n\n  // Calculate dynamic overall score based on applied fixes\n  const fixedBonus = evaluation.fixes\n    .filter((f) => f.applied)\n    .reduce((acc, curr) => acc + curr.scoreBonus, 0);\n\n  const computedScore = Math.min(10, Number((evaluation.overallScore + (scopeCutApplied ? 0.35 : 0) + fixedBonus * 0.3).toFixed(2)));\n\n  return (\n    <div className=\"space-y-8 animate-in fade-in duration-300 pb-12\">\n      {/* Header */}\n      <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-4\">\n        <div>\n          <div className=\"inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#31413F] border border-[#3B4B47] text-xs font-mono text-[#FFE0A3] mb-2\">\n            <Scale className=\"w-3.5 h-3.5\" />\n            <span>AI JUDGE SIMULATION &amp; RUBRIC AUDIT</span>\n          </div>\n          <h1 className=\"text-2xl sm:text-4xl font-extrabold text-[#F0F4EE] tracking-tight font-display\">\n            JUDGE MODE\n          </h1>\n          <p className=\"text-sm sm:text-base text-[#AAB8B2] mt-1 font-medium\">\n            Brutally honest feedback calibrated against competitive hackathon rubrics.\n          </p>\n        </div>\n\n        <button\n          id=\"btn-rerun-judge-audit\"\n          onClick={handleRerun}\n          disabled={isAuditing}\n          className=\"flex items-center gap-2 px-4 py-2.5 rounded-xl bg-[#293735] hover:bg-[#31413F] border border-[#3B4B47] hover:border-[#FFE0A3]/40 text-xs font-mono text-[#F0F4EE] transition-all active:scale-95 self-start sm:self-auto cursor-pointer disabled:opacity-50\"\n        >\n          <RefreshCw className={`w-3.5 h-3.5 text-[#FFE0A3] ${isAuditing ? \'animate-spin\' : \'\'}`} />\n          <span>{isAuditing ? \'HALFTIME IS THINKING...\' : \'RE-RUN JUDGE AUDIT WITH GEMINI\'}</span>\n        </button>\n      </div>\n\n      {errorMessage && (\n        <div className=\"p-4 rounded-xl bg-[#FFB7B2]/10 border border-[#FFB7B2]/30 flex items-center justify-between gap-3 text-xs text-[#FFB7B2] animate-in fade-in\">\n          <div className=\"flex items-center gap-2.5\">\n            <AlertCircle className=\"w-4 h-4 shrink-0\" />\n            <span>{errorMessage}</span>\n          </div>\n          <button\n            onClick={handleRerun}\n            className=\"px-3 py-1 rounded-lg bg-[#FFB7B2]/20 hover:bg-[#FFB7B2]/30 font-mono text-[11px] font-bold text-[#FFB7B2] transition-colors\"\n          >\n            TRY AGAIN\n          </button>\n        </div>\n      )}\n\n      {/* Auditing State */}\n      {isAuditing && (\n        <div className=\"p-4 rounded-xl bg-[#293735] border border-[#FFE0A3]/40 space-y-2 animate-in fade-in\">\n          <div className=\"flex items-center justify-between text-xs font-mono\">\n            <span className=\"font-bold text-[#FFE0A3] flex items-center gap-2\">\n              <Sparkles className=\"w-3.5 h-3.5 animate-spin\" />\n              HALFTIME IS THINKING...\n            </span>\n            <span className=\"text-[#71817B]\">Step {auditStep + 1} of 4</span>\n          </div>\n          <p className=\"text-xs text-[#F0F4EE] font-mono\">{judgeSteps[auditStep]}</p>\n          <div className=\"h-1.5 w-full bg-[#3B4B47] rounded-full overflow-hidden\">\n            <div\n              className=\"h-full bg-gradient-to-r from-[#FFE0A3] to-[#C7F9A6] transition-all duration-500\"\n              style={{ width: `${((auditStep + 1) / judgeSteps.length) * 100}%` }}\n            />\n          </div>\n        </div>\n      )}\n\n      {/* Main Score & Top Risk Row */}\n      <div className=\"grid grid-cols-1 lg:grid-cols-3 gap-6\">\n        {/* Overall Score Box */}\n        <div className=\"p-6 sm:p-8 rounded-3xl bg-[#293735] border border-[#3B4B47] shadow-xl flex flex-col justify-between\">\n          <div>\n            <div className=\"flex items-center justify-between pb-3 border-b border-[#3B4B47]\">\n              <span className=\"text-xs font-mono font-bold text-[#AAB8B2] uppercase\">\n                PREDICTED SCORE\n              </span>\n              <span className=\"text-xs font-mono px-2.5 py-0.5 rounded-full bg-[#FFE0A3]/20 text-[#FFE0A3] border border-[#FFE0A3]/40 font-bold\">\n                {evaluation.statusLabel}\n              </span>\n            </div>\n\n            <div className=\"mt-6 flex items-baseline gap-2\">\n              <span className=\"text-5xl sm:text-6xl font-extrabold font-mono text-[#F0F4EE] tracking-tight\">\n                {computedScore}\n              </span>\n              <span className=\"text-lg font-mono text-[#71817B]\">/ 10</span>\n            </div>\n\n            <p className=\"text-xs text-[#AAB8B2] mt-3 leading-relaxed\">\n              {evaluation.summaryFeedback}\n            </p>\n          </div>\n\n          {scopeCutApplied && (\n            <div className=\"mt-4 p-3 rounded-xl bg-[#C7F9A6]/10 border border-[#C7F9A6]/30 flex items-center gap-2 text-xs font-mono text-[#C7F9A6]\">\n              <Zap className=\"w-3.5 h-3.5\" />\n              <span>Scope cut applied (+0.35 demo confidence bonus)</span>\n            </div>\n          )}\n        </div>\n\n        {/* Why You Might Lose Card */}\n        <div className=\"lg:col-span-2 p-6 sm:p-8 rounded-3xl bg-[#293735] border border-[#FFB7B2]/40 shadow-xl space-y-4\">\n          <div className=\"flex items-center gap-2 pb-3 border-b border-[#3B4B47] text-[#FFB7B2]\">\n            <ShieldAlert className=\"w-4 h-4\" />\n            <span className=\"text-xs font-mono font-bold uppercase tracking-wider\">\n              PRIMARY SUBMISSION RISK\n            </span>\n          </div>\n\n          <div className=\"space-y-2\">\n            <h3 className=\"text-lg font-bold text-[#F0F4EE]\">\n              Why You Might Lose:\n            </h3>\n            <p className=\"text-sm text-[#AAB8B2] leading-relaxed\">\n              {evaluation.whyYouMightLose}\n            </p>\n          </div>\n\n          <div className=\"p-4 rounded-xl bg-[#202B2A] border border-[#3B4B47] text-xs text-[#71817B]\">\n            <span className=\"font-mono text-[#F0F4EE] font-bold\">Judge Advice: </span>\n            A clean 3-minute demo that works 100% beats an ambitious broken product every single time.\n          </div>\n        </div>\n      </div>\n\n      {/* Weighted Criteria Breakdown */}\n      <div className=\"p-6 sm:p-8 rounded-3xl bg-[#293735] border border-[#3B4B47] shadow-xl space-y-6\">\n        <div className=\"flex items-center justify-between pb-3 border-b border-[#3B4B47]\">\n          <span className=\"text-xs font-mono font-bold text-[#F0F4EE] flex items-center gap-2\">\n            <Target className=\"w-4 h-4 text-[#FFE0A3]\" />\n            SCORING RUBRIC BREAKDOWN\n          </span>\n          <span className=\"text-[10px] font-mono text-[#71817B]\">WEIGHTED ALGORITHM</span>\n        </div>\n\n        <div className=\"grid grid-cols-1 md:grid-cols-2 gap-5\">\n          {evaluation.criteria.map((c, idx) => (\n            <div\n              key={idx}\n              className=\"p-4 rounded-2xl bg-[#202B2A] border border-[#3B4B47] space-y-2\"\n            >\n              <div className=\"flex items-center justify-between\">\n                <span className=\"text-xs font-bold text-[#F0F4EE]\">\n                  {c.name}\n                </span>\n                <span className=\"text-xs font-mono font-bold text-[#FFE0A3]\">\n                  {c.score}/10 <span className=\"text-[10px] text-[#71817B]\">({c.weight}%)</span>\n                </span>\n              </div>\n\n              <div className=\"h-1.5 rounded-full bg-[#293735] overflow-hidden\">\n                <div\n                  className=\"h-full bg-[#FFE0A3] rounded-full\"\n                  style={{ width: `${(c.score / 10) * 100}%` }}\n                />\n              </div>\n\n              <p className=\"text-[11px] text-[#AAB8B2] leading-relaxed pt-1\">\n                {c.feedback}\n              </p>\n            </div>\n          ))}\n        </div>\n      </div>\n\n      {/* Suggested Fixes (Interactive Toggle) */}\n      <div className=\"p-6 sm:p-8 rounded-3xl bg-[#293735] border border-[#3B4B47] shadow-xl space-y-6\">\n        <div className=\"flex items-center justify-between pb-3 border-b border-[#3B4B47]\">\n          <div>\n            <span className=\"text-xs font-mono font-bold text-[#F0F4EE] flex items-center gap-2\">\n              <Sparkles className=\"w-4 h-4 text-[#C7F9A6]\" />\n              INSTANT PRE-SUBMISSION FIXES\n            </span>\n            <p className=\"text-xs text-[#71817B] mt-0.5\">Toggle fixes you implement to recalculate your estimated score</p>\n          </div>\n          <span className=\"text-xs font-mono text-[#C7F9A6] font-bold\">\n            +{fixedBonus.toFixed(1)} Bonus Pts Available\n          </span>\n        </div>\n\n        <div className=\"space-y-3\">\n          {evaluation.fixes.map((fix) => (\n            <div\n              key={fix.id}\n              onClick={() => onToggleFix(fix.id)}\n              className={`p-4 rounded-2xl border transition-all cursor-pointer flex items-start justify-between gap-4 ${\n                fix.applied\n                  ? \'bg-[#202B2A] border-[#C7F9A6] shadow-[0_0_15px_rgba(199,249,166,0.1)]\'\n                  : \'bg-[#202B2A]/50 border-[#3B4B47] hover:border-[#71817B]\'\n              }`}\n            >\n              <div className=\"flex items-start gap-3\">\n                <div\n                  className={`w-5 h-5 rounded-lg border flex items-center justify-center mt-0.5 transition-colors ${\n                    fix.applied\n                      ? \'bg-[#C7F9A6] border-[#C7F9A6] text-[#202B2A]\'\n                      : \'border-[#3B4B47] text-transparent\'\n                  }`}\n                >\n                  <CheckCircle2 className=\"w-3.5 h-3.5\" />\n                </div>\n\n                <div>\n                  <h4 className={`text-xs font-bold ${fix.applied ? \'text-[#F0F4EE]\' : \'text-[#AAB8B2]\'}`}>\n                    {fix.title}\n                  </h4>\n                  <p className=\"text-[11px] text-[#71817B] mt-0.5 leading-relaxed\">\n                    {fix.description}\n                  </p>\n                </div>\n              </div>\n\n              <span className={`text-xs font-mono font-bold shrink-0 ${fix.applied ? \'text-[#C7F9A6]\' : \'text-[#71817B]\'}`}>\n                +{fix.scoreBonus} pts\n              </span>\n            </div>\n          ))}\n        </div>\n      </div>\n    </div>\n  );\n};\n"
    }
